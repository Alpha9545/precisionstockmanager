                        <form asp-page="/Account/Logout"
                              method="post"
                              class="d-inline ms-1">

                            <button type="submit"
                                    class="btn btn-sm btn-danger logout-btn">

                                Logout

                            </button>

                        </form>

                    </div>


                    <!-- Mobile -->

                    <div class="d-flex d-md-none align-items-center">

                        <div class="dropdown">

                            @{
                                var name =
                                    User.Identity?.Name ?? "";

                                var firstWord =
                                    name
                                    .Split(
                                        ' ',
                                        StringSplitOptions.RemoveEmptyEntries
                                    )
                                    .FirstOrDefault() ?? "";
                            }


                            <button class="btn btn-outline-secondary btn-sm dropdown-toggle user-avatar-btn"
                                    type="button"
                                    id="userMenuBtn"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                <span class="avatar-name">
                                    @firstWord
                                </span>

                            </button>


                            <ul class="dropdown-menu dropdown-menu-end p-2"
                                aria-labelledby="userMenuBtn"
                                style="min-width:180px;">

                                <li class="px-2">

                                    <div class="fw-semibold small user-mobile-name">
                                        @User.Identity?.Name
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(designationName))
                                    {
                                        <div class="small text-danger user-mobile-designation">
                                            @designationName
                                        </div>
                                    }

                                </li>


                                <li>
                                    <hr class="dropdown-divider" />
                                </li>




                                <li>

                                    <form asp-page="/Account/Logout"
                                          method="post"
                                          class="m-0 px-2">

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger w-100">

                                            Logout

                                        </button>

                                    </form>

                                </li>

                            </ul>

                        </div>

                    </div>

                </div>
            }
            else
            {
                <!-- Desktop Login -->

                <div class="d-none d-md-block">

                    <a class="btn btn-outline-primary"
                       asp-page="/Account/Login">

                        Login

                    </a>

                </div>


                <!-- Mobile Login -->

                <div class="d-block d-md-none">

                    <a class="btn btn-outline-primary btn-sm"
                       asp-page="/Account/Login">

                        Login

                    </a>

                </div>
            }

        </div>

    </header>


    <!-- =========================================================
         MAIN CONTENT
         ========================================================= -->

    <div class="main-content">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- =========================================================
         JAVASCRIPT
         ========================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <script src="~/js/flatpicker.min.js"></script>


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                /*
                 * From Date
                 */
                const fromDatePicker =
                    document.getElementById("fromDatePicker");

                if (fromDatePicker) {

                    flatpickr(
                        "#fromDatePicker",
                        {
                            dateFormat: "d/m/Y",
                            allowInput: true
                        }
                    );

                }


                /*
                 * To Date
                 */
                const toDatePicker =
                    document.getElementById("toDatePicker");

                if (toDatePicker) {

                    flatpickr(
                        "#toDatePicker",
                        {
                            dateFormat: "d/m/Y",
                            allowInput: true
                        }
                    );

                }

            }
        );


        /*
         * Base path for AJAX requests.
         */
        window.basePath =
            '@Url.Content("~/")';


        /*
         * Prevent browser from restoring
         * an authenticated page from cache
         * after logout.
         */
        if (window.history.replaceState) {

            window.history.replaceState(
                null,
                null,
                window.location.href
            );

        }


        /*
         * Handle browser Back / Forward cache.
         */
        window.addEventListener(
            "pageshow",
            function (event) {

                if (
                    event.persisted ||
                    (
                        window.performance &&
                        window.performance.navigation &&
                        window.performance.navigation.type === 2
                    )
                ) {

                    window.location.reload();

                }

            }
        );

    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>
</html>