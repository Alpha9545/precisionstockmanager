<!DOCTYPE html>
<html lang="en-GB">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - PlantStockManager</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PlantStockManager.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/flatpicker.min.css" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
</head>

<body>

    @using System.Security.Claims

    @{
        var isAuthenticated =
            User.Identity != null &&
            User.Identity.IsAuthenticated;

        var designationName =
            User.FindFirst("DesignationName")?.Value;

        /*
         * Phase A: the sidebar is permission-based. Every menu item carries
         * nav-page="<page>" and is rendered only if the user passes that
         * page's rule in Authorization/FeatureAuthorizationConventions.cs --
         * the SAME rule the server enforces on the page itself (hiding a
         * link is never the security boundary). A section (nav-section) is
         * hidden when none of its items is visible. The System Administrator
         * (full access) sees every item. The former hard-coded designation
         * checks (DesignationId 2/3/4/5) are gone: access comes from roles.
         */
    }

    <div class="overlay"></div>

    <!-- =========================================================
         SIDEBAR
         ========================================================= -->

    <div class="sidebar close">

        <!-- Logo / Menu -->
        <div class="logo-details">

            <img src="~/images/menu.svg"
                 alt="Menu Icon"
                 class="menu-icon" />

            <span class="logo_name"></span>

        </div>


        <ul class="nav-links">

            <!-- =================================================
                 HOME (company home page)
                 ================================================= -->

            <li nav-page="/index">

                <a asp-page="/index">

                    <img src="~/images/home.svg"
                         alt="Home Icon"
                         class="nav-icon" />

                    <span class="link_name">
                        Home
                    </span>

                </a>

                <ul class="sub-menu blank">

                    <li>
                        <a class="link_name"
                           asp-page="/index">
                            Home
                        </a>
                    </li>

                </ul>

            </li>


            <!-- =================================================
                 USER SEED STOCK (2026-10-08: renamed from "Seed Production")
                 ================================================= -->

            <li nav-section>
                <div class="icon-link">
                    <a href="#">
                        <img src="~/images/leaf.svg" alt="" class="nav-icon" />
                        <span class="link_name">User Seed Stock</span>
                    </a>
                    <img src="~/images/arrow.svg" alt="Expand" class="arrow" />
                </div>
                <ul class="sub-menu">
                    <li><a class="link_name" href="#">User Seed Stock</a></li>
                    <li nav-page="/Production/SeedStock/Index"><a asp-page="/Production/SeedStock/Index">Seed Stock</a></li>
                    <li nav-page="/Production/MaterialStock/Index"><a asp-page="/Production/MaterialStock/Index">Material Stock</a></li>
                    <li nav-page="/Production/MaterialStock/Add"><a asp-page="/Production/MaterialStock/Add">Add Material</a></li>
                    <li nav-page="/Production/MaterialStock/TrayTransfers"><a asp-page="/Production/MaterialStock/TrayTransfers">Tray Transfers</a></li>
                    <li nav-page="/Production/MaterialStock/TrayAdjust"><a asp-page="/Production/MaterialStock/TrayAdjust">Adjust Trays</a></li>
                    <li nav-page="/Production/SeedSowing/Index"><a asp-page="/Production/SeedSowing/Index">Direct Seed Sowing</a></li>
                    <li nav-page="/Production/BedSowing/Index"><a asp-page="/Production/BedSowing/Index">Bed Sowing</a></li>
                    <li nav-page="/Production/BedSowing/Transplant"><a asp-page="/Production/BedSowing/Transplant">Bed Transplanting</a></li>
                    <li nav-page="/Production/CuttingStock/PendingConfirmations"><a asp-page="/Production/CuttingStock/PendingConfirmations">Confirm Cutting Receipt</a></li>
                    <li nav-page="/Production/ReadyConfirmation/Index"><a asp-page="/Production/ReadyConfirmation/Index">Sowing Approvals</a></li>
                    <li nav-page="/Production/ReadyAlerts/Index"><a asp-page="/Production/ReadyAlerts/Index">Ready Alerts</a></li>
                    <li nav-page="/Production/ReadyStock/Index"><a asp-page="/Production/ReadyStock/Index">Ready Seedling Stock</a></li>
                    @if (PlantStockManager.Authorization.ClaimsPrincipalSecurityExtensions.HasPermission(User, "ReadyStock.TransferToMotherPlant"))
                    {
                        <li nav-page="/Production/MotherPlantTransfers/Index"><a asp-page="/Production/MotherPlantTransfers/Index">Transfers to Mother Plant</a></li>
                    }
                </ul>
            </li>


            <!-- =================================================
                 MOTHER PLANT & CUTTING
                 ================================================= -->

            <li nav-section>
                <div class="icon-link">
                    <a href="#">
                        <img src="~/images/compass.svg" alt="" class="nav-icon" />
                        <span class="link_name">Mother Plant &amp; Cutting</span>
                    </a>
                    <img src="~/images/arrow.svg" alt="Expand" class="arrow" />
                </div>
                <ul class="sub-menu">
                    <li><a class="link_name" href="#">Mother Plant &amp; Cutting</a></li>
                    <li nav-page="/Production/MotherPlant/Index"><a asp-page="/Production/MotherPlant/Index">Mother Plants</a></li>
                    <li nav-page="/Production/MotherPlant/ReadyStock"><a asp-page="/Production/MotherPlant/ReadyStock">Ready Stock (Trays &amp; Pots)</a></li>
                    @* 2026-10-21: Direct (seed) Sowing into a Mother Plant Area; the batch waits in Sowing Approvals *@
                    <li nav-page="/Production/MotherPlant/DirectSowing"><a asp-page="/Production/MotherPlant/DirectSowing">Direct Sowing</a></li>
                    @* 2026-10-19: transplanted tray batches of the user's Mother Plant Areas waiting for approval *@
                    <li nav-page="/Production/MotherPlant/SowingApprovals"><a asp-page="/Production/MotherPlant/SowingApprovals">Sowing Approvals</a></li>
                    <li nav-page="/Production/Cutting/Index"><a asp-page="/Production/Cutting/Index">Cutting Production</a></li>
                    <li nav-page="/Production/CuttingStock/GiveToMainOffice"><a asp-page="/Production/CuttingStock/GiveToMainOffice">Send Cuttings to Main Office</a></li>
                    <li nav-page="/Production/CuttingStock/MyTransactions"><a asp-page="/Production/CuttingStock/MyTransactions">Cutting Delivery History</a></li>
                    <li nav-page="/Production/CuttingStock/Index"><a asp-page="/Production/CuttingStock/Index">Cutting Stock</a></li>
                    @* 2026-10-14: empty pots / trays of a Mother Plant or Cutting Area (Area only, no polyhouse). *@
                    <li nav-page="/Production/EmptyPotInventory/AddStock"><a asp-page="/Production/EmptyPotInventory/AddStock" asp-route-section="MotherPlant">Add Empty Pots</a></li>
                    <li nav-page="/Production/MotherPlant/AddEmptyTrays"><a asp-page="/Production/MotherPlant/AddEmptyTrays" asp-route-section="MotherPlant">Add Empty Trays</a></li>
                    <li nav-page="/Production/SeedSowing/CreateFromCutting"><a asp-page="/Production/SeedSowing/CreateFromCutting">Confirm Cutting Sowing</a></li>
                    @* One page serves both sides of a transfer; each menu entry shows only to its own side. *@
                    @if (PlantStockManager.Authorization.ClaimsPrincipalSecurityExtensions.HasPermission(User, "ReadyStock.ReceiveTransfer"))
                    {
                        <li nav-page="/Production/MotherPlantTransfers/Index"><a asp-page="/Production/MotherPlantTransfers/Index">Incoming Ready Stock</a></li>
                    }
                    <li nav-page="/Production/Transplanting/Index"><a asp-page="/Production/Transplanting/Index">Transplanting</a></li>
                    <li nav-page="/Production/Transplanting/History"><a asp-page="/Production/Transplanting/History">Transplanting History</a></li>
                </ul>
            </li>


            <!-- =================================================
                 POT PRODUCTION
                 ================================================= -->

            <li nav-section>
                <div class="icon-link">
                    <a href="#">
                        <img src="~/images/bulb.svg" alt="" class="nav-icon" />
                        <span class="link_name">Pot Production</span>
                    </a>
                    <img src="~/images/arrow.svg" alt="Expand" class="arrow" />
                </div>
                <ul class="sub-menu">
                    <li><a class="link_name" href="#">Pot Production</a></li>
                    <li nav-page="/Production/EmptyPotInventory/Index"><a asp-page="/Production/EmptyPotInventory/Index">Empty Pot Stock</a></li>
                    <li nav-page="/Production/PotBatch/Index"><a asp-page="/Production/PotBatch/Index">Pot Production Batches</a></li>
                    <li nav-page="/Production/PottedPlantStock/Index"><a asp-page="/Production/PottedPlantStock/Index">Potted Plant Stock</a></li>
                </ul>
            </li>


            <!-- =================================================
                 SALES / DISTRIBUTION
                 ================================================= -->

            <li nav-section>
                <div class="icon-link">
                    <a href="#">
                        <img src="~/images/cart.svg" alt="" class="nav-icon" />
                        <span class="link_name">Sales / Distribution</span>
                    </a>
                    <img src="~/images/arrow.svg" alt="Expand" class="arrow" />
                </div>
                <ul class="sub-menu">
                    <li><a class="link_name" href="#">Sales / Distribution</a></li>
                    <li nav-page="/Bookings/Book"><a asp-page="/Bookings/Book">New Seedling Booking</a></li>
                    <li nav-page="/Bookings/EditBookingRecords"><a asp-page="/Bookings/EditBookingRecords">Edit Seedling Booking</a></li>
                    <li nav-page="/Data/BookingsRecord"><a asp-page="/Data/BookingsRecord">Seedling Booking Records</a></li>
                    <li nav-page="/Bookings/Fulfilment"><a asp-page="/Bookings/Fulfilment">Seedling Fulfilment</a></li>
                    <li nav-page="/Bookings/DispatchRegister"><a asp-page="/Bookings/DispatchRegister">Seedling Dispatch Register</a></li>
                    <li nav-page="/Production/PottedPlantBooking/Index"><a asp-page="/Production/PottedPlantBooking/Index">Potted Plant Bookings</a></li>
                    <li nav-page="/Production/Dispatch/Index"><a asp-page="/Production/Dispatch/Index">Potted Plant Dispatch</a></li>
                    <li nav-page="/Production/InternalTransfer/Index"><a asp-page="/Production/InternalTransfer/Index">Stock Movement Register</a></li>
                </ul>
            </li>


            <!-- =================================================
                 OUTLET
                 ================================================= -->

            <li nav-section>
                <div class="icon-link">
                    <a href="#">
                        <img src="~/images/cart.svg" alt="" class="nav-icon" />
                        <span class="link_name">Outlet</span>
                    </a>
                    <img src="~/images/arrow.svg" alt="Expand" class="arrow" />
                </div>
                <ul class="sub-menu">
                    <li><a class="link_name" href="#">Outlet</a></li>
                    <li nav-page="/Production/PottedPlantStock/Index"><a asp-page="/Production/PottedPlantStock/Index">Potted Plants (Stock)</a></li>
                    <li nav-page="/Production/ReadyStock/Index"><a asp-page="/Production/ReadyStock/Index">Ready Trays (Stock)</a></li>
                    <li nav-page="/Production/OutletPurchase/Create"><a asp-page="/Production/OutletPurchase/Create">External Purchase</a></li>
                    <li nav-page="/Production/OutletSale/Create"><a asp-page="/Production/OutletSale/Create">Direct Sale</a></li>
                    <li nav-page="/Production/OutletBooking/Create"><a asp-page="/Production/OutletBooking/Create">Customer Booking</a></li>
                    <li nav-page="/Production/OutletWastage/Create"><a asp-page="/Production/OutletWastage/Create">Record Wastage</a></li>
                    <li nav-page="/Production/OutletSale/Index"><a asp-page="/Production/OutletSale/Index">Sales History</a></li>
                    <li nav-page="/Production/OutletBooking/Index"><a asp-page="/Production/OutletBooking/Index">Booking History</a></li>
                    <li nav-page="/Data/StockHistory"><a asp-page="/Data/StockHistory">Stock History</a></li>
                </ul>
            </li>


            <!-- =================================================
                 PURCHASE
                 ================================================= -->

            <li nav-section>
                <div class="icon-link">
                    <a href="#">
                        <img src="~/images/find.svg" alt="" class="nav-icon" />
                        <span class="link_name">Purchase</span>
                    </a>
                    <img src="~/images/arrow.svg" alt="Expand" class="arrow" />
                </div>
                <ul class="sub-menu">
                    <li><a class="link_name" href="#">Purchase</a></li>
                    <li nav-page="/Admin/Vendor"><a asp-page="/Admin/Vendor">Vendors</a></li>
                    <li nav-page="/Production/PurchaseOrder/Index"><a asp-page="/Production/PurchaseOrder/Index">Purchase Orders</a></li>
                </ul>
            </li>


            <!-- =================================================
                 LAB
                 ================================================= -->

            <li nav-section>
                <div class="icon-link">
                    <a href="#">
                        <img src="~/images/find.svg" alt="" class="nav-icon" />
                        <span class="link_name">Lab</span>
                    </a>
                    <img src="~/images/arrow.svg" alt="Expand" class="arrow" />
                </div>
                <ul class="sub-menu">
                    <li><a class="link_name" href="#">Lab</a></li>
                    <li nav-page="/Production/LabRequest/Index"><a asp-page="/Production/LabRequest/Index">Lab Requests</a></li>
                </ul>
            </li>

            <!-- =================================================
                 INVENTORY STORE (tools / consumables at Main Office)
                 ================================================= -->

            <li nav-section>
                <div class="icon-link">
                    <a href="#">
                        <img src="~/images/find.svg" alt="" class="nav-icon" />
                        <span class="link_name">Inventory Store</span>
                    </a>
                    <img src="~/images/arrow.svg" alt="Expand" class="arrow" />
                </div>
                <ul class="sub-menu">
                    <li><a class="link_name" href="#">Inventory Store</a></li>
                    <li nav-page="/Store/Index"><a asp-page="/Store/Index">Dashboard</a></li>
                    <li nav-page="/Store/Items"><a asp-page="/Store/Items">Item Master</a></li>
                    <li nav-page="/Store/StockEntry"><a asp-page="/Store/StockEntry">Stock Entry</a></li>
                    <li nav-page="/Store/Requests"><a asp-page="/Store/Requests">Requests</a></li>
                    <li nav-page="/Store/Issue"><a asp-page="/Store/Issue">Issue</a></li>
                    <li nav-page="/Store/Returns"><a asp-page="/Store/Returns">Returns</a></li>
                    <li nav-page="/Store/Transfers"><a asp-page="/Store/Transfers">Transfers</a></li>
                    <li nav-page="/Store/Reports"><a asp-page="/Store/Reports">Reports</a></li>
                </ul>
            </li>

            <!-- =================================================
                 SUGGESTIONS & PROBLEMS (posts, comments and replies)
                 ================================================= -->

            <li nav-section>
                <div class="icon-link">
                    <a href="#">
                        <img src="~/images/bulb.svg" alt="" class="nav-icon" />
                        <span class="link_name">Suggestions &amp; Problems</span>
                    </a>
                    <img src="~/images/arrow.svg" alt="Expand" class="arrow" />
                </div>
                <ul class="sub-menu">
                    <li><a class="link_name" href="#">Suggestions &amp; Problems</a></li>
                    <li nav-page="/Suggestions/Index"><a asp-page="/Suggestions/Index">All Posts</a></li>
                    <li nav-page="/Suggestions/Create"><a asp-page="/Suggestions/Create">Create Post</a></li>
                </ul>
            </li>

            <!-- =================================================
                 MAINTENANCE (electrical / welding / plumbing tickets)
                 ================================================= -->

            <li nav-section>
                <div class="icon-link">
                    <a href="#">
                        <img src="~/images/cog.svg" alt="" class="nav-icon" />
                        <span class="link_name">Maintenance</span>
                    </a>
                    <img src="~/images/arrow.svg" alt="Expand" class="arrow" />
                </div>
                <ul class="sub-menu">
                    <li><a class="link_name" href="#">Maintenance</a></li>
                    <li nav-page="/Maintenance/Raise"><a asp-page="/Maintenance/Raise">Raise Ticket</a></li>
                    <li nav-page="/Maintenance/MyTickets"><a asp-page="/Maintenance/MyTickets">My Tickets</a></li>
                    <li nav-page="/Maintenance/Assigned"><a asp-page="/Maintenance/Assigned">Assigned Tickets</a></li>
                    <li nav-page="/Maintenance/Reports"><a asp-page="/Maintenance/Reports">Maintenance Reports</a></li>
                </ul>
            </li>

            <!-- =================================================
                 LABOUR (daily headcount)
                 ================================================= -->

            <li nav-section>
                <div class="icon-link">
                    <a href="#">
                        <img src="~/images/compass.svg" alt="" class="nav-icon" />
                        <span class="link_name">Labour</span>
                    </a>
                    <img src="~/images/arrow.svg" alt="Expand" class="arrow" />
                </div>
                <ul class="sub-menu">
                    <li><a class="link_name" href="#">Labour</a></li>
                    <li nav-page="/Production/Labour/Attendance"><a asp-page="/Production/Labour/Attendance">Daily Attendance</a></li>
                    <li nav-page="/Production/Labour/Overtime"><a asp-page="/Production/Labour/Overtime">Overtime</a></li>
                    <li nav-page="/Production/Labour/MyOvertime"><a asp-page="/Production/Labour/MyOvertime">My Overtime Entries</a></li>
                </ul>
            </li>


            <!-- =================================================
                 FERTILIZER
                 ================================================= -->

            <li nav-section>
                <div class="icon-link">
                    <a href="#">
                        <img src="~/images/leaf.svg" alt="" class="nav-icon" />
                        <span class="link_name">Fertilizer</span>
                    </a>
                    <img src="~/images/arrow.svg" alt="Expand" class="arrow" />
                </div>
                <ul class="sub-menu">
                    <li><a class="link_name" href="#">Fertilizer</a></li>
                    <li nav-page="/Fertilizer/UnitMaster"><a asp-page="/Fertilizer/UnitMaster">Unit Master</a></li>
                    <li nav-page="/Fertilizer/Type"><a asp-page="/Fertilizer/Type">Fertilizer Type</a></li>
                    <li nav-page="/Fertilizer/Fertilizer"><a asp-page="/Fertilizer/Fertilizer">Fertilizer Master</a></li>
                    <li nav-page="/Fertilizer/Source"><a asp-page="/Fertilizer/Source">Fertilizer Source</a></li>
                    <li nav-page="/Fertilizer/Stock"><a asp-page="/Fertilizer/Stock">Fertilizer Stock</a></li>
                    <li nav-page="/Fertilizer/Usage"><a asp-page="/Fertilizer/Usage">Fertilizer Usage</a></li>
                    <li nav-page="/Fertilizer/View"><a asp-page="/Fertilizer/View">Fertilizer Report</a></li>
                    <li nav-page="/Fertilizer/Transactions"><a asp-page="/Fertilizer/Transactions">Fertilizer Transactions</a></li>
                </ul>
            </li>


            <!-- =================================================
                 REPORTS
                 ================================================= -->

            <li nav-section>
                <div class="icon-link">
                    <a href="#">
                        <img src="~/images/chart.svg" alt="" class="nav-icon" />
                        <span class="link_name">Reports</span>
                    </a>
                    <img src="~/images/arrow.svg" alt="Expand" class="arrow" />
                </div>
                <ul class="sub-menu">
                    <li><a class="link_name" href="#">Reports</a></li>
                    <li nav-page="/Data/StockHistory"><a asp-page="/Data/StockHistory">Stock History</a></li>
                    <li nav-page="/Data/WastedStock"><a asp-page="/Data/WastedStock">Wastage</a></li>
                    <li nav-page="/Data/SeedSowingMonthlyReport"><a asp-page="/Data/SeedSowingMonthlyReport">Sowing Monthly Report</a></li>
                    <li nav-page="/Production/MaterialStock/History"><a asp-page="/Production/MaterialStock/History">Material History</a></li>
                    @* 2026-10-20: labour reports, System Administrator only (FeatureAuthorizationConventions) *@
                    <li nav-page="/Production/Labour/AttendanceHistory"><a asp-page="/Production/Labour/AttendanceHistory">Attendance History</a></li>
                    <li nav-page="/Production/Labour/OvertimeHistory"><a asp-page="/Production/Labour/OvertimeHistory">Overtime History</a></li>
                </ul>
            </li>


            <!-- =================================================
                 MASTER DATA & ADMIN
                 ================================================= -->

            <li nav-section>
                <div class="icon-link">
                    <a href="#">
                        <img src="~/images/cog.svg" alt="" class="nav-icon" />
                        <span class="link_name">Master Data &amp; Admin</span>
                    </a>
                    <img src="~/images/arrow.svg" alt="Expand" class="arrow" />
                </div>
                <ul class="sub-menu">
                    <li><a class="link_name" href="#">Master Data &amp; Admin</a></li>
                    <li nav-page="/Admin/Plant"><a asp-page="/Admin/Plant">Plant / Variety Master</a></li>
                    <li nav-page="/Admin/PotSizes"><a asp-page="/Admin/PotSizes">Pot Sizes</a></li>
                    <li nav-page="/Admin/Seedsource"><a asp-page="/Admin/Seedsource">Seed Sources</a></li>
                    <li nav-page="/Admin/Area"><a asp-page="/Admin/Area">Areas</a></li>
                    <li nav-page="/Admin/Polyhouse"><a asp-page="/Admin/Polyhouse">Polyhouses</a></li>
                    <li nav-page="/Production/MaterialStock/Settings"><a asp-page="/Production/MaterialStock/Settings">Material Settings</a></li>
                    <li nav-page="/Admin/Users"><a asp-page="/Admin/Users">Users</a></li>
                    <li nav-page="/Admin/Roles"><a asp-page="/Admin/Roles">Roles / Permissions</a></li>
                    <li nav-page="/Admin/UserRoles"><a asp-page="/Admin/UserRoles">User Roles</a></li>
                </ul>
            </li>


            <!-- =================================================
                 MANAGEMENT DASHBOARD
                 Administrator permission only
                 ================================================= -->

            <li nav-page="/ManagementDashboard/Index">

                <a asp-page="/ManagementDashboard/Index">

                    <img src="~/images/chart.svg"
                         alt="Management Dashboard Icon"
                         class="nav-icon" />

                    <span class="link_name">
                        Management Dashboard
                    </span>

                </a>


                <ul class="sub-menu blank">

                    <li>
                        <a class="link_name"
                           asp-page="/ManagementDashboard/Index">
                            Management Dashboard
                        </a>
                    </li>

                </ul>

            </li>


            <!-- =================================================
                 PROFILE / LOGOUT
                 ================================================= -->

            @if (isAuthenticated)
            {
                <li>

                    <div class="profile-details">

                        <div class="profile-content">

                            <img src="~/images/user.png"
                                 class="profileImg"
                                 alt="User" />

                        </div>


                        <div class="name-job me-2">

                            <div class="profile_name">
                                @User.Identity?.Name
                            </div>

                        </div>


                        <form asp-page="/Account/Logout"
                              method="post"
                              class="d-inline">

                            <button type="submit"
                                    class="btn p-0 border-0 bg-transparent"
                                    title="Logout">

                                <img src="~/images/log-out.svg"
                                     alt="Logout"
                                     class="log-out"
                                     style="height:28px;width:28px;" />

                            </button>

                        </form>

                    </div>

                </li>
            }

        </ul>

    </div>


    <!-- =========================================================
         TOP HEADER
         ========================================================= -->

    <header class="top-header">

        <!-- Mobile Menu -->

        <div class="mobile-menu-icon">

            <img src="~/images/menu.svg"
                 alt="Menu Icon"
                 class="menu-icon"
                 style="filter:invert(1);margin-right:10px;" />

        </div>


        <div class="header-content">

            <span class="header-title">
                Precision Agritech Pvt. Ltd. Plant Manager
            </span>


            @if (isAuthenticated)
            {
                <div class="user-area d-flex align-items-center gap-3">


                    <!-- Desktop -->

                    <div class="d-none d-md-flex align-items-center gap-2">

                        <span class="greeting text-dark fw-bold">

                            Hello

                            <span class="user-name">
                                @User.Identity?.Name
                            </span>,

                        </span>


                        @if (!string.IsNullOrWhiteSpace(designationName))
                        {
                            <span class="designation badge bg-danger">
                                @designationName
                            </span>
                        }




                        <form asp-page="/Account/Logout"
                              method="post"
                              class="d-inline ms-1">

                            <button type="submit"
                                    class="btn btn-sm btn-danger logout-btn">

                                Logout

                            </button>

                        </form>

                    </div>


                    <!-- Mobile -->

                    <div class="d-flex d-md-none align-items-center">

                        <div class="dropdown">

                            @{
                                var name =
                                    User.Identity?.Name ?? "";

                                var firstWord =
                                    name
                                    .Split(
                                        ' ',
                                        StringSplitOptions.RemoveEmptyEntries
                                    )
                                    .FirstOrDefault() ?? "";
                            }


                            <button class="btn btn-outline-secondary btn-sm dropdown-toggle user-avatar-btn"
                                    type="button"
                                    id="userMenuBtn"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false">

                                <span class="avatar-name">
                                    @firstWord
                                </span>

                            </button>


                            <ul class="dropdown-menu dropdown-menu-end p-2"
                                aria-labelledby="userMenuBtn"
                                style="min-width:180px;">

                                <li class="px-2">

                                    <div class="fw-semibold small user-mobile-name">
                                        @User.Identity?.Name
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(designationName))
                                    {
                                        <div class="small text-danger user-mobile-designation">
                                            @designationName
                                        </div>
                                    }

                                </li>


                                <li>
                                    <hr class="dropdown-divider" />
                                </li>




                                <li>

                                    <form asp-page="/Account/Logout"
                                          method="post"
                                          class="m-0 px-2">

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger w-100">

                                            Logout

                                        </button>

                                    </form>

                                </li>

                            </ul>

                        </div>

                    </div>

                </div>
            }
            else
            {
                <!-- Desktop Login -->

                <div class="d-none d-md-block">

                    <a class="btn btn-outline-primary"
                       asp-page="/Account/Login">

                        Login

                    </a>

                </div>


                <!-- Mobile Login -->

                <div class="d-block d-md-none">

                    <a class="btn btn-outline-primary btn-sm"
                       asp-page="/Account/Login">

                        Login

                    </a>

                </div>
            }

        </div>

    </header>


    <!-- =========================================================
         MAIN CONTENT
         ========================================================= -->

    <div class="main-content">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- =========================================================
         JAVASCRIPT
         ========================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <script src="~/js/flatpicker.min.js"></script>


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                /*
                 * From Date
                 */
                const fromDatePicker =
                    document.getElementById("fromDatePicker");

                if (fromDatePicker) {

                    flatpickr(
                        "#fromDatePicker",
                        {
                            dateFormat: "d/m/Y",
                            allowInput: true
                        }
                    );

                }


                /*
                 * To Date
                 */
                const toDatePicker =
                    document.getElementById("toDatePicker");

                if (toDatePicker) {

                    flatpickr(
                        "#toDatePicker",
                        {
                            dateFormat: "d/m/Y",
                            allowInput: true
                        }
                    );

                }

            }
        );


        /*
         * Base path for AJAX requests.
         */
        window.basePath =
            '@Url.Content("~/")';


        /*
         * Prevent browser from restoring
         * an authenticated page from cache
         * after logout.
         */
        if (window.history.replaceState) {

            window.history.replaceState(
                null,
                null,
                window.location.href
            );

        }


        /*
         * Handle browser Back / Forward cache.
         */
        window.addEventListener(
            "pageshow",
            function (event) {

                if (
                    event.persisted ||
                    (
                        window.performance &&
                        window.performance.navigation &&
                        window.performance.navigation.type === 2
                    )
                ) {

                    window.location.reload();

                }

            }
        );

    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>
</html>