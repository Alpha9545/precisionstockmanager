@page
@model PlantStockManager.Pages.ManagementDashboard.IndexModel
@using PlantStockManager.Models
@using PlantStockManager.Services
@inject PlantStockManager.Authorization.FeatureAccessService FeatureAccess
@{
    ViewData["Title"] = "Management Dashboard";
    // 2026-10-20: the labour reports are System Administrator only -- link to them only when this user may open them
    var canSeeAttendanceHistory = await FeatureAccess.CanAccessPageAsync(User, "/Production/Labour/AttendanceHistory");
    var canSeeOvertimeHistory = await FeatureAccess.CanAccessPageAsync(User, "/Production/Labour/OvertimeHistory");
}

@functions {
    // ------------------------------------------------------------
    // Lightweight inline-SVG chart helpers. No new JS charting
    // library is introduced (Step 7's "use existing Bootstrap/custom
    // styling -- do not introduce a large new frontend framework"),
    // and every chart below only renders data ManagementDashboardRepository
    // actually computed from a genuinely date-stamped source table --
    // see that repository's own comments for which charts were
    // deliberately NOT added (a fabricated "stock level over time"
    // trend has no supporting historical-snapshot table anywhere in
    // this app). Categorical colors below are slots 1 (blue) and 2
    // (orange) from the project's validated data-viz palette, applied
    // in fixed order (never cycled) per that skill's non-negotiables.
    // ------------------------------------------------------------
    private const string Series1Color = "#2a78d6"; // blue
    private const string Series2Color = "#eb6834"; // orange
    private const string MutedInk = "#898781";
    private const string GridColor = "#e1e0d9";
    private const string BaselineColor = "#c3c2b7";

    private static string EmptyChartState(string message)
    {
        return $"<div class='text-muted small py-4 text-center border rounded bg-light'>{System.Net.WebUtility.HtmlEncode(message)}</div>";
    }

    // Two-series grouped bar chart, one date bucket per group. Used
    // only for Sowing vs. Ready (Section B/Charts) -- a genuine,
    // date-stamped comparison of two movement quantities.
    private static string RenderGroupedBarChart(List<TrendPoint> points, string series1Name, string series2Name)
    {
        if (points == null || points.Count == 0)
            return EmptyChartState("No Sowing or Ready Confirmation activity in the selected date range.");

        var dates = points.Select(p => p.BucketDate.Date).Distinct().OrderBy(d => d).ToList();
        if (dates.Count == 0)
            return EmptyChartState("No Sowing or Ready Confirmation activity in the selected date range.");

        var max = points.Select(p => p.Value).DefaultIfEmpty(0).Max();
        if (max <= 0) max = 1;

        const int width = 900, height = 220, leftPad = 40, bottomPad = 26, topPad = 10;
        var plotWidth = width - leftPad - 10;
        var plotHeight = height - bottomPad - topPad;
        var groupWidth = dates.Count > 0 ? (double)plotWidth / dates.Count : plotWidth;
        var barWidth = Math.Max(3, Math.Min(18, groupWidth / 2.0 - 4));

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox='0 0 {width} {height}' width='100%' height='{height}' role='img' aria-label='Sowing versus Confirmed Ready, by day'>");
        // gridlines (3 horizontal guides)
        for (int i = 1; i <= 3; i++)
        {
            var y = topPad + plotHeight - (plotHeight * i / 4.0);
            sb.Append($"<line x1='{leftPad}' y1='{y:F1}' x2='{width - 10}' y2='{y:F1}' stroke='{GridColor}' stroke-width='1' />");
        }
        sb.Append($"<line x1='{leftPad}' y1='{topPad + plotHeight}' x2='{width - 10}' y2='{topPad + plotHeight}' stroke='{BaselineColor}' stroke-width='1' />");

        var byDate = points.GroupBy(p => p.BucketDate.Date).ToDictionary(g => g.Key, g => g.ToList());
        for (int i = 0; i < dates.Count; i++)
        {
            var d = dates[i];
            var groupX = leftPad + i * groupWidth;
            var sown = byDate[d].FirstOrDefault(p => p.Series == series1Name)?.Value ?? 0;
            var ready = byDate[d].FirstOrDefault(p => p.Series == series2Name)?.Value ?? 0;

            var sownH = (double)(sown / max) * plotHeight;
            var readyH = (double)(ready / max) * plotHeight;
            var x1 = groupX + groupWidth / 2.0 - barWidth - 2;
            var x2 = groupX + groupWidth / 2.0 + 2;

            sb.Append($"<rect x='{x1:F1}' y='{(topPad + plotHeight - sownH):F1}' width='{barWidth:F1}' height='{sownH:F1}' rx='2' fill='{Series1Color}'><title>{d:dd MMM}: {series1Name} {Qty(sown)}</title></rect>");
            sb.Append($"<rect x='{x2:F1}' y='{(topPad + plotHeight - readyH):F1}' width='{barWidth:F1}' height='{readyH:F1}' rx='2' fill='{Series2Color}'><title>{d:dd MMM}: {series2Name} {Qty(ready)}</title></rect>");

            if (dates.Count <= 20 || i % Math.Max(1, dates.Count / 12) == 0)
            {
                sb.Append($"<text x='{(groupX + groupWidth / 2.0):F1}' y='{height - 6}' font-size='10' fill='{MutedInk}' text-anchor='middle'>{d:dd/MM}</text>");
            }
        }
        sb.Append("</svg>");

        sb.Append("<div class='small mt-1'>")
          .Append($"<span style='display:inline-block;width:10px;height:10px;background:{Series1Color};border-radius:2px;margin-right:4px;'></span>{System.Net.WebUtility.HtmlEncode(series1Name)}")
          .Append("&nbsp;&nbsp;")
          .Append($"<span style='display:inline-block;width:10px;height:10px;background:{Series2Color};border-radius:2px;margin-right:4px;'></span>{System.Net.WebUtility.HtmlEncode(series2Name)}")
          .Append("</div>");

        return sb.ToString();
    }

    // Single-series bar chart over time. Used for Outlet Dispatch trend.
    private static string RenderSingleSeriesBarChart(List<TrendPoint> points, string unitLabel)
    {
        if (points == null || points.Count == 0)
            return EmptyChartState("No Dispatch activity in the selected date range.");

        var max = points.Select(p => p.Value).DefaultIfEmpty(0).Max();
        if (max <= 0) max = 1;

        const int width = 900, height = 180, leftPad = 40, bottomPad = 26, topPad = 10;
        var plotWidth = width - leftPad - 10;
        var plotHeight = height - bottomPad - topPad;
        var barWidth = Math.Max(3, Math.Min(22, (double)plotWidth / points.Count - 4));

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox='0 0 {width} {height}' width='100%' height='{height}' role='img' aria-label='Dispatched quantity by day, in {unitLabel}'>");
        for (int i = 1; i <= 3; i++)
        {
            var y = topPad + plotHeight - (plotHeight * i / 4.0);
            sb.Append($"<line x1='{leftPad}' y1='{y:F1}' x2='{width - 10}' y2='{y:F1}' stroke='{GridColor}' stroke-width='1' />");
        }
        sb.Append($"<line x1='{leftPad}' y1='{topPad + plotHeight}' x2='{width - 10}' y2='{topPad + plotHeight}' stroke='{BaselineColor}' stroke-width='1' />");

        var step = (double)plotWidth / points.Count;
        for (int i = 0; i < points.Count; i++)
        {
            var p = points[i];
            var h = (double)(p.Value / max) * plotHeight;
            var x = leftPad + i * step + (step - barWidth) / 2.0;
            sb.Append($"<rect x='{x:F1}' y='{(topPad + plotHeight - h):F1}' width='{barWidth:F1}' height='{h:F1}' rx='2' fill='{Series1Color}'><title>{p.BucketDate:dd MMM}: {Qty(p.Value)} {unitLabel}</title></rect>");
            if (points.Count <= 20 || i % Math.Max(1, points.Count / 12) == 0)
                sb.Append($"<text x='{(x + barWidth / 2.0):F1}' y='{height - 6}' font-size='10' fill='{MutedInk}' text-anchor='middle'>{p.BucketDate:dd/MM}</text>");
        }
        sb.Append("</svg>");
        return sb.ToString();
    }

    // Horizontal bar chart, one bar per category -- used for Growing
    // Partner production (a magnitude comparison across a small,
    // bounded set of partners/areas, not a time series).
    private static string RenderHorizontalBarChart(List<CategoryValue> categories, string unitLabel)
    {
        if (categories == null || categories.Count == 0)
            return EmptyChartState("No completed Pot/Tray Production recorded for any Growing Partner in the selected date range.");

        var max = categories.Select(c => c.Value).DefaultIfEmpty(0).Max();
        if (max <= 0) max = 1;

        const int width = 900, rowHeight = 26, leftPad = 190, rightPad = 60;
        var height = categories.Count * rowHeight + 10;
        var plotWidth = width - leftPad - rightPad;

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox='0 0 {width} {height}' width='100%' height='{height}' role='img' aria-label='Pot/Tray production by Growing Partner, in {unitLabel}'>");
        for (int i = 0; i < categories.Count; i++)
        {
            var c = categories[i];
            var y = i * rowHeight + 4;
            var barW = (double)(c.Value / max) * plotWidth;
            var label = c.Label.Length > 26 ? c.Label.Substring(0, 24) + "…" : c.Label;
            sb.Append($"<text x='{leftPad - 8}' y='{y + 14}' font-size='11' fill='#0b0b0b' text-anchor='end'>{System.Net.WebUtility.HtmlEncode(label)}</text>");
            sb.Append($"<rect x='{leftPad}' y='{y}' width='{barW:F1}' height='{rowHeight - 8}' rx='3' fill='{Series1Color}'><title>{System.Net.WebUtility.HtmlEncode(c.Label)}: {Qty(c.Value)} {unitLabel}</title></rect>");
            sb.Append($"<text x='{leftPad + barW + 6:F1}' y='{y + 14}' font-size='11' fill='{MutedInk}'>{Qty(c.Value)}</text>");
        }
        sb.Append("</svg>");
        return sb.ToString();
    }
}

@{
    var o = Model.Overview;
    var periodLabel = o.Period.Label;
    string Pct(decimal? p) => p.HasValue ? p.Value.ToString("0.0") + "%" : "";
    string N(int n, string one, string many) => $"{n} {(n == 1 ? one : many)}";
    string When(DateTime d) => d.Date == o.Today ? d.ToString("hh:mm tt") : d.ToString("dd MMM, hh:mm tt");
    var detailRoute = new Dictionary<string, string>
    {
        ["AreaId"] = Model.AreaId?.ToString() ?? "",
        ["SpeciesId"] = Model.SpeciesId?.ToString() ?? "",
        ["PotSize"] = Model.PotSize ?? "",
    };
}

<style>
    .mgmt .kpi { border: 1px solid #dee2e6; border-radius: .5rem; padding: .65rem .8rem; background: #fff; height: 100%; display: block; color: inherit; text-decoration: none; }
    .mgmt a.kpi:hover { border-color: #86b7fe; box-shadow: 0 0 0 .15rem rgba(13,110,253,.12); }
    .mgmt .kpi .label { font-size: .78rem; color: #6c757d; text-transform: uppercase; letter-spacing: .02em; }
    .mgmt .kpi .value { font-size: 1.55rem; font-weight: 700; line-height: 1.2; }
    .mgmt .kpi .sub { font-size: .8rem; color: #6c757d; }
    .mgmt .kpi.warn { background: #fffaf0; border-color: #f1d38a; }
    .mgmt .kpi.bad { background: #fff5f5; border-color: #f1aeb5; }
    .mgmt .scope { font-size: .68rem; font-weight: 600; border-radius: .25rem; padding: .05rem .35rem; vertical-align: middle; }
    .mgmt .scope.now { background: #e9ecef; color: #495057; }
    .mgmt .scope.period { background: #cfe2ff; color: #084298; }
    .mgmt .section-title { font-size: 1.05rem; font-weight: 600; margin: 1.5rem 0 .6rem; }
    .mgmt .card-title-sm { font-weight: 600; font-size: .95rem; }
    .mgmt .rank { display: inline-block; width: 1.6rem; height: 1.6rem; line-height: 1.6rem; border-radius: 50%; background: #e7f1ff; color: #084298; font-weight: 700; text-align: center; font-size: .85rem; }
    .mgmt .table td, .mgmt .table th { vertical-align: middle; }
    .mgmt .num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .mgmt .stat-list { list-style: none; padding: 0; margin: 0; font-size: .9rem; }
    .mgmt .stat-list li { display: flex; justify-content: space-between; gap: .5rem; padding: .25rem 0; border-bottom: 1px solid #f1f3f5; }
    .mgmt .stat-list li:last-child { border-bottom: 0; }
    .mgmt .period-bar .btn { margin-bottom: .25rem; }
    .mgmt .activity-kind { font-size: .7rem; min-width: 7.5rem; }
    .mgmt details > summary { cursor: pointer; }
    .mgmt .ph-row td:first-child { padding-left: 1.6rem; color: #495057; }
    .mgmt .vbar-row { display: grid; grid-template-columns: minmax(6rem, 12rem) 1fr auto; align-items: center; gap: .5rem; padding: .2rem 0; font-size: .85rem; }
    .mgmt .vbar-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .mgmt .vbar-track { height: 14px; }
    .mgmt .vbar-fill { height: 100%; min-width: 2px; background: #2a78d6; border-radius: 0 4px 4px 0; }
    .mgmt .vbar-fill.others { background: #898781; }
    .mgmt .vbar-row:hover .vbar-fill { filter: brightness(.88); }
    .mgmt .vbar-value { min-width: 4.5rem; text-align: right; font-variant-numeric: tabular-nums; color: #495057; }
    @@media (max-width: 576px) { .mgmt .kpi .value { font-size: 1.3rem; } .mgmt .activity-kind { min-width: 0; } }
</style>

<div class="container-fluid mt-4 mgmt">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h2 class="mb-0">Management Dashboard</h2>
        <div class="d-flex flex-wrap align-items-center gap-2">
            @if (await FeatureAccess.CanAccessPageAsync(User, "/ManagementDashboard/DailyOperationsReport"))
            {
                <a asp-page="/ManagementDashboard/DailyOperationsReport" class="btn btn-sm btn-primary" id="daily-operations-report-link">Daily Operations Report</a>
            }
            <span class="badge bg-dark">Administrator only</span>
        </div>
    </div>
    <div class="text-muted small mb-3">
        Read live from the operational tables; viewing this page never writes anything.
        <span class="scope now">NOW</span> = current state (the period does not change it).
        <span class="scope period">PERIOD</span> = activity dated inside <strong>@periodLabel</strong>.
        <a href="#definitions">Definitions</a>
    </div>

    <!-- Period selector -->
    <form method="get" class="period-bar d-flex flex-wrap align-items-end gap-2 mb-3 p-2 border rounded bg-light">
        @foreach (var kv in detailRoute.Where(kv => kv.Value != ""))
        {
            <input type="hidden" name="@kv.Key" value="@kv.Value" />
        }
        <div class="btn-group flex-wrap" role="group" aria-label="Period">
            @foreach (var (key, label) in DashboardPeriod.Presets.Where(p => p.Key != DashboardPeriod.Custom))
            {
                <button type="submit" name="Range" value="@key" class="btn btn-sm @(o.Period.Key == key ? "btn-primary" : "btn-outline-primary")">@label</button>
            }
        </div>
        <div>
            <label class="form-label small mb-0">From</label>
            <input type="date" name="FromDate" value="@o.Period.From.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <div>
            <label class="form-label small mb-0">To</label>
            <input type="date" name="ToDate" value="@o.Period.To.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        </div>
        <button type="submit" name="Range" value="@DashboardPeriod.Custom" class="btn btn-sm @(o.Period.Key == DashboardPeriod.Custom ? "btn-primary" : "btn-outline-secondary")">Apply custom range</button>
        <span class="small text-muted ms-auto">Today (India time): @o.Today.ToString("dd MMM yyyy") &middot; the period changes PERIOD figures only</span>
    </form>

    <!-- KPI cards -->
    <div class="row g-2 g-md-3">
        <div class="col-6 col-md-4 col-xl-3">
            <a class="kpi" asp-page="/Production/ReadyStock/Index">
                @* 2026-10-10 standard definitions (docs/STOCK_DEFINITIONS.md): the main figure is AVAILABLE
                   for booking/dispatch = physical - reserved; physical excludes plants in transit. *@
                <div class="label">Ready seedlings &mdash; available for booking/dispatch <span class="scope now">NOW</span></div>
                <div class="value">@Qty(o.ReadyTotals.Available)</div>
                <div class="sub">physical @Qty(o.ReadyTotals.Physical) &middot; reserved @Qty(o.ReadyTotals.Reserved)@(Model.MotherPlantFlow.InTransitPlants > 0 ? $" · in transit {Qty(Model.MotherPlantFlow.InTransitPlants)}" : "")</div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <a class="kpi" asp-page="/Bookings/Fulfilment" asp-route-Status="Pending">
                <div class="label">Open seedling orders <span class="scope now">NOW</span></div>
                <div class="value">@o.Seedlings.OpenOrders</div>
                <div class="sub">@Qty(o.Seedlings.OpenRemainingQuantity) plants still to dispatch &middot; @N(o.Seedlings.OpenLines, "variety line", "variety lines")@if (o.Seedlings.OverdueOrders > 0) {<text> &middot; <span class="text-danger">@o.Seedlings.OverdueOrders past delivery date</span></text>}</div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <a class="kpi" asp-page="/Bookings/DispatchRegister" asp-route-From="@o.Period.From.ToString("yyyy-MM-dd")" asp-route-To="@o.Period.To.ToString("yyyy-MM-dd")">
                <div class="label">Seedlings dispatched <span class="scope period">PERIOD</span></div>
                <div class="value">@Qty(o.Seedlings.DispatchedQuantity)</div>
                <div class="sub">@N(o.Seedlings.Dispatches, "dispatch", "dispatches") &middot; @periodLabel</div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <a class="kpi" asp-page="/Data/BookingsRecord">
                <div class="label">Seedling orders received <span class="scope period">PERIOD</span></div>
                <div class="value">@o.Seedlings.OrdersReceived</div>
                <div class="sub">@Qty(o.Seedlings.QuantityReceived) plants booked &middot; @periodLabel</div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <a class="kpi" asp-page="/Production/PottedPlantStock/Index">
                <div class="label">Potted plant stock <span class="scope now">NOW</span></div>
                <div class="value">@Qty(o.PottedTotals.Physical)</div>
                <div class="sub">@Qty(o.PottedTotals.Available) available &middot; @Qty(o.PottedTotals.Reserved) reserved</div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <a class="kpi @(o.Maintenance.Critical > 0 || o.Maintenance.Overdue > 0 ? "bad" : "")" asp-page="/Maintenance/MyTickets">
                <div class="label">Open maintenance tickets <span class="scope now">NOW</span></div>
                <div class="value">@o.Maintenance.Active</div>
                <div class="sub">@o.Maintenance.Critical critical &middot; @o.Maintenance.Overdue overdue</div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <a class="kpi @(o.Store.PendingReview + o.Store.ApprovedAwaitingIssue > 0 ? "warn" : "")" asp-page="/Store/Requests" asp-route-Status="@StoreRules.Pending">
                <div class="label">Store requests pending <span class="scope now">NOW</span></div>
                <div class="value">@o.Store.PendingReview</div>
                <div class="sub">@o.Store.ApprovedAwaitingIssue approved, not issued &middot; @o.Store.LowStockCount low-stock items</div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            @if (canSeeAttendanceHistory)
            {
                <a class="kpi" asp-page="/Production/Labour/AttendanceHistory" asp-route-FromDate="@o.Today.ToString("yyyy-MM-dd")" asp-route-ToDate="@o.Today.ToString("yyyy-MM-dd")">
                    <div class="label">Today's labour <span class="scope now">TODAY</span></div>
                    <div class="value">@o.Labour.At9</div>
                    <div class="sub">present at 9:00 AM &middot; @o.Labour.FullDay full / @o.Labour.HalfDay half day</div>
                </a>
            }
            else
            {
                <div class="kpi">
                    <div class="label">Today's labour <span class="scope now">TODAY</span></div>
                    <div class="value">@o.Labour.At9</div>
                    <div class="sub">present at 9:00 AM &middot; @o.Labour.FullDay full / @o.Labour.HalfDay half day</div>
                </div>
            }
        </div>
    </div>

    <!-- Attention required -->
    <div class="section-title">Attention required</div>
    @if (o.Attention.Any())
    {
        <div class="list-group mb-2">
            @foreach (var a in o.Attention)
            {
                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" asp-page="@a.Page" asp-all-route-data="@a.Query">
                    <span><span class="badge bg-@a.Severity me-2">@(a.Severity == "danger" ? "!" : a.Severity == "warning" ? "Due" : "Info")</span>@a.Text</span>
                    <span class="badge bg-@a.Severity rounded-pill">@a.Count</span>
                </a>
            }
        </div>
    }
    else
    {
        <div class="alert alert-success py-2">Nothing needs attention right now.</div>
    }

    <!-- Stock -->
    <div class="section-title">Stock <span class="scope now">NOW</span></div>
    <div class="row g-3">
        <div class="col-12 col-xl-4">
            <div class="card h-100"><div class="card-body">
                <div class="card-title-sm mb-2">Stock overview</div>
                <div class="table-responsive">
                    <table class="table table-sm mb-2">
                        <thead class="table-light"><tr><th></th><th class="num">Physical</th><th class="num">Reserved</th><th class="num">Available</th></tr></thead>
                        <tbody>
                            <tr><td>Ready seedlings</td><td class="num">@Qty(o.ReadyTotals.Physical)</td><td class="num">@Qty(o.ReadyTotals.Reserved)</td><td class="num fw-semibold">@Qty(o.ReadyTotals.Available)</td></tr>
                            <tr><td>Potted plants</td><td class="num">@Qty(o.PottedTotals.Physical)</td><td class="num">@Qty(o.PottedTotals.Reserved)</td><td class="num fw-semibold">@Qty(o.PottedTotals.Available)</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="text-muted small">
                    Available = Physical &minus; Reserved. Reserved seedlings are held for seedling bookings;
                    reserved potted plants for potted-plant bookings. The two stocks are different products and are never added together.
                    @if (o.PottedTotals.InTransit > 0) { <span>Potted plants in transit: @Qty(o.PottedTotals.InTransit).</span> }
                </div>
            </div></div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card h-100"><div class="card-body">
                <div class="card-title-sm">Top 3 varieties by Ready Stock</div>
                <div class="text-muted small mb-2">Physical approved seedlings per variety; % of all Ready Stock (@Qty(o.ReadyTotals.Physical)).</div>
                @if (o.TopByReadyStock.Any())
                {
                    <div class="table-responsive"><table class="table table-sm mb-0">
                        <thead><tr><th>#</th><th>Variety</th><th class="num">Quantity</th><th class="num">%</th></tr></thead>
                        <tbody>
                            @foreach (var v in o.TopByReadyStock)
                            {
                                <tr>
                                    <td><span class="rank">@v.Rank</span></td>
                                    <td><a asp-page="/Production/ReadyStock/Index" asp-route-Search="@v.VarietyName">@v.VarietyName</a><div class="text-muted small">@v.PlantTypeName</div></td>
                                    <td class="num fw-semibold">@Qty(v.Quantity)</td>
                                    <td class="num text-muted">@Pct(v.PercentOfTotal)</td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
                else { <div class="text-muted small">No Ready Stock at the moment.</div> }
            </div></div>
        </div>

        <div class="col-md-6 col-xl-4">
            <div class="card h-100"><div class="card-body">
                <div class="card-title-sm">Top 3 varieties by open booking quantity</div>
                <div class="text-muted small mb-2">Plants still to dispatch on Pending seedling bookings; % of all (@Qty(o.Seedlings.OpenRemainingQuantity)).</div>
                @if (o.TopByOpenBooking.Any())
                {
                    <div class="table-responsive"><table class="table table-sm mb-0">
                        <thead><tr><th>#</th><th>Variety</th><th class="num">Quantity</th><th class="num">%</th></tr></thead>
                        <tbody>
                            @foreach (var v in o.TopByOpenBooking)
                            {
                                <tr>
                                    <td><span class="rank">@v.Rank</span></td>
                                    <td><a asp-page="/Bookings/Fulfilment" asp-route-Status="Pending">@v.VarietyName</a><div class="text-muted small">@v.PlantTypeName</div></td>
                                    <td class="num fw-semibold">@Qty(v.Quantity)</td>
                                    <td class="num text-muted">@Pct(v.PercentOfTotal)</td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                }
                else { <div class="text-muted small">No seedlings waiting for dispatch.</div> }
            </div></div>
        </div>
    </div>

    <div class="row g-3 mt-0">
        <div class="col-xl-7">
            <div class="card h-100"><div class="card-body">
                <div class="card-title-sm">Ready Stock by variety <span class="text-muted small fw-normal">(top @IndexModel.ChartVarieties, the rest grouped as Others; unit: plants)</span></div>
                @if (o.ReadyStockByVarietyChart.Any())
                {
                    var maxBar = o.ReadyStockByVarietyChart.Max(c => c.Value);
                    <div class="vbar-list mt-2" role="list" aria-label="Ready Stock by variety, in plants">
                        @foreach (var c in o.ReadyStockByVarietyChart)
                        {
                            var width = maxBar > 0 ? Math.Round(c.Value / maxBar * 100m, 1) : 0m;
                            var isOthers = c.Label.StartsWith("Others (");
                            <div class="vbar-row" role="listitem" title="@c.Label: @Qty(c.Value) plants">
                                <div class="vbar-label">@c.Label</div>
                                <div class="vbar-track"><div class="vbar-fill @(isOthers ? "others" : "")" style="width:@(width.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div></div>
                                <div class="vbar-value">@Qty(c.Value)</div>
                            </div>
                        }
                    </div>
                }
                else { <div class="text-muted small py-4 text-center border rounded bg-light mt-2">No Ready Stock at the moment.</div> }
            </div></div>
        </div>
        <div class="col-xl-5">
            <div class="card h-100"><div class="card-body">
                <div class="card-title-sm">Ready Stock by Plant Type</div>
                <div class="text-muted small mb-2">Plant Type is the crop group (e.g. MERI GOLD); the varieties above belong to it.</div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead class="table-light"><tr><th>Plant Type</th><th class="num">Varieties</th><th class="num">Physical</th><th class="num">Available</th><th class="num">%</th></tr></thead>
                        <tbody>
                            @foreach (var p in o.ReadyStockByPlantType)
                            {
                                <tr><td>@p.PlantTypeName</td><td class="num">@p.Varieties</td><td class="num">@Qty(p.Physical)</td><td class="num">@Qty(p.Available)</td><td class="num text-muted">@Pct(p.PercentOfTotal)</td></tr>
                            }
                            @if (!o.ReadyStockByPlantType.Any()) { <tr><td colspan="5" class="text-muted text-center">No Ready Stock.</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div></div>
        </div>
    </div>

    <!-- Area / Polyhouse -->
    <div class="section-title">Stock by Area and Polyhouse <span class="scope now">NOW</span></div>
    <div class="card"><div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm mb-1">
                <thead class="table-light">
                    <tr><th>Area / Polyhouse</th><th class="num">Ready physical</th><th class="num">Reserved</th><th class="num">Available</th><th class="num">Potted physical</th><th class="num">Potted available</th></tr>
                </thead>
                <tbody>
                    @foreach (var a in o.Areas)
                    {
                        <tr class="fw-semibold">
                            <td>@a.AreaName @if (a.AreaType != null) { <span class="text-muted small fw-normal">(@a.AreaType)</span> }</td>
                            <td class="num">@Qty(a.ReadyPhysical)</td><td class="num">@Qty(a.ReadyReserved)</td><td class="num">@Qty(a.ReadyAvailable)</td>
                            <td class="num">@Qty(a.PottedPhysical)</td><td class="num">@Qty(a.PottedAvailable)</td>
                        </tr>
                        @foreach (var p in a.Polyhouses.Where(p => a.Polyhouses.Count > 1 || p.PolyhouseId.HasValue))
                        {
                            <tr class="ph-row small">
                                <td>@p.Name @if (p.BelongsToAreaName != null) { <span class="badge bg-warning text-dark" title="Area/Polyhouse master-data mismatch: this Polyhouse belongs to @p.BelongsToAreaName">mismatch: Polyhouse of @p.BelongsToAreaName</span> }</td>
                                <td class="num">@Qty(p.Physical)</td><td class="num">@Qty(p.Reserved)</td><td class="num">@Qty(p.Available)</td>
                                <td class="num text-muted">&ndash;</td><td class="num text-muted">&ndash;</td>
                            </tr>
                        }
                    }
                    @if (!o.Areas.Any()) { <tr><td colspan="6" class="text-muted text-center">No stock recorded.</td></tr> }
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr><td>Total</td><td class="num">@Qty(o.ReadyTotals.Physical)</td><td class="num">@Qty(o.ReadyTotals.Reserved)</td><td class="num">@Qty(o.ReadyTotals.Available)</td><td class="num">@Qty(o.PottedTotals.Physical)</td><td class="num">@Qty(o.PottedTotals.Available)</td></tr>
                </tfoot>
            </table>
        </div>
        <div class="text-muted small">Ready Stock is recorded per Polyhouse; Potted Plant Stock only per Area (&ndash;).</div>
        @if (o.PolyhouseMismatches.Any())
        {
            <div class="alert alert-warning small mt-2 mb-0 py-2" role="alert">
                <div class="fw-semibold">Area/Polyhouse master-data mismatch</div>
                <div class="mb-1">Ready Stock below is recorded under one Area on a Polyhouse that belongs to another Area. It is counted under the recorded Area, exactly as stored; nothing has been moved. Correcting the master data is a separate task.</div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0 bg-transparent">
                        <thead><tr><th>Recorded Area</th><th>Polyhouse</th><th>Polyhouse's actual Area</th><th class="num">Quantity</th></tr></thead>
                        <tbody>
                            @foreach (var m in o.PolyhouseMismatches)
                            {
                                <tr>
                                    <td>@m.RecordedAreaName</td><td>@m.PolyhouseName</td><td>@m.PolyhouseAreaName</td>
                                    <td class="num">@Qty(m.Physical) <span class="text-muted">(@N(m.Batches, "batch", "batches")@(m.Reserved > 0 ? $", {Qty(m.Reserved)} reserved" : ""))</span></td>
