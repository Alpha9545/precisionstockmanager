                <a asp-page="/Production/PottedPlantBooking/Index" class="btn btn-sm btn-outline-secondary">Potted bookings &rarr;</a>
            </div></div>
        </div>
        <div class="col-lg-6">
            <div class="section-title">Production <span class="scope period">PERIOD</span></div>
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small mb-1">@periodLabel, all Areas</div>
