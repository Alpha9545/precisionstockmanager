                        <strong>Many pending orders are past their expected delivery date:</strong>
                        @o.Seedlings.OverdueOrders of @o.Seedlings.OpenOrders open orders (@((o.Seedlings.OverdueOrders * 100m / o.Seedlings.OpenOrders).ToString("0"))%)
