                    <li><span>Still to dispatch</span><span><strong>@Qty(o.Seedlings.OpenRemainingQuantity)</strong> &middot; @Qty(o.Seedlings.OpenReservedQuantity) reserved</span></li>
                    <li><span>Pending, past expected delivery date</span><span class="@(o.Seedlings.OverdueOrders > 0 ? "text-danger fw-semibold" : "")">@N(o.Seedlings.OverdueOrders, "order", "orders") &middot; @Qty(o.Seedlings.OverdueRemainingQuantity) plants</span></li>
                    <li><span>Pending, due for delivery today</span><span>@N(o.Seedlings.DueTodayOrders, "order", "orders") &middot; @Qty(o.Seedlings.DueTodayRemainingQuantity) plants</span></li>
                    <li><span>Orders received <span class="scope period">PERIOD</span></span><span>@N(o.Seedlings.OrdersReceived, "order", "orders") &middot; @Qty(o.Seedlings.QuantityReceived) plants</span></li>
                    <li><span>Dispatched <span class="scope period">PERIOD</span></span><span>@N(o.Seedlings.Dispatches, "dispatch", "dispatches") &middot; @Qty(o.Seedlings.DispatchedQuantity) plants</span></li>
                </ul>
