    <!-- Definitions -->
    <details class="mt-3" id="definitions">
        <summary class="small text-muted">How these figures are calculated</summary>
        <div class="small text-muted mt-2">
            <ul>
                <li><strong>Ready seedling stock</strong>: dbo.ReadyStock, physical = SUM(Quantity &minus; DispatchedQuantity); reserved = SUM(ReservedQuantity); available = physical &minus; reserved.</li>
                <li><strong>Potted plant stock</strong>: dbo.PottedPlantStock, SUM(PhysicalQuantity); available = physical &minus; reserved.</li>
                <li><strong>Seedling order</strong>: one customer booking (ISNULL(OrderBookingId, Id)); a multi-variety order is ONE order. Quantities are summed over its variety lines.</li>
                <li><strong>Open / still to dispatch</strong>: lines with Status Pending; remaining = Quantity &minus; Dispatched &minus; legacy-fulfilled (never below 0).</li>
                <li><strong>Top 3 varieties</strong>: Ready Stock physical per variety (dbo.PlantSpecies), and open remaining per variety; highest first, % of the all-variety total.</li>
                <li><strong>Orders received / dispatched (period)</strong>: same definitions as the Daily Report &mdash; bookings by BookingDate (every status), seedling dispatches by DispatchDate (Dispatch Register).</li>
                <li><strong>Maintenance overdue</strong>: the Maintenance module's own rule (not accepted within 4 / 24 / 72 h by priority, or expected visit date passed).</li>
                <li><strong>Store low stock</strong>: active items whose available quantity is below their Minimum Stock.</li>
                <li><strong>Labour</strong>: today's 9:00 AM / 2:00 PM attendance; Full Day / Half Day per the Labour module (only when both headcounts are in).</li>
                <li><strong>Dates</strong>: every date is an India (Asia/Kolkata) date; timestamps stored in UTC or server time are converted before they are counted, so an entry at 02:00 IST counts on that India day.</li>
                <li><strong>Pending past expected delivery date</strong>: counted exactly as recorded; old pending bookings need a separate business review.</li>
                <li>Full list: docs/MANAGEMENT_DASHBOARD.md.</li>
            </ul>
        </div>
    </details>

    <!-- Production detail (Phase L) -->
    <details class="mt-4" id="production-detail" @(Model.DetailFiltered ? "open" : "")>
        <summary class="section-title d-inline-block">Production detail &mdash; seed, cutting, ready, outlet, stock health, trends</summary>

        <form method="get" class="row g-2 align-items-end my-3 p-3 border rounded bg-light">
            <input type="hidden" name="Range" value="@o.Period.Key" />
            <input type="hidden" name="FromDate" value="@o.Period.From.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="ToDate" value="@o.Period.To.ToString("yyyy-MM-dd")" />
            <div class="col-12 small text-muted">These filters narrow this detail section only. Period: <strong>@periodLabel</strong>.</div>
            <div class="col-6 col-md-auto">
                <label class="form-label small mb-0">Area</label>
                <select name="AreaId" class="form-select form-select-sm">
                    <option value="">All Areas</option>
                    @foreach (var a in Model.Dashboard.Areas)
                    {
                        <option value="@a.Id" selected="@(Model.AreaId == a.Id)">@a.Name @(a.AreaType != null ? $"({a.AreaType})" : "")</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-auto">
                <label class="form-label small mb-0">Variety</label>
                <select name="SpeciesId" class="form-select form-select-sm">
                    <option value="">All Varieties</option>
                    @foreach (var s in Model.Dashboard.SpeciesOptions)
                    {
                        <option value="@s.Id" selected="@(Model.SpeciesId == s.Id)">@s.Name</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-auto">
                <label class="form-label small mb-0">Pot Size</label>
                <select name="PotSize" class="form-select form-select-sm">
                    <option value="">All Pot Sizes</option>
                    @foreach (var p in Model.Dashboard.PotSizeOptions)
                    {
                        <option value="@p" selected="@(Model.PotSize == p)">@p</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary">Apply</button>
                <a asp-page="/ManagementDashboard/Index" asp-route-Range="@o.Period.Key" asp-route-FromDate="@o.Period.From.ToString("yyyy-MM-dd")" asp-route-ToDate="@o.Period.To.ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-secondary">Clear</a>
            </div>
        </form>

    <!-- Section A: Overall Production Summary -->
    <h5>Overall Production Summary <span class="badge bg-secondary">Balance</span></h5>
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-2">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">Mother Plants</div>
                <div class="fs-4">@Qty(Model.Dashboard.Production.MotherPlantActiveQuantity)</div>
                <div class="text-muted small">plants &middot; @Model.Dashboard.Production.MotherPlantActiveCount active batches</div>
            </div></div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">Cutting Stock</div>
                <div class="fs-4">@Qty(Model.Dashboard.Production.CuttingStockPhysical)</div>
                <div class="text-muted small">cuttings &middot; @Qty(Model.Dashboard.Production.CuttingStockInTransit) in transit</div>
            </div></div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">Potted Plant Stock</div>
                <div class="fs-4">@Qty(Model.Dashboard.Production.PottedPlantPhysical)</div>
                <div class="text-muted small">plants &middot; @Qty(Model.Dashboard.Production.PottedPlantAvailable) available</div>
            </div></div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">Ready Stock &mdash; total owned</div>
                <div class="fs-4">@Qty(Model.Dashboard.Production.ReadyStockQuantity)</div>
                <div class="text-muted small">approved &minus; dispatched@(Model.Dashboard.Production.ReadyStockInTransit > 0 ? $", incl. {Qty(Model.Dashboard.Production.ReadyStockInTransit)} in transit" : "")</div>
            </div></div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">Seed Stock</div>
                @if (Model.Dashboard.Production.SeedStock.Any())
                {
                    @foreach (var su in Model.Dashboard.Production.SeedStock)
                    {
                        <div class="fs-6">@Qty(su.Physical) <span class="text-muted small">@su.Unit</span></div>
                    }
                }
                else
                {
                    <div class="text-muted small">No stock</div>
                }
            </div></div>
        </div>
        <div class="col-6 col-md-2">
            <div class="card h-100"><div class="card-body">
                <div class="text-muted small">Empty Pot Stock</div>
                <div class="fs-4">@Qty(Model.Dashboard.Production.EmptyPotPhysical)</div>
                <div class="text-muted small">pots</div>
            </div></div>
        </div>
    </div>
    <div class="text-muted small mb-4">Pot/Tray Production in selected range: <strong>@Qty(Model.Dashboard.Production.PotProductionQuantityInRange)</strong> pots <span class="badge bg-primary">Movement</span></div>

    <!-- Section B: Ready Stock / Production Readiness -->
    <h5>Ready Stock / Production Readiness</h5>
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-2"><div class="card h-100"><div class="card-body">
            <div class="text-muted small">Sown</div>
            <div class="fs-5">@Qty(Model.Dashboard.ReadyStock.SownQuantity)</div>
        </div></div></div>
        <div class="col-6 col-md-2"><div class="card h-100"><div class="card-body">
            <div class="text-muted small">Confirmed Ready</div>
            <div class="fs-5">@Qty(Model.Dashboard.ReadyStock.ConfirmedReadyQuantity)</div>
        </div></div></div>
        <div class="col-6 col-md-2"><div class="card h-100"><div class="card-body">
            <div class="text-muted small">Remaining</div>
            <div class="fs-5">@Qty(Model.Dashboard.ReadyStock.RemainingQuantity)</div>
        </div></div></div>
        <div class="col-6 col-md-2"><div class="card h-100 border-danger"><div class="card-body">
            <div class="text-danger small">Overdue</div>
            <div class="fs-5">@Model.Dashboard.ReadyStock.OverdueCount <span class="text-muted small">batches</span></div>
            <div class="text-muted small">@Qty(Model.Dashboard.ReadyStock.OverdueQuantity) remaining</div>
        </div></div></div>
        <div class="col-6 col-md-2"><div class="card h-100 border-warning"><div class="card-body">
            <div class="text-warning-emphasis small">Ready Today</div>
            <div class="fs-5">@Model.Dashboard.ReadyStock.ReadyTodayCount <span class="text-muted small">batches</span></div>
            <div class="text-muted small">@Qty(Model.Dashboard.ReadyStock.ReadyTodayQuantity) remaining</div>
        </div></div></div>
        <div class="col-6 col-md-2"><div class="card h-100 border-success"><div class="card-body">
            <div class="text-success small">Ready Soon</div>
            <div class="fs-5">@Model.Dashboard.ReadyStock.ReadySoonCount <span class="text-muted small">batches</span></div>
            <div class="text-muted small">@Qty(Model.Dashboard.ReadyStock.ReadySoonQuantity) remaining</div>
        </div></div></div>
    </div>
    <div class="mb-4">
        <a asp-page="/Production/ReadyAlerts/Index" class="btn btn-sm btn-outline-danger">Open Ready Alerts &rarr;</a>
        <a asp-page="/Production/ReadyConfirmation/Index" class="btn btn-sm btn-outline-success">Open Ready Confirmation &rarr;</a>
    </div>

    <!-- Section D: Outlet / Sales Summary -->
    <h5>Outlet / Sales Summary</h5>
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-2"><div class="card h-100"><div class="card-body">
            <div class="text-muted small">Outlet Stock</div>
            <div class="fs-5">@Qty(Model.Dashboard.OutletSales.OutletStockPhysical)</div>
            <div class="text-muted small">@Qty(Model.Dashboard.OutletSales.OutletStockAvailable) available</div>
        </div></div></div>
        <div class="col-6 col-md-2"><div class="card h-100"><div class="card-body">
            <div class="text-muted small">Pending Bookings</div>
            <div class="fs-5">@Model.Dashboard.OutletSales.PendingBookings</div>
        </div></div></div>
        <div class="col-6 col-md-2"><div class="card h-100"><div class="card-body">
            <div class="text-muted small">Partially Dispatched</div>
            <div class="fs-5">@Model.Dashboard.OutletSales.PartiallyDispatchedBookings</div>
        </div></div></div>
        <div class="col-6 col-md-2"><div class="card h-100"><div class="card-body">
            <div class="text-muted small">Remaining Booking Qty</div>
            <div class="fs-5">@Qty(Model.Dashboard.OutletSales.RemainingBookingQuantity)</div>
        </div></div></div>
        <div class="col-6 col-md-2"><div class="card h-100"><div class="card-body">
            <div class="text-muted small">Completed Dispatches</div>
            <div class="fs-5">@Model.Dashboard.OutletSales.CompletedDispatchCountInRange</div>
            <div class="text-muted small">@Qty(Model.Dashboard.OutletSales.CompletedDispatchQuantityInRange) plants <span class="badge bg-primary">Movement</span></div>
        </div></div></div>
        <div class="col-6 col-md-2"><div class="card h-100"><div class="card-body">
            <div class="text-muted small">Cancelled Bookings</div>
            <div class="fs-5">@Model.Dashboard.OutletSales.CancelledBookings</div>
        </div></div></div>
    </div>
    <div class="mb-4">
        <a asp-page="/Production/PottedPlantBooking/Index" class="btn btn-sm btn-outline-primary">Open Outlet Bookings &rarr;</a>
    </div>

    <!-- Section E: Seed Summary -->
    <h5>Seed Summary</h5>
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3"><div class="card h-100"><div class="card-body">
            <div class="text-muted small">Main Office Seed Stock <span class="badge bg-secondary">Balance</span></div>
            @if (Model.Dashboard.Seed.MainOfficeSeedStock.Any())
            {
                @foreach (var su in Model.Dashboard.Seed.MainOfficeSeedStock)
                {
                    <div class="fs-6">@Qty(su.Physical) <span class="text-muted small">@su.Unit</span></div>
                }
            }
            else { <div class="text-muted small">No stock</div> }
        </div></div></div>
        <div class="col-6 col-md-3"><div class="card h-100"><div class="card-body">
            <div class="text-muted small">Seed Issue (historical, retired) <span class="badge bg-primary">Movement</span></div>
            <div class="fs-6">Issued: @Qty(Model.Dashboard.Seed.SeedIssuedQuantityInRange)</div>
            <div class="fs-6">Received: @Qty(Model.Dashboard.Seed.SeedReceivedQuantityInRange)</div>
        </div></div></div>
        <div class="col-6 col-md-3"><div class="card h-100"><div class="card-body">
            <div class="text-muted small">Sown (range) <span class="badge bg-primary">Movement</span></div>
            <div class="fs-5">@Qty(Model.Dashboard.Seed.SeedSownQuantityInRange)</div>
            <div class="text-muted small">@Model.Dashboard.Seed.SowingActivityCountInRange sowing events</div>
        </div></div></div>
        <div class="col-6 col-md-3"><div class="card h-100"><div class="card-body">
            <div class="text-muted small">Pending Seed Receipts (legacy Seed Issue) <span class="badge bg-secondary">Balance</span></div>
            <div class="fs-5">@Model.Dashboard.Seed.PendingSeedReceipts</div>
        </div></div></div>
    </div>
    <div class="mb-4">
        <a asp-page="/Production/SeedStock/Index" class="btn btn-sm btn-outline-primary me-2">Open Seed Stock &rarr;</a>
        <a asp-page="/Production/SeedSowing/Index" class="btn btn-sm btn-outline-primary">Open Direct Sowing &rarr;</a>
    </div>

    <!-- Section F: Cutting Summary -->
    <h5>Cutting Summary</h5>
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-2"><div class="card h-100"><div class="card-body">
            <div class="text-muted small">Cutting Available</div>
            <div class="fs-5">@Qty(Model.Dashboard.Cutting.CuttingAvailable)</div>
        </div></div></div>
        <div class="col-6 col-md-2"><div class="card h-100"><div class="card-body">
            <div class="text-muted small">In Transit</div>
            <div class="fs-5">@Qty(Model.Dashboard.Cutting.CuttingInTransit)</div>
        </div></div></div>
        <div class="col-6 col-md-2"><div class="card h-100"><div class="card-body">
            <div class="text-muted small">Pending Confirmation</div>
            <div class="fs-5">@Model.Dashboard.Cutting.PendingConfirmationCount <span class="text-muted small">(@Qty(Model.Dashboard.Cutting.PendingConfirmationQuantity))</span></div>
        </div></div></div>
        <div class="col-6 col-md-2"><div class="card h-100"><div class="card-body">
            <div class="text-muted small">Confirmed, Awaiting Transplant</div>
            <div class="fs-5">@Model.Dashboard.Cutting.ConfirmedAwaitingTransplantCount <span class="text-muted small">(@Qty(Model.Dashboard.Cutting.ConfirmedAwaitingTransplantQuantity))</span></div>
        </div></div></div>
        <div class="col-6 col-md-2"><div class="card h-100"><div class="card-body">
            <div class="text-muted small">Transplanted (range)</div>
            <div class="fs-5">@Model.Dashboard.Cutting.TransplantedCountInRange <span class="text-muted small">(@Qty(Model.Dashboard.Cutting.TransplantedQuantityInRange))</span></div>
        </div></div></div>
    </div>
    <div class="table-responsive mb-4">
        <table class="table table-sm">
            <thead class="table-light"><tr><th>Date</th><th>Type</th><th>Area</th><th>Species</th><th>Quantity</th></tr></thead>
            <tbody>
                @foreach (var a in Model.Dashboard.Cutting.RecentActivity)
                {
                    <tr>
                        <td>@a.TransactionDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@a.TransactionType</td>
                        <td>@a.AreaName</td>
                        <td>@a.SpeciesName</td>
                        <td>@Qty(a.Quantity)</td>
                    </tr>
                }
                @if (!Model.Dashboard.Cutting.RecentActivity.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted">No Cutting Stock activity in the selected date range.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Section G: Inventory / Stock Health -->
    <h5>Inventory / Stock Health <span class="badge bg-secondary">Balance</span></h5>
    <div class="table-responsive mb-4">
        <table class="table table-sm table-bordered">
            <thead class="table-light"><tr><th>Domain</th><th>Physical</th><th>Reserved</th><th>Available</th><th>In Transit</th></tr></thead>
            <tbody>
                @foreach (var row in Model.Dashboard.StockHealth)
                {
                    <tr>
                        <td>@row.Domain <span class="text-muted small">(@row.Unit)</span></td>
                        <td>@(Qty(row.Physical, "—"))</td>
                        <td>@(Qty(row.Reserved, "N/A"))</td>
                        <td>@(Qty(row.Available, "N/A"))</td>
                        <td>@(Qty(row.InTransit, "N/A"))</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="text-muted small">"N/A" means this stock domain has no such concept in the current architecture (e.g. Empty Pot Inventory has no Reserved/In-Transit/Available column) &mdash; never a fabricated zero.</div>
    </div>

    <!-- Charts -->
    <h5>Charts</h5>
    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="card h-100"><div class="card-body">
                <div class="fw-semibold">Sowing vs. Confirmed Ready <span class="text-muted small">(daily, selected range, unit: quantity)</span></div>
                <div class="chart-scroll">@Html.Raw(RenderGroupedBarChart(Model.Dashboard.SowingVsReadyTrend, "Sown", "Confirmed Ready"))</div>
            </div></div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100"><div class="card-body">
                <div class="fw-semibold">Outlet Dispatch Trend <span class="text-muted small">(daily, selected range, unit: plants)</span></div>
                <div class="chart-scroll">@Html.Raw(RenderSingleSeriesBarChart(Model.Dashboard.OutletDispatchTrend, "plants"))</div>
            </div></div>
        </div>
    </div>
    </details>
</div>
