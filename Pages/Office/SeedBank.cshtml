@page
@model PlantStockManager.Pages.Office.SeedBankModel
@{
    ViewData["Title"] = "Seed/Cuttings Bank";

}




<div class="container mt-4">
    <h2 class="mb-3">Seed / Cuttings Bank</h2>

    @if (!string.IsNullOrEmpty(Model.WarningMessage))
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @Model.WarningMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Add Form -->
    <form method="post" asp-page-handler="Add" class="card card-body mb-4">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Plant</label>
                <select id="addPlant" name="NewItem.PlantId" class="form-select" required>
                    <option value="0">-- Select Plant --</option>
                    @foreach (var p in Model.Plants)
                    {
                        <option value="@p.PlantId">@p.PlantName</option>
                    }
                </select>
                <span asp-validation-for="NewItem.PlantId" class="text-danger"></span>

            </div>

            <div class="col-md-4">
                <label class="form-label">Species</label>
                <select id="addSpecies" name="NewItem.SpeciesId" class="form-select" required>
                    <option value="0">-- Select Species --</option>
                    <!-- populated by JS when plant changes -->
                </select>
                <span asp-validation-for="NewItem.SpeciesId" class="text-danger"></span>

            </div>

            <div class="col-md-4">
                <label class="form-label">Source</label>
                <select name="NewItem.SourceId" class="form-select">
                    <option value="">-- Select Source --</option>
                    @foreach (var s in Model.Sources)
                    {
                        <option value="@s.SourceId">@s.SourceName</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Batch No</label>
                <input name="NewItem.BatchNo" class="form-control" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Unit</label>
                <input name="NewItem.Unit" class="form-control" value="pcs" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Quantity</label>
                <input name="NewItem.Quantity" type="number" min="0" class="form-control" value="0" required />
            </div>

            <div class="col-md-3">
                <label class="form-label">Received On </label>
                <input name="NewItem.ReceivedOn" type="datetime-local" class="form-control"
                       value="@Model.DefaultReceivedOnLocal" />
            </div>

            <div class="col-md-12">
                <label class="form-label">Notes</label>
                <input name="NewItem.Notes" class="form-control" />
            </div>

            <div class="col-md-12">
                <button type="submit" class="btn btn-primary mt-2">Add to Bank</button>
            </div>
        </div>
    </form>

    <!-- List -->
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Plant</th>
                    <th>Species</th>
                    <th>Source</th>
                    <th>Batch</th>
                    <th>Unit</th>
                    <th>Qty</th>
                    <th>Utilized</th>
                    <th>Available</th>
                    <th>Received</th>
                    <th>Notes</th>
                    <th style="width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>@row.Id</td>
                        <td>@row.PlantName</td>
                        <td>@row.SpeciesName</td>
                        <td>@(row.SourceName ?? "-")</td>
                        <td>@(row.BatchNo ?? "-")</td>
                        <td>@row.Unit</td>
                        <td>@row.Quantity</td>
                        <td>@row.UtilizedQuantity</td>
                        <td>@row.Available</td>
                        <td>@row.ReceivedOnUtc.ToString("yyyy-MM-dd HH:mm ")</td>
                        <td>@(row.Notes ?? "-")</td>
                        <td>
                            <button class="btn btn-sm btn-warning"
                                    onclick="openEdit(@row.Id,
                                                      @row.PlantId,
                                                      @row.SpeciesId,
                                                      @((row.SourceId.HasValue ? row.SourceId.Value.ToString() : "null")),
                                                      '@(row.BatchNo ?? "")',
                                                      '@row.Unit',
                                                      @row.Quantity,
                                                      @row.UtilizedQuantity,
                                                      '@row.ReceivedOnUtc.ToString("yyyy-MM-ddTHH:mm")',
                                                      '@(row.Notes ?? "")')">
                                Edit
                            </button>
                            <form method="post" asp-page-handler="Delete" class="d-inline"
                                  onsubmit="return confirm('Delete this lot? (Blocked if transactions exist)');">
                                <input type="hidden" name="id" value="@row.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="Edit">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Seed/Cutting Lot</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="EditItem.Id" id="eId" />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Plant</label>
                            <select id="ePlant" name="EditItem.PlantId" class="form-select" required>
                                <option value="">-- Select Plant --</option>
                                @foreach (var p in Model.Plants)
                                {
                                    <option value="@p.PlantId">@p.PlantName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Species</label>
                            <select id="eSpecies" name="EditItem.SpeciesId" class="form-select" required>
                                <option value="">-- Select Species --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Source</label>
                            <select id="eSource" name="EditItem.SourceId" class="form-select">
                                <option value="">-- Select Source --</option>
                                @foreach (var s in Model.Sources)
                                {
                                    <option value="@s.SourceId">@s.SourceName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Batch No</label>
                            <input id="eBatch" name="EditItem.BatchNo" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Unit</label>
                            <input id="eUnit" name="EditItem.Unit" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Quantity</label>
                            <input id="eQty" name="EditItem.Quantity" type="number" min="0" class="form-control" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Utilized</label>
                            <input id="eUtil" name="EditItem.UtilizedQuantity" type="number" min="0" class="form-control" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Received On </label>
                            <input id="eRecv" name="EditItem.ReceivedOn" type="datetime-local" class="form-control" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Notes</label>
                            <input id="eNotes" name="EditItem.Notes" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Dependent species for ADD form
        // document.getElementById('addPlant')?.addEventListener('change', async function() {
        //     const plantId = this.value;
        //     const speciesSelect = document.getElementById('addSpecies');
        //     speciesSelect.innerHTML = '<option value="">-- Select Species --</option>';
        //     if (!plantId) return;
        //     const res = await fetch(`?handler=Species&plantId=${plantId}`);
        //     const data = await res.json();
        //     data.forEach(sp => {
        //         const opt = document.createElement('option');
        //         opt.value = sp.speciesId;
        //         opt.textContent = sp.speciesName;
        //         speciesSelect.appendChild(opt);
        //     });
        // });

                document.getElementById('addPlant')?.addEventListener('change', async function () {
          const plantId = this.value;
          const speciesSelect = document.getElementById('addSpecies');
          speciesSelect.innerHTML = '<option value="0">-- Select Species --</option>';
          if (plantId === "0") return;

          const res = await fetch(`?handler=Species&plantId=${plantId}`);
          const data = await res.json();
          data.forEach(sp => {
            const opt = document.createElement('option');
            opt.value = sp.speciesId; // must be a number-like string, e.g. "5"
            opt.textContent = sp.speciesName;
            speciesSelect.appendChild(opt);
          });
        });


        // Open edit modal & preload species
        async function openEdit(id, plantId, speciesId, sourceId, batchNo, unit, qty, util, recvIso, notes) {
            document.getElementById('eId').value = id;
            document.getElementById('ePlant').value = plantId;
            document.getElementById('eBatch').value = batchNo;
            document.getElementById('eUnit').value = unit;
            document.getElementById('eQty').value = qty;
            document.getElementById('eUtil').value = util;
            document.getElementById('eRecv').value = recvIso;
            document.getElementById('eNotes').value = notes;
            if (sourceId && sourceId !== 'null') document.getElementById('eSource').value = sourceId;

            // load species for selected plant
            const eSpecies = document.getElementById('eSpecies');
            eSpecies.innerHTML = '<option value="">-- Select Species --</option>';
            if (plantId) {
                const res = await fetch(`?handler=Species&plantId=${plantId}`);
                const data = await res.json();
                data.forEach(sp => {
                    const opt = document.createElement('option');
                    opt.value = sp.speciesId;
                    opt.textContent = sp.speciesName;
                    eSpecies.appendChild(opt);
                });
                if (speciesId) eSpecies.value = speciesId;
            }

            new bootstrap.Modal(document.getElementById('editModal')).show();
        }
    </script>
}
