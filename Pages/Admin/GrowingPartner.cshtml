@page
@model PlantStockManager.Pages.Admin.GrowingPartnerModel
@{
    ViewData["Title"] = "Growing Partners";
}

<div class="container-fluid mt-4">
    <h2 class="mb-3">Growing Partners</h2>
    <p class="text-muted">
        A Growing Partner is a party (internal or external) that can be assigned ownership of one or more Areas
        via Area administration. This is a foundation page only — capability flags and access restrictions are
        configured in a later phase.
    </p>

    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@err.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header">Add Growing Partner</div>
        <div class="card-body">
            <form method="post" asp-page-handler="Add">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Name</label>
                        <input type="text" asp-for="NewGrowingPartner.Name" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Contact Person</label>
                        <input type="text" asp-for="NewGrowingPartner.ContactPerson" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Phone</label>
                        <input type="text" asp-for="NewGrowingPartner.Phone" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Email</label>
                        <input type="email" asp-for="NewGrowingPartner.Email" class="form-control" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label fw-bold">Address</label>
                        <input type="text" asp-for="NewGrowingPartner.Address" class="form-control" />
                    </div>
                </div>
                <div class="text-end mt-3">
                    <button type="submit" class="btn btn-primary">Add Growing Partner</button>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Contact Person</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var gp in Model.GrowingPartners)
                {
                    <tr>
                        <form method="post" asp-page-handler="Edit">
                            <td>
                                <input type="hidden" name="EditGrowingPartner.Id" value="@gp.Id" />
                                <input type="text" name="EditGrowingPartner.Name" value="@gp.Name" class="form-control form-control-sm" required />
                            </td>
                            <td><input type="text" name="EditGrowingPartner.ContactPerson" value="@gp.ContactPerson" class="form-control form-control-sm" /></td>
                            <td><input type="text" name="EditGrowingPartner.Phone" value="@gp.Phone" class="form-control form-control-sm" /></td>
                            <td><input type="email" name="EditGrowingPartner.Email" value="@gp.Email" class="form-control form-control-sm" /></td>
                            <td>
                                <input type="hidden" name="EditGrowingPartner.Address" value="@gp.Address" />
                                <div class="form-check">
                                    <input type="checkbox" name="EditGrowingPartner.IsActive" value="true" class="form-check-input" checked="@gp.IsActive" />
                                </div>
                            </td>
                            <td>
                                <button type="submit" class="btn btn-sm btn-outline-warning">Save</button>
                            </td>
                        </form>
                    </tr>
                }
                @if (!Model.GrowingPartners.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted">No Growing Partners found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
