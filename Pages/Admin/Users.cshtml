@page
@model PlantStockManager.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Manage Users";
}

<style>
    /* Layout */
    :root {
        --card-bg: #ffffff;
        --muted: #6c757d;
        --accent: #0d6efd; /* bootstrap primary */
        --surface: #f8f9fa;
        --shadow: 0 6px 18px rgba(13,110,253,0.06);
    }

    body {
        background: linear-gradient(180deg, #f6f9ff 0%, var(--surface) 100%);
    }

    .container.manage-users {
        max-width: 1100px;
        margin: 28px auto;
    }

    .card-panel {
        background: var(--card-bg);
        border-radius: 12px;
        padding: 18px;
        box-shadow: var(--shadow);
        border: 1px solid rgba(13,110,253,0.06);
    }

    h2.mb-3 {
        font-weight: 700;
        letter-spacing: -0.2px;
    }

    /* Form grid */
    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

        .form-grid .full {
            grid-column: 1 / -1;
        }

    @@media (min-width: 992px) {
        .form-grid

    {
        grid-template-columns: repeat(4, 1fr);
    }

    }

    .form-label {
        font-size: 0.9rem;
        color: var(--muted);
        margin-bottom: 6px;
    }

    .input, input.form-control, select.form-select {
        border-radius: 8px;
        height: 44px;
    }

    .btn-primary {
        border-radius: 10px;
        padding: 10px 18px;
        box-shadow: 0 6px 12px rgba(13,110,253,0.08);
    }

    /* Table styles */
    .table-wrap {
        overflow-x: auto;
        border-radius: 10px;
    }

    .table {
        min-width: 760px;
        border-radius: 8px;
        overflow: hidden;
    }

        .table thead th {
            background: #fff;
            position: sticky;
            top: 0;
            z-index: 1;
        }

        .table tbody tr {
            transition: background 0.12s ease;
        }

            .table tbody tr:hover {
                background: rgba(13,110,253,0.04);
            }

        .table td, .table th {
            vertical-align: middle;
        }

    .small-muted {
        color: var(--muted);
        font-size: 0.85rem;
    }

    /* Action button */
    .btn-action {
        border-radius: 8px;
        padding: 6px 10px;
        min-width: 72px;
    }

    /* Modal tweaks */
    .modal-content {
        border-radius: 12px;
        overflow: hidden;
    }

    .modal .modal-body input, .modal .modal-body select {
        height: 44px;
        border-radius: 8px;
    }

    /* Responsive helpers */
    .header-row {
        display: flex;
        gap: 12px;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
    }

    .header-left {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .logo-circle {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: linear-gradient(135deg,#e9f0ff,#d8e7ff);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: var(--accent);
    }

    .search-bar {
        flex: 1;
        min-width: 180px;
        margin-left: 12px;
    }

    /* Mobile tweaks */
    @@media (max-width: 575.98px) {
        .container.manage-users

    {
        padding: 12px;
        margin: 12px auto;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .table {
        min-width: 540px;
    }

    .btn-primary {
        width: 100%;
    }

    }

    /* Focus and accessibility */
    input:focus, select:focus, button:focus {
        outline: 3px solid rgba(13,110,253,0.12);
        outline-offset: 2px;
    }

    /* Utility */
    .form-actions {
        display: flex;
        gap: 10px;
        align-items: center;
        justify-content: flex-end;
        margin-top: 8px;
    }

    .alert-warning {
        border-radius: 8px;
    }
</style>

@if (!string.IsNullOrEmpty(Model.WarningMessage))
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @Model.WarningMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container manage-users">
    <div class="card-panel">
        <div class="header-row mb-3">
            <div class="header-left">
                <div class="logo-circle">BB</div>
                <div>
                    <h2 class="mb-0">User Management</h2>
                    <div class="small-muted">
                        A user's access comes only from their <strong>Role</strong>
                        (permissions are maintained per Role on <a asp-page="/Admin/Roles">Roles &amp; Permissions</a>).
                    </div>
                </div>
            </div>
            <div class="d-flex align-items-center">
                <div class="small-muted me-3">@DateTime.Now.ToString("dd MMM yyyy")</div>
                <form method="get" class="d-flex align-items-center">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="showInactive" name="ShowInactive" value="true"
                               checked="@Model.ShowInactive" onchange="this.form.submit()" />
                        <label class="form-check-label small-muted" for="showInactive">Show inactive users</label>
                    </div>
                </form>
            </div>
        </div>

        <!-- Add User -->
        <form method="post" asp-page-handler="Add" class="mb-4">
            <div class="form-grid">
                <div>
                    <label class="form-label">Username</label>
                    <input name="NewUser.Username" class="form-control" maxlength="100" required />
                </div>
                <div>
                    <label class="form-label">Name</label>
                    <input name="NewUser.Name" class="form-control" maxlength="150" required />
                </div>
                <div>
                    <label class="form-label">Password</label>
                    <input name="NewPassword" type="password" class="form-control" autocomplete="new-password" required />
                </div>
                <div>
                    <label class="form-label">Email (optional)</label>
                    <input name="NewUser.Email" type="email" class="form-control" maxlength="256" />
                </div>
                <div>
                    <label class="form-label">Role</label>
                    <select name="NewUser.RoleId" class="form-select" required>
                        <option value="">-- Select Role --</option>
                        @foreach (var role in Model.Roles)
                        {
                            <option value="@role.Id">@role.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label">Area (only for area-based roles)</label>
                    <select name="NewUser.AreaId" class="form-select">
                        <option value="">-- None --</option>
                        @foreach (var area in Model.Areas)
                        {
                            <option value="@area.Id">@area.Name @(area.AreaType != null ? $"({area.AreaType})" : "")</option>
                        }
                    </select>
                </div>
                <div class="d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="newIsActive" name="NewUser.IsActive" value="true" checked />
                        <input type="hidden" name="NewUser.IsActive" value="false" />
                        <label class="form-check-label" for="newIsActive">Active</label>
                    </div>
                </div>

                <div class="full form-actions">
                    <button type="submit" class="btn btn-primary">Create User</button>
                </div>
            </div>
        </form>

        <!-- Users List -->
        <div class="table-wrap">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Username</th>
                        <th>Name</th>
                        <th>Role(s) / Area</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Users)
                    {
                        var single = u.SingleAssignment;
                        <tr>
                            <td>@u.Id</td>
                            <td>@u.Username</td>
                            <td>
                                @u.Name
                                @if (!string.IsNullOrWhiteSpace(u.Email))
                                {
                                    <div class="small-muted">@u.Email</div>
                                }
                            </td>
                            <td>
                                @if (u.Assignments.Count == 0)
                                {
                                    <span class="badge bg-warning text-dark">No role &ndash; no access</span>
                                }
                                @foreach (var a in u.Assignments)
                                {
                                    <div>@a.RoleName @(a.AreaName != null ? $"@ {a.AreaName}" : "")</div>
                                }
                            </td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    @* Values are passed as HTML-encoded data-* attributes (not inline JS strings). *@
                                    <button type="button" class="btn btn-outline-secondary btn-sm btn-action js-edit-user"
                                            data-id="@u.Id" data-username="@u.Username" data-name="@u.Name" data-email="@(u.Email ?? "")"
                                            data-role-id="@(single?.RoleId.ToString() ?? "")" data-area-id="@(single?.AreaId?.ToString() ?? "")"
                                            data-multi="@(u.Assignments.Count > 1 ? "true" : "false")" data-active="@(u.IsActive ? "true" : "false")">
                                        Edit
                                    </button>

                                    @if (u.IsActive)
                                    {
                                        <form method="post" asp-page-handler="Deactivate" asp-route-id="@u.Id" asp-route-ShowInactive="@Model.ShowInactive"
                                              onsubmit="return confirm('Deactivate this user?');">
                                            <button type="submit" class="btn btn-outline-danger btn-sm btn-action">Inactive</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="Activate" asp-route-id="@u.Id" asp-route-ShowInactive="@Model.ShowInactive">
                                            <button type="submit" class="btn btn-outline-success btn-sm btn-action">Activate</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div id="editModal" class="modal fade" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Edit" asp-route-ShowInactive="@Model.ShowInactive">
                <div class="modal-header">
                    <h5 class="modal-title">Edit User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="EditUser.Id" id="editId" />
                    <div class="mb-3">
                        <label class="form-label">Username</label>
                        <input name="EditUser.Username" id="editUsername" class="form-control" maxlength="100" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input name="EditUser.Name" id="editName" class="form-control" maxlength="150" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input name="EditUser.Email" id="editEmail" type="email" class="form-control" maxlength="256" />
                    </div>
                    <div id="editRoleBlock">
                        <div class="mb-3">
                            <label class="form-label">Role</label>
                            <select name="EditUser.RoleId" id="editRole" class="form-select">
                                <option value="">-- Select Role --</option>
                                @foreach (var role in Model.Roles)
                                {
                                    <option value="@role.Id">@role.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Area (only for area-based roles)</label>
                            <select name="EditUser.AreaId" id="editArea" class="form-select">
                                <option value="">-- None --</option>
                                @foreach (var area in Model.Areas)
                                {
                                    <option value="@area.Id">@area.Name @(area.AreaType != null ? $"({area.AreaType})" : "")</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div id="editMultiRoleNote" class="alert alert-info small d-none">
                        This user has several role assignments. Change them on
                        <a asp-page="/Admin/UserRoles">User Role / Area Assignments</a>.
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="editIsActive" name="EditUser.IsActive" value="true" />
                        <input type="hidden" name="EditUser.IsActive" value="false" />
                        <label class="form-check-label" for="editIsActive">Active</label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Reset Password (optional)</label>
                        <input name="EditPassword" id="editPassword" type="password" class="form-control"
                               autocomplete="new-password" placeholder="Leave blank to keep current" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.js-edit-user').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var d = btn.dataset;
            document.getElementById('editId').value = d.id;
            document.getElementById('editUsername').value = d.username;
            document.getElementById('editName').value = d.name;
            document.getElementById('editEmail').value = d.email;
            document.getElementById('editPassword').value = '';
            document.getElementById('editIsActive').checked = d.active === 'true';
            var multi = d.multi === 'true';
            var role = document.getElementById('editRole');
            var area = document.getElementById('editArea');
            document.getElementById('editRoleBlock').classList.toggle('d-none', multi);
            document.getElementById('editMultiRoleNote').classList.toggle('d-none', !multi);
            role.disabled = multi; area.disabled = multi;
            role.value = d.roleId || '';
            area.value = d.areaId || '';
            new bootstrap.Modal(document.getElementById('editModal')).show();
        });
    });
</script>
