                        <input name="EditUser.Name" id="editName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input name="EditUser.Email" id="editEmail" type="email" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Designation</label>
                        <select name="EditUser.DesignationId" id="editDesignation" class="form-select" required>
