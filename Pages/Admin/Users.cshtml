                            @foreach (var desig in Model.Designations)
                            {
                                <option value="@desig.DesignationId">@desig.DesignationName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Reset Password (optional)</label>
                        <input name="EditPassword" id="editPassword" type="password" class="form-control"
                               placeholder="Leave blank to keep current" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openEditModal(id, username, name, email, designationId) {
        document.getElementById("editId").value = id;
        document.getElementById("editUsername").value = username;
        document.getElementById("editName").value = name;
