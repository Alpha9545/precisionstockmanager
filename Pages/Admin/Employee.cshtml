@page
@model PlantStockManager.Pages.Admin.EmployeeModel
@{
    ViewData["Title"] = "Manage Employees";
}


<div class="container mt-4">
    <h2 class="mb-3">Polyhouse Management</h2>

    <!-- Add Polyhouse Form -->
    <form method="post" asp-page-handler="Add" class="mb-4">
        <div class="input-group">
            <input type="text" asp-for="NewEmployeeName" class="form-control" placeholder="Enter Employee name" required />
            <select id="designationDropdown" asp-for="Designation" class="form-select" required>
                <option value="">-- Select Designation --</option>
                @foreach (var desig in Model.DistinctDesignations)
                {
                    <option value="@desig.DesignationName">@desig.DesignationName</option>
                }
            </select>

            <button type="submit" class="btn btn-primary">Add Employee</button>
           
        </div>
    </form>

    <!-- Polyhouse List -->
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Employee Name</th>
                <th>Designation</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model.Employees)
            {
                <tr>
                    <td>@employee.EmployeeID</td>
                    <td>@employee.Name</td>
                    <td>@employee.Designation</td>
                    <td>
                        <button class="btn btn-warning btn-sm" onclick="openEditModal('@employee.EmployeeID', '@employee.Name')">
                            Edit
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Edit Modal -->
<div id="editModal" class="modal fade" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Polyhouse</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Edit">
                <div class="modal-body">
                    <input type="hidden" asp-for="EditId" id="editId" />
                    <div class="mb-3">
                        <label for="editName" class="form-label">Employee Name</label>
                        <input type="text" asp-for="EditEmployeeName" class="form-control" id="editName" required />
                    </div>
                    <div class="mb-3">
                        <label for="editDesignation" class="form-label">Designation</label>
                        <select id="editDesignation" name="Designation" class="form-select" required>
                            <option value="">-- Select Designation --</option>
                            @foreach (var desig in Model.DistinctDesignations)
                            {
                                <option value="@desig.DesignationName">@desig.DesignationName</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- JavaScript for Modal -->
<script>
    function openEditModal(id, name) {
        document.getElementById("editId").value = id;
        document.getElementById("editName").value = name;
       //  document.getElementById("editDesignation").value = designation;

        var modal = new bootstrap.Modal(document.getElementById('editModal'));
        modal.show();
    }
</script>
