@page
@model PlantStockManager.Pages.Admin.PlantModel
@{
    ViewData["Title"] = "Manage Plant Types & Species";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

<div style="height: 80vh; overflow-y: auto;">
    <div class="container mt-4">
        <h2 class="mb-4">Plant Types & Species Management</h2>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <!-- Add New Plant Type -->
        <div class="mb-4">
            <h4>Add New Plant Type</h4>
            <form method="post" asp-page-handler="AddPlantType">
                <div class="input-group">
                    <input type="text" asp-for="NewPlantTypeName" class="form-control" placeholder="Enter plant type name" required />
                    <button type="submit" class="btn btn-primary">Add Plant Type</button>
                </div>
            </form>
            
        </div>

        <!-- Accordion for Plant Types and Their Species -->
        <div class="accordion" id="plantTypesAccordion">
            @foreach (var item in Model.PlantTypeSpeciesList)
            {
                var type = item.PlantType;
                var collapseId = $"collapse{type.Id}";
                <div class="accordion-item">
                    @* <h2 class="accordion-header" id="heading@type.Id">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                            @type.Name
                        </button>
                        <button class="btn btn-warning btn-sm ms-3" onclick="openEditTypeModal('@type.Id', '@type.Name')">Edit</button>
                    </h2> *@
                    <h2 class="accordion-header d-flex align-items-center" id="heading@type.Id">

                        <button class="accordion-button collapsed flex-grow-1"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#@collapseId">
                            @type.Name
                        </button>

                        <!-- Edit Button -->
                        <button class="btn btn-warning btn-sm ms-2"
                                onclick="openEditTypeModal('@type.Id', '@type.Name')">
                            Edit
                        </button>

                        <!-- ✅ Delete Button -->
                        <form method="post"
                              asp-page-handler="DeletePlantType"
                              asp-route-id="@type.Id"
                              style="display:inline;">
                            <button type="submit"
                                    class="btn btn-danger btn-sm ms-2"
                                    onclick="return confirm('Are you sure you want to delete this plant type?');">
                                Delete
                            </button>
                        </form>

                    </h2>

                    <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="heading@type.Id" data-bs-parent="#plantTypesAccordion">
                        <div class="accordion-body">
                            <!-- Add New Species for this Plant Type -->
                            <form method="post" asp-page-handler="AddSpecies" class="mb-3">
                                <input type="hidden" name="NewSpeciesTypeId" value="@type.Id" />
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-3">
                                        <label class="form-label">Variety Name</label>
                                        <input type="text" name="NewSpeciesName" class="form-control" placeholder="Variety Name" required />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Colour</label>
                                        <input type="text" name="NewSpeciesColor" class="form-control" placeholder="e.g. Pink" maxlength="50" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Scientific Name</label>
                                        <input type="text" name="NewSpeciesScientificName" class="form-control" placeholder="Scientific Name" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Growing Days</label>
                                        <input type="number" name="NewSpeciesReadyStockDays" min="1" class="form-control" placeholder="e.g. 25" />
                                    </div>
                                    <div class="col-md-2">
                                        <button type="submit" class="btn btn-success">Add Variety</button>
                                    </div>
                                </div>
                            </form>

                            <!-- Species List -->
                            <table class="table table-sm table-striped">
                                <thead>
                                    <tr>
                                        @* <th>ID</th> *@
                                        <th>Variety</th>
                                        <th>Colour</th>
                                        <th>Scientific Name</th>
                                        <th>Growing Days</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var species in item.Species)
                                    {
                                        <tr>
                                            @* <td>@species.Id</td> *@
                                            <td>@species.Name</td>
                                            <td>@(species.Color ?? "-")</td>
                                            <td>@species.ScientificName</td>
                                            <td>@(species.ReadyStockDays?.ToString() ?? "-")</td>
                                            @* <td>
                                                <button class="btn btn-warning btn-sm" onclick="openEditSpeciesModal('@species.Id', '@species.Name', '@species.ScientificName')">
                                                    Edit
                                                </button>
                                            </td> *@
                                            <td>
                                                <!-- Edit -->
                                                @* Values travel in data- attributes (HTML-encoded), never pasted into
                                                   JavaScript -- variety names can contain quotes and line breaks. *@
                                                <button type="button" class="btn btn-warning btn-sm"
                                                        data-id="@species.Id" data-name="@species.Name.Trim()" data-scientific="@species.ScientificName"
                                                        data-days="@(species.ReadyStockDays?.ToString() ?? "")" data-color="@species.Color"
                                                        onclick="openEditSpeciesModal(this)">
                                                    Edit
                                                </button>

                                                <!-- ✅ Delete -->
                                                <form method="post"
                                                      asp-page-handler="DeleteSpecies"
                                                      asp-route-id="@species.Id"
                                                      style="display:inline;">
                                                    <button type="submit"
                                                            class="btn btn-danger btn-sm"
                                                            onclick="return confirm('Are you sure you want to delete this species?');">
                                                        Delete
                                                    </button>
                                                </form>
                                            </td>

                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>



<!-- Edit Plant Type Modal -->
<div id="editTypeModal" class="modal fade" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Plant Type</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="EditPlantType">
                <div class="modal-body">
                    <input type="hidden" asp-for="EditTypeId" id="editTypeId" />
                    <div class="mb-3">
                        <label class="form-label">Plant Type Name</label>
                        <input type="text" asp-for="EditTypeName" class="form-control" id="editTypeName" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Plant Species Modal -->
<div id="editSpeciesModal" class="modal fade" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Plant Species</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="EditSpecies">
                <div class="modal-body">
                    <input type="hidden" asp-for="EditSpeciesId" id="editSpeciesId" />
                    <div class="mb-3">
                        <label class="form-label">Variety Name</label>
                        <input type="text" asp-for="EditSpeciesName" class="form-control" id="editSpeciesName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Colour</label>
                        <input type="text" asp-for="EditSpeciesColor" class="form-control" id="editSpeciesColor" maxlength="50" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Scientific Name</label>
                        <input type="text" asp-for="EditSpeciesScientificName" class="form-control" id="editSpeciesScientificName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ready Stock Days</label>
                        <input type="number" min="1" asp-for="EditSpeciesReadyStockDays" class="form-control" id="editSpeciesReadyStockDays" placeholder="e.g. 25 (optional)" />
                        <div class="form-text">Days from Sowing to expected readiness. Used to auto-compute Expected Ready Date on new Sowings only -- changing this never rewrites an existing Sowing's dates.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Open modal to edit plant type
    function openEditTypeModal(id, name) {
        document.getElementById("editTypeId").value = id;
        document.getElementById("editTypeName").value = name;
        var modal = new bootstrap.Modal(document.getElementById('editTypeModal'));
        modal.show();
    }

    // Open modal to edit plant species
    function openEditSpeciesModal(btn) {
        document.getElementById("editSpeciesId").value = btn.dataset.id;
        document.getElementById("editSpeciesName").value = btn.dataset.name || "";
        document.getElementById("editSpeciesScientificName").value = btn.dataset.scientific || "";
        document.getElementById("editSpeciesReadyStockDays").value = btn.dataset.days || "";
        document.getElementById("editSpeciesColor").value = btn.dataset.color || "";
        var modal = new bootstrap.Modal(document.getElementById('editSpeciesModal'));
        modal.show();
    }
</script>
