@page
@model PlantStockManager.Pages.Admin.AreaModel
@functions {
    // Q2: stored AreaType values are unchanged; Kunjir/Kiran are shown as Production Areas.
    static string AreaTypeLabel(string areaType) => areaType switch
    {
        "MotherPlant" => "Mother Plant (Production Area)",
        "Kunjir" => "Production Area - Kunjir",
        "Kiran" => "Production Area - Kiran",
        "MainOffice" => "Main Office",
        _ => areaType
    };
}
@{
    ViewData["Title"] = "Manage Areas";
}

<div class="container mt-4">
    <h2 class="mb-3">Area Management</h2>

    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@err.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <!-- Add Area Form -->
    <form method="post" asp-page-handler="Add" class="mb-4">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label fw-bold">Area Type</label>
                <select asp-for="NewArea.AreaType" class="form-select" id="newAreaType">
                    <option value="">-- Plain / Legacy --</option>
                    @foreach (var t in Model.AreaTypes)
                    {
                        <option value="@t">@AreaTypeLabel(t)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Polyhouse</label>
                <select asp-for="NewArea.PolyhouseId" class="form-select">
                    <option value="">-- None (Main Office only) --</option>
                    @foreach (var p in Model.Polyhouses)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Area Name</label>
                <input type="text" asp-for="NewArea.Name" class="form-control" placeholder="Area name" required />
            </div>
            <div class="col-md-1">
                <label class="form-label fw-bold">Area Code</label>
                <input type="text" asp-for="NewArea.AreaCode" class="form-control" placeholder="Optional" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Supervisor</label>
                @* Phase 1 (D-3): only supervisors of the chosen Area Type; a new Area
                   has no assigned users yet, so only all-Area supervisors apply. *@
                <select asp-for="NewArea.SupervisorId" class="form-select" id="newSupervisorId">
                    <option value="">-- None --</option>
                    @foreach (var s in Model.Supervisors)
                    {
                        <option value="@s.Option.EmployeeID" data-kind="@s.KindKey" data-areas="@s.Option.AreaAttribute">@s.Option.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-1">
                <label class="form-label fw-bold">Size</label>
                <input type="number" step="0.01" min="0.01" asp-for="NewArea.AreaSize" class="form-control" placeholder="Size" />
            </div>
            <div class="col-md-1">
                <label class="form-label fw-bold">Capacity</label>
                <input type="number" step="0.01" min="0.01" asp-for="NewArea.Capacity" class="form-control" placeholder="Capacity" />
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100">Add</button>
            </div>
        </div>
        <div class="row g-2 mt-2">
            <div class="col-md-3">
                <input type="text" asp-for="NewArea.Location" class="form-control" placeholder="Location (optional)" />
            </div>
            <div class="col-md-3">
                <input type="text" asp-for="NewArea.Remarks" class="form-control" placeholder="Remarks (optional)" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Growing Partner</label>
                <select asp-for="NewArea.GrowingPartnerId" class="form-select">
                    <option value="">-- Internal / No Growing Partner --</option>
                    @foreach (var gp in Model.GrowingPartners)
                    {
                        <option value="@gp.Id">@gp.Name</option>
                    }
                </select>
            </div>
        </div>
    </form>

    <!-- Area List -->
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Area Type</th>
                <th>Polyhouse</th>
                <th>Area Name</th>
                <th>Area Code</th>
                <th>Supervisor</th>
                <th>Growing Partner</th>
                <th>Size</th>
                <th>Capacity</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var area in Model.Areas)
            {
                <tr>
                    <td>@(area.AreaType == null ? "-" : AreaTypeLabel(area.AreaType))</td>
                    <td>@(area.PolyhouseName ?? "-")</td>
                    <td>@area.Name</td>
                    <td>@area.AreaCode</td>
                    <td>@(area.SupervisorName ?? "-")</td>
                    <td>@(area.GrowingPartnerName ?? "Internal")</td>
                    <td>@(area.AreaSize.HasValue ? $"{area.AreaSize:N2} {area.AreaUnit}" : "-")</td>
                    <td>@(area.Capacity.HasValue ? $"{area.Capacity:N2} {area.CapacityUnit}" : "-")</td>
                    <td>@(area.IsActive ? "Active" : "Inactive")</td>
                    <td>
                        <button class="btn btn-warning btn-sm"
                                onclick="openEditModal(@area.Id, '@(area.PolyhouseId?.ToString() ?? "")', '@area.Name', '@area.AreaCode', '@(area.AreaSize?.ToString() ?? "")', '@area.AreaUnit', '@(area.Capacity?.ToString() ?? "")', '@area.CapacityUnit', @(area.IsActive ? "true" : "false"), '@(area.AreaType ?? "")', '@(area.SupervisorId?.ToString() ?? "")', '@(area.Location ?? "")', '@(area.Remarks ?? "")', '@(area.GrowingPartnerId?.ToString() ?? "")', @System.Text.Json.JsonSerializer.Serialize(area.SupervisorName ?? ""))">
                            Edit
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Edit Modal -->
<div id="editModal" class="modal fade" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Area</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Edit">
                <div class="modal-body">
                    <input type="hidden" asp-for="EditArea.Id" id="editId" />
                    <div class="mb-3">
                        <label class="form-label">Area Type</label>
                        <select asp-for="EditArea.AreaType" class="form-select" id="editAreaType">
                            <option value="">-- Plain / Legacy --</option>
                            @foreach (var t in Model.AreaTypes)
                            {
                                <option value="@t">@AreaTypeLabel(t)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Polyhouse</label>
                        <select asp-for="EditArea.PolyhouseId" class="form-select" id="editPolyhouseId">
                            <option value="">-- None (Main Office only) --</option>
                            @foreach (var p in Model.Polyhouses)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Area Name</label>
                        <input type="text" asp-for="EditArea.Name" class="form-control" id="editName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Area Code</label>
                        <input type="text" asp-for="EditArea.AreaCode" class="form-control" id="editAreaCode" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Supervisor</label>
                        <select asp-for="EditArea.SupervisorId" class="form-select" id="editSupervisorId">
                            <option value="">-- None --</option>
                            @foreach (var s in Model.Supervisors)
                            {
                                <option value="@s.Option.EmployeeID" data-kind="@s.KindKey" data-areas="@s.Option.AreaAttribute">@s.Option.Name</option>
                            }
                        </select>
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label">Area Size</label>
                            <input type="number" step="0.01" min="0.01" asp-for="EditArea.AreaSize" class="form-control" id="editAreaSize" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Area Unit</label>
                            <input type="text" asp-for="EditArea.AreaUnit" class="form-control" id="editAreaUnit" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label">Capacity</label>
                            <input type="number" step="0.01" min="0.01" asp-for="EditArea.Capacity" class="form-control" id="editCapacity" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Capacity Unit</label>
                            <input type="text" asp-for="EditArea.CapacityUnit" class="form-control" id="editCapacityUnit" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Location</label>
                        <input type="text" asp-for="EditArea.Location" class="form-control" id="editLocation" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Remarks</label>
                        <input type="text" asp-for="EditArea.Remarks" class="form-control" id="editRemarks" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Growing Partner</label>
                        <select asp-for="EditArea.GrowingPartnerId" class="form-select" id="editGrowingPartnerId">
                            <option value="">-- Internal / No Growing Partner --</option>
                            @foreach (var gp in Model.GrowingPartners)
                            {
                                <option value="@gp.Id">@gp.Name</option>
                            }
                        </select>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" asp-for="EditArea.IsActive" class="form-check-input" id="editIsActive" />
                        <label class="form-check-label" for="editIsActive">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- JavaScript for Modal -->
<script>
    // Phase 1 (D-3): narrow a supervisor select to the Area Type's supervisor
    // kind and to supervisors of that Area ("*" = all-Area). A current
    // supervisor who is no longer eligible stays selectable, marked (current),
    // so editing other fields never clears it; the server re-checks on save.
    var areaTypeKinds = { MotherPlant: "ProductionArea", Kunjir: "ProductionArea", Kiran: "ProductionArea", MainOffice: "MainOffice", Outlet: "Outlet" };
    function narrowAreaSupervisors(select, areaType, areaId, currentId, currentName) {
        var kind = areaTypeKinds[areaType] || null;
        Array.prototype.slice.call(select.querySelectorAll("option[data-current]")).forEach(function (o) { o.remove(); });
        Array.prototype.forEach.call(select.options, function (o) {
            if (!o.dataset.kind) return;
            var ok = !!kind && o.dataset.kind === kind &&
                     (o.dataset.areas === "*" || (!!areaId && o.dataset.areas.split(",").indexOf(String(areaId)) >= 0));
            o.hidden = !ok; o.disabled = !ok;
        });
        if (currentId) {
            var match = Array.prototype.some.call(select.options, function (o) { return o.value === String(currentId) && !o.disabled; });
            if (!match) {
                var c = new Option((currentName || ("#" + currentId)) + " (current)", currentId);
                c.dataset.current = "1";
                select.add(c);
            }
        }
        var sel = select.options[select.selectedIndex];
        if (sel && sel.disabled) select.value = "";
    }
    (function () {
        var type = document.getElementById("newAreaType"), sup = document.getElementById("newSupervisorId");
        var run = function () { narrowAreaSupervisors(sup, type.value, 0, null, null); };
        type.addEventListener("change", run); run();
        var editType = document.getElementById("editAreaType");
        editType.addEventListener("change", function () {
            var s = document.getElementById("editSupervisorId");
            narrowAreaSupervisors(s, editType.value, document.getElementById("editId").value, s.dataset.currentId, s.dataset.currentName);
        });
    })();

    function openEditModal(id, polyhouseId, name, areaCode, areaSize, areaUnit, capacity, capacityUnit, isActive, areaType, supervisorId, location, remarks, growingPartnerId, supervisorName) {
        document.getElementById("editId").value = id;
        document.getElementById("editPolyhouseId").value = polyhouseId;
        document.getElementById("editName").value = name;
        document.getElementById("editAreaCode").value = areaCode;
        document.getElementById("editAreaSize").value = areaSize;
        document.getElementById("editAreaUnit").value = areaUnit;
        document.getElementById("editCapacity").value = capacity;
        document.getElementById("editCapacityUnit").value = capacityUnit;
        document.getElementById("editIsActive").checked = isActive;
        document.getElementById("editAreaType").value = areaType;
        var sup = document.getElementById("editSupervisorId");
        sup.dataset.currentId = supervisorId || "";
        sup.dataset.currentName = supervisorName || "";
        narrowAreaSupervisors(sup, areaType, id, supervisorId, supervisorName);
        sup.value = supervisorId;
        document.getElementById("editLocation").value = location;
        document.getElementById("editRemarks").value = remarks;
        document.getElementById("editGrowingPartnerId").value = growingPartnerId;
        var modal = new bootstrap.Modal(document.getElementById('editModal'));
        modal.show();
    }
</script>
