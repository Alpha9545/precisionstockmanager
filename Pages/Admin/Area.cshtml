@page
@model PlantStockManager.Pages.Admin.AreaModel
@{
    ViewData["Title"] = "Manage Areas";
}

<div class="container mt-4">
    <h2 class="mb-3">Area Management</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@err.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <!-- Add Area Form -->
    <form method="post" asp-page-handler="Add" class="mb-4">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label fw-bold">Area Type</label>
                <select asp-for="NewArea.AreaType" class="form-select">
                    <option value="">-- Plain / Legacy --</option>
                    @foreach (var t in Model.AreaTypes)
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Area Name</label>
                <input type="text" asp-for="NewArea.Name" class="form-control" placeholder="Area name" required />
            </div>
            <div class="col-md-1">
                <label class="form-label fw-bold">Area Code</label>
                <input type="text" asp-for="NewArea.AreaCode" class="form-control" placeholder="Optional" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Supervisor</label>
                <div class="form-text mt-0">Choose with Edit after users are given this Area in User Roles.</div>
            </div>
            <div class="col-md-1">
                <label class="form-label fw-bold">Size</label>
                <input type="number" step="0.01" min="0.01" asp-for="NewArea.AreaSize" class="form-control" placeholder="Size" />
            </div>
            <div class="col-md-1">
                <label class="form-label fw-bold">Capacity</label>
                <input type="number" step="0.01" min="0.01" asp-for="NewArea.Capacity" class="form-control" placeholder="Capacity" />
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100">Add</button>
            </div>
        </div>
        <div class="row g-2 mt-2">
            <div class="col-md-3">
                <input type="text" asp-for="NewArea.Location" class="form-control" placeholder="Location (optional)" />
            </div>
            <div class="col-md-3">
                <input type="text" asp-for="NewArea.Remarks" class="form-control" placeholder="Remarks (optional)" />
            </div>
        </div>
    </form>

    <!-- Area List -->
    <div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Area Type</th>
                <th>Polyhouses (in this Area)</th>
                <th>Area Name</th>
                <th>Area Code</th>
                <th>Supervisor</th>
                <th>Size</th>
                <th>Capacity</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var area in Model.Areas)
            {
                <tr class="@(area.IsActive ? "" : "text-muted")">
                    <td>@(area.AreaType ?? "-")</td>
                    <td>@(area.PolyhouseName ?? "-")</td>
                    <td>@area.Name</td>
                    <td>@area.AreaCode</td>
                    <td>@(area.SupervisorName ?? "-")</td>
                    <td>@(area.AreaSize.HasValue ? $"{area.AreaSize:N2} {area.AreaUnit}" : "-")</td>
                    <td>@(area.Capacity.HasValue ? $"{area.Capacity:N2} {area.CapacityUnit}" : "-")</td>
                    <td>@(area.IsActive ? "Active" : "Inactive")</td>
                    <td>
                        <button class="btn btn-warning btn-sm"
                                onclick="openEditModal(@area.Id, '@area.Name', '@area.AreaCode', '@(area.AreaSize?.ToString() ?? "")', '@area.AreaUnit', '@(area.Capacity?.ToString() ?? "")', '@area.CapacityUnit', @(area.IsActive ? "true" : "false"), '@(area.AreaType ?? "")', '@(area.SupervisorId?.ToString() ?? "")', '@(area.Location ?? "")', '@(area.Remarks ?? "")')">
                            Edit
                        </button>
                        <form method="post" asp-page-handler="SetActive" asp-route-id="@area.Id" asp-route-isActive="@(area.IsActive ? "false" : "true")" class="d-inline"
                              onsubmit="return confirm('@(area.IsActive ? "Deactivate this Area? It will be hidden from selection lists for new work. All existing records are kept. (An Area that still contains stock cannot be deactivated.)" : "Activate this Area again?")');">
                            <button type="submit" class="btn btn-sm @(area.IsActive ? "btn-outline-secondary" : "btn-outline-success")">
                                @(area.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                        <a asp-page-handler="ConfirmDelete" asp-route-id="@area.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>

@if (Model.DeleteCandidate != null)
{
    var candidate = Model.DeleteCandidate;
    <!-- Delete confirmation -->
    <div id="deleteModal" class="modal fade" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Area</h5>
                    <a asp-page="/Admin/Area" class="btn-close" aria-label="Close"></a>
                </div>
                <div class="modal-body">
                    <dl class="row mb-3">
                        <dt class="col-sm-4">Area Name</dt><dd class="col-sm-8">@candidate.Name</dd>
                        <dt class="col-sm-4">Area Code</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(candidate.AreaCode) ? "-" : candidate.AreaCode)</dd>
                        <dt class="col-sm-4">Area Type</dt><dd class="col-sm-8">@(candidate.AreaType ?? "-")</dd>
                        <dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(candidate.IsActive ? "Active" : "Inactive")</dd>
                    </dl>

                    <div class="alert alert-warning">
                        This Area may have related records (stock, sowings, Mother Plants, Polyhouses, user roles and more).
                        It can only be deleted when no record uses it. Deleting cannot be undone.
                    </div>

                    @if (Model.DeleteBlockedMessage != null)
                    {
                        <div class="alert alert-danger">@Model.DeleteBlockedMessage</div>
                    }
                    else if (Model.CanDeleteCandidate)
                    {
                        <div class="alert alert-success mb-3">No records use this Area. It can be deleted safely.</div>
                    }
                    else
                    {
                        <div class="alert alert-danger">This Area cannot be deleted because it is being used by existing records.</div>
                    }

                    @if (!Model.CanDeleteCandidate)
                    {
                        <p class="mb-2">
                            <strong>Area: @candidate.Name</strong><br />
                            Remove/archive the dependent records first, then delete this Area.
                            @if (candidate.IsActive && Model.CanDeactivateCandidate)
                            {
                                <span>If these are historical or business records that must be kept, <strong>Deactivate</strong> the Area instead.</span>
                            }
                        </p>
                        @if (candidate.IsActive && !Model.CanDeactivateCandidate)
                        {
                            <div class="alert alert-warning">
                                <strong>Deactivate is not available either.</strong> @Model.CandidateStockMessage
                            </div>
                        }
                    }
                    <partial name="_DependencyTable" model="Model.DeleteDependencies" />
                </div>
                <div class="modal-footer">
                    <a asp-page="/Admin/Area" class="btn btn-secondary">Cancel</a>
                    @if (!Model.CanDeleteCandidate && candidate.IsActive && Model.CanDeactivateCandidate)
                    {
                        <form method="post" asp-page-handler="SetActive" asp-route-id="@candidate.Id" asp-route-isActive="false" class="d-inline"
                              onsubmit="return confirm('Deactivate this Area? All existing records are kept.');">
                            <button type="submit" class="btn btn-warning">Deactivate instead</button>
                        </form>
                    }
                    @if (Model.CanDeleteCandidate)
                    {
                        <form method="post" asp-page-handler="Delete" asp-route-id="@candidate.Id" class="d-inline"
                              onsubmit="return confirm('Delete this Area permanently? This cannot be undone.');">
                            <button type="submit" class="btn btn-danger">Delete Area</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            new bootstrap.Modal(document.getElementById("deleteModal")).show();
        });
    </script>
}

<!-- Edit Modal -->
<div id="editModal" class="modal fade" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Area</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Edit">
                <div class="modal-body">
                    <input type="hidden" asp-for="EditArea.Id" id="editId" />
                    <div class="mb-3">
                        <label class="form-label">Area Type</label>
                        <select asp-for="EditArea.AreaType" class="form-select" id="editAreaType">
                            <option value="">-- Plain / Legacy --</option>
                            @foreach (var t in Model.AreaTypes)
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Area Name</label>
                        <input type="text" asp-for="EditArea.Name" class="form-control" id="editName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Area Code</label>
                        <input type="text" asp-for="EditArea.AreaCode" class="form-control" id="editAreaCode" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Supervisor</label>
                        <select asp-for="EditArea.SupervisorId" class="form-select" id="editSupervisorId">
                            <option value="">-- None --</option>
                            @foreach (var s in Model.Supervisors)
                            {
                                <option value="@s.EmployeeID" data-areas="@(Model.SupervisorAreaIds.TryGetValue(s.EmployeeID, out var ids) ? string.Join(",", ids) : "")">@s.Name</option>
                            }
                        </select>
                        <div class="form-text">Only users with a Supervisor role for this Area (Admin &gt; User Roles).</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label">Area Size</label>
                            <input type="number" step="0.01" min="0.01" asp-for="EditArea.AreaSize" class="form-control" id="editAreaSize" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Area Unit</label>
                            <input type="text" asp-for="EditArea.AreaUnit" class="form-control" id="editAreaUnit" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label">Capacity</label>
                            <input type="number" step="0.01" min="0.01" asp-for="EditArea.Capacity" class="form-control" id="editCapacity" />
                        </div>
                        <div class="col-6">
                            <label class="form-label">Capacity Unit</label>
                            <input type="text" asp-for="EditArea.CapacityUnit" class="form-control" id="editCapacityUnit" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Location</label>
                        <input type="text" asp-for="EditArea.Location" class="form-control" id="editLocation" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Remarks</label>
                        <input type="text" asp-for="EditArea.Remarks" class="form-control" id="editRemarks" />
                    </div>
                    <div class="form-check">
                        <input type="checkbox" asp-for="EditArea.IsActive" class="form-check-input" id="editIsActive" />
                        <label class="form-check-label" for="editIsActive">Active</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- JavaScript for Modal -->
<script>
    function openEditModal(id, name, areaCode, areaSize, areaUnit, capacity, capacityUnit, isActive, areaType, supervisorId, location, remarks) {
        document.getElementById("editId").value = id;
        document.getElementById("editName").value = name;
        document.getElementById("editAreaCode").value = areaCode;
        document.getElementById("editAreaSize").value = areaSize;
        document.getElementById("editAreaUnit").value = areaUnit;
        document.getElementById("editCapacity").value = capacity;
        document.getElementById("editCapacityUnit").value = capacityUnit;
        document.getElementById("editIsActive").checked = isActive;
        document.getElementById("editAreaType").value = areaType;
        // Only this Area's supervisors (plus the one already stored).
        var sup = document.getElementById("editSupervisorId");
        Array.from(sup.options).forEach(function (o) {
            if (!o.value) return;
            var areas = (o.getAttribute("data-areas") || "").split(",");
            o.hidden = !(areas.indexOf(String(id)) >= 0 || o.value === String(supervisorId));
        });
        sup.value = supervisorId;
        document.getElementById("editLocation").value = location;
        document.getElementById("editRemarks").value = remarks;
        var modal = new bootstrap.Modal(document.getElementById('editModal'));
        modal.show();
    }
</script>
