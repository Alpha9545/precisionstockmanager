@page
@model PlantStockManager.Pages.Admin.RolesModel
@{
    ViewData["Title"] = "Roles & Permissions";
}

<div class="container mt-4">
    <h2 class="mb-3">Roles &amp; Permissions</h2>
    <p class="text-muted">
        A user's access comes <strong>only</strong> from the permissions of the Role(s) assigned to them.
        Tick the permissions for a Role here; every user holding that Role receives them automatically
        (within a few minutes, or at their next login). Users are given Roles on
        <a asp-page="/Admin/Users">Users</a> or <a asp-page="/Admin/UserRoles">User Role / Area Assignments</a>.
    </p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success">@Model.SuccessMessage</div>
    }

    <div class="row">
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header fw-bold">Roles</div>
                <ul class="list-group list-group-flush">
                    @foreach (var role in Model.Roles)
                    {
                        var selected = Model.SelectedRoleId == role.Id;
                        <li class="list-group-item @(selected ? "active" : "")">
                            <a asp-page="/Admin/Roles" asp-route-SelectedRoleId="@role.Id" class="text-decoration-none @(selected ? "text-white" : "")">
                                <strong>@role.Name</strong>
                            </a>
                            <div class="small @(selected ? "text-white-50" : "text-muted")">
                                @if (Model.IsFullAccessRole(role))
                                {
                                    <span class="badge bg-danger">Full access</span>
                                }
                                else
                                {
                                    <span>@role.PermissionCount permission(s)</span>
                                }
                                <span> &middot; @role.UserCount user(s)</span>
                            </div>
                        </li>
                    }
                </ul>
            </div>

            <div class="card">
                <div class="card-header fw-bold">Add Role</div>
                <div class="card-body">
                    <form method="post" asp-page-handler="AddRole">
                        <div class="mb-2">
                            <label class="form-label">Name</label>
                            <input type="text" asp-for="NewRoleName" class="form-control" maxlength="50" required />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Description</label>
                            <input type="text" asp-for="NewRoleDescription" class="form-control" maxlength="200" />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Add Role</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            @if (Model.SelectedRole != null)
            {
                <div class="card">
                    <div class="card-header fw-bold">
                        Permissions for @Model.SelectedRole.Name
                        @if (!string.IsNullOrWhiteSpace(Model.SelectedRole.Description))
                        {
                            <div class="small text-muted fw-normal">@Model.SelectedRole.Description</div>
                        }
                    </div>
                    <div class="card-body">
                        @if (Model.SelectedRoleIsFullAccess)
                        {
                            <div class="alert alert-warning mb-0">
                                <strong>@Model.SelectedRole.Name</strong> has <strong>full access</strong> to every feature and
                                every Area automatically. No permissions need to be assigned to it.
                            </div>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="SavePermissions">
                                <input type="hidden" name="roleId" value="@Model.SelectedRole.Id" />
                                @foreach (var group in Model.PermissionGroups)
                                {
                                    <h6 class="mt-3 border-bottom pb-1">@group.Key</h6>
                                    <div class="row">
                                        @foreach (var perm in group)
                                        {
                                            var isAdminCode = perm.Code.StartsWith("Admin.");
                                            var locked = isAdminCode && !Model.CanEditAdminPermissions;
                                            <div class="col-md-6 form-check mb-1">
                                                <input type="checkbox" class="form-check-input" name="permissionIds" value="@perm.Id" id="perm_@perm.Id"
                                                       checked="@perm.IsGrantedToRole" disabled="@locked" />
                                                @if (locked && perm.IsGrantedToRole)
                                                {
                                                    @* disabled inputs are not posted: keep the existing grant *@
                                                    <input type="hidden" name="permissionIds" value="@perm.Id" />
                                                }
                                                <label class="form-check-label" for="perm_@perm.Id">
                                                    @perm.Code
                                                    @if (!string.IsNullOrEmpty(perm.Description))
                                                    {
                                                        <div class="text-muted small">@perm.Description</div>
                                                    }
                                                </label>
                                            </div>
                                        }
                                    </div>
                                }
                                @if (!Model.CanEditAdminPermissions)
                                {
                                    <div class="small text-muted mt-2">Admin.* permissions can only be changed by a System Administrator.</div>
                                }
                                <button type="submit" class="btn btn-success mt-3">Save Permissions</button>
                            </form>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">Select a Role on the left to view/edit its permissions.</div>
            }
        </div>
    </div>
</div>
