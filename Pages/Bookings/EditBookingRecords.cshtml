@page
@model PlantStockManager.Pages.Bookings.BookingRecordsModel
@using System.Globalization
@attribute [IgnoreAntiforgeryToken]

@{
    ViewData["Title"] = "Booking Records";
}

@functions {
    private static string ToTitle(string s)
    {
        if (string.IsNullOrWhiteSpace(s)) return s;
        s = s.ToLowerInvariant();
        return CultureInfo.CurrentCulture.TextInfo.ToTitleCase(s);
    }
}

<link rel="stylesheet" href="~/css/sweetalert.css" />
<style>
    .table-compact {
        font-size: 0.82rem;
        line-height: 1.2;
    }

        .table-compact thead th {
            font-size: 0.75rem;
            font-weight: 600;
            padding: .35rem .5rem;
        }

        .table-compact tbody td {
            font-size: 0.78rem;
            padding: .35rem .5rem;
        }

    thead.table-dark th {
        vertical-align: middle;
    }

    @@media (max-width: 768px) {
        .table-compact {
            font-size: 0.78rem;
        }

            .table-compact thead th, .table-compact tbody td {
                padding: .3rem .4rem;
            }
    }

    .hidden-column {
        display: none;
    }
</style>

<div class="p-2">
    <h2>Booking Records</h2>

    <!-- Filters -->
    <form method="get" class="row g-3">
        @Html.AntiForgeryToken()
        <div class="col-md-3">
            <label class="form-label">Plant Type</label>
            <select asp-for="SelectedPlantType" class="form-control" onchange="this.form.submit()">
                <option value="">All</option>
                @foreach (var plantType in Model.PlantTypes)
                {
                    <option value="@plantType.Id">@plantType.Name</option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Species</label>
            <select asp-for="SelectedSpecies" class="form-control" onchange="this.form.submit()">
                <option value="">All</option>
                @foreach (var species in Model.PlantSpecies)
                {
                    <option value="@species.Id">@species.Name</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label">Delivery Month</label>
            <select asp-for="SelectedMonth" class="form-control" onchange="this.form.submit()">
                <option value="0" selected="@(Model.SelectedMonth == 0 ? "selected" : null)">All</option>
                @for (int month = 1; month <= 12; month++)
                {
                    <option value="@month" selected="@(Model.SelectedMonth == month ? "selected" : null)">
                        @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)
                    </option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label">Delivery Year</label>
            <select asp-for="SelectedYear" class="form-control" onchange="this.form.submit()">
                @for (int year = DateTime.Now.Year - 1; year <= DateTime.Now.Year + 1; year++)
                {
                    <option value="@year">@year</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label">Delivery Status</label>
            <select asp-for="SelectedStatus" class="form-control" onchange="this.form.submit()">
                <option value="Pending">Pending</option>
                <option value="Completed">Completed</option>
                <option value="Cancelled">Cancelled</option>
            </select>
        </div>
    </form>

    <!-- Table -->
    <div class="table-responsive" style="max-height: 570px; overflow-y:auto; border:1px solid #ddd; margin-top:10px;">
        <table class="table table-striped table-sm m-0 table-compact">
            <thead class="table-dark" style="position: sticky; top: 0; z-index: 10;">
                <tr>
                    <th>Booking ID</th>
                    <th>Customer Name</th>
                    <th>Booking Date</th>
                    <th>Delivery Status</th>
                    <th>Delivery Date</th>
                    <th class="hidden-column">Plant Type Id</th>
                    <th>Plant Type</th>
                    <th class="hidden-column">Species Type Id</th>
                    <th>Species</th>
                    <th>Quantity</th>
                    <th class="hidden-column">Customer Address</th>
                    <th class="hidden-column">Customer Contact</th>
                    <th class="hidden-column">Advance Taken</th>
                    <th>Advance</th>
                    <th class="hidden-column">Transaction Details</th>
                    <th>Booked By</th>
                    <th class="hidden-column">Booked By Id</th>
                    <th class="hidden-column">BookedByOthers</th>
                    <th class="hidden-column">StateId</th>
                    <th>State</th>
                    <th class="hidden-column">DistrictId</th>
                    <th>District</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.Bookings)
                {
                    <tr>
                        <td>@booking.Id</td>
                        <td>@ToTitle(booking.CustomerName)</td>
                        <td>@booking.BookingDate.ToString("dd-MMMM-yyyy")</td>
                        <td>@booking.Status</td>
                        <td>@booking.DeliveryDate.ToString("dd-MMMM-yyyy")</td>
                        <td class="hidden-column">@booking.PlantId</td>
                        <td>@ToTitle(booking.PlantTypeName)</td>
                        <td class="hidden-column">@booking.SpeciesId</td>
                        <td>@ToTitle(booking.SpeciesName)</td>
                        <td>@booking.Quantity</td>
                        <td class="hidden-column">@booking.Address</td>
                        <td class="hidden-column">@booking.Contact</td>
                        <td class="hidden-column">@booking.AdvanceTaken</td>
                        <td>@booking.AdvanceTakenAmount</td>
                        <td class="hidden-column">@booking.AdvanceTakenDetails</td>
                        <td>@ToTitle((booking.BookedById == 0 ? booking.BookedByOther : booking.BookedByName))</td>
                        <td class="hidden-column">@booking.BookedById</td>
                        <td class="hidden-column">@booking.BookedByOther</td>
                        <td class="hidden-column">@booking.StateId</td>
                        <td>@booking.StateName</td>
                        <td class="hidden-column">@booking.DistrictId</td>
                        <td>@booking.DistrictName</td>
                        <td>
                            @if (booking.Status == "Pending")
                            {
                                <button class="btn btn-primary btn-sm edit-booking-btn" data-id="@booking.Id">Edit</button>
                                <button class="btn btn-danger btn-sm ms-2 delete-booking-btn" data-id="@booking.Id">Delete</button>
                            }
                            else
                            {
                                <span>Completed</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Edit Booking Modal -->
<div class="modal fade" id="editBookingModal" tabindex="-1" aria-labelledby="editBookingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background-color:#008080; color:white;">
                <h5 class="modal-title" id="editBookingModalLabel">Edit Booking</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form id="editBookingForm" method="post">
                    <input type="hidden" id="editBookingId" asp-for="Booking.Id" />
                    <input type="hidden" asp-for="Booking.AddedBy" value="Lalit" />

                    <div class="col-md-12 mb-3">
                        <div class="row">
                            <div class="col-md-6">
                                <label class="fw-bold">Booking No:</label> <span id="bookingId1"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="fw-bold">Booking Date:</label> <span id="bookingDate1"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="fw-bold">Select Plant Type</label>
                            <select id="editPlantTypeDropdown" class="form-select" asp-for="Booking.PlantId" required>
                                <option value="">-- Select --</option>
                                @foreach (var type in Model.PlantTypes)
                                {
                                    <option value="@type.Id">@type.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="fw-bold">Select Variety</label>
                            <select id="editSpeciesDropdown" class="form-select" asp-for="Booking.SpeciesId" required>
                                <option value="">-- Select a Plant Type First --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="fw-bold">Customer Name</label>
                            <input type="text" class="form-control" id="editCustomerName" asp-for="Booking.CustomerName" required />
                        </div>

                        <div class="col-md-6">
                            <label class="fw-bold">Customer Address</label>
                            <input type="text" class="form-control" id="editAddress" asp-for="Booking.Address" required />
                        </div>

                        <div class="col-md-6">
                            <label class="fw-bold">Customer Contact</label>
                            <input type="number" class="form-control" id="editContact" asp-for="Booking.Contact" required />
                        </div>

                        <div class="col-md-6">
                            <label class="fw-bold">Quantity</label>
                            <input type="text" class="form-control" id="editQuantityInput" required />
                            <small class="text-muted d-block mt-1" id="editQuantityInWords"></small>
                            <input type="hidden" asp-for="Booking.Quantity" id="editHiddenQuantity" />
                        </div>

                        <!-- NEW: Booked By Whom (Employees) -->
                        <div class="col-md-6">
                            <label class="fw-bold">Booked By Whom</label>
                            <select class="form-select" id="editBookedByDropdown" asp-for="Booking.BookedById" required>
                                <option value="">-- Select --</option>
                                @foreach (var emp in Model.Employees)
                                {
                                    <option value="@emp.EmployeeID">@emp.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="fw-bold">Advance Taken</label>
                            <select class="form-select" id="editAdvanceTakenDropdown" asp-for="Booking.AdvanceTaken">
                                <option value="false">No</option>
                                <option value="true">Yes</option>
                            </select>
                        </div>

                        <div class="col-md-6 advance-fields-edit d-none">
                            <label class="fw-bold">Advance Amount</label>
                            <input type="text" class="form-control" id="editAdvanceTakenAmount" />
                            <small class="text-muted d-block mt-1" id="editAdvanceAmountInWords"></small>
                            <input type="hidden" asp-for="Booking.AdvanceTakenAmount" id="editHiddenAdvanceAmount" />
                        </div>

                        <div class="col-md-12 advance-fields-edit d-none">
                            <label class="fw-bold">Transaction Details of Advance Taken</label>
                            <input type="text" class="form-control" id="editAdvanceTakenDetails" asp-for="Booking.AdvanceTakenDetails" />
                        </div>

                        <div class="col-md-6">
                            <label class="fw-bold">State</label>
                            <select id="editStateDropdown" class="form-select" asp-for="Booking.StateId" required>
                                <option value="">-- Select State --</option>
                                @foreach (var s in Model.States)
                                {
                                    <option value="@s.StateId">@s.StateName</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="fw-bold">District</label>
                            <select id="editDistrictDropdown" class="form-select" asp-for="Booking.DistrictId" required>
                                <option value="">-- Select State First --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="fw-bold">Tentative Delivery Date</label>
                            <input type="date" class="form-control" id="editDeliveryDate" asp-for="Booking.DeliveryDate" required />
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <button type="submit" class="btn btn-primary w-100 py-2">Update Booking</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/sweetalert.js"></script>
    <script>
        $(document).ready(function () {
            // number helpers
            function formatNumberWithCommas(num){ return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ","); }
            function numberToWords(num){
                if (num === "" || isNaN(num) || num < 1) return "";
                var ones = ["","One","Two","Three","Four","Five","Six","Seven","Eight","Nine","Ten","Eleven","Twelve","Thirteen","Fourteen","Fifteen","Sixteen","Seventeen","Eighteen","Nineteen"];
                var tens = ["","","Twenty","Thirty","Forty","Fifty","Sixty","Seventy","Eighty","Ninety"];
                function conv(n){
                    if (n<20) return ones[n];
                    if (n<100) return tens[Math.floor(n/10)] + (n%10 ? " "+ones[n%10] : "");
                    if (n<1000) return ones[Math.floor(n/100)] + " Hundred" + (n%100 ? " "+conv(n%100) : "");
                    if (n<1000000) return conv(Math.floor(n/1000)) + " Thousand" + (n%1000 ? " "+conv(n%1000) : "");
                    return n;
                }
                return conv(num);
            }
            function handleNumberInput(inputId, wordsId, hiddenInputId){
                $(`#${inputId}`).on("input", function(){
                    let raw = $(this).val().replace(/,/g,"");
                    let n = parseInt(raw,10);
                    if (!isNaN(n)){
                        if (n<1) n=1;
                        if (n>999999) n=999999;
                        $(this).val(formatNumberWithCommas(n));
                        $(`#${wordsId}`).text(numberToWords(n));
                        $(`#${hiddenInputId}`).val(n);
                    } else {
                        $(this).val("");
                        $(`#${wordsId}`).text("");
                        $(`#${hiddenInputId}`).val("");
                    }
                });
            }
            handleNumberInput("editQuantityInput","editQuantityInWords","editHiddenQuantity");
            handleNumberInput("editAdvanceTakenAmount","editAdvanceAmountInWords","editHiddenAdvanceAmount");

            // species
            function fetchSpeciesByPlantType(plantTypeId, speciesDropdownId, selectedSpeciesId=null){
                if (!plantTypeId) return;
                $.get(window.basePath + `Bookings/EditBookingRecords?handler=SpeciesByPlantType&plantTypeId=${plantTypeId}`, function (list) {
                    let dd = $(`#${speciesDropdownId}`);
                    dd.empty().append('<option value="">-- Select --</option>');
                    $.each(list, function(_, sp){ dd.append(`<option value="${sp.id}">${sp.name}</option>`); });
                    if (selectedSpeciesId) dd.val(selectedSpeciesId);
                }).fail(function(){ alert("Error fetching species data."); });
            }
            $('#editPlantTypeDropdown').change(function(){
                fetchSpeciesByPlantType($(this).val(),'editSpeciesDropdown');
            });

            // state -> districts
            function loadDistricts(stateId, selectedDistrictId=null){
                const d = $('#editDistrictDropdown');
                d.prop('disabled', true).empty();
                if (!stateId){
                    d.append('<option value="">-- Select State First --</option>');
                    return;
                }
                $.get(window.basePath + 'Bookings/EditBookingRecords?handler=DistrictsByState&stateId=' + stateId, function(data){
                    d.append('<option value="">-- Select District --</option>');
                    $.each(data, function(_, row){
                        d.append(`<option value="${row.districtId}">${row.districtName}</option>`);
                    });
                    if (selectedDistrictId) d.val(selectedDistrictId);
                    d.prop('disabled', false);
                }).fail(function(){
                    d.append('<option value="">-- Failed to load districts --</option>');
                });
            }
            $('#editStateDropdown').on('change', function(){
                loadDistricts($(this).val());
            });

            // toggle advance fields
            function toggleAdvanceFields(show){
                if (show) $('.advance-fields-edit').removeClass('d-none');
                else $('.advance-fields-edit').addClass('d-none');
            }
            $('#editAdvanceTakenDropdown').change(function(){
                toggleAdvanceFields($(this).val()==="true");
            });

            // open modal
            $(document).on('click', '.edit-booking-btn', function () {
                let row = $(this).closest("tr");
                let id            = $(this).data("id");
                let customerName  = row.find("td:eq(1)").text().trim();
                let bookingDate   = row.find("td:eq(2)").text().trim();
                let status        = row.find("td:eq(3)").text().trim();
                let deliveryDate  = row.find("td:eq(4)").text().trim();
                let plantId       = row.find("td:eq(5)").text().trim();
                let speciesId     = row.find("td:eq(7)").text().trim();
                let quantity      = row.find("td:eq(9)").text().trim();
                let address       = row.find("td:eq(10)").text().trim();
                let contact       = row.find("td:eq(11)").text().trim();
                let advTaken      = row.find("td:eq(12)").text().trim().toLowerCase()==="true";
                let advAmount     = row.find("td:eq(13)").text().trim();
                let advDetails    = row.find("td:eq(14)").text().trim();
                let bookedById    = row.find("td:eq(16)").text().trim(); // hidden BookedById
                let stateId       = row.find("td:eq(18)").text().trim(); // hidden StateId
                let districtId    = row.find("td:eq(20)").text().trim(); // hidden DistrictId

                // normalize
                stateId    = stateId && !isNaN(stateId)    ? String(parseInt(stateId, 10))    : "";
                districtId = districtId && !isNaN(districtId) ? String(parseInt(districtId, 10)) : "";
                bookedById = bookedById && !isNaN(bookedById) ? String(parseInt(bookedById, 10)) : "";

                function toISO(dateStr){ let d=new Date(dateStr); return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`; }
                function toDMY(dateStr){ let d=new Date(dateStr); return `${String(d.getDate()).padStart(2,'0')}-${String(d.getMonth()+1).padStart(2,'0')}-${d.getFullYear()}`; }

                $('#bookingId1').text(id);
                $('#bookingDate1').text(toDMY(bookingDate));
                $('#editBookingId').val(id);
                $('#editCustomerName').val(customerName);
                $('#editAddress').val(address);
                $('#editContact').val(contact);
                $('#editQuantityInput').val(quantity);
                $('#editHiddenQuantity').val(quantity);
                $('#editAdvanceTakenDropdown').val(advTaken.toString());
                $('#editAdvanceTakenAmount').val(advAmount);
                $('#editHiddenAdvanceAmount').val(advAmount);
                $('#editAdvanceTakenDetails').val(advDetails);
                $('#editDeliveryDate').val(toISO(deliveryDate));
                toggleAdvanceFields(advTaken);

                // set BookedById (Employees)
                $('#editBookedByDropdown').val(bookedById || "");

                // state & districts
                $('#editStateDropdown').val(stateId || "");
                if (stateId) loadDistricts(stateId, districtId); else { $('#editDistrictDropdown').empty().append('<option value="">-- Select State First --</option>'); }

                // plant/species
                $('#editPlantTypeDropdown').val(plantId);
                fetchSpeciesByPlantType(plantId, 'editSpeciesDropdown', speciesId);

                $('#editBookingModal').modal('show');
            });

            // submit edit
            $('#editBookingForm').submit(function(e){
                e.preventDefault();

                if (!$('#editStateDropdown').val()){
                    showCustomAlert("Error", "State is required.", "error"); return;
                }
                if (!$('#editDistrictDropdown').val()){
                    showCustomAlert("Error", "District is required.", "error"); return;
                }
                if (!$('#editBookedByDropdown').val()){
                    showCustomAlert("Error", "Booked By is required.", "error"); return;
                }

                let formData = $(this).serialize();
                $.post('@Url.Page("/Bookings/EditBookingRecords", "EditBooking")', formData, function(res){
                    if (res.success){
                        $('#editBookingModal').modal('hide');
                        showCustomAlert("Success","Booking Updated Successfully!","success", function(){ location.reload(); });
                    } else {
                        $('#editBookingModal').modal('hide');
                        showCustomAlert("Error", res.message ?? "Something went wrong!", "error");
                    }
                }).fail(function(){
                    $('#editBookingModal').modal('hide');
                    showCustomAlert("Error","Server error. Please try again later.","error");
                });
            });

            // delete
            $(document).on('click', '.delete-booking-btn', function () {
                const id = $(this).data('id');
                if (!confirm('Delete this booking? This will remove its transactions first, then the booking.')) return;
                $.post('@Url.Page("/Bookings/EditBookingRecords", "DeleteBooking")', { id: id }, function (res) {
                    if (res.success) { alert('Booking deleted.'); location.reload(); }
                    else { alert(res.message || 'Failed to delete booking.'); }
                }).fail(function(){ alert('Server error while deleting.'); });
            });
        });
    </script>
}
