@page
@model PlantStockManager.Pages.Bookings.sampleModel
@using System.Globalization
@using PlantStockManager.Pages.Bookings

@attribute [IgnoreAntiforgeryToken]
@{
    ViewData["Title"] = "Manage Bookings";
}

@functions {
    private static string ToTitle(string s)
    {
        if (string.IsNullOrWhiteSpace(s)) return s;
        s = s.ToLowerInvariant();
        return CultureInfo.CurrentCulture.TextInfo.ToTitleCase(s);
    }
}

<style>
    /* ====== Layout & Spacing ====== */
    .page-header {
        gap: .75rem;
        flex-wrap: wrap;
    }

    /* ====== Filters ====== */
    .filters .input-group > .form-control {
        min-width: 260px;
    }
    @@media (min-width: 576px) {
        .filters .input-group > .form-control

    {
        min-width: 320px;
    }

    }
    @@media (min-width: 992px) {
        .filters .input-group > .form-control

    {
        min-width: 380px;
    }

    }

    /* ====== Table Wrapper ====== */
    #bookingTableOuter {
        border-radius: .75rem;
        box-shadow: 0 1px 2px rgba(0,0,0,.05), 0 8px 24px rgba(0,0,0,.06);
        overflow: hidden; /* for sticky header shadow clip */
    }

    #bookingTableContainer {
        overflow-x: auto; /* Horizontal scroll on narrow screens */
        -webkit-overflow-scrolling: touch;
        position: relative;
    }
        /* Scroll hint gradient on mobile */
        #bookingTableContainer::after {
            content: "";
            position: absolute;
            right: 0;
            top: 0;
            bottom: 0;
            width: 16px;
            pointer-events: none;
            background: linear-gradient(to right, rgba(255,255,255,0), rgba(255,255,255,.9));
            display: none;
        }
    @@media (max-width: 767.98px) {
        #bookingTableContainer::after

    {
        display: block;
    }

    }

    /* ====== Table ====== */
    table#bookingTable {
        min-width: 1200px; /* keeps a big table; adjust if you add more columns */
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        background: #fff;
    }

        table#bookingTable thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            background: #111827; /* tailwind slate-900ish for strong contrast */
            color: #fff;
            border: 0;
            padding-top: .9rem;
            padding-bottom: .9rem;
            box-shadow: 0 2px 0 rgba(0,0,0,.08);
            white-space: nowrap;
        }

        table#bookingTable tbody td {
            vertical-align: middle;
            white-space: nowrap;
        }

        table#bookingTable tbody tr:hover {
            background-color: #f9fafb; /* subtle hover */
        }

    /* ====== Status Badge Normalization (Bootstrap 4/5 friendly) ====== */
    .badge.rounded-pill, .badge.badge-pill {
        padding: .45rem .65rem;
        font-weight: 600;
    }

    .badge-success, .bg-success {
        background-color: #16a34a !important;
    }
    /* emerald-ish */
    .badge-warning, .bg-warning {
        background-color: #f59e0b !important;
    }

    .badge-danger, .bg-danger {
        background-color: #dc2626 !important;
    }

    .badge-secondary, .bg-secondary {
        background-color: #6b7280 !important;
    }

    /* ====== Action Buttons ====== */
    .btn-action {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        font-weight: 600;
        letter-spacing: .2px;
        border-radius: 9999px; /* pill */
        padding: .4rem .75rem;
        line-height: 1.2;
        box-shadow: 0 1px 0 rgba(0,0,0,.05);
    }

        .btn-action i {
            font-size: .9rem;
        }

    .btn-success.btn-action {
        background-color: #16a34a;
        border-color: #16a34a;
    }

        .btn-success.btn-action:hover {
            background-color: #15803d;
            border-color: #15803d;
        }

    .btn-danger.btn-action {
        background-color: #dc2626;
        border-color: #dc2626;
    }

        .btn-danger.btn-action:hover {
            background-color: #b91c1c;
            border-color: #b91c1c;
        }

    /* Keep button text visible and crisp on all sizes */
    .btn-action .btn-text {
        display: inline;
    }

    /* On the absolute smallest screens, allow icon-only if space is extremely tight */
    @@media (max-width: 360px) {
        .btn-action .btn-text

    {
        display: none;
    }

    }

    /* ====== Utilities ====== */
    .text-quiet {
        color: #6b7280;
    }
    /* gray-500 */
    .fw-semibold {
        font-weight: 600;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3 page-header">
    <h2 class="mb-0">📅 Manage Bookings</h2>
    <div class="filters d-flex flex-wrap gap-2 align-items-start">
        <!-- Status filter form -->
        <form method="get" class="d-inline-block me-2 mt-2">
            <select class="form-control" name="StatusFilter" onchange="this.form.submit()">
                <option value="">All</option>
                @if (Model.StatusFilter == "Pending")
                {
                    <option value="Pending" selected>Pending</option>
                }
                else
                {
                    <option value="Pending">Pending</option>
                }
                @if (Model.StatusFilter == "Completed")
                {
                    <option value="Completed" selected>Completed</option>
                }
                else
                {
                    <option value="Completed">Completed</option>
                }
                @if (Model.StatusFilter == "Cancelled")
                {
                    <option value="Cancelled" selected>Cancelled</option>
                }
                else
                {
                    <option value="Cancelled">Cancelled</option>
                }
            </select>
        </form>

        <!-- Search form -->
        <form method="get" class="d-inline-block me-2">
            <div class="input-group">
                <input type="text" class="form-control" name="SearchTerm"
                       placeholder="Search by Customer Name, Address or Contact"
                       value="@(Model.SearchTerm ?? "")" />
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </form>

        <!-- Date filter form (only preserving StatusFilter) -->
        <form method="get" class="d-inline-block mt-2">
            <div class="input-group">
                <input type="date" class="form-control" name="FromDate"
                       value="@(Model.FromDate?.ToString("yyyy-MM-dd") ?? "")" />
                <input type="date" class="form-control" name="ToDate"
                       value="@(Model.ToDate?.ToString("yyyy-MM-dd") ?? "")" />
                <button type="submit" class="btn btn-primary" style="margin-right: 10px;">Filter Dates</button>
            </div>
            <!-- Preserve StatusFilter only -->
            <input type="hidden" name="StatusFilter" value="@(Model.StatusFilter ?? "")" />
        </form>
    </div>
    <!-- Antiforgery token (even if ignored, you’re reading it client-side for headers) -->
    <input name="__RequestVerificationToken" type="hidden" value="CfDJ8sfdasfassafsafsajl^(&(&(&(*&)ekjhkbfsdfhkjfs" />
</div>

<div class="alert alert-info mb-4 d-flex justify-content-between align-items-center flex-wrap">
    <div class="mb-2 mb-sm-0">
        <i class="fas fa-info-circle"></i> Manage customer plant orders and track fulfillment status
    </div>
    <div>
        <a asp-page="/Bookings/Bookinglist"
           asp-route-handler="GeneratePdf"
           asp-route-StatusFilter="@Model.StatusFilter"
           asp-route-SearchTerm="@Model.SearchTerm"
           asp-route-FromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
           asp-route-ToDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
           class="btn btn-secondary btn-sm" target="_blank">
            Generate PDF
        </a>
    </div>
</div>

<div id="bookingTableOuter" class="bg-white">
    <div class="table-responsive" id="bookingTableContainer">
        <table class="table table-hover align-middle mb-0" id="bookingTable">
            <thead class="thead-dark">
                <tr>
                    <th class="d-none d-md-table-cell">Booking ID</th>
                    <th>Customer</th>
                    <th>Plant Type</th>
                    <th class="d-none d-sm-table-cell">Variety</th>
                    <th>Qty</th>
                    <th>Status</th>
                    <th class="d-none d-md-table-cell">Tentative Delivery Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model.Bookings)
                {
                    <tr class="@(booking.TentativeDeliveryDate < DateTime.Now && booking.Status != "Completed" ? "table-warning" : "")">
                        <td class="d-none d-md-table-cell">#@booking.Id</td>
                        <td>
                            <div class="fw-semibold">@ToTitle(booking.CustomerName)</div>
                            <small class="text-quiet d-block d-sm-none">@booking.Species</small>
                        </td>
                        <td>@ToTitle(booking.PlantType)</td>
                        <td class="d-none d-sm-table-cell">@ToTitle(booking.Species)</td>
                        <td>@booking.Quantity</td>
                        <td>
                            <span class="badge @Model.GetStatusBadge(booking.Status) rounded-pill">
                                <i class="fas @Model.GetStatusIcon(booking.Status) me-1"></i>@booking.Status
                            </span>
                        </td>
                        <td class="d-none d-md-table-cell">
                            <span data-toggle="tooltip" data-bs-toggle="tooltip"
                                  title="@(booking.ActualDeliveryDate != null
                                                                 ? "Booking Fulfilled"
                                                                 : ((booking.TentativeDeliveryDate - DateTime.Now).Days >= 0
                                                                 ? $"Days Remained: {(booking.TentativeDeliveryDate - DateTime.Now).Days}"
                                                                 : $"Days Passed: {Math.Abs((booking.TentativeDeliveryDate - DateTime.Now).Days)}"))">
                            @booking.TentativeDeliveryDate.ToString("dd-MMM-yy")
                        </span>
                    </td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            @if (booking.Status == "Pending")
                                {
                                    <a asp-page="/Bookings/FulfillBooking"
                                       asp-route-BookingId="@booking.Id"
                                       class="btn btn-sm btn-success btn-action"
                                       data-toggle="tooltip" data-bs-toggle="tooltip" title="Mark as fulfilled">
                                        <i class="fas fa-check"></i>
                                        <span class="btn-text">Fulfill</span>
                                    </a>

                                    <button type="button"
                                            class="btn btn-sm btn-danger btn-action cancel-booking"
                                            data-booking-id="@booking.Id"
                                            data-customer-name="@booking.CustomerName"
                                            data-toggle="tooltip" data-bs-toggle="tooltip" title="Cancel this booking">
                                        <i class="fas fa-times"></i>
                                        <span class="btn-text">Cancel</span>
                                    </button>
                                }
                                else if (booking.Status == "Cancelled")
                                {
                                    <span class="text-muted small">Cancelled</span>
                                }
                                else if (booking.Status == "Completed" || booking.Status == "Fulfilled")
                                {
                                    <span class="text-muted small">Fulfilled</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // Bootstrap 4/5 tooltip compatibility
        (function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-toggle="tooltip"],[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.forEach(function (el) {
                if (window.bootstrap && bootstrap.Tooltip) {
                    new bootstrap.Tooltip(el);
                } else if (window.$ && $.fn.tooltip) {
                    $(el).tooltip();
                }
            });
        })();

        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".cancel-booking").forEach(button => {
                button.addEventListener("click", function () {
                    let bookingId = this.getAttribute("data-booking-id");
                    let customerName = this.getAttribute("data-customer-name");

                    if (confirm(`Are you sure you want to cancel the booking for ${customerName}?`)) {
                        fetch(window.location.pathname + "?handler=CancelBooking", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value
                            },
                            body: JSON.stringify(parseInt(bookingId))
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                const row = document.querySelector(`button[data-booking-id='${bookingId}']`).closest("tr");

                                // Update badge to show "Cancelled"
                                let badge = row.querySelector("span.badge");
                                if (badge) {
                                    badge.classList.remove("bg-warning", "badge-warning", "bg-success", "badge-success");
                                    badge.classList.add("bg-danger", "badge-danger", "rounded-pill");
                                    badge.innerHTML = '<i class="fas fa-times-circle me-1"></i>Cancelled';
                                }

                                // Remove the cancel button
                                this.remove();

                                // Remove the fulfill button if it exists
                                let fulfillButton = row.querySelector("a.btn-success");
                                if (fulfillButton) {
                                    fulfillButton.remove();
                                }
                            } else {
                                console.log(JSON.stringify({ BookingId: parseInt(bookingId) }));
                                alert("Failed to cancel booking. Try again!");
                            }
                        })
                        .catch(error => console.error("Error:", error));
                    }
                });
            });
        });
    </script>
}
