@page
@model PlantStockManager.Pages.Bookings.BookModel
@{
    ViewData["Title"] = "Booking";
}

<link rel="stylesheet" href="~/css/sweetalert.css" />

<div class="container mt-4">
    <div class="card shadow-lg mx-auto p-3" style="max-width: 900px;">
        <div class="card-header text-white text-center" style="background-color: #008080;">
            <h2 class="mb-0">Advance Booking</h2>
        </div>

        <div class="card-body">
            <form method="post" id="directBookingForm">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                  

                    <!-- Shared fields -->
                    <div class="col-md-6">
                        <label class="fw-bold">Customer Name</label>
                        <input type="text" class="form-control" asp-for="Booking.CustomerName" required />
                    </div>

                    <div class="col-md-6">
                        <label class="fw-bold">Customer Contact</label>
                        <input type="number" class="form-control" asp-for="Booking.Contact" required />
                    </div>

                    <div class="col-md-12">
                        <label class="fw-bold">Address</label>
                        <input type="text" class="form-control" asp-for="Booking.Address" required />
                    </div>

                    <!-- Booking Items (dynamic) -->
                    <div class="col-12">
                        <label class="fw-bold">Booking Items</label>
                        <div id="bookingItemsContainer"></div>

                        <div class="mt-2">
                            <button type="button" id="addBookingItemBtn" class="btn btn-outline-primary btn-sm" disabled>
                                + Add another species
                            </button>
                        </div>
                        <small class="text-muted d-block mt-1">
                            Add multiple plant type / species lines. Shared info (customer, address, booked by, state, district, advance) will apply to all.
                        </small>
                    </div>

                    <div class="col-md-6">
                        <label class="fw-bold">Booked By Whom</label>
                        <select class="form-select" id="bookedByDropdown" asp-for="Booking.BookedById" required>
                            <option value="">-- Select --</option>
                            @foreach (var employee in Model.Employees)
                            {
                                <option value="@employee.EmployeeID">@employee.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="fw-bold">State</label>
                        <select id="stateDropdown" class="form-select" asp-for="Booking.StateId" required>
                            <option value="">-- Select State --</option>
                            @foreach (var s in Model.States)
                            {
                                <option value="@s.StateId">@s.StateName</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="fw-bold">District</label>
                        <select id="districtDropdown" class="form-select" asp-for="Booking.DistrictId" required disabled>
                            <option value="">-- Select State First --</option>
                        </select>
                    </div>

                    <!-- Advance Taken -->
                    <div class="col-md-6">
                        <label class="fw-bold">Advance Taken</label>
                        <select id="advanceTakenDropdown" class="form-select" asp-for="Booking.AdvanceTaken">
                            <option value="false">No</option>
                            <option value="true">Yes</option>
                        </select>
                    </div>

                    <div class="col-md-6 advance-fields d-none">
                        <label class="fw-bold">Advance Amount</label>
                        <input type="text" class="form-control" id="advanceTakenAmount" />
                        <small class="text-muted" id="advanceAmountInWords"></small>
                        <input type="hidden" id="hiddenAdvanceAmountGlobal" />
                    </div>

                    <div class="col-md-12 advance-fields d-none">
                        <label class="fw-bold">Advance Transaction Details</label>
                        <input type="text" class="form-control" id="advanceTakenDetails" asp-for="Booking.AdvanceTakenDetails" />
                    </div>

                    <input type="hidden" asp-for="Booking.AddedBy" value="Auto" />
                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-success w-100 py-2">Submit</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Booking item template (hidden). Cloned by JS. -->
<div id="bookingItemTemplate" class="d-none">
    <div class="booking-item row g-2 align-items-end mb-2 p-2 border rounded">
        <div class="col-md-4">
            <label class="fw-bold">Plant Type</label>
            <select class="form-select plant-type-select" required>
                <option value="">-- Select --</option>
                @foreach (var type in Model.PlantTypes)
                {
                    <option value="@type.Id">@type.Name</option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label class="fw-bold">Species / Variety</label>
            <select class="form-select species-select" required>
                <option value="">-- Select a Plant Type First --</option>
            </select>
        </div>

        <div class="col-md-2">
            <label class="fw-bold">Quantity</label>
            <input type="text" class="form-control quantity-input" required />
            <small class="text-muted quantity-words"></small>
            <input type="hidden" class="line-hidden-quantity" />
        </div>

        <div class="col-md-2">
            <label class="fw-bold">Tentative Delivery</label>
            <input type="date" class="form-control delivery-input" required />
        </div>

        <div class="col-md-9 mt-2">
            <small class="availability-info text-muted"></small>
        </div>
        <div class="col-md-3 text-end mt-2">
            <button type="button" class="btn btn-danger btn-sm removeBookingItemBtn">Remove</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/sweetalert.js"></script>

    <script>
        $(function () {
            // ---- Helpers ----
            function formatNumberWithCommas(num) {
                return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
            }
            function numberToWords(num) {
                if (num === "" || isNaN(num) || num < 1) return "";
                var ones = ["","One","Two","Three","Four","Five","Six","Seven","Eight","Nine","Ten","Eleven","Twelve","Thirteen","Fourteen","Fifteen","Sixteen","Seventeen","Eighteen","Nineteen"];
                var tens = ["","","Twenty","Thirty","Forty","Fifty","Sixty","Seventy","Eighty","Ninety"];
                function conv(n){
                    if (n < 20) return ones[n];
                    if (n < 100) return tens[Math.floor(n/10)] + (n%10 ? " " + ones[n%10] : "");
                    if (n < 1000) return ones[Math.floor(n/100)] + " Hundred" + (n%100 ? " " + conv(n%100) : "");
                    if (n < 1000000) return conv(Math.floor(n/1000)) + " Thousand" + (n%1000 ? " " + conv(n%1000) : "");
                    return n;
                }
                return conv(num);
            }
            function showCustomAlert(title, text, icon, cb) {
                if (typeof swal === 'function') {
                    swal({ title: title, text: text, icon: icon }).then(function(){ if(cb) cb(); });
                } else { alert(title + ": " + text); if(cb) cb(); }
            }

            // ---------- Setup dynamic booking items ----------
            const container = $('#bookingItemsContainer');
            const template = $('#bookingItemTemplate .booking-item').clone();
            $('#bookingItemTemplate').remove();
            const addBtn = $('#addBookingItemBtn');

            function isLineComplete(line) {
                // checks: plantType, species, quantity (numeric >=1), deliveryDate
                const plant = line.find('.plant-type-select').val();
                const species = line.find('.species-select').val();
                const qty = parseInt(line.find('.line-hidden-quantity').val() || '', 10);
                const delivery = line.find('.delivery-input').val();
                return plant && species && !isNaN(qty) && qty >= 1 && delivery;
            }

            function updateAddButtonState() {
                // enable add only when the last booking-item is complete
                const last = container.find('.booking-item').last();
                if (last.length === 0) {
                    // if no lines, allow adding a first line
                    addBtn.prop('disabled', false);
                    return;
                }
                addBtn.prop('disabled', !isLineComplete(last));
            }

            // Phase C: Ready Stock availability per line (information only).
            const availabilityCache = {};
            function renderAvailability(line, a) {
                const el = line.find('.availability-info');
                const qty = parseInt(line.find('.line-hidden-quantity').val(), 10) || 0;
                const fmt = n => Number(n).toLocaleString('en-IN');
                let html = 'Ready Stock: ' + fmt(a.ready) + ' &middot; Already reserved: ' + fmt(a.reserved) + ' &middot; <strong>Available: ' + fmt(a.available) + '</strong>';
                if (qty > 0 && qty > a.available) {
                    html += ' <span class="badge bg-warning text-dark ms-1">Pre-booking &ndash; not reserved</span>';
                } else if (qty > 0) {
                    html += ' <span class="badge bg-info text-dark ms-1">Can be reserved after saving</span>';
                }
                el.html(html);
            }
            function showAvailability(line) {
                const speciesId = line.find('.species-select').val();
                const el = line.find('.availability-info');
                if (!speciesId) { el.html(''); return; }
                if (availabilityCache[speciesId]) { renderAvailability(line, availabilityCache[speciesId]); return; }
                $.get(window.basePath + 'Bookings/Book?handler=Availability&speciesId=' + speciesId, function (a) {
                    availabilityCache[speciesId] = a;
                    renderAvailability(line, a);
                });
            }

            function initLineHandlers(line) {
                // Plant -> species for this line
                line.find('.plant-type-select').on('change', function () {
                    const plantTypeId = $(this).val();
                    const speciesSelect = line.find('.species-select');
                    speciesSelect.empty();
                    if (!plantTypeId) {
                        speciesSelect.append('<option value="">-- Select a Plant Type First --</option>');
                        updateAddButtonState();
                        return;
                    }
                    $.get(window.basePath + 'Bookings/Book?handler=SpeciesByPlantType&plantTypeId=' + plantTypeId, function (data) {
                        speciesSelect.append('<option value="">-- Select --</option>');
                        $.each(data, function (i, s) {
                            speciesSelect.append('<option value="' + s.id + '">' + s.name + '</option>');
                        });
                        updateAddButtonState();
                    }).fail(function () {
                        speciesSelect.append('<option value="">-- Failed to load species --</option>');
                        updateAddButtonState();
                    });
                });

                // species change -> update add button
                line.find('.species-select').on('change', function () {
                    updateAddButtonState();
                    showAvailability(line);
                });

                // Quantity input handler for this line
                line.find('.quantity-input').on('input', function () {
                    let raw = $(this).val().replace(/,/g, "");
                    let n = parseInt(raw, 10);
                    const wordsEl = line.find('.quantity-words');
                    const hiddenEl = line.find('.line-hidden-quantity');
                    if (!isNaN(n)) {
                        if (n < 1) n = 1;
                        if (n > 999999) n = 999999;
                        $(this).val(formatNumberWithCommas(n));
                        wordsEl.text(numberToWords(n));
                        hiddenEl.val(n);
                    } else {
                        $(this).val('');
                        wordsEl.text('');
                        hiddenEl.val('');
                    }
                    updateAddButtonState();
                    showAvailability(line);
                });

                // delivery date change -> update add button
                line.find('.delivery-input').on('change input', function () {
                    updateAddButtonState();
                });

                // Remove button
                line.find('.removeBookingItemBtn').on('click', function () {
                    line.remove();
                    // After removal, ensure at least one line exists
                    if (container.find('.booking-item').length === 0) {
                        addBookingItem(); // create a fresh empty line
                    }
                    updateAddButtonState();
                });

                // also update add button if user focuses/leaves inputs (safety)
                line.find('input, select').on('blur', function () {
                    setTimeout(updateAddButtonState, 50);
                });
            }

            function addBookingItem(prefill) {
                const newLine = template.clone();
                if (prefill) {
                    if (prefill.plantTypeId) newLine.find('.plant-type-select').val(prefill.plantTypeId).trigger('change');
                    if (prefill.speciesId) {
                        // deferred set in case species dropdown needs ajax fill
                        setTimeout(function () {
                            newLine.find('.species-select').val(prefill.speciesId);
                            updateAddButtonState();
                        }, 300);
                    }
                    if (prefill.quantity) { newLine.find('.quantity-input').val(formatNumberWithCommas(prefill.quantity)).trigger('input'); }
                    if (prefill.deliveryDate) newLine.find('.delivery-input').val(prefill.deliveryDate);
                }
                container.append(newLine);
                initLineHandlers(newLine);
                // when user creates a new line, disable add button until this new line is complete
                updateAddButtonState();
            }

            // start with one booking line
            addBookingItem();

            // Add button click — guard against race or manual click when disabled
            addBtn.on('click', function () {
                if (addBtn.prop('disabled')) return;
                addBookingItem();
            });

            // ---------- State -> Districts (shared) ----------
            $('#stateDropdown').on('change', function () {
                const stateId = $(this).val();
                const district = $('#districtDropdown');
                district.prop('disabled', true).empty();

                if (!stateId) {
                    district.append('<option value="">-- Select State First --</option>');
                    return;
                }

                $.get(window.basePath + 'Bookings/Book?handler=DistrictsByState&stateId=' + stateId, function (data) {
                    district.append('<option value="">-- Select District --</option>');
                    $.each(data, function (_, d) {
                        district.append('<option value="' + d.districtId + '">' + d.districtName + '</option>');
                    });
                    district.prop('disabled', false);
                }).fail(function () {
                    district.append('<option value="">-- Failed to load districts --</option>');
                });
            });

            // ---------- Advance Taken toggle (shared) ----------
            $('#advanceTakenDropdown').change(function () {
                if ($(this).val() === "true") {
                    $('.advance-fields').removeClass('d-none');
                    $('#advanceTakenAmount').prop('required', true);
                    $('#advanceTakenDetails').prop('required', true);
                } else {
                    $('.advance-fields').addClass('d-none');
                    $('#advanceTakenAmount').prop('required', false).val('');
                    $('#advanceAmountInWords').text('');
                    $('#hiddenAdvanceAmountGlobal').val('');
                    $('#advanceTakenDetails').prop('required', false).val('');
                }
            });

            // shared advance amount input -> update hidden global
            $('#advanceTakenAmount').on('input', function () {
                let raw = $(this).val().replace(/,/g, "");
                let n = parseInt(raw, 10);
                if (!isNaN(n)) {
                    if (n < 1) n = 1;
                    if (n > 999999) n = 999999;
                    $(this).val(formatNumberWithCommas(n));
                    $('#advanceAmountInWords').text(numberToWords(n));
                    $('#hiddenAdvanceAmountGlobal').val(n);
                } else {
                    $(this).val('');
                    $('#advanceAmountInWords').text('');
                    $('#hiddenAdvanceAmountGlobal').val('');
                }
            });

            // ---------- Submit multiple requests (one per booking item) ----------
            $('#directBookingForm').on('submit', function (event) {
                event.preventDefault();

                // Validate shared fields
                if (!$('#stateDropdown').val()) {
                    showCustomAlert("Error", "State is required.", "error");
                    return;
                }
                if (!$('#districtDropdown').val()) {
                    showCustomAlert("Error", "District is required.", "error");
                    return;
                }
                if (!$('#bookedByDropdown').val()) {
                    showCustomAlert("Error", "Please select who booked this.", "error");
                    return;
                }

                // Advance validation (shared)
                const advanceTaken = $('#advanceTakenDropdown').val();
                const advanceAmount = $('#hiddenAdvanceAmountGlobal').val();
                const advanceDetails = $('#advanceTakenDetails').val();
                if (advanceTaken === "true") {
                    if (!advanceAmount || parseInt(advanceAmount, 10) <= 0) {
                        showCustomAlert("Error", "Advance Amount must be greater than zero.", "error");
                        return;
                    }
                    if (!advanceDetails || !advanceDetails.trim()) {
                        showCustomAlert("Error", "Advance Details are required when Advance Taken is Yes.", "error");
                        return;
                    }
                }

                // Collect line items
                const lines = [];
                container.find('.booking-item').each(function () {
                    const line = $(this);
                    const plantTypeId = line.find('.plant-type-select').val();
                    const speciesId = line.find('.species-select').val();
                    const quantity = line.find('.line-hidden-quantity').val();
                    const deliveryDate = line.find('.delivery-input').val();

                    lines.push({ plantTypeId, speciesId, quantity, deliveryDate });
                });

                if (lines.length === 0) {
                    showCustomAlert("Error", "Please add at least one booking item.", "error");
                    return;
                }

                // Validate each line
                for (let i = 0; i < lines.length; i++) {
                    const L = lines[i];
                    if (!L.plantTypeId) { showCustomAlert("Error", "Plant Type is required for each item.", "error"); return; }
                    if (!L.speciesId) { showCustomAlert("Error", "Species is required for each item.", "error"); return; }
                    if (!L.quantity || parseInt(L.quantity, 10) < 1) { showCustomAlert("Error", "Quantity must be at least 1 for each item.", "error"); return; }
                    if (!L.deliveryDate) { showCustomAlert("Error", "Delivery date is required for each item.", "error"); return; }
                }

                // Get antiforgery token
                const antiToken = $('input[name="__RequestVerificationToken"]').val();

                // Build shared form fields
                const shared = {
                    CustomerName: $('input[name="Booking.CustomerName"]').val(),
                    Contact: $('input[name="Booking.Contact"]').val(),
                    Address: $('input[name="Booking.Address"]').val(),
                    BookedById: $('#bookedByDropdown').val(),
                    StateId: $('#stateDropdown').val(),
                    DistrictId: $('#districtDropdown').val(),
                    AdvanceTaken: $('#advanceTakenDropdown').val(),
                    AdvanceTakenAmount: $('#hiddenAdvanceAmountGlobal').val(),
                    AdvanceTakenDetails: $('#advanceTakenDetails').val(),
                    AddedBy: $('input[name="Booking.AddedBy"]').val()
                };

                // Prepare and send one POST per line.
                // IMPORTANT: apply advance only to first booking (index 0). For others send AdvanceTaken=false and AdvanceTakenAmount=0 and empty details.
                const promises = lines.map(function (L, idx) {
                    // for first booking include advance, else zero it out
                    const advanceForThisLine = (idx === 0 && shared.AdvanceTaken === "true");
                    const payload = {
                        "__RequestVerificationToken": antiToken,
                        "Booking.PlantId": L.plantTypeId,
                        "Booking.SpeciesId": L.speciesId,
                        "Booking.Quantity": L.quantity,
                        "Booking.DeliveryDate": L.deliveryDate,
                        "Booking.CustomerName": shared.CustomerName,
                        "Booking.Contact": shared.Contact,
                        "Booking.Address": shared.Address,
                        "Booking.BookedById": shared.BookedById,
                        "Booking.StateId": shared.StateId,
                        "Booking.DistrictId": shared.DistrictId,
                        // advance fields: only first line carries the advance if advanceTaken true
                        "Booking.AdvanceTaken": advanceForThisLine ? "true" : "false",
                        "Booking.AdvanceTakenAmount": advanceForThisLine ? shared.AdvanceTakenAmount : 0,
                        "Booking.AdvanceTakenDetails": advanceForThisLine ? shared.AdvanceTakenDetails : "",
                        "Booking.AddedBy": shared.AddedBy
                    };

                    return $.post('@Url.Page("/Bookings/Book")', payload);
                });

                // Show a loading message
                showCustomAlert("Please wait", "Submitting bookings...", "info");

                // Wait for all to finish
                $.when.apply($, promises)
                    .done(function () {
                        showCustomAlert("Success", "All bookings submitted successfully.", "success", function () { location.reload(); });
                    })
                    .fail(function () {
                        showCustomAlert("Error", "One or more bookings failed. Please check and retry.", "error");
                    });
            });
        });
    </script>
}
