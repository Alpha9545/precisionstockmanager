@page
@model PlantStockManager.Pages.Bookings.FulfillBookingModel
@using System.Globalization

@{
    ViewData["Title"] = "Fulfill Booking Order";
}

@functions {
    private static string ToTitle(string s)
    {
        if (string.IsNullOrWhiteSpace(s)) return s;
        s = s.ToLowerInvariant();
        return CultureInfo.CurrentCulture.TextInfo.ToTitleCase(s);
    }
}
<style>
     .table-scroll-container {
        max-height: 60vh;
        overflow-y: auto;
        overflow-x: hidden; /* ⛔️ Hide horizontal scroll */
        border: 1px solid #dee2e6;
        border-radius: 0.35rem;
        box-shadow: 0 0.15rem 0.4rem rgba(0,0,0,0.08);
    }

    table.table {
        width: 100%;
        table-layout: fixed; /* 🔒 Fix layout for clean fit */
        border-collapse: collapse;
    }

    .table th,
    .table td {
        padding: 0.5rem;
        font-size: 0.875rem;
        text-align: center;
        white-space: normal; /* 🌀 Allow wrapping */
        word-wrap: break-word;
    }

    .table thead th {
        position: sticky;
        top: 0;
        background-color: #f8f9fa;
        z-index: 2;
        box-shadow: 0 2px 2px -1px rgba(0,0,0,0.1);
    }

    /* Optional: Responsive adjustments on smaller screens */
    @@media (max-width: 768px) {
        .table th, .table td {
            font-size: 0.75rem;
            padding: 0.4rem;
        }
    }

    .status-row {
        background: #f8f9fa;
        padding: 0.75rem 1.25rem;
        border-top: 1px solid #dee2e6;
        position: sticky;
        bottom: 0;
        z-index: 3;
    }

    .modal-summary-table th {
        white-space: nowrap;
    }

    .spinner-border {
        vertical-align: middle;
    }
</style>


@{
    var backUrl = Model.From == "direct"
        ? "/Bookings/DirectBookinglist"
        : "/Bookings/Bookinglist";
}


@{
    // Month mapping for batch code
    Dictionary<int, string> monthCodes = new Dictionary<int, string>
    {
        {1, "A"}, {2, "B"}, {3, "C"}, {4, "D"}, {5, "E"}, {6, "F"},
        {7, "G"}, {8, "H"}, {9, "I"}, {10, "J"}, {11, "K"}, {12, "L"}
    };
}

<div class="container-fluid">
    <div class="card border-0 shadow-lg">
        <div class="card-body p-2">
            <div class="alert alert-info mb-2 py-2">
                <div class="row g-4 flex-wrap">
                    <div class="col-md-auto col-12">
                        <strong class="me-1">Customer:</strong>
                        <span class="text-dark">@Model.Booking.CustomerName</span>
                    </div>
                    <div class="col-md-auto col-12">
                        <strong class="me-1">Plant:</strong>
                        <span class="text-dark">@Model.Booking.PlantName</span>
                    </div>
                    <div class="col-md-auto col-12">
                        <strong class="me-1">Species:</strong>
                        <span class="text-dark">@Model.Booking.SpeciesName</span>
                    </div>
                    <div class="col-md-auto col-12">
                        <strong class="me-1">Booked Quantity:</strong>
                        <span class="text-dark">@Model.Booking.Quantity</span>
                    </div>
                    <div class="col-md-auto col-12">
                        <strong class="me-1">Delivery:</strong>
                        <span class="text-dark">@Model.Booking.TentativeDeliveryDate.ToString("d")</span>
                    </div>
                </div>
            </div>

            @if (Model.InventoryItems.Count == 0)
            {
                <div class="alert alert-warning mb-4">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    No available inventory found for this plant type!
                </div>
            }
            else
            {
                <div class="alert alert-secondary d-md-flex justify-content-around align-items-center py-1">
                    <div class="mb-2 mb-md-0">
                        <i class="fas fa-box-open me-2"></i>
                        Total Available <span class="text-dark">@Model.Booking.PlantName</span>: <strong>@Model.TotalAvailable</strong>
                    </div>
                    <div>
                        <i class="fas fa-bullseye me-2"></i>
                        Required Quantity: <strong>@Model.Booking.Quantity</strong>
                    </div>
                </div>

                <form method="post" id="allocationForm">
                    <input type="hidden" name="From" value="@Model.From" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                   <div class="mb-3 d-flex align-items-center" style="max-width: 300px;">
  <label for="actualBookingDate" 
         class="form-label fw-bold small me-2 mb-0">
    Actual Delivery Date
  </label>
  <input 
    type="date" 
    class="form-control form-control-sm flex-shrink-1" 
    id="actualBookingDate" 
    name="ActualBookingDate"
    value="@DateTime.Today.ToString("yyyy-MM-dd")"
    required 
    style="width: auto;" />
</div>


                    
                    <div class="table-scroll-container">
                        <table class="table table-hover align-middle mb-0" >
                            <thead class="thead-light">
                                <tr>
                                    <th style="min-width: 100px">Sowing Id</th>
                                    <th style="min-width: 220px">Species</th>
                                    <th style="min-width: 220px">Polyhouse</th>
                                    <th style="min-width: 140px">Batch</th>
                                    <th style="min-width: 140px">Available</th>
                                    <th style="min-width: 140px">Location</th>
                                    <th style="min-width: 140px">Stock Ready On</th>
                                    <th style="min-width: 260px">Allocate Quantity</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int index = 0;
                                    foreach (var item in Model.InventoryItems)
                                    {
                                        var batchNo = $"{item.SeedingDate.Day}-{monthCodes[item.SeedingDate.Month]}";
                                        <tr>
                                            <td>@item.SeedEntryId</td>
                                            <td class="ps-3">
                                                @ToTitle(item.SpeciesName)
                                                <input type="hidden"
                                                       asp-for="Allocations[index].InventoryId"
                                                       value="@item.InventoryId" />
                                            </td>
                                            <td>@ToTitle(item.PolyhouseName)</td>
                                            <td class="text-info fw-bold">@batchNo</td>
                                            <td>@item.AvailableQuantity</td>
                                            <td>@ToTitle(item.LocationDesc)</td>
                                            <td>@item.AddedOn.ToString("d")</td>
                                            <td style="width: 240px">
                                                <div class="input-group ">
                                                    <input asp-for="Allocations[index].QuantityToUse"
                                                           class="form-control allocate-qty py-2"
                                                           type="number"
                                                           min="0"
                                                           max="@item.AvailableQuantity"
                                                           data-available="@item.AvailableQuantity" data-inventory="@item.InventoryId" />
                                                    <span class="input-group-text bg-light">
                                                        / @item.AvailableQuantity
                                                    </span>
                                                </div>
                                                <span asp-validation-for="Allocations[index].QuantityToUse"
                                                      class="text-danger small"></span>
                                            </td>
                                        </tr>
                                        index++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-4 gap-3">
                        <div class="order-2 order-md-1">
                            <a asp-page="@backUrl" class="btn btn-outline-secondary btn-lg px-4">
                                <i class="fas fa-arrow-left me-2"></i>Back
                            </a>
                            <button type="button" class="btn btn-success btn-lg px-4 ms-2" id="confirmButton">
                                <i class="fas fa-check-circle me-2"></i>Confirm
                            </button>
                        </div>
                        <div class="order-1 order-md-2">
                            <span class="badge bg-primary fs-6 p-3">
                                Remaining To Allocate: <span id="remainingCount" class="fw-bold">@Model.Booking.Quantity</span>
                            </span>
                        </div>
                    </div>
                </form>

                <!-- Confirmation Modal -->
                <div class="modal fade" id="confirmationModal" tabindex="-1" aria-labelledby="confirmationModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <div class="modal-header bg-light">
                                <h5 class="modal-title" id="confirmationModalLabel">Confirm Allocation</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="row mb-4">
                                    <div class="col-md-6">
                                        <h6 class="text-muted">Order Details:</h6>
                                        <ul class="list-unstyled">
                                            <li><strong>Name:</strong> @Model.Booking.CustomerName</li>
                                            <li><strong>Plant:</strong> @Model.Booking.PlantName</li>
                                            <li><strong>Species:</strong> @Model.Booking.SpeciesName</li>
                                        </ul>
                                    </div>
                                    <div class="col-md-6">
                                        <h6 class="text-muted"> </h6>
                                        <ul class="list-unstyled">
                                            <li><strong>Total Booked Quantity:</strong> @Model.Booking.Quantity</li>
                                            <li><strong>Delivery Date:</strong> @Model.Booking.TentativeDeliveryDate.ToString("dd-MMM-yy")</li>
                                            @* <li>
                                                <strong>Allocating Date:</strong> <span id="allocationDate">
                                                    @DateTime.Today.ToString("dd-MMM-yy")
                                                </span>
                                            </li> *@
                                            <li><strong>Actual Delivery Date:</strong> <span id="allocationDateDisplay"></span></li>

                                        </ul>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table class="table table-bordered modal-summary-table">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Species</th>
                                                <th>Polyhouse</th>
                                                <th>Batch</th>
                                                <th>Available</th>
                                                <th>Location</th>
                                                <th>Stock Ready On</th>
                                                <th>Allocated</th>
                                            </tr>
                                        </thead>
                                        <tbody id="allocationSummaryBody">
                                            <!-- JavaScript will populate this -->
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="button" class="btn btn-primary" id="finalConfirmButton">
                                    <i class="fas fa-print me-2"></i>Final Submit & Print
                                    <span id="loadingSpinner" class="spinner-border spinner-border-sm ms-2 d-none"></span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const requiredTotal = @Model.Booking.Quantity;
            const inputs = document.querySelectorAll('.allocate-qty');
            const remainingDisplay = document.getElementById('remainingCount');

            // Initialize input tracking
            inputs.forEach(input => input.dataset.lastValid = input.value || "0");

            function updateLimits() {
                let totalAllocated = 0;
                inputs.forEach(input => {
                    const available = parseInt(input.dataset.available, 10);
                    const current = parseInt(input.value, 10) || 0;
                    let otherAllocations = 0;

                    inputs.forEach(otherInput => {
                        if (otherInput !== input) {
                            otherAllocations += parseInt(otherInput.value, 10) || 0;
                        }
                    });

                    const remainingForTotal = requiredTotal - otherAllocations;
                    const maxPossible = Math.min(available, remainingForTotal);
                    input.max = maxPossible;
                    input.title = `Max allocation: ${maxPossible}`;

                    if (current > maxPossible) {
                        input.value = maxPossible;
                    }
                    totalAllocated += parseInt(input.value, 10) || 0;
                });

                remainingDisplay.textContent = ` ${requiredTotal - totalAllocated}`;
            }

            // Input validation and events
            inputs.forEach(input => {
                input.addEventListener('input', function() {
                    this.value = this.value.replace(/[^0-9]/g, '');
                    let sumOther = 0;
                    inputs.forEach(otherInput => {
                        if (otherInput !== this) {
                            sumOther += parseInt(otherInput.value, 10) || 0;
                        }
                    });

                    const available = parseInt(this.dataset.available, 10);
                    const remainingForTotal = requiredTotal - sumOther;
                    const allowedForThis = Math.min(available, remainingForTotal);
                    let current = parseInt(this.value, 10) || 0;

                    if (current > available) {
                        alert("Exceeding Batch Quantity!");
                        this.value = this.dataset.lastValid;
                    } else if (current > remainingForTotal) {
                        alert("Exceeding requested total Booked quantity!");
                        this.value = this.dataset.lastValid;
                    } else {
                        this.dataset.lastValid = this.value;
                    }

                    updateLimits();
                });

                input.addEventListener('change', function() {
                    const current = parseInt(this.value, 10) || 0;
                    const maxAllowed = parseInt(this.max, 10) || 0;
                    if (current > maxAllowed) {
                        this.value = maxAllowed;
                        updateLimits();
                    }
                });
            });

            // Modal handling
            document.getElementById('confirmButton').addEventListener('click', function() {
                if (document.getElementById('allocationForm').checkValidity()) {
                    const allocationRows = [];
                    let totalAllocated = 0;

                    document.querySelectorAll('tbody tr').forEach(row => {
                        const cells = row.cells;
                        const allocatedInput = row.querySelector('.allocate-qty');
                         if (!allocatedInput) return;
                        const allocatedQty = parseInt(allocatedInput.value) || 0;

                        if (allocatedQty > 0) {
                            allocationRows.push(`
                                <tr>
                                    <td>${cells[1].textContent.trim()}</td>
                                    <td>${cells[2].textContent.trim()}</td>
                                    <td>${cells[3].textContent.trim()}</td>
                                    <td>${cells[4].textContent.trim()}</td>
                                     <td>${cells[5].textContent.trim()}</td>
                                      <td>${cells[6].textContent.trim()}</td>
                                    <td>${allocatedQty}</td>
                                </tr>
                            `);
                            totalAllocated += allocatedQty;
                        }
                    });

                     if(totalAllocated === 0) {
                          alert("Please allocate a quantity before confirming!");
                           return;
                       }

                    document.querySelector('#allocationSummaryBody').innerHTML = allocationRows.join('');
                   const actualBookingDate = document.getElementById('actualBookingDate').value;

const formattedDate = new Date(actualBookingDate).toLocaleDateString('en-GB', {
    day: '2-digit',
    month: 'long',
    year: '2-digit'
}).replace(/ /g, '-');

document.getElementById('allocationDateDisplay').textContent = formattedDate;


                    // document.getElementById('allocationDate').textContent = new Date().toLocaleDateString();
                    new bootstrap.Modal(document.getElementById('confirmationModal')).show();
                } else {
                    document.getElementById('allocationForm').reportValidity();
                }
            });

                   document.getElementById('finalConfirmButton').addEventListener('click', function() {
            const form = document.getElementById('allocationForm');
            const formData = new FormData(form);
const actualBookingDate = document.getElementById('actualBookingDate').value;
formData.append('ActualBookingDate', actualBookingDate);

            const spinner = document.getElementById('loadingSpinner');
            const submitButton = this;
            const modal = new bootstrap.Modal(document.getElementById('confirmationModal'));

            // Show spinner and disable button
            spinner.classList.remove('d-none');
            submitButton.disabled = true;

            fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            })
            .then(response => {
                if (response.ok) return response.json();
                return response.json().then(err => { throw err; });
            })
            .then(data => {
                if (data.success) {
                    // Keep modal open and trigger print
                   

                    window.print();
                    // Redirect after print
                    setTimeout(() => { window.location.href = data.redirectUrl; }, 500);
                } else if (data.redirectUrl) {
                    window.location.href = data.redirectUrl;
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert(`Error: ${error.error || error.message}`);
                modal.hide();
            })
            .finally(() => {
                spinner.classList.add('d-none');
                submitButton.disabled = false;
            });
        });

            // Initial setup
            updateLimits();
        });
    </script>
}

    <style>
        @@media print {
            body *

        {
            visibility: hidden;
        }

        .modal, .modal * {
            visibility: visible;
        }

        .modal {
            position: absolute;
            left: 0;
            top: 0;
            margin: 0;
            padding: 20px;
            width: 100%;
            min-height: 100vh;
        }

        .modal-dialog {
            max-width: 100%;
            margin: 0;
        }

        .modal-content {
            border: none;
            box-shadow: none;
        }

        .modal-header, .modal-footer {
            display: none !important;
        }

        }
    </style>