@page
@model PlantStockManager.Pages.SeedEntry.SampleModel
@Html.AntiForgeryToken()
@{
    ViewData["Title"] = "Plant Progress Tracker";
}

<style>
    .main-container {
       /*  height: calc(100vh - 150px); */ /* Adjust based on your header/footer height */
        overflow-y: auto;
        min-height:750px;
    }

    .table-container {
       
    }

    .fixed-header {
        position: sticky;
        top: 0;
        background: white;
        z-index: 10;
    }

    /* .progress-column {
        min-width: 250px;
    }

    .action-column {
        min-width: 150px;
    } */
</style>

@{
    // Month mapping for batch code
    Dictionary<int, string> monthCodes = new Dictionary<int, string>
    {
        {1, "A"}, {2, "B"}, {3, "C"}, {4, "D"}, {5, "E"}, {6, "F"},
        {7, "G"}, {8, "H"}, {9, "I"}, {10, "J"}, {11, "K"}, {12, "L"}
    };
}

<div class="p-2" >

    <div class="container-fluid h-100">
        <div class="row fixed-header  bg-light pb-2 border-bottom mb-1">
            <div class="col">
                <h2 class="mb-0">Plant Growth Tracker</h2>
            </div>
        </div>

        <div class="row main-container">
            <div class="col-12 ">
                <div class="card shadow table-container">
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0" style="font-size: 0.875rem;">
                            <thead class=" fixed-header" style=" background-color: #c8e6c9;">
                                <tr>
                                    <th>Polyhouse</th>
                                    <th>Plant</th>
                                    <th>Species</th>
                                    <th>Planting Date</th>
                                    <th>Batch</th>
                                    <th>Planted</th>
                                    <th>Days Passed</th>
                                    <th>Status</th>
                                    <th>Progress</th>
                                    <th>Current Stage</th>
                                    <th>Actions</th>
                                    <th>Ready Stock</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.SeedEntries)
                                {
                                    var batchNo = $"{item.SeedingDate.Day}-{monthCodes[item.SeedingDate.Month]}";
                                    <tr class="align-middle">
                                        <td>@item.PolyhouseName</td>
                                        <td>@item.PlantTypeName</td>
                                        <td>@item.SpeciesName</td>
                                        <td>@item.SeedingDate.ToString("dd-MMM-yyyy")</td>
                                        <td class="text-info fw-bold">@batchNo</td>
                                        <td>@item.SeedsPlanted</td>
                                        <td>@item.DaysPassed</td>
                                        <td>@(item.DaysPassed >= 21 ? "🔴 Critical" : item.DaysPassed >= 18 ? "🟡 Warning" : "🟢 Normal")</td>
                                        <td style="width: 20%">
                                            <div class="progress" style="height: 25px;">
                                                <div class="progress-bar progress-bar-striped"
                                                     role="progressbar"
                                                     style="width: @Model.GetProgressWidth(item)"
                                                     aria-valuenow="@item.SeedsPlanted"
                                                     aria-valuemin="0"
                                                     aria-valuemax="@item.SeedsPlanted">
                                                    @item.CurrentStage
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="@Model.GetStageBadgeClass(item.CurrentStage, item.CurrentStage)">
                                                @item.CurrentStage
                                            </span>
                                        </td>
                                        <td>
                                            @if (item.CurrentStage != "Inventory")
                                            {
                                                <button class="btn btn-sm btn-outline-primary"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#stageModal"
                                                        data-id="@item.Id"
                                                        data-stage="@item.CurrentStage"
                                                        data-current="@(Model.GetCurrentCount(item))">
                                                    <i class="fas fa-arrow-right me-2"></i>Next Stage
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Completed</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.AliveCount > 0)
                                            {
                                                <span>@item.AliveCount</span>
                                            }

                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <input name="__RequestVerificationToken" type="hidden" value="CfDJ8sfdasfassafsafsajl^(&(&(&(*&)ekjhkbfsdfhkjfs" />
    </div>
</div>

<!-- Progress Modal -->
<div class="modal fade" id="stageModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Update Plant Progress</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="stageForm">
                    <input type="hidden" id="seedEntryId">
                    <input type="hidden" id="targetStage">
                    
                    <div class="mb-3">
                        <label class="form-label">Previous Stage Count</label>
                        <input type="number" class="form-control" id="previousCount" readonly>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label"> Plants For <span id="stageLabel"></span></label>
                        <input type="number" class="form-control" id="aliveCount" 
                               min="0" required>
                        <div class="form-text text-danger" id="countError"></div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveStage">Save Progress</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Modal initialization
        const stageModal = document.getElementById('stageModal');
        stageModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const seedId = button.getAttribute('data-id');
            const currentStage = button.getAttribute('data-stage');
            const currentCount = button.getAttribute('data-current');

            const modal = this;
            modal.querySelector('#seedEntryId').value = seedId;
            modal.querySelector('#previousCount').value = currentCount;
            modal.querySelector('#stageLabel').textContent = getNextStage(currentStage);
            modal.querySelector('#targetStage').value = getNextStage(currentStage);

                    // Remove `inert` so the modal is accessible
            modal.removeAttribute('inert');
            
            // Reset validation
            modal.querySelector('#aliveCount').classList.remove('is-invalid');
            modal.querySelector('#countError').textContent = '';
        });

        function getNextStage(currentStage) {
            const stages = ['Sowing', 'Trays', 'Hardening', 'Inventory'];
            const currentIndex = stages.indexOf(currentStage);
            return stages[currentIndex + 1] || 'Inventory';
        }

        // Save handler
        document.getElementById('saveStage').addEventListener('click', async () => {
            const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
                if (!tokenElement) {
                       alert('Security token missing!');
                        return;
              }

             
            const formData = new FormData();
            const aliveCount = Number(document.getElementById('aliveCount').value);
            const previousCount = Number(document.getElementById('previousCount').value);

            if (!aliveCount || aliveCount <= 0 || aliveCount > previousCount) {
                document.getElementById('aliveCount').classList.add('is-invalid');
                document.getElementById('countError').textContent = 
                    `Alive count must be between 1 and ${previousCount}`;
                return;
            }

            formData.append('seedEntryId', document.getElementById('seedEntryId').value);
            formData.append('aliveCount', aliveCount);
            formData.append('nextStage', document.getElementById('targetStage').value);

            try {
                
                const response = await fetch('/SeedEntry/GrowthTracker?handler=UpdateStage', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': tokenElement.value
                    }
                });

                if (!response.ok) throw new Error(await response.text());

                const result = await response.json();
                if (result.success) {
                    bootstrap.Modal.getInstance(stageModal).hide();

                     // ✅ Remove focus before hiding
                    document.activeElement.blur();
 
                      // ✅ Set `inert` before hiding
                    stageModal.setAttribute('inert', 'true');

                    location.reload();
                } else {
                    alert(`Error: ${result.message}`);
                }
            } catch (error) {
                alert(`Operation failed: ${error.message}`);
                console.error('Error:', error);
            }
        });

                stageModal.addEventListener('hidden.bs.modal', function () {
            // Ensure `inert` is set when the modal is fully hidden
            stageModal.setAttribute('inert', 'true');

            // Ensure no lingering focus issues
            document.activeElement.blur();
        });
    </script>

    <style>
        .progress-bar {
            transition: width 0.5s ease-in-out;
        }
        .badge {
            font-size: 0.9em;
            padding: 0.5em 0.75em;
        }
        .table-hover tbody tr:hover {
            background-color: #f8f9fa;
        }
    </style>
}