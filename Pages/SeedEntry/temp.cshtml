        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title">🌱 Update Plant Progress</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <!-- Details Section -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label text-muted">Batch ID</label>
                                            <div class="fw-bold" id="detailBatchId">-</div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label text-muted">Polyhouse</label>
                                            <div class="fw-bold" id="detailPolyhouse">-</div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label text-muted">Plant</label>
                                            <div class="fw-bold" id="detailPlant">-</div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label text-muted">Variety</label>
                                            <div class="fw-bold" id="detailVariety">-</div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label text-muted">Planting Date</label>
                                            <div class="fw-bold" id="detailPlantingDate">-</div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label text-muted">Days Passed</label>
                                            <div class="fw-bold" id="detailDaysPassed">-</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Stage History -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0">📜 Stage History</h6>
                                </div>
                                <div class="card-body">
                                    <div class="row g-4">
                                        <div class="col-md-3">
                                            <label class="form-label text-muted">Sowing</label>
                                            <div class="small">
                                                <span id="detailSowingCount" class="badge bg-info me-2">-</span>
                                                <span id="detailSowingDate">-</span>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label text-muted">Trays</label>
                                            <div class="small">
                                                <span id="detailTraysCount" class="badge bg-info me-2">-</span>
                                                <span id="detailTraysDate">-</span>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label text-muted">Hardening</label>
                                            <div class="small">
                                                <span id="detailHardeningCount" class="badge bg-info me-2">-</span>
                                                <span id="detailHardeningDate">-</span>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label text-muted">Inventory</label>
                                            <div class="small">
                                                <span id="detailInventoryCount" class="badge bg-info me-2">-</span>
                                                <span id="detailInventoryDate">-</span>
                                            </div>
                                        </div>
                                    </div>
                                    @* <div class="col-md-12 mt-2 ">
                                        <label class="form-label text-muted">Location</label>
                                        <div class="fw-bold small" id="detailInventoryLocation">-</div>
                                    </div> *@
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Progress Form -->
                    <form id="stageForm">
                        <div class="card border-primary shadow">
                            <div class="card-header bg-primary text-white">
                                <h6 class="mb-0">➡️ Progress to Next Stage</h6>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <input type="hidden" id="seedEntryId">
                                    <input type="hidden" id="targetStage">

                                    <div class="col-md-6">
                                        <label class="form-label">Previous Stage Count</label>
                                        <input type="number" class="form-control" id="previousCount" readonly>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">Plants for <span id="stageLabel"></span></label>
                                        <input type="number" class="form-control" id="aliveCount" min="1" required>
                                        <div class="form-text text-danger" id="countError"></div>
                                    </div>

                                    <div class="col-md-12">
                                        <label class="form-label">Stage Date for <span id="stageLabelDate"></span></label>
                                        <input type="date" class="form-control" id="stageDate" required>
                                        <div class="form-text text-danger" id="dateError"></div>
                                    </div>
                                    <div class="col-md-12" id="locationField" style="display: none;">
                                        <label class="form-label">Storage Location/Destination</label>
