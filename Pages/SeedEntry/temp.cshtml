</div>
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="successToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
            <strong class="me-auto">Notification</strong>
            <small>Just now</small>
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body">
            Stage updated successfully!
        </div>
    </div>
</div>



@section Scripts {
    <script>
        // Initialize modal instance properly
        const stageModalElement = document.getElementById('stageModal');
        let stageModalInstance = null;

        // Create modal instance once
        if (stageModalElement) {
            stageModalInstance = new bootstrap.Modal(stageModalElement, {
                backdrop: 'static',
                keyboard: false
            });
        }
         function showToast(message) {
            const toastEl = document.getElementById('successToast');
            // Update the message if needed
            toastEl.querySelector('.toast-body').textContent = message;
            const toast = new bootstrap.Toast(toastEl);
            toast.show();
        }
        stageModalElement.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const modal = this;
           
            // Get core data from button attributes
            const seedId = button.getAttribute('data-id');
            const currentStage = button.getAttribute('data-stage');
            const currentCount = button.getAttribute('data-current');
                 const nextStage = getNextStage(currentStage);

        // Toggle view/edit mode
        if (nextStage) {
            modal.querySelector('.modal-title').textContent = '🌱 Update Plant Progress';
            document.getElementById('stageForm').style.display = 'block';
            document.getElementById('saveStage').style.display = 'block';
        } else {
            modal.querySelector('.modal-title').textContent = '🌱 View Plant Progress';
            document.getElementById('stageForm').style.display = 'none';
            document.getElementById('saveStage').style.display = 'none';
        }

            const locationField = modal.querySelector('#locationField');
        const locationInput = modal.querySelector('#location');
        if (nextStage === 'Inventory') {
            locationField.style.display = 'block';
            locationInput.required = true;
        } else {
            locationField.style.display = 'none';
            locationInput.required = false;
        }

                if (currentStage === 'Inventory') {
            modal.querySelector('#location').value = button.dataset.inventoryLocation || '';
           }

            // Set hidden inputs and previous count
            modal.querySelector('#seedEntryId').value = seedId;
            modal.querySelector('#previousCount').value = currentCount;
            modal.querySelector('#targetStage').value = getNextStage(currentStage);

            // Set labels and visual elements
            modal.querySelector('#stageLabel').textContent = getNextStage(currentStage);
            modal.querySelector('#stageLabelDate').textContent = getNextStage(currentStage);

            // Populate informational details
            modal.querySelector('#detailBatchId').textContent = seedId;
            modal.querySelector('#detailPolyhouse').textContent = button.dataset.polyhouse;
            modal.querySelector('#detailPlant').textContent = button.dataset.plant;
            modal.querySelector('#detailVariety').textContent = button.dataset.variety;
            modal.querySelector('#detailPlantingDate').textContent = button.dataset.plantingDate;
            modal.querySelector('#detailDaysPassed').textContent = `${button.dataset.daysPassed} days`;

            // Stage history population
            modal.querySelector('#detailSowingCount').textContent = button.dataset.sowingCount;
            modal.querySelector('#detailSowingDate').textContent = formatDate(button.dataset.sowingDate);
            modal.querySelector('#detailTraysCount').textContent = button.dataset.traysCount || '-';
            modal.querySelector('#detailTraysDate').textContent = formatDate(button.dataset.traysDate);
            modal.querySelector('#detailHardeningCount').textContent = button.dataset.hardeningCount || '-';
            modal.querySelector('#detailHardeningDate').textContent = formatDate(button.dataset.hardeningDate);
                 modal.querySelector('#detailInventoryCount').textContent = button.dataset.inventoryCount || '-';
           modal.querySelector('#detailInventoryDate').textContent = formatDate(button.dataset.inventoryDate);
           
            //modal.querySelector('#detailInventoryLocation').textContent = button.dataset.inventoryLocation || '-';

            // Date handling
            const previousDate = getPreviousStageDate(button, currentStage);
            const dateInput = modal.querySelector('#stageDate');
            dateInput.min = previousDate;
            dateInput.value = getDefaultDate(previousDate);
        });

        // Helper functions
        function getNextStage(currentStage) {
            const stages = ['Sowing', 'Trays', 'Hardening', 'Inventory'];
                const currentIndex = stages.indexOf(currentStage);
        return currentIndex < stages.length - 1 ? stages[currentIndex + 1] : null;
        }

        function formatDate(isoDate) {
            if (!isoDate) return '-';
            const date = new Date(isoDate);
            return date.toLocaleDateString('en-GB', {
                day: '2-digit',
                month: 'short',
                year: 'numeric'
            });
        }

        function getPreviousStageDate(button, currentStage) {
            switch(currentStage) {
                case 'Sowing': return button.dataset.sowingDate;
                case 'Trays': return button.dataset.traysDate || button.dataset.sowingDate;
                case 'Hardening': return button.dataset.hardeningDate || button.dataset.traysDate || button.dataset.sowingDate;
                default: return new Date().toISOString().split('T')[0];
            }
        }

        function getDefaultDate(previousDate) {
            const today = new Date().toISOString().split('T')[0];
            return today > previousDate ? today : previousDate;
        }

        // Save handler
        document.getElementById('saveStage').addEventListener('click', async () => {
            // Clear previous errors
            document.getElementById('countError').textContent = '';
            document.getElementById('dateError').textContent = '';
           
                 const nextStage = document.getElementById('targetStage').value;
        if (nextStage === 'Inventory') {
            const locationValue = document.getElementById('location').value.trim();
            if (!locationValue) {
                document.getElementById('locationError').textContent =
                    'Location is required for inventory stage';
                return;
            }
        }

            // Get form values
            const formElements = {
                token: document.querySelector('input[name="__RequestVerificationToken"]'),
                seedEntryId: document.getElementById('seedEntryId'),
                aliveCount: document.getElementById('aliveCount'),
                targetStage: document.getElementById('targetStage'),
                stageDate: document.getElementById('stageDate'),
                previousCount: document.getElementById('previousCount')
            };

            // Validation checks
            const validation = {
                aliveCount: {
                    value: Number(formElements.aliveCount.value),
                    min: 1,
                    max: Number(formElements.previousCount.value)
                },
                stageDate: {
                    value: formElements.stageDate.value,
                    min: formElements.stageDate.min
                }
            };

            // Validate alive count
            if (!validation.aliveCount.value ||
                validation.aliveCount.value < validation.aliveCount.min ||
                validation.aliveCount.value > validation.aliveCount.max) {
                formElements.aliveCount.classList.add('is-invalid');
                document.getElementById('countError').textContent =
                    `Count must be between ${validation.aliveCount.min} and ${validation.aliveCount.max}`;
                return;
            }

            // Validate date
            if (new Date(validation.stageDate.value) < new Date(validation.stageDate.min)) {
                formElements.stageDate.classList.add('is-invalid');
                document.getElementById('dateError').textContent =
                    `Date cannot be before ${new Date(validation.stageDate.min).toLocaleDateString()}`;
                return;
            }

            // Prepare form data
            const formData = new FormData();
            formData.append('seedEntryId', formElements.seedEntryId.value);
            formData.append('aliveCount', validation.aliveCount.value);
            formData.append('nextStage', formElements.targetStage.value);
            formData.append('stageDate', validation.stageDate.value);
               
            formData.append('location', document.getElementById('location').value.trim());
           


            try {
                    const response = await fetch(window.basePath + 'SeedEntry/temp?handler=UpdateStage', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': formElements.token.value
                    }
                });

                if (!response.ok) {
                    const errorText = await response.text();
                    throw new Error(`Server error: ${response.status} - ${errorText}`);
                }

                const result = await response.json();
                if (result.success) {
                    if (stageModalInstance) {
                        stageModalInstance.hide();
                    }
                    showToast("Stage updated successfully!");
                   setTimeout(() => location.reload(), 1500);
                } else {
                    alert(`Operation failed: ${result.message}`);
                }
            } catch (error) {
                console.error('Submission error:', error);
                alert(`Failed to save: ${error.message}`);
            }
        });

        // Proper modal cleanup
        stageModalElement.addEventListener('hidden.bs.modal', () => {
            // Reset form and validation
            document.getElementById('stageForm').reset();
            stageModalElement.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));

            // Cleanup Bootstrap backdrop
            const backdrops = document.getElementsByClassName('modal-backdrop');
            while(backdrops.length > 0) {
                backdrops[0].parentNode.removeChild(backdrops[0]);
            }

            // Reset body state
            document.body.classList.remove('modal-open');
            document.body.style.paddingRight = '';

                   

        });
    </script>
}


