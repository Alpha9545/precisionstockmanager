<style>
    .main-container {
        overflow-y: auto;
        min-height: 750px;
    }

    .table-container {
        overflow-x: auto;
    }

    .fixed-header {
        position: sticky;
        top: 0;
        background: white;
        z-index: 10;
    }

    .modal-dialog {
        max-width: 95vw;
        margin: 0 auto;
    }

    .modal-content {
        height: 95vh;
        max-height: 95vh;
        overflow-y: auto;
        border-radius: 0;
        font-size: 0.85rem;
    }

    .modal-header,
    .modal-footer,
    .modal-body,
    .card-body,
    .card-header {
        padding: 0.75rem 1rem;
    }

    .row.g-3 > [class^='col-'] {
        padding-left: 0.25rem;
        padding-right: 0.25rem;
    }

    .form-label {
        margin-bottom: 0.25rem;
        font-size: 0.8rem;
    }

    .form-control,
    .badge {
        font-size: 0.8rem;
        padding: 0.4rem 0.5rem;
    }

    .btn {
        padding: 0.4rem 0.75rem;
        font-size: 0.8rem;
    }

    @@media (max-width: 992px), (max-height: 600px) {
        table

    {
        font-size: 0.75rem;
    }

    .modal-content {
        height: 90vh;
        max-height: 90vh;
    }

    }

    @@media (min-width: 1200px) {
        .container-fluid

    {
        max-width: 100%;
    }

    }
</style>

@{
    Dictionary<int, string> monthCodes = new Dictionary<int, string>
    {
        {1, "A"}, {2, "B"}, {3, "C"}, {4, "D"}, {5, "E"}, {6, "F"},
        {7, "G"}, {8, "H"}, {9, "I"}, {10, "J"}, {11, "K"}, {12, "L"}
    };
}

<div class="p-2">

    <div class="container-fluid h-100">
        <div class="row fixed-header  bg-light pb-2 border-bottom mb-1">
            <div class="col">
                <h2 class="mb-0">Plant Growth Tracker</h2>
            </div>
        </div>

        <div class="row main-container">
            <div class="col-12 ">
                <div class="card shadow table-container">
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0" style="font-size: 0.875rem;">
                            <thead class=" fixed-header" style=" background-color: #c8e6c9;">
                                <tr>
                                    <th>Batch</th>
                                    <th>Polyhouse</th>
                                    <th>Plant</th>
                                    <th>Variety</th>
                                    <th>Supervisor</th>
                                    <th>Planting Date</th>
                                    <th>Batch</th>
                                    <th>Planted</th>
                                    <th>Tryas</th>
                                    <th>Hardening</th>
                                    <th>Ready Stock</th>
                                    <th>Days Passed</th>
                                    <th>Status</th>

                                    <th>Current Stage</th>
                                    <th>Actions</th>
                                  
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                foreach (var item in Model.SeedEntries)
                                {
                                    
                                    var batchNo = $"{item.SeedingDate.Day}-{monthCodes[item.SeedingDate.Month]}";
                                   
                                    <tr class="align-middle">
                                        <td>#@item.Id</td>
                                        <td>@ToTitle(item.PolyhouseName)</td>
                                        <td>@ToTitle(item.PlantTypeName)</td>
                                        <td>@ToTitle(item.SpeciesName)</td>
                                        <td>@ToTitle(item.Supervisor)</td>
                                        <td>@item.SeedingDate.ToString("dd-MMM-yyyy")</td>
                                        <td class="text-info fw-bold">@batchNo</td>
                                        <td>@item.SeedsPlanted</td>
                                        <td>
                                            @if (item.TraysAlive > 0)
                                            {
                                                <span>@item.TraysAlive</span>
                                            }
                                            else
                                            {
                                                @:Balance
                                            }
                                        </td>
                                        <td>
                                            @if (item.HardeningAlive > 0)
                                            {
                                                <span>@item.HardeningAlive</span>
                                            }
                                            else
                                            {
                                                @:Balance
                                            }
                                        </td>
                                        <td>
                                            @if (item.AliveCount > 0)
                                            {
                                                <span>@item.AliveCount</span>
                                            }
                                            else
                                            {
                                                @:Balance
                                            }

                                        </td>
                                        <td>@item.DaysPassed</td>
                                        <td>@(item.DaysPassed >= 21 ? "🔴 Critical" : item.DaysPassed >= 18 ? "🟡 Warning" : "🟢 Normal")</td>

                                        <td>
                                            <span class="@Model.GetStageBadgeClass(item.CurrentStage, item.CurrentStage)">
                                                @item.CurrentStage
                                            </span>
                                        </td>
                                       
                                        <td>
                                            @if (item.CurrentStage == "Sowing" || item.CurrentStage == "Trays" || item.CurrentStage == "Hardening" )
                                            {
                                                <button class="btn btn-sm btn-outline-primary"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#stageModal"
                                                        data-id="@item.Id"
                                                        data-stage="@item.CurrentStage"
                                                        data-current="@Model.GetCurrentCount(item)"
                                                        data-polyhouse="@item.PolyhouseName"
                                                        data-plant="@item.PlantTypeName"
                                                        data-variety="@item.SpeciesName"
                                                        data-planting-date="@item.SeedingDate.ToString("dd-MMM-yyyy")"
                                                        data-days-passed="@item.DaysPassed"
                                                        data-batch-no="@batchNo"
                                                        data-sowing-count="@item.SeedsPlanted"
                                                        data-sowing-date="@item.SeedingDate.ToString("yyyy-MM-dd")"
                                                        data-trays-count="@item.TraysAlive"
                                                        data-trays-date="@(item.TraysDate?.ToString("yyyy-MM-dd") ?? "")"
                                                        data-hardening-count="@item.HardeningAlive"
                                                        data-hardening-date="@(item.HardeningDate?.ToString("yyyy-MM-dd") ?? "")"
                                                    data-inventory-count="@item.AliveCount"
                                                        data-inventory-date="@(item.InventoryDate?.ToString("yyyy-MM-dd") ?? "")"
                                                        data-inventory-location="@item.locationDesc">
                                                    <i class="fas fa-arrow-right me-2"></i>Next Stage
                                                </button>
                                            }
                                            else if (item.CurrentStage == "Inventory")
                                            {
                                                <button class="btn btn-sm btn-outline-secondary"  
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#stageModal"
                                                                data-id="@item.Id"
                                                                data-stage="@item.CurrentStage"
                                                                data-current="@Model.GetCurrentCount(item)"
                                                                data-polyhouse="@item.PolyhouseName"
                                                                data-plant="@item.PlantTypeName"
                                                                data-variety="@item.SpeciesName"
                                                                data-planting-date="@item.SeedingDate.ToString("dd-MMM-yyyy")"
                                                                data-days-passed="@item.DaysPassed"
                                                                data-batch-no="@batchNo"
                                                                data-sowing-count="@item.SeedsPlanted"
                                                                data-sowing-date="@item.SeedingDate.ToString("yyyy-MM-dd")"
                                                                data-trays-count="@item.TraysAlive"
                                                                data-trays-date="@(item.TraysDate?.ToString("yyyy-MM-dd") ?? "")"
                                                                data-hardening-count="@item.HardeningAlive"
                                                        data-hardening-date="@(item.HardeningDate?.ToString("yyyy-MM-dd") ?? "")"
                                                        data-inventory-count="@item.AliveCount"
                                                        data-inventory-date="@(item.InventoryDate?.ToString("yyyy-MM-dd") ?? "")"
                                                        data-inventory-location="@item.locationDesc">
                                                            <i class="fas fa-arrow-right me-2"></i>View
                                                        
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Completed</span>
                                            }
                                        </td>
                                      
                                        </tr>
                                       
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <input name="__RequestVerificationToken" type="hidden" value="CfDJ8sfdasfassafsafsajl^(&(&(&(*&)ekjhkbfsdfhkjfs" />
    </div>
</div>

<!-- Progress Modal -->
