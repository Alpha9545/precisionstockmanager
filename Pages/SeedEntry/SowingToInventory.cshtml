@page
@model PlantStockManager.Pages.SeedEntry.SowingToInventoryModel
@attribute [IgnoreAntiforgeryToken]
@{
}
<style>
    .table-container {
        max-height: 600px; /* Adjust height as needed */
        overflow-y: auto;
        overflow-x: auto;
        border: 1px solid #ddd;
        margin-top: 15px;
    }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
    }

        .custom-table th, .custom-table td {
            white-space: nowrap; /* Prevents text from wrapping */
            text-align: center;
            padding: 8px;
            border: 1px solid #ddd;
        }

        .custom-table thead th {
            position: sticky;
            top: 0;
            background-color: #f8f9fa;
            z-index: 10;
        }
</style>

<h2>Plants Ready for Inventory</h2>

<div class="table-container">
    <table class="table table-bordered custom-table">
    <thead>
        <tr>
            <th>Polyhouse</th>
            <th>Plant Type</th>
            <th>Species</th>
            <th>Seeding Date</th>
            <th>Seeds Planted</th>
            <th>Days Passed</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var record in Model.SeedEntries)
        {
            string alertClass = record.DaysPassed >= 21 ? "table-danger" : record.DaysPassed >= 18 ? "table-warning" : "table-success";
            <tr class="@alertClass">
                <td>@record.PolyhouseName</td>
                <td>@record.PlantTypeName</td>
                <td>@record.SpeciesName</td>
                <td>@record.SeedingDate.ToString("dd-MMMM-yyyy")</td>
                <td>@record.SeedsPlanted</td>   
                <td>@record.DaysPassed</td>
                <td>@(record.DaysPassed >= 21 ? "🔴 Critical" : record.DaysPassed >= 18 ? "🟡 Warning" : "🟢 Normal")</td>
                <td>
                    <button class="btn btn-primary" onclick="openInput(@record.Id)">Add to Inventory</button>
                    <div id="inputBox-@record.Id" class="d-none mt-2">
                        <input type="number" id="alivePlants-@record.Id" placeholder="Alive Plants" class="form-control mb-2">
                        <button class="btn btn-success" onclick="addToInventory(@record.Id)">Final Add</button>
                        <button class="btn btn-danger" onclick="cancelInput(@record.Id)">Cancel</button>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>


<script>
    function openInput(id) {
        document.getElementById("inputBox-" + id).classList.remove("d-none");
    }

    function cancelInput(id) {
        document.getElementById("inputBox-" + id).classList.add("d-none");
    }


        async function addToInventory(seedEntryId) {
            debugger;
        let aliveCount = document.getElementById("alivePlants-" + seedEntryId).value;

        if (!aliveCount || aliveCount <= 0) {
            alert("Enter a valid alive plants count!");
            return;
        }

        let formData = new FormData();
        formData.append("SeedEntryId", seedEntryId);
        formData.append("AliveCount", aliveCount);

        try {
            let response = await fetch('/SeedEntry/SowingToInventory?handler=AddToInventory', {
                method: 'POST',
                body: formData
            });

            if (!response.ok) {
                throw new Error(`HTTP error! Status: ${response.status}`);
            }

            let result = await response.json();
            if (result.success) {
                alert("Successfully added to inventory!");
                location.reload();
            } else {
                alert("Failed to add: " + result.message);
            }
        } catch (error) {
            alert("Error: " + error.message);
            console.error("Fetch error:", error);
        }
    }





</script>
