@page
@model PlantStockManager.Pages.SeedEntry.PlantPhaseModel
@Html.AntiForgeryToken()
@{
}

<style>
    .table-container {
        max-height: 600px; /* Adjust height as needed */
        overflow-y: auto;
        overflow-x: auto;
        border: 1px solid #ddd;
        margin-top: 15px;
    }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
    }

        .custom-table th, .custom-table td {
            white-space: nowrap; /* Prevents text from wrapping */
            text-align: center;
            padding: 8px;
            border: 1px solid #ddd;
        }

        .custom-table thead th {
            position: sticky;
            top: 0;
            background-color: #f8f9fa;
            z-index: 10;
        }
</style>


<h2>Add Plant Phases</h2>
<div class="table-container">
    <table class="table table-bordered custom-table">
        <thead>
            <tr>
                <th>Polyhouse</th>
                <th>Plant Type</th>
                <th>Species</th>
                <th>Seeding Date</th>
                <th>Seeds Planted</th>
                <th>Days Passed</th>
                <th>Status</th>
                <!-- Existing columns -->
                <th>Current Stage</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var record in Model.SeedEntries)
            {
                string alertClass = record.DaysPassed >= 21 ? "table-danger" : record.DaysPassed >= 18 ? "table-warning" : "table-success";
                <tr class="@alertClass">
                    <td>@record.PolyhouseName</td>
                    <td>@record.PlantTypeName</td>
                    <td>@record.SpeciesName</td>
                    <td>@record.SeedingDate.ToString("dd-MMMM-yyyy")</td>
                    <td>@record.SeedsPlanted</td>
                    <td>@record.DaysPassed</td>
                    <td>@(record.DaysPassed >= 21 ? "🔴 Critical" : record.DaysPassed >= 18 ? "🟡 Warning" : "🟢 Normal")</td>
                    <!-- Existing columns -->
                    <td>@record.CurrentStage</td>
                    <td>
                        @{
                            string buttonText = "";
                            string nextStage = "";
                            if (record.CurrentStage == "Sowing")
                            {
                                buttonText = "Move to Trays";
                                nextStage = "Trays";
                            }
                            else if (record.CurrentStage == "Trays")
                            {
                                buttonText = "Move to Hardening";
                                nextStage = "Hardening";
                            }
                            else if (record.CurrentStage == "Hardening")
                            {
                                buttonText = "Move to Inventory";
                                nextStage = "Inventory";
                            }
                        }
                        <button class="btn btn-primary" onclick="openInput(@record.Id, '@nextStage')">@buttonText</button>
                        <div id="inputBox-@record.Id" class="d-none mt-2">
                            <input type="number" id="alivePlants-@record.Id" placeholder="Alive in @nextStage" class="form-control mb-2">
                            <button class="btn btn-success" onclick="addToInventory(@record.Id, '@nextStage')">Confirm</button>
                            <button class="btn btn-danger" onclick="cancelInput(@record.Id)">Cancel</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <input name="__RequestVerificationToken" type="hidden" value="CfDJ8sfdasfassafsafsajl^(&(&(&(*&)ekjhkbfsdfhkjfs" />
</div>



<script>

     function openInput(id) {
        document.getElementById("inputBox-" + id).classList.remove("d-none");
    }

    function cancelInput(id) {
        document.getElementById("inputBox-" + id).classList.add("d-none");
    }

        async function addToInventory(seedEntryId, nextStage) {
            debugger;
          

     const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
    if (!tokenElement) {
        alert('Security token missing!');
        return;
    }


        let aliveCount = document.getElementById("alivePlants-" + seedEntryId).value;

        if (!aliveCount || aliveCount <= 0) {
            alert("Enter a valid alive plants count!");
            return;
        }

        let formData = new FormData();
        formData.append("SeedEntryId", seedEntryId);
        formData.append("AliveCount", aliveCount);
        formData.append("NextStage", nextStage);

        try {
            let response = await fetch('/SeedEntry/PlantPhase?handler=AddToInventory', {
                method: 'POST',
                body: formData,
                headers: {
                'RequestVerificationToken': tokenElement.value
                }
            });

            if (!response.ok) throw new Error(`HTTP error! Status: ${response.status}`);
            let result = await response.json();

            if (result.success) {
                alert("Successfully updated!");
                location.reload();
            } else {
                alert("Failed: " + result.message);
            }
        } catch (error) {
            alert("Error: " + error.message);
        }
    }
</script>