@page
@model UsageModel

<div class="container mt-4">

    <h3 class="mb-3">Available Fertilizer Stock</h3>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Fertilizer</th>
                    <th>Batch</th>
                    <th>Available Qty</th>
                    <th>Unit</th>
                    <th>Expiry</th>
                    <th style="width:120px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.AvailableStocks)
                {
                    <tr>
                        <td>@s.FertilizerName</td>
                        <td>@s.BatchNumber</td>
                        <td>
                            <span class="fw-bold text-success">
                                @s.AvailableQuantity
                            </span>
                        </td>
                        <td>@s.UnitName</td>
                        <td>
                            @(s.ExpiryDate?.ToShortDateString() ?? "-")
                        </td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-primary"
                                    data-bs-toggle="modal"
                                    data-bs-target="#usageModal"
                                    onclick="openUsageModal(
                                        '@s.StockId',
                                        '@s.FertilizerName',
                                        '@s.BatchNumber',
                                        '@s.AvailableQuantity',
                                        '@s.UnitName'
                                    )">
                                Use
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- USAGE MODAL -->
<div class="modal fade" id="usageModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <form method="post">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Issue Fertilizer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <!-- Hidden StockId -->
                    <input type="hidden" asp-for="Usage.StockId" id="stockId" />

                    <div class="mb-2">
                        <label class="form-label">Fertilizer</label>
                        <input type="text" id="fertilizerName"
                               class="form-control" readonly />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label class="form-label">Batch</label>
                            <input type="text" id="batchNo"
                                   class="form-control" readonly />
                        </div>

                        <div class="col-md-6 mb-2">
                            <label class="form-label">Available</label>
                            <input type="text" id="availableQty"
                                   class="form-control text-success fw-bold"
                                   readonly />
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Quantity to Use</label>
                        <input asp-for="Usage.UsedQuantity"
                               type="number" step="0.001"
                               id="usedQty"
                               class="form-control"
                               oninput="validateQuantity()"
                               required />
                    </div>
                    <div class="text-danger mt-1" id="qtyError"></div>


                    <div class="mb-2">
                        <label class="form-label">Issue Date</label>
                        <input asp-for="Usage.IssueDate"
                               type="date"
                               class="form-control"
                               required />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Received By</label>
                        <input asp-for="Usage.ReceivedBy"
                               class="form-control"
                               placeholder="Receiver Name"
                               required />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Remarks</label>
                        <textarea asp-for="Usage.Remarks"
                                  class="form-control"
                                  rows="2"></textarea>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            id="issueBtn"
                            asp-page-handler="Save"
                            class="btn btn-success"
                            disabled>
                        Issue Fertilizer
                    </button>

                </div>
            </form>

        </div>
    </div>
</div>



    <script>
    let maxAvailableQty = 0;

    function openUsageModal(stockId, fertilizer, batch, qty, unit) {

        maxAvailableQty = parseFloat(qty);

        document.getElementById("stockId").value = stockId;
        document.getElementById("fertilizerName").value = fertilizer;
        document.getElementById("batchNo").value = batch;
        document.getElementById("availableQty").value =
            qty + " " + unit;

        // Reset fields & errors
        document.getElementById("usedQty").value = "";
        document.getElementById("qtyError").innerText = "";
        document.getElementById("issueBtn").disabled = true;
    }

     function validateQuantity() {

        const usedQtyInput = document.getElementById("usedQty");
        const errorDiv = document.getElementById("qtyError");
        const issueBtn = document.getElementById("issueBtn");

        const usedQty = parseFloat(usedQtyInput.value);

        if (isNaN(usedQty) || usedQty <= 0) {
            errorDiv.innerText = "Enter a valid quantity.";
            issueBtn.disabled = true;
            return;
        }

        if (usedQty > maxAvailableQty) {
            errorDiv.innerText =
                `Used quantity cannot exceed available quantity (${maxAvailableQty}).`;
            issueBtn.disabled = true;
            return;
        }

        // Valid quantity
        errorDiv.innerText = "";
        issueBtn.disabled = false;
    }
</script>


