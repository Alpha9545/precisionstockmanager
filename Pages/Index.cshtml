@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
    var firstName = Model.DisplayName;
}

<style>
    .home { max-width: 1280px; }
    .home .hero { background: linear-gradient(to right, #348F50, #56AB2F); color: #fff; border-radius: .75rem; padding: 1.25rem 1.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; }
    .home .hero .logo { background: #fff; border-radius: .6rem; padding: .5rem .75rem; flex: 0 0 auto; }
    .home .hero .logo img { height: 84px; width: auto; display: block; }
    .home .hero .company { font-size: .85rem; letter-spacing: .12em; text-transform: uppercase; opacity: .95; font-weight: 600; }
    .home .hero h1 { font-size: 1.9rem; font-weight: 700; margin: .1rem 0 .15rem; }
    .home .hero .tagline { margin: 0; opacity: .95; }
    .home .hero .clock { margin-left: auto; text-align: right; font-size: .9rem; opacity: .95; }
    .home .welcome { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem; margin: 1.25rem 0 .5rem; }
    .home .welcome h2 { font-size: 1.35rem; margin: 0; }
    .home .role { background: #e8f4ec; color: #1f6b3a; border-radius: 1rem; padding: .15rem .6rem; font-size: .78rem; margin-right: .25rem; display: inline-block; }
    .home .btn-mgmt { background: #1f6b3a; border-color: #1f6b3a; color: #fff; font-weight: 600; }
    .home .btn-mgmt:hover { background: #17552e; color: #fff; }
    .home .section-title { font-size: .8rem; text-transform: uppercase; letter-spacing: .06em; color: #6c757d; font-weight: 600; margin: 1.5rem 0 .6rem; }
    .home .module { border: 1px solid #dee2e6; border-radius: .6rem; background: #fff; height: 100%; padding: .9rem 1rem; }
    .home .module .icon { width: 38px; height: 38px; border-radius: .5rem; background: linear-gradient(to right, #348F50, #56AB2F); display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto; }
    .home .module .icon img { width: 20px; height: 20px; }
    .home .module h3 { font-size: 1rem; font-weight: 600; margin: 0; }
    .home .module p { font-size: .82rem; color: #6c757d; margin: .35rem 0 .5rem; }
    .home .module ul { list-style: none; padding: 0; margin: 0; font-size: .9rem; }
    .home .module li { padding: .15rem 0; }
    .home .module a { text-decoration: none; }
    .home .module a:hover { text-decoration: underline; }
    .home .info { border: 1px solid #dee2e6; border-radius: .6rem; background: #fff; padding: 1rem 1.1rem; height: 100%; }
    .home .info h3 { font-size: 1rem; font-weight: 600; }
    .home .flow { list-style: none; padding: 0; margin: 0; counter-reset: step; }
    .home .flow li { position: relative; padding: .3rem 0 .3rem 2rem; font-size: .9rem; }
    .home .flow li::before { counter-increment: step; content: counter(step); position: absolute; left: 0; top: .3rem; width: 1.4rem; height: 1.4rem; border-radius: 50%; background: #e8f4ec; color: #1f6b3a; font-size: .75rem; font-weight: 700; text-align: center; line-height: 1.4rem; }
    .home .chip { display: inline-block; border: 1px solid #cfe3d6; background: #f4faf6; color: #1f6b3a; border-radius: 1rem; padding: .2rem .7rem; margin: 0 .3rem .4rem 0; font-size: .85rem; }
    .with-footer-space { margin-bottom: 80px; }
    .footer { position: fixed; bottom: 0; width: 100%; height: 50px; background: #f8f9fa; display: flex; align-items: center; justify-content: center; box-shadow: 0 -2px 5px rgba(0, 0, 0, 0.1); z-index: 999; }
    @@media (max-width: 768px) {
        .footer { display: none; }
        .home .hero { padding: 1rem; }
        .home .hero .logo img { height: 60px; }
        .home .hero h1 { font-size: 1.4rem; }
        .home .hero .clock { margin-left: 0; text-align: left; width: 100%; }
    }
</style>

<div class="container-fluid py-4 with-footer-space home">

    <!-- Company identity -->
    <section class="hero" aria-label="Company">
        <div class="logo"><img src="~/images/company-logo.png" alt="Precision Agritech Pvt. Ltd." /></div>
        <div>
            <div class="company">@IndexModel.CompanyName</div>
            <h1>Plant Stock Manager</h1>
            <p class="tagline">Nursery production and management system</p>
        </div>
        <div class="clock">
            <div class="fw-semibold">@Model.NowIndia.ToString("dddd, dd MMMM yyyy")</div>
            <div>@Model.NowIndia.ToString("hh:mm tt") (India time)</div>
        </div>
    </section>

    <!-- Welcome -->
    <div class="welcome">
        <div>
            <h2>Welcome, @firstName</h2>
            @if (Model.RoleNames.Any())
            {
                <div class="mt-1">@foreach (var r in Model.RoleNames) { <span class="role">@r</span> }</div>
            }
        </div>
        @if (Model.CanOpenManagementDashboard)
        {
            <a class="btn btn-mgmt" asp-page="/ManagementDashboard/Index">Management Dashboard &rarr;</a>
        }
    </div>

    <!-- My work -->
    @if (Model.Items.Any())
    {
        <div class="section-title">My work</div>
        <div class="list-group" style="max-width: 760px;">
            @foreach (var i in Model.Items)
            {
                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" asp-page="@i.Page">
                    <span>@i.Text</span>
                    <span class="badge bg-@i.Css rounded-pill">@i.Count</span>
                </a>
            }
        </div>
    }

    <!-- Quick access -->
    <div class="section-title">Quick access</div>
    @if (Model.Modules.Any())
    {
        <div class="row g-3">
            @foreach (var m in Model.Modules)
            {
                <div class="col-12 col-sm-6 col-lg-4 col-xxl-3">
                    <div class="module">
                        <div class="d-flex align-items-center gap-2">
                            <span class="icon"><img src="~/images/@m.Icon" alt="" /></span>
                            <h3>@m.Title</h3>
                        </div>
                        <p>@m.Description</p>
                        <ul>
                            @foreach (var l in m.Links)
                            {
                                <li><a asp-page="@l.Page">@l.Label</a></li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-secondary">No modules are assigned to your account yet. Please contact your administrator.</div>
    }

    <!-- Company information -->
    <div class="section-title">About the company</div>
    <div class="row g-3">
        <div class="col-12 col-lg-6">
            <div class="info">
                <h3>@IndexModel.CompanyName</h3>
                <p class="mb-2">
                    Precision Agritech Pvt. Ltd. runs its plant nursery on Plant Stock Manager: one system for raising
                    seedlings from seed and from mother-plant cuttings, approving them into Ready Stock, booking and
                    dispatching them to customers, producing potted plants and selling through the outlet.
                </p>
                <p class="mb-0 text-muted small">
                    The store, maintenance, labour attendance, fertilizer and staff suggestions are managed in the same system.
                </p>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="info">
                <h3>How the nursery works</h3>
                <ol class="flow">
                    <li>Seeds are sown directly; mother plants give cuttings, which are sent to the Main Office and sown in trays.</li>
                    <li>Sowings are approved into Ready Stock when the seedlings are ready.</li>
                    <li>Customer bookings reserve Ready Stock and are dispatched batch by batch.</li>
                    <li>Cuttings are also potted into potted plants, which are booked, dispatched or sold at the outlet.</li>
                </ol>
            </div>
        </div>
        @if (Model.PlantTypes.Any())
        {
            <div class="col-12 col-lg-6">
                <div class="info">
                    <h3>What we grow</h3>
                    <div class="text-muted small mb-2">Plant types in the Plant / Variety master</div>
                    @foreach (var t in Model.PlantTypes) { <span class="chip">@t</span> }
                </div>
            </div>
        }
        @if (Model.AreaGroups.Any())
        {
            <div class="col-12 col-lg-6">
                <div class="info">
                    <h3>Where we work</h3>
                    @foreach (var g in Model.AreaGroups)
                    {
                        <div class="small text-muted mt-1">@g.Label</div>
                        <div>@foreach (var n in g.Names) { <span class="chip">@n</span> }</div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<footer class="footer">
    <div class="footer-content">
        &copy; @DateTime.Today.Year - @IndexModel.CompanyName - <a asp-area="" asp-page="/Privacy">Privacy</a>
    </div>
</footer>
