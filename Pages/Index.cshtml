@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4 with-footer-space">
    <h3 class="mb-3">Dashboard</h3>

    @if (Model.Items.Any())
    {
        <h6 class="text-muted text-uppercase small">Needs attention</h6>
        <div class="list-group mb-4" style="max-width: 720px;">
            @foreach (var i in Model.Items)
            {
                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" asp-page="@i.Page">
                    <span>@i.Text</span>
                    <span class="badge bg-@i.Css rounded-pill">@i.Count</span>
                </a>
            }
        </div>
    }
    else
    {
        <div class="alert alert-success" style="max-width: 720px;">Nothing is waiting for you.</div>
    }

    <h6 class="text-muted text-uppercase small">Seedlings by crop</h6>
    <div class="row g-3">
        @foreach (var c in Model.Crops)
        {
            <div class="col-12 col-md-6 col-xl-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="card-title">@c.Crop</h6>
                        <ul class="list-group list-group-flush small">
                            <li class="list-group-item d-flex justify-content-between px-0">
                                <span>Active sowings</span><span class="fw-bold text-primary">@c.ActiveSowings (@c.ActiveSown.ToString("N0"))</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between px-0">
                                <span>Ready seedlings available</span><span class="fw-bold text-success">@c.ReadyAvailable.ToString("N0")</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between px-0">
                                <span>Pending bookings</span><span class="fw-bold text-danger">@c.PendingBookings (@c.PendingBookingQuantity.ToString("N0"))</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<footer class="footer">
    <div class="footer-content">
        &copy; @DateTime.Today.Year - PlantStockManager - <a asp-area="" asp-page="/Privacy">Privacy</a>
    </div>
</footer>

<style>
    .with-footer-space { margin-bottom: 80px; }
    .footer {
        position: fixed; bottom: 0; width: 100%; height: 50px; background: #f8f9fa;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 -2px 5px rgba(0, 0, 0, 0.1); z-index: 999;
    }
    @@media (max-width: 768px) {
        .footer { display: none; }
        h3 { font-size: 1.25rem; }
    }
</style>
