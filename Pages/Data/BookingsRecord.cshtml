@page
@model PlantStockManager.Pages.Data.BookingsRecordModel
@using System.Globalization

@{
    ViewData["Title"] = "Booking Records";
}

@functions {
    private static string ToTitle(string s)
    {
        if (string.IsNullOrWhiteSpace(s)) return s;
        s = s.ToLowerInvariant();
        return CultureInfo.CurrentCulture.TextInfo.ToTitleCase(s);
    }
}

<link rel="stylesheet" href="~/css/sweetalert.css" />

<div class="p-2">
    <h2 class="text-primary fw-bold fs-4 mb-3">Booking Records</h2>
    @if (Model.ShowingOwnBookingsOnly)
    {
        <div class="alert alert-info py-2 small mb-3">@PlantStockManager.Authorization.BookingOwnershipService.OwnBookingsNotice</div>
    }

    <!-- Filters -->
    <form method="get" class="row g-2 mb-3" id="filtersForm">
        <div class="col-6 col-md-3">
            <label class="form-label small fw-bold mb-1">Plant Type</label>
            <select asp-for="SelectedPlantType" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All</option>
                @foreach (var plantType in Model.PlantTypes)
                {
                    <option value="@plantType.Id">@plantType.Name</option>
                }
            </select>
        </div>

        <div class="col-6 col-md-3">
            <label class="form-label small fw-bold mb-1">Species</label>
            <select asp-for="SelectedSpecies" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All</option>
                @foreach (var species in Model.PlantSpecies)
                {
                    <option value="@species.Id">@species.Name</option>
                }
            </select>
        </div>

        <div class="col-6 col-md-2">
            <label class="form-label small fw-bold mb-1">Delivery Month</label>
            <select asp-for="SelectedMonth" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="0" selected="@(Model.SelectedMonth == 0 ? "selected" : null)">All</option>
                @for (int month = 1; month <= 12; month++)
                {
                    <option value="@month" selected="@(Model.SelectedMonth == month ? "selected" : null)">
                        @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)
                    </option>
                }
            </select>
        </div>

        <div class="col-6 col-md-2">
            <label class="form-label small fw-bold mb-1">Delivery Year</label>
            <select asp-for="SelectedYear" class="form-select form-select-sm" onchange="this.form.submit()">
                @for (int year = DateTime.Now.Year - 1; year <= DateTime.Now.Year + 1; year++)
                {
                    <option value="@year" selected="@(Model.SelectedYear == year ? "selected" : null)">@year</option>
                }
            </select>
        </div>

        <div class="col-6 col-md-2">
            <label class="form-label small fw-bold mb-1">Delivery Status</label>
            <select asp-for="SelectedStatus" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="Pending">Pending</option>
                <option value="Completed">Completed</option>
                <option value="Cancelled">Cancelled</option>
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small fw-bold mb-1">Booking By</label>
            <select name="SelectedBookedBy" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All</option>
                @foreach (var option in Model.BookedByOptions)
                {
                    <option value="@option.Value" selected="@(Model.SelectedBookedBy == option.Value)">@option.Label</option>
                }
            </select>
        </div>

        @if (Model.Notice != null)
        {
            <div class="col-12"><div class="alert alert-warning py-1 mb-0 small">@Model.Notice</div></div>
        }

        <!-- Actions -->
        <div class="col-12 d-grid gap-2 d-md-flex justify-content-md-end mt-1">
            <a asp-page="/Data/BookingsRecord" class="btn btn-outline-secondary btn-sm">Clear filters</a>
            <a asp-page="/Data/BookingsRecord"
               asp-route-handler="GeneratePdf"
               asp-route-SelectedBookedBy="@Model.SelectedBookedBy"
               asp-route-SelectedPlantType="@Model.SelectedPlantType"
               asp-route-SelectedSpecies="@Model.SelectedSpecies"
               asp-route-SelectedMonth="@Model.SelectedMonth"
               asp-route-SelectedYear="@Model.SelectedYear"
               asp-route-SelectedStatus="@Model.SelectedStatus"
               class="btn btn-secondary btn-sm"
               target="_blank" rel="noopener" >
                Generate PDF
            </a>
        </div>


    </form>

    @{ var orders = Model.Orders; }
    <div class="small text-muted mb-1">@orders.Count.ToString("N0") booking@(orders.Count == 1 ? "" : "s") &middot; @Model.Bookings.Count.ToString("N0") variety line@(Model.Bookings.Count == 1 ? "" : "s") found@(Model.BookedByActive ? " (filtered by Booking By)" : "")</div>

    <!-- Table -->
    <div class="card shadow-sm p-2">
        <div class="table-responsive" style="max-height: 570px; overflow-y: auto;">
            <table class="table table-striped table-hover table-sm align-middle">
                <thead class="table-dark position-sticky top-0 small">
                    <tr>
                        <th>Booking</th>
                        <th>Customer Name</th>
                        <th>Address</th>
                        <th>Booking Date</th>
                        <th>Varieties</th>
                        <th>Total Qty</th>
                        <th>Advance</th>
                        <th>Booked By</th>
                        <th>Mob</th>
                    </tr>
                </thead>
                @foreach (var order in orders)
                {
                    var h = order.First;
                    <tbody class="small border-top border-2">
                        <tr class="table-secondary booking-order-row" data-order="@order.OrderId" role="button" title="Show / hide the varieties">
                            <td class="fw-bold text-nowrap"><span class="toggle-icon">&#9662;</span> #@order.OrderId</td>
                            <td>@ToTitle(h.CustomerName)</td>
                            <td>@ToTitle(h.Address)</td>
                            <td>@h.BookingDate.ToString("dd-MMMM-yyyy")</td>
                            <td>@order.Lines.Count@(h.OrderLineCount > order.Lines.Count ? $" of {h.OrderLineCount}" : "")</td>
                            <td class="fw-bold">@Qty(order.Lines.Sum(l => l.Quantity))</td>
                            <td>@(order.Lines.Sum(l => l.AdvanceTakenAmount ?? 0) > 0 ? order.Lines.Sum(l => l.AdvanceTakenAmount ?? 0).ToString("0.##") : "")</td>
                            <td>@ToTitle(PlantStockManager.Services.BookedByFilter.Display(h.BookedById, h.BookedByName, h.BookedByOther))</td>
                            <td>@h.Contact</td>
                        </tr>
                        @foreach (var booking in order.Lines)
                        {
                            <tr class="booking-line-row" data-order="@order.OrderId">
                                <td class="text-muted ps-4" title="Booking line reference">Ref @booking.Id</td>
                                <td colspan="2">@ToTitle(booking.PlantTypeName) / <strong>@ToTitle(booking.SpeciesName)</strong></td>
                                <td>Delivery @booking.DeliveryDate.ToString("dd-MMM-yyyy")</td>
                                <td>@booking.Status</td>
                                <td>@Qty(booking.Quantity)</td>
                                <td>@((booking.AdvanceTakenAmount ?? 0) > 0 ? booking.AdvanceTakenAmount : null)</td>
                                <td colspan="2"></td>
                            </tr>
                        }
                    </tbody>
                }
                @if (!Model.Bookings.Any())
                {
                    <tbody><tr><td colspan="9" class="text-center text-muted">No records match the selected filters.</td></tr></tbody>
                }
            </table>
        </div>
    </div>
</div>

<script>
    // An order's varieties show under it; clicking the order row hides / shows them.
    document.querySelectorAll('.booking-order-row').forEach(function (row) {
        row.addEventListener('click', function () {
            var id = row.getAttribute('data-order');
            var lines = document.querySelectorAll('.booking-line-row[data-order="' + id + '"]');
            var hide = lines.length && !lines[0].classList.contains('d-none');
            lines.forEach(function (l) { l.classList.toggle('d-none', hide); });
            row.querySelector('.toggle-icon').innerHTML = hide ? '&#9656;' : '&#9662;';
        });
    });
</script>

<style>
    @@media (max-width: 576px) {
        #filtersForm select, #filtersForm input

    {
        font-size: 0.85rem;
    }

    .btn-sm {
        font-size: 0.8rem;
        padding: 0.3rem 0.5rem;
    }

    h2 {
        font-size: 1.25rem;
    }

    .table,
    .table th,
    .table td {
        font-size: 0.75rem;
        white-space: nowrap;
    }

    }
</style>
