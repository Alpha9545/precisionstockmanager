@page
@model PlantStockManager.Pages.Data.WastedStockModel
@{
    ViewData["Title"] = "Wasted Stock Report";
}

<style>
    /* Sticky table header inside the scroll container */
    .sticky-head thead th {
        position: sticky;
        top: 0; /* set to your fixed navbar height if you have one, e.g. 56px */
        z-index: 5; /* keep it above table rows */
        background-color: #212529; /* match .table-dark */
        color: #fff;
    }

        /* Optional: subtle divider line under the stuck header */
        .sticky-head thead th::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: -1px;
            height: 1px;
            background: rgba(0,0,0,.2);
        }

    /* On very small screens, you may want to disable sticky to avoid overlap */
    @@media (max-width: 576px) {
        .sticky-head thead th

    {
        position: static;
    }

    }
</style>


<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
        <h2 class="mb-0 text-danger">Wasted Stock Report</h2>

        <form method="get" class="d-flex flex-wrap gap-2 align-items-end">
            <div class="d-flex flex-column">
                <label class="form-label fw-bold">From:</label>
                <input type="date" asp-for="DateFrom" class="form-control form-control-sm" style="width: 140px;">
            </div>
            <div class="d-flex flex-column">
                <label class="form-label fw-bold">To:</label>
                <input type="date" asp-for="DateTo" class="form-control form-control-sm" style="width: 140px;">
            </div>
            <div>
                <label class="form-label fw-bold">Polyhouse:</label>
                <select asp-for="SelectedPolyhouse" class="form-select form-select-sm">
                    <option value="">All</option>
                    @foreach (var p in Model.Polyhouses)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label fw-bold">Plant Type:</label>
                <select asp-for="SelectedPlantType" class="form-select form-select-sm" id="SelectedPlantType">
                    <option value="">All</option>
                    @foreach (var pt in Model.PlantTypes)
                    {
                        <option value="@pt.Id">@pt.Name</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label fw-bold">Species:</label>
                <select asp-for="SelectedSpecies" class="form-select form-select-sm" id="SelectedSpecies">
                    <option value="">All</option>
                    @foreach (var sp in Model.PlantSpecies)
                    {
                        <option value="@sp.Id">@sp.Name</option>
                    }
                </select>
            </div>
            <div>
                <button type="submit" class="btn btn-sm btn-primary">Apply</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="generatePdfBtn">PDF</button>
            </div>
        </form>
    </div>

    <div class="card p-3 shadow-sm">
        <div class="table-responsive sticky-head" style="max-height: 70vh; overflow-y: auto;">
            @if (Model.Inventory.Any())
            {
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Sowing ID</th>
                            <th>Polyhouse</th>
                            <th>Plant Type</th>
                            <th>Species</th>
                            <th>Seeds Planted</th>
                            <th>Sowing Date</th>
                            <th>Trays wasted</th>
                            <th>Hardening wasted</th>
                            <th>Inventory wasted</th>
                            <th>Sorting wasted</th>
                            <th>Total wasted</th>

                            <th>Supervisor</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Inventory)
                        {
                            <tr>
                                <td>@item.SeedEntryId</td>
                                <td>@item.PolyhouseName</td>
                                <td>@item.PlantTypeName</td>
                                <td>@item.SpeciesName</td>
                                <td>@item.SeedsPlanted</td>
                                <td>@item.SeedingDate.ToString("dd-MMM-yyyy")</td>
                                <td>@item.WastedInTrays</td>
                                <td>@item.WastedInHardening</td>
                                <td>@item.WastedInInventory</td>
                                <td>@item.WastedInSorting</td>
                                <td><strong class="text-danger">@item.TotalWasted</strong></td>
                               
                                <td>@item.Supervisor</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-warning text-center">No records found.</div>
            }
        </div>
    </div>

    <hr class="my-4" />
    <h4 class="text-danger">Potted Plant Stock Wastage</h4>
    <div class="card p-3 shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover table-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Date</th><th>Variety</th><th>Pot Size</th><th>Area</th><th>Quantity Wasted</th><th>Reason</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var w in Model.PottedPlantWastage)
                    {
                        <tr>
                            <td>@w.TransactionDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@w.SpeciesName</td>
                            <td>@w.PotSize</td>
                            <td>@(w.AreaName ?? "-")</td>
                            <td><strong class="text-danger">@((-w.Quantity).ToString("N2"))</strong></td>
                            <td>@(w.Remarks ?? "-")</td>
                        </tr>
                    }
                    @if (!Model.PottedPlantWastage.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted">No Potted Plant Stock wastage recorded in this date range.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <h4 class="text-danger">Seed / Cutting Sowing Process Wastage</h4>
    <p class="text-muted small">Seedlings that never became Ready Stock -- read from each Sowing's own recorded Wastage (approved at Ready Confirmation), not a separate stock ledger.</p>
    <div class="card p-3 shadow-sm">
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover table-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Sowing Date</th><th>Type</th><th>Batch Code</th><th>Variety</th><th>Area</th><th>Sown</th><th>Wasted</th><th>Wastage %</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var w in Model.ProcessWastage)
                    {
                        <tr>
                            <td>@w.SowingDate.ToString("dd/MM/yyyy")</td>
                            <td>@w.SourceType</td>
                            <td>@w.BatchCode</td>
                            <td>@w.SpeciesName</td>
                            <td>@w.AreaName</td>
                            <td>@w.QuantitySown.ToString("N0")</td>
                            <td><strong class="text-danger">@w.WastageQuantity.ToString("N0")</strong></td>
                            <td>@w.WastagePercent.ToString("N2")%</td>
                        </tr>
                    }
                    @if (!Model.ProcessWastage.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted">No Seed/Cutting Sowing wastage recorded in this date range.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("SelectedPlantType").addEventListener("change", function () {
            const plantTypeId = this.value;
            const speciesDropdown = document.getElementById("SelectedSpecies");
            speciesDropdown.innerHTML = '<option value="">All</option>';

            if (plantTypeId) {
                fetch(`/Data/WastedStock?handler=SpeciesByPlantType&plantTypeId=${plantTypeId}`)
                    .then(res => res.json())
                    .then(data => {
                        data.forEach(sp => {
                            const option = document.createElement("option");
                            option.value = sp.id;
                            option.textContent = sp.name;
                            speciesDropdown.appendChild(option);
                        });
                    });
            }
        });

        document.getElementById("generatePdfBtn").addEventListener("click", function () {
            const params = new URLSearchParams();
            const fields = ["DateFrom", "DateTo", "SelectedPolyhouse", "SelectedPlantType", "SelectedSpecies"];
            fields.forEach(field => {
                const el = document.querySelector(`[name='${field}']`);
                if (el && el.value) params.append(field, el.value);
            });
            window.open(`/Data/WastedStock?handler=GeneratePdf&${params.toString()}`, '_blank');
        });
    </script>
}
