@page
@model PlantStockManager.Pages.Data.WastedStockModel
@{
    ViewData["Title"] = "Wastage";
}

<div class="container-fluid mt-4">
    <h3 class="mb-3">Wastage</h3>

    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-md-2">
            <label class="form-label mb-0">From</label>
            <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label mb-0">To</label>
            <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label mb-0">Area</label>
            <select name="areaId" class="form-select">
                <option value="">All Areas</option>
                @foreach (var a in Model.Areas)
                {
                    <option value="@a.Id" selected="@(a.Id == Model.AreaId)">@a.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label mb-0">Production type</label>
            <select name="type" class="form-select">
                <option value="">All</option>
                @foreach (var t in Model.Types)
                {
                    <option value="@t" selected="@(t == Model.Type)">@t</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label mb-0">Search</label>
            <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Variety, crop, sowing or batch" />
        </div>
        <div class="col-md-1"><button class="btn btn-primary w-100">Show</button></div>
    </form>

    <p class="text-muted small">
        Tray wastage = seeds/cuttings used in complete trays &minus; ready seedlings. Leftover seeds or cuttings below one complete tray stay in stock and are not wastage.
    </p>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-sm">
            <thead class="table-light">
                <tr>
                    <th>Date</th><th>Production</th><th>Material</th><th>Variety</th><th>Colour</th><th>Cavity / Pot</th><th>Area</th>
                    <th class="text-end">Wastage</th><th class="text-end">Of</th><th class="text-end">%</th><th>Reason</th><th>Sowing / Batch</th><th>Supervisor</th><th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td class="text-nowrap">@r.Date.ToString("dd/MM/yyyy")</td>
                        <td>@r.ProductionType</td>
                        <td>@r.Material</td>
                        <td>@r.Variety <span class="text-muted">(@r.PlantType)</span></td>
                        <td>@(r.Color ?? "-")</td>
                        <td>@(r.Cavity ?? r.PotSize ?? "-")</td>
                        <td>@(r.AreaName ?? "-")</td>
                        <td class="text-end fw-bold">@r.Quantity.ToString("N0")</td>
                        <td class="text-end">@(r.OutOf?.ToString("N0") ?? "-")</td>
                        <td class="text-end">@(r.Percent?.ToString("0.00") ?? "-")</td>
                        <td>@(r.Reason ?? "-")</td>
                        <td>@(r.Reference ?? "-")</td>
                        <td>@(r.Supervisor ?? "-")</td>
                        <td>@r.Remarks</td>
                    </tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="14" class="text-center text-muted">No wastage in this period.</td></tr>
                }
            </tbody>
            @if (Model.Rows.Any())
            {
                <tfoot>
                    <tr class="fw-bold"><td colspan="7">Total</td><td class="text-end">@Model.Rows.Sum(r => r.Quantity).ToString("N0")</td><td colspan="6"></td></tr>
                </tfoot>
            }
        </table>
    </div>
</div>
