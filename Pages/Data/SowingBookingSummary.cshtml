@page
@model PlantStockManager.Pages.Data.SowingBookingSummaryModel

@{
    ViewData["Title"] = "Weekly Sowing–Inventory–Booking Sync";
}

<link rel="stylesheet" href="~/css/weekly-sync.css" />
<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6f9;
    }

    .page-container {
        padding: 20px;
    }

    .filter-bar select {
        padding: 8px;
        margin-right: 10px;
    }

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
        margin: 20px 0;
    }

    .kpi {
        padding: 15px;
        border-radius: 10px;
        color: white;
        text-align: center;
    }

        .kpi.green {
            background: #2ecc71;
        }

        .kpi.red {
            background: #e74c3c;
        }

        .kpi.amber {
            background: #f39c12;
        }

        .kpi.danger {
            background: #c0392b;
        }

    .kpi-label {
        font-size: 14px;
        opacity: 0.9;
    }

    .kpi-value {
        font-size: 28px;
        font-weight: bold;
    }

    .card {
        background: white;
        border-radius: 10px;
        padding: 20px;
    }

    .sync-table {
        width: 100%;
        border-collapse: collapse;
    }

        .sync-table th,
        .sync-table td {
            padding: 12px;
            text-align: center;
        }

        .sync-table tr {
            cursor: pointer;
            border-bottom: 1px solid #eee;
        }

            .sync-table tr:hover {
                background: #f9f9f9;
            }

    .status.safe {
        color: #2ecc71;
        font-weight: bold;
    }

    .status.warning {
        color: #f39c12;
        font-weight: bold;
    }

    .status.danger {
        color: #e74c3c;
        font-weight: bold;
    }

    /* MODAL */
    .modal {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        justify-content: center;
        align-items: center;
    }

    .modal-content {
        background: white;
        padding: 20px;
        border-radius: 10px;
        width: 500px;
    }

</style>

<div class="page-container">

    <!-- FILTERS -->
    <div class="filter-bar">
        <select>
            <option>Mango</option>
            <option>Guava</option>
        </select>

        <select>
            <option>Alphonso</option>
            <option>Kesar</option>
        </select>

        <select>
            <option>September 2025</option>
        </select>
    </div>

    <!-- KPI CARDS -->
    <div class="kpi-grid">
        <div class="kpi green">
            <span class="kpi-label">Ready</span>
            <span class="kpi-value">140</span>
        </div>
        <div class="kpi red">
            <span class="kpi-label">Booked</span>
            <span class="kpi-value">160</span>
        </div>
        <div class="kpi amber">
            <span class="kpi-label">Expiring</span>
            <span class="kpi-value">30</span>
        </div>
        <div class="kpi danger">
            <span class="kpi-label">Waste %</span>
            <span class="kpi-value">21%</span>
        </div>
    </div>

    <!-- WEEKLY TABLE -->
    <div class="card">
        <h3>Weekly Synchronization</h3>

        <table class="sync-table">
            <thead>
                <tr>
                    <th>Week</th>
                    <th>Ready</th>
                    <th>Booked</th>
                    <th>Expiring</th>
                    <th>Net</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <tr class="risk shortage" onclick="openPopup()">
                    <td>W1 (Sep 1–7)</td>
                    <td>120</td>
                    <td>90</td>
                    <td>10</td>
                    <td>+20</td>
                    <td><span class="status safe">Safe</span></td>
                </tr>

                <tr class="risk shortage" onclick="openPopup()">
                    <td>W2 (Sep 8–14)</td>
                    <td>140</td>
                    <td>160</td>
                    <td>30</td>
                    <td>-50</td>
                    <td><span class="status danger">Shortage</span></td>
                </tr>

                <tr class="risk waste" onclick="openPopup()">
                    <td>W3 (Sep 15–21)</td>
                    <td>200</td>
                    <td>110</td>
                    <td>80</td>
                    <td>+10</td>
                    <td><span class="status warning">Waste Risk</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- POPUP -->
<div id="popup" class="modal">
    <div class="modal-content">
        <h3>Week 3 – Mango Alphonso</h3>

        <h4>Expiring Inventory</h4>
        <table>
            <tr><td>Batch A</td><td>40</td><td>Expires Sep 19</td></tr>
            <tr><td>Batch B</td><td>40</td><td>Expires Sep 20</td></tr>
        </table>

        <h4>Bookings</h4>
        <table>
            <tr><td>#451</td><td>30</td><td>Sep 18</td></tr>
            <tr><td>#462</td><td>40</td><td>Sep 20</td></tr>
        </table>

        <button onclick="closePopup()">Close</button>
    </div>
</div>

<script>
    function openPopup() {
        document.getElementById("popup").style.display = "flex";
    }
    function closePopup() {
        document.getElementById("popup").style.display = "none";
    }
</script>
