@page
@model PlantStockManager.Pages.Data.test201225Model

@{
    ViewData["Title"] = "Weekly Sowing & Booking Planner";
}



<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background: #f4f6f9;
    }

    .planner-container {
        padding: 24px;
    }

    h2 {
        margin-bottom: 4px;
    }

    .subtext {
        color: #666;
        margin-bottom: 15px;
    }

    /* FILTERS */
    .filter-bar {
        display: flex;
        gap: 12px;
        margin-bottom: 15px;
    }

    .filter-bar select {
        padding: 8px 10px;
        border-radius: 6px;
        border: 1px solid #ccc;
    }

    /* LEGEND */
    .legend {
        margin-bottom: 12px;
        font-size: 14px;
    }

    .dot {
        height: 10px;
        width: 10px;
        border-radius: 50%;
        display: inline-block;
        margin: 0 5px;
    }

    .green { background: #2ecc71; }
    .red { background: #e74c3c; }
    .orange { background: #f39c12; }

    /* WEEK TABLE */
    .table-wrapper {
        background: white;
        border-radius: 10px;
        padding: 15px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 12px;
        text-align: center;
        font-size: 14px;
    }

    th {
        background: #f1f3f6;
        font-weight: 600;
    }

    tr {
        border-bottom: 1px solid #eee;
        cursor: pointer;
    }

    tr.safe:hover { background: #ecf9f1; }
    tr.shortage:hover { background: #fdecea; }
    tr.waste:hover { background: #fff5e6; }

    /* MODAL */
    .modal {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.55);
        justify-content: center;
        align-items: center;
        z-index: 999;
    }

    .modal-content {
        background: white;
        width: 95%;
        max-width: 1200px;
        border-radius: 12px;
        padding: 20px;
    }

    .modal-header {
        border-bottom: 1px solid #eee;
        padding-bottom: 10px;
    }

    .modal-header h3 {
        margin: 0;
    }

    .analysis-box {
        display: flex;
        gap: 20px;
        margin-top: 12px;
    }

    .analysis-card {
        flex: 1;
        padding: 12px;
        border-radius: 8px;
        text-align: center;
        color: white;
        font-weight: 600;
    }

    .analysis-card.safe { background: #2ecc71; }
    .analysis-card.shortage { background: #e74c3c; }
    .analysis-card.waste { background: #f39c12; }

    /* PARALLEL TABLES */
    .parallel-section {
        display: flex;
        gap: 20px;
        margin-top: 20px;
    }

    .parallel-box {
        flex: 1;
        background: #fafafa;
        border-radius: 10px;
        padding: 12px;
    }

    .parallel-box h4 {
        margin-bottom: 8px;
        text-align: center;
    }

    .parallel-box table th {
        background: #e9ecef;
    }

    .close-btn {
        margin-top: 15px;
        padding: 8px 16px;
        border: none;
        background: #333;
        color: white;
        border-radius: 6px;
        cursor: pointer;
    }
</style>

<div class="planner-container">

    <!-- HEADER -->
    <h2>Weekly Sowing–Inventory–Booking Planner</h2>
    <div class="subtext">Weeks are calculated from <strong>Monday to Sunday</strong></div>

    <!-- FILTERS -->
    <div class="filter-bar">
        <select><option>2025</option></select>
        <select><option>Mango</option><option>Guava</option></select>
        <select><option>Alphonso</option><option>Kesar</option></select>
    </div>

    <!-- LEGEND -->
    <div class="legend">
        <span class="dot green"></span> Safe
        <span class="dot red"></span> Shortage
        <span class="dot orange"></span> Waste Risk
    </div>

    <!-- WEEK TABLE -->
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>Week</th>
                    <th>Date Range</th>
                    <th>Ready</th>
                    <th>Booked</th>
                    <th>Expiring</th>
                    <th>Net</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <tr class="safe" onclick="openModal()">
                    <td>W35</td>
                    <td>Aug 26 – Sep 1</td>
                    <td>120</td>
                    <td>90</td>
                    <td>10</td>
                    <td>+20</td>
                    <td>🟢 Safe</td>
                </tr>

                <tr class="shortage" onclick="openModal()">
                    <td>W36</td>
                    <td>Sep 2 – Sep 8</td>
                    <td>140</td>
                    <td>180</td>
                    <td>30</td>
                    <td>-70</td>
                    <td>🔴 Shortage</td>
                </tr>

                <tr class="waste" onclick="openModal()">
                    <td>W37</td>
                    <td>Sep 9 – Sep 15</td>
                    <td>200</td>
                    <td>110</td>
                    <td>80</td>
                    <td>+10</td>
                    <td>🟠 Waste Risk</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL -->
<div id="weekModal" class="modal">
    <div class="modal-content">

        <!-- HEADER -->
        <div class="modal-header">
            <h3>Week 37 — Mango / Alphonso</h3>
            <div class="subtext">Mon Sep 9 – Sun Sep 15</div>

            <!-- ANALYSIS -->
            <div class="analysis-box">
                <div class="analysis-card waste">
                    ⚠️ 80 plants will expire this week
                </div>
                <div class="analysis-card shortage">
                    📉 Demand exceeds supply by 70
                </div>
                <div class="analysis-card safe">
                    ✅ Action: Push Sales + Reduce Sowing
                </div>
            </div>
        </div>

        <!-- PARALLEL TABLES -->
        <div class="parallel-section">

            <!-- SOWING -->
            <div class="parallel-box">
                <h4>🌱 Sowing</h4>
                <table>
                    <tr><th>Date</th><th>Qty</th><th>Ready On</th></tr>
                    <tr><td>Aug 18</td><td>60</td><td>Sep 8</td></tr>
                    <tr><td>Aug 20</td><td>40</td><td>Sep 10</td></tr>
                </table>
            </div>

            <!-- INVENTORY -->
            <div class="parallel-box">
                <h4>📦 Inventory (Expiring)</h4>
                <table>
                    <tr><th>Batch</th><th>Qty</th><th>Expires</th></tr>
                    <tr><td>INV-112</td><td>40</td><td>Sep 11</td></tr>
                    <tr><td>INV-115</td><td>40</td><td>Sep 12</td></tr>
                </table>
            </div>

            <!-- BOOKINGS -->
            <div class="parallel-box">
                <h4>📑 Bookings</h4>
                <table>
                    <tr><th>Order</th><th>Qty</th><th>Delivery</th></tr>
                    <tr><td>#452</td><td>30</td><td>Sep 10</td></tr>
                    <tr><td>#459</td><td>40</td><td>Sep 13</td></tr>
                </table>
            </div>

        </div>

        <button class="close-btn" onclick="closeModal()">Close</button>
    </div>
</div>

<script>
    function openModal() {
        document.getElementById("weekModal").style.display = "flex";
    }

    function closeModal() {
        document.getElementById("weekModal").style.display = "none";
    }
</script>
