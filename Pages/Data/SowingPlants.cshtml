@page
@model PlantStockManager.Pages.Data.SowingPlantsModel
@using System.Globalization

@{
    ViewData["Title"] = "Sowing Records";
}

@functions {
    private static string ToTitle(string s)
    {
        if (string.IsNullOrWhiteSpace(s)) return s;
        s = s.ToLowerInvariant();
        return CultureInfo.CurrentCulture.TextInfo.ToTitleCase(s);
    }
}

<div class="p-3">
    <h2 class="mb-3">Sowing Records</h2>

    <!-- Filters -->
    <form method="get" class="row g-2 g-md-3 align-items-end">
        <div class="col-6 col-md-2">
            <label class="form-label small">Polyhouse</label>
            <select asp-for="SelectedPolyhouse" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All</option>
                @foreach (var polyhouse in Model.Polyhouses)
                {
                    <option value="@polyhouse.Id">@polyhouse.Name</option>
                }
            </select>
        </div>

        <div class="col-6 col-md-2">
            <label class="form-label small">Plant Type</label>
            <select asp-for="SelectedPlantType" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All</option>
                @foreach (var plantType in Model.PlantTypes)
                {
                    <option value="@plantType.Id">@plantType.Name</option>
                }
            </select>
        </div>

        <div class="col-6 col-md-2 ">
            <label class="form-label small ">Species</label>
            <select asp-for="SelectedSpecies" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All</option>
                @foreach (var species in Model.PlantSpecies)
                {
                    <option value="@species.Id">@species.Name</option>
                }
            </select>
        </div>

        <div class="col-6 col-md-2">
            <label class="form-label small">From</label>
            <input type="date" asp-for="FromDate" class="form-control form-control-sm" onchange="this.form.submit()" />
        </div>

        <div class="col-6 col-md-2">
            <label class="form-label small">To</label>
            <input type="date" asp-for="ToDate" class="form-control form-control-sm" onchange="this.form.submit()" />
        </div>

        <div class="col-12 col-md-2 d-flex flex-column flex-md-row gap-2 mt-2 mt-md-0">
            <button type="submit" class="btn btn-sm btn-primary w-100 w-md-auto">Filter</button>
            <a asp-page="/Data/SowingPlants"
               asp-route-handler="GeneratePdf"
               asp-route-SelectedPolyhouse="@Model.SelectedPolyhouse"
               asp-route-SelectedPlantType="@Model.SelectedPlantType"
               asp-route-SelectedSpecies="@Model.SelectedSpecies"
               class="btn btn-sm btn-secondary w-100 w-md-auto"
               target="_blank">
                PDF
            </a>
        </div>
    </form>

    <!-- Table -->
    <div class="table-responsive" style="max-height: 570px; overflow-y: auto; overflow-x: auto; border: 1px solid #ddd; margin-top: 10px; position: relative; z-index: 0;">
        <table class="table table-striped table-sm m-0">
            <thead class="table-dark">
                <tr class="sticky-table-header">

                    <th>Batch No</th>
                    <th>Polyhouse</th>
                    <th>Plant Type</th>
                    <th>Variety</th>
                    <th>Supervisor</th>
                    <th>Seeds</th>
                    <th>In Trays</th>
                    <th>Hardening</th>
                    <th>In Stock</th>
                    <th>Seeding Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Model.SeedEntries)
                {
                    <tr>
                        <td>#@record.Id</td>
                        <td>@ToTitle(record.PolyhouseName)</td>
                        <td>@ToTitle(record.PlantTypeName)</td>
                        <td>@ToTitle(record.SpeciesName)</td>
                        <td>@ToTitle(record.Supervisor)</td>
                        <td>@record.SeedsPlanted</td>
                        <td>@(record.TraysAlive?.ToString() ?? "Balance")</td>
                        <td>@(record.HardeningAlive?.ToString() ?? "Balance")</td>
                        <td>@(record.AliveCount?.ToString() ?? "Balance")</td>
                        <td>@record.SeedingDate.ToString("dd-MMMM-yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>



<style>
    .sticky-table-header {
        position: sticky;
        top: 0;
        background-color: #212529;
        color: white;
        z-index: 1;
    }

    /* Override sticky header on mobile to prevent overlaying sidebar */
    @@media (max-width: 768px) {
        .sticky-table-header

    {
        position: static !important;
    }

    h2 {
        font-size: 1.25rem;
    }

    .form-label, .form-control, .form-select {
        font-size: 0.85rem;
    }

    .table-responsive thead th {
        background-color: #343a40 !important;
        color: white;
    }

    .table th, .table td {
        font-size: 0.75rem;
        padding: 0.4rem;
    }

    .btn {
        font-size: 0.75rem;
    }

    .species {
        display: none;
    }

    }
</style>

