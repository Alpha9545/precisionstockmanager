@page
@model PlantStockManager.Pages.Data.ReadyStockModel
@using System.Globalization

@attribute [IgnoreAntiforgeryToken]
@{
    ViewData["Title"] = "Ready Stock";
}

@functions {
    private static string ToTitle(string s)
    {
        if (string.IsNullOrWhiteSpace(s)) return s;
        s = s.ToLowerInvariant();
        return CultureInfo.CurrentCulture.TextInfo.ToTitleCase(s);
    }
}

<div class="container-fluid px-2 py-2">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="h5 mb-0">Ready Stock</h2>
    </div>

    <!-- Filters -->
    <form method="get" class="row gy-2 gx-2 align-items-end bg-light p-2 rounded shadow-sm">
        <div class="col-12 col-sm-6 col-md-3">
            <label class="form-label small">Polyhouse</label>
            <select asp-for="SelectedPolyhouse" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All</option>
                @foreach (var polyhouse in Model.Polyhouses)
                {
                    <option value="@polyhouse.Id">@polyhouse.Name</option>
                }
            </select>
        </div>

        <div class="col-12 col-sm-6 col-md-3">
            <label class="form-label small">Plant Type</label>
            <select asp-for="SelectedPlantType" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All</option>
                @foreach (var plantType in Model.PlantTypes)
                {
                    <option value="@plantType.Id">@plantType.Name</option>
                }
            </select>
        </div>

        <div class="col-12 col-sm-6 col-md-3">
            <label class="form-label small">Species</label>
            <select asp-for="SelectedSpecies" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All</option>
                @foreach (var species in Model.PlantSpecies)
                {
                    <option value="@species.Id">@species.Name</option>
                }
            </select>
        </div>

        <div class="col-12 col-sm-6 col-md-3 d-flex flex-wrap gap-1">
            <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Filter</button>
            <a asp-page="/Data/ReadyStock"
               asp-route-handler="GeneratePdf"
               asp-route-SelectedPolyhouse="@Model.SelectedPolyhouse"
               asp-route-SelectedPlantType="@Model.SelectedPlantType"
               asp-route-SelectedSpecies="@Model.SelectedSpecies"
               class="btn btn-secondary btn-sm flex-grow-1 " target="_blank">
                Generate PDF
            </a>

            <a asp-page="/Data/ReadyStock"
               asp-route-handler="GenerateExcel" 
               asp-route-SelectedPolyhouse="@Model.SelectedPolyhouse"
               asp-route-SelectedPlantType="@Model.SelectedPlantType"
               asp-route-SelectedSpecies="@Model.SelectedSpecies"
               class="btn btn-success btn-sm flex-grow-1"  >
                Export Excel
            </a>

        </div>

    </form>

    <!-- Table -->
    @if (Model.Inventory.Any())
    {
        <div class="table-responsive mt-3">
            <table class="table table-striped table-sm table-hover align-middle">
                <thead class="table-dark sticky-header">
                    <tr>
                        <th>Batch No</th>
                        <th>Polyhouse</th>
                        <th>Plant Type</th>
                        <th>Variety</th>
                        <th>Supervisor</th>
                        <th>Seeding Date</th>
                        <th>Available Qty</th>
                        <th>Ready Date</th>
                        <th>Location</th>
                        
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model.Inventory)
                    {
                        <tr>
                            <td>#@record.SeedEntryId</td>
                            <td>@ToTitle(record.PolyhouseName)</td>
                            <td>@ToTitle(record.PlantTypeName)</td>
                            <td>@ToTitle(record.SpeciesName)</td>
                            <td>@ToTitle(record.Supervisor)</td>
                            <td>@record.SeedingDate.ToString("dd-MMMM-yyyy")</td>
                            <td>@record.Quantity</td>
                            <td>@record.LastUpdated.ToString("dd-MMMM-yyyy")</td>
                            <td>@ToTitle(record.LocationDesc)</td>
                            
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center mt-4">
            No results found for the specified search.
        </div>
    }
</div>


<style>
    .sticky-header tr {
        position: sticky;
        top: 0;
        background-color: #212529;
        color: white;
        z-index: 1;
    }

    /* Disable sticky header on mobile to prevent overlap */
    @@media (max-width: 768px) {
        .sticky-header tr

    {
        position: static !important;
    }

    h2, .h5 {
        font-size: 1rem;
    }

    .form-label, .form-control, .form-select, .btn {
        font-size: 0.8rem;
    }

    table th, table td {
        font-size: 0.7rem;
        padding: 0.35rem;
    }

    .table-responsive {
        font-size: 0.8rem;
    }

    }
</style>

