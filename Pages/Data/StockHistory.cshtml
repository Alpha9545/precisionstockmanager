@page
@model PlantStockManager.Pages.Data.StockHistoryModel
@{
    ViewData["Title"] = "Stock History";
}

<div class="container-fluid mt-4">
    <h3 class="mb-3">Stock History</h3>

    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-md-2">
            <label class="form-label mb-0">Stock</label>
            <select name="stockType" class="form-select">
                @foreach (var t in PlantStockManager.Data.StockHistoryRepository.StockTypes)
                {
                    <option value="@t.Key" selected="@(t.Key == Model.StockType)">@t.Value</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label mb-0">From</label>
            <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label mb-0">To</label>
            <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label mb-0">Area</label>
            <select name="areaId" class="form-select">
                <option value="">All Areas</option>
                @foreach (var a in Model.Areas)
                {
                    <option value="@a.Id" selected="@(a.Id == Model.AreaId)">@a.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label mb-0">Search</label>
            <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Variety, lot, pot size, batch" />
        </div>
        <div class="col-md-1"><button class="btn btn-primary w-100">Show</button></div>
    </form>

    <p class="text-muted small mb-2">Opening (before @Model.From.ToString("dd/MM/yyyy")) + Incoming &minus; Outgoing = Balance (end of @Model.To.ToString("dd/MM/yyyy")). Reservations are not stock movements and are not counted.</p>

    <div class="table-responsive mb-4">
        <table class="table table-bordered table-striped table-sm">
            <thead class="table-light">
                <tr><th>Item</th><th>Area</th><th class="text-end">Opening</th><th class="text-end">Incoming</th><th class="text-end">Outgoing</th><th class="text-end">Balance</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>@r.Item</td>
                        <td>@(r.AreaName ?? "-")</td>
                        <td class="text-end">@r.Summary.Opening.ToString("N0")</td>
                        <td class="text-end text-success">@r.Summary.Incoming.ToString("N0")</td>
                        <td class="text-end text-danger">@r.Summary.Outgoing.ToString("N0")</td>
                        <td class="text-end fw-bold">@r.Summary.Balance.ToString("N0")</td>
                    </tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted">No stock movements.</td></tr>
                }
            </tbody>
            @if (Model.Rows.Any())
            {
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="2">Total</td>
                        <td class="text-end">@Model.Rows.Sum(r => r.Summary.Opening).ToString("N0")</td>
                        <td class="text-end">@Model.Rows.Sum(r => r.Summary.Incoming).ToString("N0")</td>
                        <td class="text-end">@Model.Rows.Sum(r => r.Summary.Outgoing).ToString("N0")</td>
                        <td class="text-end">@Model.Rows.Sum(r => r.Summary.Balance).ToString("N0")</td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>

    <h5>Movements in the period</h5>
    <div class="table-responsive">
        <table class="table table-bordered table-sm">
            <thead class="table-light">
                <tr><th>Date</th><th>Item</th><th>Area</th><th>Type</th><th class="text-end">Quantity</th><th>Reference</th><th>By</th><th>Remarks</th></tr>
            </thead>
            <tbody>
                @foreach (var m in Model.PeriodMovements)
                {
                    <tr>
                        <td class="text-nowrap">@m.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@m.Item</td>
                        <td>@(m.AreaName ?? "-")</td>
                        <td>@m.TransactionType</td>
                        <td class="text-end @(m.Quantity < 0 ? "text-danger" : "text-success")">@m.Quantity.ToString("N0")</td>
                        <td>@m.Reference</td>
                        <td>@m.UserName</td>
                        <td>@m.Remarks</td>
                    </tr>
                }
                @if (!Model.PeriodMovements.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted">No movements in this period.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
