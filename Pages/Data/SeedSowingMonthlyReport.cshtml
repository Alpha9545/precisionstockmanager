@page
@model PlantStockManager.Pages.Data.SeedSowingMonthlyReportModel
@{
    ViewData["Title"] = "Sowing Monthly Report";
}

<div class="p-3">
    <h2>Sowing Daywise Monthly Report</h2>
    <div class="small text-muted mb-2">
        From the current Seed Sowing workflow (dbo.SeedSowings). Cancelled sowings are excluded.
    </div>

    @if (Model.FilterNotice != null)
    {
        <div class="alert alert-warning">@Model.FilterNotice</div>
    }

    <form method="get" class="mb-3" id="filterForm">
        <div class="row g-2 align-items-end">
            <div class="col-6 col-md-3">
                <label>Area</label>
                <select name="AreaId" class="form-control" onchange="this.form.submit()">
                    <option value="">All (accessible)</option>
                    @foreach (var a in Model.Areas)
                    {
                        <option value="@a.Id" selected="@(Model.AreaId == a.Id)">@a.Name</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label>Plant Type</label>
                <select name="PlantTypeId" class="form-control" onchange="this.form.submit()">
                    <option value="">All</option>
                    @foreach (var pt in Model.PlantTypes)
                    {
                        <option value="@pt.Id" selected="@(Model.PlantTypeId == pt.Id)">@pt.Name</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label>Month</label>
                <select name="Month" class="form-control" onchange="this.form.submit()">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(Model.Month == m)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label>Year</label>
                <select name="Year" class="form-control" onchange="this.form.submit()">
                    @foreach (var y in Model.YearOptions)
                    {
                        <option value="@y" selected="@(Model.Year == y)">@y</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-1">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
            <div class="col-6 col-md-1 print-button">
                <button type="button" onclick="printTable()" class="btn btn-secondary w-100">Print</button>
            </div>
        </div>
    </form>

    <h5>@Model.MonthName</h5>

    <div class="table-container">
        <table class="custom-table" id="sowingTable">
            <thead>
                <tr>
                    <th>Area</th>
                    <th>Plant Type</th>
                    <th>Species</th>
                    @for (int day = 1; day <= Model.DaysInMonth; day++)
                    {
                        <th>@day</th>
                    }
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr><td colspan="@(Model.DaysInMonth + 4)" class="text-center text-muted">No sowings recorded for this month.</td></tr>
                }
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td>@row.AreaName</td>
                        <td>@row.PlantTypeName</td>
                        <td>@row.SpeciesName</td>
                        @foreach (var qty in row.DailyQuantities)
                        {
                            <td>@(qty > 0 ? qty.ToString("N0") : "")</td>
                        }
                        <td><strong>@row.MonthTotal.ToString("N0")</strong></td>
                    </tr>
                }
            </tbody>
            @if (Model.Rows.Count > 0)
            {
                <tfoot>
                    <tr>
                        <th colspan="3">Day Total</th>
                        @foreach (var qty in Model.DailyTotals)
                        {
                            <th>@(qty > 0 ? qty.ToString("N0") : "")</th>
                        }
                        <th>@Model.GrandTotal.ToString("N0")</th>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>

<style>

    .table-container {
        overflow: auto;
        max-height: 570px;
        border: 1px solid #ccc;
        margin-top: 15px;
    }

    .custom-table {
        border-collapse: collapse;
        width: max-content;
        min-width: 100%;
        table-layout: fixed;
    }

    .custom-table th, .custom-table td {
        border: 1px solid #ddd;
        padding: 6px;
        text-align: center;
        white-space: nowrap;
        font-size: 0.875rem;
    }

    .custom-table thead th {
        background-color: #f8f9fa;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    .custom-table tfoot th {
        background-color: #eef2f5;
        position: sticky;
        bottom: 0;
    }

    .custom-table tbody tr:nth-child(even) {
        background-color: #f9f9f9;
    }

    .custom-table tbody tr:hover {
        background-color: #f1f1f1;
    }

    @@media print {
        @@page {
            size: landscape;
            margin: 0.5cm;
        }

        body {
            font-size: 8px;
            margin: 0;
            padding: 0;
        }

        table {
            width: 100% !important;
            font-size: 8px;
            table-layout: auto;
        }

        .custom-table th, .custom-table td {
            border: 1px solid #000;
            padding: 2px;
        }

        thead {
            display: table-header-group;
        }

        .table-container {
            overflow: visible !important;
            height: auto !important;
            width: 100% !important;
        }
    }

    @@media (max-width: 768px) {
        .print-button {
            display: none;
        }
    }
</style>

<script>
    function printTable() {
        const tableContent = document.querySelector('.table-container').innerHTML;
        const form = document.getElementById("filterForm");

        const area = form.AreaId?.selectedOptions[0]?.text || 'All (accessible)';
        const plantType = form.PlantTypeId?.selectedOptions[0]?.text || 'All';
        const month = form.Month?.selectedOptions[0]?.text || '';
        const year = form.Year?.selectedOptions[0]?.text || '';

        const filterSummary = `
            <div style="margin-bottom: 10px; font-size: 10px;">
                <strong>Filters : </strong>
                Area: ${area} &nbsp;&nbsp; |
                Plant Type: ${plantType} &nbsp;&nbsp; |
                Month: ${month} &nbsp;&nbsp; |
                Year: ${year}
            </div>
        `;

        const originalContent = document.body.innerHTML;

        document.body.innerHTML = `
            <style>
                @@media print {
                    @@page { size: landscape; margin: 0.5cm; }
                    body { font-size: 8px; margin: 0; padding: 0; }
                    table { width: 100%; font-size: 8px; border-collapse: collapse; }
                    th, td {
                        border: 1px solid #000;
                        padding: 2px;
                        word-wrap: break-word;
                        text-align: center;
                    }
                    thead { display: table-header-group; }
                }
            </style>
            <h2 style="margin-bottom: 5px;">Sowing Daywise Monthly Report</h2>
            ${filterSummary}
            ${tableContent}
        `;

        window.print();
        document.body.innerHTML = originalContent;
        window.location.reload();
    }
</script>
