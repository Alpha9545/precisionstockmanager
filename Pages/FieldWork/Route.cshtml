@page
@model PlantStockManager.Pages.FieldWork.RouteModel
@using PlantStockManager.Services
@using PlantStockManager.Services.FieldWork
@using PlantStockManager.Pages.FieldWork
@{
    ViewData["Title"] = Model.CanManage ? "Route" : "My Route";
}
<link rel="stylesheet" href="~/lib/leaflet/dist/leaflet.css" />
<link rel="stylesheet" href="~/css/fieldwork.css" asp-append-version="true" />

<div class="fw-page-wide">
    <div class="d-flex justify-content-between align-items-center mt-2 mb-2 flex-wrap gap-2">
        <h4 class="mb-0">@ViewData["Title"]</h4>
        @if (Model.CanManage)
        {
            <a asp-page="/FieldWork/Manage/Team" class="btn btn-sm btn-outline-secondary">Team today</a>
        }
    </div>

    @if (!Model.SchemaReady)
    {
        <div class="alert alert-warning">@PlantStockManager.Data.FieldWorkSchema.MigrationMessage</div>
    }
    else
    {
        <form method="get" class="fw-step row g-2 align-items-end">
            @if (Model.CanManage)
            {
                <div class="col-12 col-md-4">
                    <label class="form-label small mb-0" for="emp">Employee</label>
                    <select id="emp" name="EmployeeId" class="form-select form-select-sm">
                        <option value="">Me</option>
                        @foreach (var e in Model.Employees)
                        {
                            <option value="@e.UserId" selected="@(Model.EmployeeId == e.UserId)">@e.Name</option>
                        }
                    </select>
                </div>
            }
            <div class="col-8 col-md-3">
                <label class="form-label small mb-0" for="date">Date</label>
                <input type="date" id="date" name="Date" class="form-control form-control-sm" value="@Model.ShownDate.ToString("yyyy-MM-dd")"
                       max="@AppClock.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-4 col-md-2 d-grid"><button type="submit" class="btn btn-sm btn-primary">Show</button></div>
        </form>

        @if (Model.View == null)
        {
            <div class="alert alert-light border">No Field Day was recorded on @Model.ShownDate.ToString("ddd, dd MMM yyyy").</div>
        }
        else
        {
            var d = Model.View.Day;
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                <div>
                    <strong>@d.EmployeeName</strong> · @d.WorkDate.ToString("ddd, dd MMM yyyy")@(d.VehicleType != null ? " · " + FieldDayRules.VehicleLabel(d.VehicleType) : "")
                    <span class="badge bg-light text-dark border">@FieldDayRules.StatusLabel(d.Status)</span>
                </div>
                <a asp-page="/FieldWork/DayDetails" asp-route-id="@d.Id" class="btn btn-sm btn-outline-secondary">Day details</a>
            </div>
            <partial name="_RouteMap" model="new RouteMapModel(Model.View, Model.Options)" />
        }

        @if (!Model.CanManage && Model.MyRecentDays.Any())
        {
            <h6 class="mt-3">My recent days</h6>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var day in Model.MyRecentDays)
                {
                    <a asp-page="/FieldWork/Route" asp-route-Date="@day.WorkDate.ToString("yyyy-MM-dd")"
                       class="btn btn-sm @(day.WorkDate.Date == Model.ShownDate ? "btn-primary" : "btn-outline-secondary")">@day.WorkDate.ToString("dd MMM")</a>
                }
            </div>
        }
    }
</div>

@section Scripts {
    <script src="~/lib/leaflet/dist/leaflet.js"></script>
    <script src="~/js/fieldwork-route.js" asp-append-version="true"></script>
}
