@page
@model PlantStockManager.Pages.FieldWork.Customers.NoteModel
@using PlantStockManager.Services
@using PlantStockManager.Services.FieldWork
@using PlantStockManager.Pages.FieldWork
@{
    ViewData["Title"] = Model.IsCorrection ? "Correction" : "Call / Note";
    var today = AppClock.Today;
}
<link rel="stylesheet" href="~/css/fieldwork.css" asp-append-version="true" />

<div class="fw-page">
    <div class="d-flex justify-content-between align-items-center mt-2 mb-2">
        <h4 class="mb-0">@ViewData["Title"]</h4>
        <a asp-page="/FieldWork/Customers/Details" asp-route-id="@Model.CustomerId" class="btn btn-sm btn-outline-secondary">Back</a>
    </div>
    @if (!Model.SchemaReady)
    {
        <div class="alert alert-warning">@PlantStockManager.Data.FieldCustomerSchema.MigrationMessage</div>
    }
    else
    {
        <div class="text-muted mb-2">@Model.Customer.Name · @Model.Customer.VillageCity · <span class="badge bg-info text-dark">@FieldCustomerRules.LeadLabel(Model.Customer.LeadStatus)</span></div>
        @if (Model.Errors.Any()) { <div class="alert alert-danger"><ul class="mb-0">@foreach (var e in Model.Errors) { <li>@e</li> }</ul></div> }

        @if (Model.Visit != null)
        {
            <div class="fw-step small">
                <div class="fw-step-title">Visit of @FieldWorkReadingPageModel.Ist(Model.Visit.CheckInAtUtc) by @Model.Visit.EmployeeName</div>
                <div><span class="text-muted">Discussed:</span> @Model.Visit.Discussed</div>
                @if (Model.Visit.Notes != null) { <div><span class="text-muted">Notes:</span> @Model.Visit.Notes</div> }
                <div class="form-text">A saved visit is not changed. Your correction is added below it, with your name and the time.</div>
            </div>
        }

        <form method="post" asp-route-customerId="@Model.CustomerId" asp-route-visitId="@Model.VisitId">
            <input type="hidden" name="SubmitToken" value="@Model.SubmitToken" />
            @if (!Model.IsCorrection)
            {
                <div class="fw-step">
                    <div class="btn-group w-100" role="group" aria-label="Type">
                        <input type="radio" class="btn-check" name="NoteType" id="ntCall" value="Call" checked="@(Model.NoteType != "Note")" />
                        <label class="btn btn-outline-primary" for="ntCall">Phone call</label>
                        <input type="radio" class="btn-check" name="NoteType" id="ntNote" value="Note" checked="@(Model.NoteType == "Note")" />
                        <label class="btn btn-outline-primary" for="ntNote">Note</label>
                    </div>
                </div>
            }
            <div class="fw-step">
                <label class="fw-step-title form-label" for="ntText">@(Model.IsCorrection ? "Correction" : "What was discussed")</label>
                <textarea id="ntText" name="Text" class="form-control" rows="4" maxlength="1000" required>@Model.Text</textarea>
            </div>

            @if (!Model.IsCorrection)
            {
                <div class="fw-step">
                    <label class="fw-step-title form-label" for="ntStatus">Lead status</label>
                    <select id="ntStatus" name="NewLeadStatus" class="form-select">
                        <option value="">Keep: @FieldCustomerRules.LeadLabel(Model.Customer.LeadStatus)</option>
                        @foreach (var s in FieldCustomerRules.LeadStatuses.Where(s => s.Key != Model.Customer.LeadStatus))
                        {
                            <option value="@s.Key" selected="@(Model.NewLeadStatus == s.Key)">@s.Value</option>
                        }
                    </select>
                </div>

                <div class="fw-step">
                    <div class="fw-step-title">Follow-up</div>
                    @if (Model.Pending != null)
                    {
                        <div class="form-check mb-2">
                            <input type="checkbox" class="form-check-input" id="ntCompletes" name="CompletesFollowUp" value="true" checked="@Model.CompletesFollowUp" />
                            <input type="hidden" name="CompletesFollowUp" value="false" />
                            <label class="form-check-label" for="ntCompletes">
                                This completes the follow-up due <strong>@Model.Pending.DueDate.ToString("dd-MMM-yyyy")</strong>@(Model.Pending.Note != null ? ": " + Model.Pending.Note : "")
                            </label>
                        </div>
                    }
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small mb-0" for="ntNext">Next follow-up (optional)</label>
                            <input type="date" id="ntNext" name="NextFollowUpDate" value="@Model.NextFollowUpDate?.ToString("yyyy-MM-dd")" class="form-control"
                                   min="@today.ToString("yyyy-MM-dd")" max="@today.AddDays(FieldCustomerRules.MaxFollowUpDaysAhead).ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-12">
                            <input name="NextFollowUpNote" value="@Model.NextFollowUpNote" class="form-control form-control-sm" maxlength="500" placeholder="Follow-up note (optional)" />
                        </div>
                    </div>
                </div>
            }
            <button type="submit" class="btn btn-success w-100 fw-submit">Save</button>
        </form>
    }
</div>
