@page
@model PlantStockManager.Pages.FieldWork.Visits.CreateModel
@using PlantStockManager.Services
@using PlantStockManager.Services.FieldWork
@{
    ViewData["Title"] = "Log Visit";
    var today = AppClock.Today;
}
<link rel="stylesheet" href="~/css/fieldwork.css" asp-append-version="true" />

<div class="fw-page">
    <div class="d-flex justify-content-between align-items-center mt-2 mb-2">
        <h4 class="mb-0">Log visit</h4>
        <a asp-page="/FieldWork/Customers/Details" asp-route-id="@Model.CustomerId" class="btn btn-sm btn-outline-secondary">Back</a>
    </div>
    @if (!Model.SchemaReady)
    {
        <div class="alert alert-warning">@PlantStockManager.Data.FieldCustomerSchema.MigrationMessage</div>
    }
    else
    {
        <div class="text-muted mb-2">@Model.Customer.Name · @Model.Customer.VillageCity · <span class="badge bg-info text-dark">@FieldCustomerRules.LeadLabel(Model.Customer.LeadStatus)</span></div>

        @if (!Model.HasOpenDay)
        {
            <div class="alert alert-warning">
                <strong>@Model.DayMessage</strong>
                <div class="mt-2">@if (Model.DayMessage == FieldVisitService.NoOpenDayMessage) { <a asp-page="/FieldWork/StartDay" class="btn btn-sm btn-success">Start Day</a> }
                    <a asp-page="/FieldWork/Customers/Note" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-outline-primary">Log a call / note instead</a></div>
            </div>
        }
        else
        {
            <div class="alert alert-danger @(Model.Errors.Any() ? "" : "d-none")">
                <ul class="mb-0" id="fpClientErrors">@foreach (var e in Model.Errors) { <li>@e</li> }</ul>
            </div>
            @if (Model.Errors.Any())
            {
                <div class="alert alert-warning small">For safety the photos are not kept after an error. Take them again.</div>
            }

            <form method="post" enctype="multipart/form-data" id="fpForm" novalidate asp-route-customerId="@Model.CustomerId"
                  data-max-accuracy="@Model.MaxAccuracyMeters.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                  data-max-bytes="@Model.MaxPhotoBytes" data-max-photos="@Model.MaxPhotos" data-gps-required="true">
                <input type="hidden" name="SubmitToken" value="@Model.SubmitToken" />
                <div class="small text-muted mb-2">Check-in time is the server's time when you save.</div>

                <div class="fw-step">
                    <label class="fw-step-title form-label" for="vDiscussed">What was discussed</label>
                    <textarea id="vDiscussed" name="Discussed" class="form-control" rows="3" maxlength="1000" required>@Model.Discussed</textarea>
                    <label class="form-label small mt-2 mb-0" for="vNotes">Visit notes (optional)</label>
                    <textarea id="vNotes" name="Notes" class="form-control" rows="2" maxlength="2000">@Model.Notes</textarea>
                </div>

                <div class="fw-step">
                    <div class="fw-step-title">Items given (optional)</div>
                    <partial name="_ItemRows" model="((IReadOnlyList<string?>)Model.ItemText, (IReadOnlyList<string?>)Model.ItemQty)" />
                </div>

                <partial name="/Pages/FieldWork/_PhotosCapture.cshtml" model="Model.Capture" />

                <div class="fw-step">
                    <label class="fw-step-title form-label" for="vStatus">Lead status after this visit</label>
                    <select id="vStatus" name="NewLeadStatus" class="form-select">
                        <option value="">Keep: @FieldCustomerRules.LeadLabel(Model.Customer.LeadStatus)</option>
                        @foreach (var s in FieldCustomerRules.LeadStatuses.Where(s => s.Key != Model.Customer.LeadStatus))
                        {
                            <option value="@s.Key" selected="@(Model.NewLeadStatus == s.Key)">@s.Value</option>
                        }
                    </select>
                </div>

                <div class="fw-step">
                    <div class="fw-step-title">Next follow-up (optional)</div>
                    @if (Model.Pending != null)
                    {
                        <div class="small text-muted mb-2">This visit completes the follow-up due @Model.Pending.DueDate.ToString("dd-MMM-yyyy").</div>
                    }
                    <input type="date" name="NextFollowUpDate" value="@Model.NextFollowUpDate?.ToString("yyyy-MM-dd")" class="form-control mb-2"
                           min="@today.ToString("yyyy-MM-dd")" max="@today.AddDays(FieldCustomerRules.MaxFollowUpDaysAhead).ToString("yyyy-MM-dd")" aria-label="Next follow-up date" />
                    <input name="NextFollowUpNote" value="@Model.NextFollowUpNote" class="form-control form-control-sm" maxlength="500" placeholder="Follow-up note (optional)" />
                </div>

                <button type="submit" class="btn btn-success w-100 fw-submit" id="fpSubmit">Save visit</button>
            </form>
        }
    }
</div>

@section Scripts {
    <script src="~/js/fieldwork-photos.js" asp-append-version="true"></script>
}
