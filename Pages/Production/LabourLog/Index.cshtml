@page
@model PlantStockManager.Pages.Production.LabourLog.IndexModel
@{
    ViewData["Title"] = "Labour Log";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Labour Log</h2>
        <a asp-page="/Production/LabourLog/Create" class="btn btn-primary">+ New Labour Log</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total Wage (Recorded)</div>
                    <div class="fs-3 fw-bold">@Model.TotalWage.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Worker</th>
                    <th>Date</th>
                    <th>Area</th>
                    <th>Work Type</th>
                    <th>Reference</th>
                    <th>Units</th>
                    <th>Rate</th>
                    <th>Total Wage</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Logs)
                {
                    <tr>
                        <td>@l.LabourLogCode</td>
                        <td>@l.WorkerName</td>
                        <td>@l.WorkDate.ToString("dd/MM/yyyy")</td>
                        <td>@(l.AreaName ?? "Unassigned")</td>
                        <td>@l.WorkType</td>
                        <td>@(l.ReferenceCode ?? "-")</td>
                        <td>@l.UnitsWorked.ToString("N2") (@l.WageType)</td>
                        <td>@l.WageRate.ToString("N2")</td>
                        <td>@l.TotalWage.ToString("N2")</td>
                        <td>
                            @if (l.Status == "Cancelled")
                            {
                                <span class="badge bg-secondary">Cancelled</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Recorded</span>
                            }
                        </td>
                        <td>
                            <a asp-page="/Production/LabourLog/Details" asp-route-id="@l.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            @if (l.Status == "Recorded")
                            {
                                <a asp-page="/Production/LabourLog/Edit" asp-route-id="@l.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Logs.Any())
                {
                    <tr><td colspan="11" class="text-center text-muted">No Labour Logs found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
