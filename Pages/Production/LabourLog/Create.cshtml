@page
@model PlantStockManager.Pages.Production.LabourLog.CreateModel
@{
    ViewData["Title"] = "New Labour Log";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 800px;">
        <div class="card-header">
            <h4 class="mb-0">New Labour Log</h4>
        </div>
        <div class="card-body">
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form method="post">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Worker</label>
                        <select asp-for="Log.WorkerId" class="form-select" required>
                            <option value="">-- Select Worker --</option>
                            @foreach (var w in Model.Workers)
                            {
                                <option value="@w.EmployeeID">@w.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Work Date</label>
                        <input type="date" asp-for="Log.WorkDate" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Area</label>
                        <select asp-for="Log.AreaId" class="form-select">
                            <option value="">-- Unassigned --</option>
                            @foreach (var a in Model.Areas)
                            {
                                <option value="@a.Id">@a.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Work Type</label>
                        <input type="text" asp-for="Log.WorkType" class="form-control" placeholder="e.g. Cutting, Potting, Weeding" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Reference (optional)</label>
                        <input type="text" asp-for="Log.ReferenceCode" class="form-control" placeholder="e.g. related batch code, PROP-2026-00012" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Wage Type</label>
                        <select asp-for="Log.WageType" class="form-select">
                            <option value="Daily">Daily</option>
                            <option value="Hourly">Hourly</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Wage Rate</label>
                        <input type="number" step="0.01" min="0.01" asp-for="Log.WageRate" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Units Worked (days/hours)</label>
                        <input type="number" step="0.01" min="0.01" asp-for="Log.UnitsWorked" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Supervisor</label>
                        <select asp-for="Log.SupervisorId" class="form-select">
                            <option value="">-- None --</option>
                            @foreach (var w in Model.Workers)
                            {
                                <option value="@w.EmployeeID">@w.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Remarks</label>
                        <textarea asp-for="Log.Remarks" class="form-control" rows="2"></textarea>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <a asp-page="/Production/LabourLog/Index" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-success">Save Labour Log</button>
                </div>
            </form>
        </div>
    </div>
</div>
