@page "{id:int}"
@model PlantStockManager.Pages.Production.LabourLog.EditModel
@{
    ViewData["Title"] = "Edit Labour Log";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 800px;">
        <div class="card-header">
            <h4 class="mb-0">Edit Labour Log &mdash; @Model.Log.LabourLogCode</h4>
        </div>
        <div class="card-body">
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <div class="alert alert-secondary">
                <strong>@Model.Log.WorkerName</strong> &mdash; @Model.Log.WorkDate.ToString("dd/MM/yyyy") &mdash;
                @Model.Log.UnitsWorked.ToString("N2") @Model.Log.WageType @@ @Model.Log.WageRate.ToString("N2")
                = Total Wage <strong>@Model.Log.TotalWage.ToString("N2")</strong>
                <div class="small text-muted">
                    Worker/Wage/Units cannot be changed once recorded -- this is a wage record, not a draft.
                    Use "Cancel" below to void this entry entirely if it was a mistake.
                </div>
            </div>

            @if (Model.Log.Status == "Cancelled")
            {
                <div class="alert alert-warning">This Labour Log is Cancelled.</div>
            }

            <form method="post">
                <input type="hidden" asp-for="Log.Id" />
                <input type="hidden" asp-for="Log.LabourLogCode" />
                <input type="hidden" asp-for="Log.CreatedBy" />
                <input type="hidden" asp-for="Log.CreatedDate" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Area</label>
                        <select asp-for="Log.AreaId" class="form-select" disabled="@(Model.Log.Status == "Cancelled")">
                            <option value="">-- Unassigned --</option>
                            @foreach (var a in Model.Areas)
                            {
                                <option value="@a.Id">@a.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Work Type</label>
                        <input type="text" asp-for="Log.WorkType" class="form-control" disabled="@(Model.Log.Status == "Cancelled")" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Reference (optional)</label>
                        <input type="text" asp-for="Log.ReferenceCode" class="form-control" disabled="@(Model.Log.Status == "Cancelled")" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Supervisor</label>
                        <select asp-for="Log.SupervisorId" class="form-select" disabled="@(Model.Log.Status == "Cancelled")">
                            <option value="">-- None --</option>
                            @foreach (var w in Model.Workers)
                            {
                                <option value="@w.EmployeeID">@w.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">Remarks</label>
                        <textarea asp-for="Log.Remarks" class="form-control" rows="2" disabled="@(Model.Log.Status == "Cancelled")"></textarea>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <a asp-page="/Production/LabourLog/Index" class="btn btn-secondary me-2">Cancel</a>
                    @if (Model.Log.Status != "Cancelled")
                    {
                        <button type="submit" class="btn btn-success">Save Changes</button>
                    }
                </div>
            </form>

            @if (Model.Log.Status != "Cancelled")
            {
                <hr />
                <form method="post" asp-page-handler="Cancel" asp-route-id="@Model.Log.Id" onsubmit="return confirm('Cancel this Labour Log? This cannot be undone.');">
                    <div class="text-center">
                        <button type="submit" class="btn btn-outline-danger">Cancel Labour Log</button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>
