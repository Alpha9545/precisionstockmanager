@page "{id:int}"
@model PlantStockManager.Pages.Production.MotherPlant.EditModel
@{
    ViewData["Title"] = "Edit Mother Plant Batch";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 800px;">
        <div class="card-header">
            <h4 class="mb-0">Edit Mother Plant Batch &mdash; @Model.MotherPlant.MotherPlantCode</h4>
        </div>
        <div class="card-body">
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form method="post">
                <input type="hidden" asp-for="MotherPlant.Id" />
                <input type="hidden" asp-for="MotherPlant.MotherPlantCode" />
                <input type="hidden" asp-for="MotherPlant.CreatedBy" />
                <input type="hidden" asp-for="MotherPlant.CreatedDate" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Polyhouse</label>
                        <select asp-for="MotherPlant.PolyhouseId" id="polyhouseSelect" class="form-select" required>
                            @foreach (var p in Model.Polyhouses)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Area (optional)</label>
                        <select asp-for="MotherPlant.AreaId" id="areaSelect" class="form-select" data-area-select>
                            <option value="">-- None --</option>
                            @foreach (var a in Model.Areas)
                            {
                                <option value="@a.Id">@a.Name</option>
                            }
                        </select>
                        <small class="text-muted">Select a Polyhouse first; Areas are scoped to it.</small>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Plant Type</label>
                        <select asp-for="SelectedPlantTypeId" id="plantTypeSelect" class="form-select" required>
                            @foreach (var t in Model.PlantTypes)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Variety (Species)</label>
                        <select asp-for="MotherPlant.SpeciesId" id="speciesSelect" class="form-select" required>
                            @foreach (var s in Model.SpeciesForSelectedType)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Supervisor <span class="text-muted fw-normal">(Production Area supervisors of the selected Area)</span></label>
                        <select asp-for="MotherPlant.SupervisorId" class="form-select" data-supervisor-area-source="#areaSelect">
                            <option value="">-- None --</option>
                            @foreach (var s in Model.Supervisors)
                            {
                                <option value="@s.EmployeeID" data-areas="@s.AreaAttribute">@s.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Planting Date</label>
                        <input type="date" asp-for="MotherPlant.PlantingDate" class="form-control" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Mother Plant Quantity</label>
                        <input type="number" step="0.01" min="0.01" asp-for="MotherPlant.MotherPlantQuantity" id="qtyInput" class="form-control" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Cutting Rate (per plant)</label>
                        <input type="number" step="0.0001" min="0" asp-for="MotherPlant.CuttingRate" id="rateInput" class="form-control" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Cutting Period (days)</label>
                        <input type="number" step="1" min="1" asp-for="MotherPlant.CuttingPeriodDays" id="periodInput" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Expected Cutting Quantity</label>
                        <input type="text" id="expectedCuttingPreview" class="form-control" value="@Model.PreviewExpectedCuttingQuantity.ToString("N2")" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Expected Monthly Cutting Quantity</label>
                        <input type="text" id="expectedMonthlyPreview" class="form-control" value="@Model.PreviewExpectedMonthlyCuttingQuantity.ToString("N2")" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Status</label>
                        <select asp-for="MotherPlant.Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Completed">Completed</option>
                            <option value="Removed">Removed</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Remarks</label>
                        <textarea asp-for="MotherPlant.Remarks" class="form-control" rows="2"></textarea>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <a asp-page="/Production/MotherPlant/Index" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-success">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#plantTypeSelect').on('change', function () {
                const plantTypeId = $(this).val();
                const speciesSelect = $('#speciesSelect');
                speciesSelect.empty();
                if (!plantTypeId) {
                    speciesSelect.append('<option value="">-- Select a Plant Type First --</option>');
                    return;
                }
                $.get(window.basePath + 'Production/MotherPlant/Edit?handler=SpeciesByPlantType&plantTypeId=' + plantTypeId, function (data) {
                    $.each(data, function (i, s) {
                        speciesSelect.append('<option value="' + s.id + '">' + s.name + '</option>');
                    });
                }).fail(function () {
                    speciesSelect.append('<option value="">-- Failed to load varieties --</option>');
                });
            });

            // Polyhouse -> Area cascading dropdown. An Area belongs to
            // exactly one Polyhouse, so the Area list is re-fetched every
            // time the Polyhouse changes and never shows areas outside it.
            // The initial page load already renders the correct Area list
            // (filtered server-side to the record's existing Polyhouse in
            // EditModel.OnGetAsync), so this only fires on a user change.
            $('#polyhouseSelect').on('change', function () {
                const polyhouseId = $(this).val();
                const areaSelect = $('#areaSelect');
                areaSelect.empty();
                areaSelect.append('<option value="">-- None --</option>');
                if (!polyhouseId) {
                    return;
                }
                $.get(window.basePath + 'Production/MotherPlant/Edit?handler=AreasByPolyhouseId&polyhouseId=' + polyhouseId, function (data) {
                    $.each(data, function (i, a) {
                        areaSelect.append('<option value="' + a.id + '">' + a.name + '</option>');
                    });
                }).fail(function () {
                    areaSelect.append('<option value="">-- Failed to load areas --</option>');
                });
            });

            function recalcPreview() {
                const qty = parseFloat($('#qtyInput').val()) || 0;
                const rate = parseFloat($('#rateInput').val()) || 0;
                const period = parseFloat($('#periodInput').val()) || 0;
                const expectedCutting = qty * rate;
                const expectedMonthly = period > 0 ? (expectedCutting * 30 / period) : 0;
                $('#expectedCuttingPreview').val(expectedCutting.toFixed(2));
                $('#expectedMonthlyPreview').val(expectedMonthly.toFixed(2));
            }

            $('#qtyInput, #rateInput, #periodInput').on('input', recalcPreview);
        });
    </script>
}
