@page
@model PlantStockManager.Pages.Production.MotherPlant.DirectSowingModel
@{
    ViewData["Title"] = "Direct Sowing";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 960px;">
        <div class="card-header">
            <h4 class="mb-0">Direct Sowing <span class="text-muted fs-6">&mdash; Mother Plant &amp; Cutting Areas</span></h4>
            <small class="text-muted">Seed is taken from a Main Office seed lot and the empty trays from the chosen Mother Plant Area. A batch
                number (YYYY-MM-DD-L-NNN) is generated on save; the batch then waits in
                <a asp-page="/Production/MotherPlant/SowingApprovals" asp-route-tab="pending">Sowing Approvals</a> until an Area Supervisor of
                that Area approves it.</small>
        </div>
        <div class="card-body">
            @if (TempData["Success"] != null) { <div class="alert alert-success" id="sowing-success">@TempData["Success"]</div> }

            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger" id="sowing-errors">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            @if (!Model.SchemaReady)
            {
                <div class="alert alert-warning" id="schema-missing">@PlantStockManager.Data.WorkflowCorrectionsSchema.MotherPlantDirectSowingMigrationMessage</div>
            }
            @if (!Model.Areas.Any())
            {
                <div class="alert alert-warning" id="no-areas">You are not assigned to any active Mother Plant / Cutting Area, so you cannot record a Direct Sowing here.</div>
            }

            <div class="mb-3 p-3 bg-light border rounded">
                <label class="form-label fw-bold mb-1" for="lotFinder">Find seed lot</label>
                <input type="search" id="lotFinder" class="form-control" autocomplete="off"
                       placeholder="Type part of the variety, crop, colour, supplier or lot number..." />
                <div class="list-group mt-1 d-none" id="lotFinderResults" style="max-height: 260px; overflow-y: auto;"></div>
                <div class="form-text">Picking a result fills Species, Variety and Seed Lot below. Only Main Office lots with stock are shown.</div>
            </div>

            <form method="post" id="sowingForm">
                <input type="hidden" asp-for="SubmissionToken" />
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold" for="sowingDate">Sowing Date</label>
                        <input type="date" asp-for="SowingDate" id="sowingDate" class="form-control" required
                               max="@PlantStockManager.Services.AppClock.Today.ToString("yyyy-MM-dd")" />
                    </div>

                    @* The destination is a Mother Plant Area itself -- no Polyhouse: the Area holds its empty trays in one pool per cavity. *@
                    <div class="col-md-8">
                        <label class="form-label fw-bold" for="areaSelect">Mother Plant Area</label>
                        <select asp-for="AreaId" id="areaSelect" class="form-select" required>
                            <option value="">-- Select Mother Plant Area --</option>
                            @foreach (var a in Model.Areas)
                            {
                                <option value="@a.Id">@a.Name</option>
                            }
                        </select>
                        <div class="form-text">Only the active Mother Plant Areas you are assigned to.</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold" for="plantTypeSelect">Species</label>
                        <select asp-for="PlantTypeId" id="plantTypeSelect" class="form-select" required>
                            <option value="">-- Select Species --</option>
                            @foreach (var t in Model.PlantTypes)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold" for="varietySelect">Variety</label>
                        <select asp-for="SpeciesId" id="varietySelect" class="form-select" required data-searchable
                                data-selected="@(Model.SpeciesId > 0 ? Model.SpeciesId.ToString() : "")">
                            <option value="">-- Select Species first --</option>
                        </select>
                        <div class="form-text" id="growingDaysInfo"></div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold" for="expectedReadyPreview">Expected Ready Date</label>
                        <input type="text" id="expectedReadyPreview" class="form-control" readonly placeholder="Sowing Date + growing days" />
                        <div class="form-text">Calculated automatically; the saved value is recomputed on the server.</div>
                    </div>

                    <div class="col-md-8">
                        <label class="form-label fw-bold" for="seedLotSelect">Main Office Seed Lot</label>
                        <select asp-for="SourceSeedStockId" id="seedLotSelect" class="form-select" required
                                data-selected="@(Model.SourceSeedStockId > 0 ? Model.SourceSeedStockId.ToString() : "")">
                            <option value="">-- Select Variety first --</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold" for="availablePreview">Available</label>
                        <input type="text" id="availablePreview" class="form-control" readonly placeholder="Select a seed lot" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold" for="quantityInput">Seed Quantity</label>
                        <input type="number" step="1" min="1" asp-for="SeedQuantity" asp-format="{0:0.##}" id="quantityInput" class="form-control" required />
                        <div class="text-danger small d-none" id="quantityWarning">Quantity exceeds the available seed stock.</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold" for="cavitySelect">Tray Size</label>
                        <select asp-for="CavityType" id="cavitySelect" class="form-select" required>
                            <option value="">-- Select --</option>
                            @foreach (var ct in Model.CavityTypes)
                            {
                                <option value="@ct">@ct</option>
                            }
                        </select>
                    </div>

                    @* Calculated -- never typed and never posted: the server recalculates when saving. *@
                    <div class="col-md-4">
                        <label class="form-label fw-bold" for="traysOut">No. of Complete Trays</label>
                        <input type="text" id="traysOut" class="form-control" readonly placeholder="calculated" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold" for="seedsUsedOut">Seeds Used (sown &amp; deducted)</label>
                        <input type="text" id="seedsUsedOut" class="form-control" readonly placeholder="calculated" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold" for="remainingSeedsOut">Remaining Seeds (automatically wasted)</label>
                        <input type="text" id="remainingSeedsOut" class="form-control" readonly placeholder="calculated" />
                    </div>
                    <div class="col-12">
                        <div class="text-danger small d-none" id="trayError"></div>
                    </div>

                    <partial name="/Pages/Production/SeedSowing/_TrayAvailability.cshtml" />

                    <div class="col-12">
                        <div class="alert alert-secondary py-2 mb-0 small" id="approval-info">
                            <strong>Approval:</strong> no supervisor is chosen here. The batch waits in Sowing Approvals and is approved by an
                            Area Supervisor of the selected Mother Plant Area (or a System Administrator). Nothing reaches Ready Stock before then.
                            Growing material (Cocopeat / Pitmos) is used only in Main Office Polyhouses, so none is taken here.
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold" for="remarks">Remarks</label>
                        <textarea asp-for="Remarks" id="remarks" class="form-control" rows="2" maxlength="500"></textarea>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <a asp-page="/Production/MotherPlant/SowingApprovals" asp-route-tab="pending" class="btn btn-secondary me-2">Sowing Approvals</a>
                    <button type="submit" class="btn btn-success" id="saveSowingButton" disabled="@(!Model.SchemaReady || !Model.Areas.Any())">Save Sowing</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Pending.Any())
    {
        <div class="card shadow-sm mx-auto mt-4" style="max-width: 960px;">
            <div class="card-header"><h6 class="mb-0">Direct Sowings in your Mother Plant Areas waiting for approval</h6></div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-striped mb-0" id="pending-direct-sowings">
                        <thead class="table-light">
                            <tr><th>Batch No.</th><th>Area</th><th>Variety</th><th>Cavity</th><th class="text-end">Trays</th><th class="text-end">Seeds</th><th>Sowing Date</th><th>Expected Ready</th><th>Recorded by</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Pending)
                            {
                                <tr data-sowing="@s.Id">
                                    <td>@s.SowingCode</td>
                                    <td>@s.AreaName</td>
                                    <td>@s.SpeciesName?.Trim() <span class="small text-muted">(@s.PlantTypeName)</span></td>
                                    <td>@s.CavityType</td>
                                    <td class="text-end">@s.NumberOfTrays</td>
                                    <td class="text-end">@Qty(s.QuantitySown)</td>
                                    <td>@s.SowingDate.ToString("dd/MM/yyyy")</td>
                                    <td>@(s.ExpectedReadyDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td>@s.CreatedBy</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/tray-availability.js" asp-append-version="true"></script>
    <script>
        $(function () {
            const handlerUrl = '@Url.Page("/Production/MotherPlant/DirectSowing")';
            let growingDays = null;
            let available = null;

            function fill($select, items, placeholder, textFn, dataFn) {
                const selected = String($select.data('selected') || '');
                $select.empty().append($('<option>').val('').text(placeholder));
                items.forEach(function (it) {
                    const $o = $('<option>').val(it.id).text(textFn(it));
                    if (dataFn) dataFn($o, it);
                    if (String(it.id) === selected) $o.prop('selected', true);
                    $select.append($o);
                });
                $select.data('selected', '');
            }

            function loadVarieties() {
                const typeId = $('#plantTypeSelect').val();
                const $v = $('#varietySelect');
                if (!typeId) { fill($v, [], '-- Select Species first --', x => x.name); onVarietyChange(); return; }
                $.getJSON(handlerUrl, { handler: 'Varieties', plantTypeId: typeId }, function (list) {
                    fill($v, list, '-- Select Variety --',
                        x => x.name + (x.growingDays ? ' (' + x.growingDays + ' days)' : ' (growing days not set)'),
                        ($o, x) => $o.attr('data-days', x.growingDays || ''));
                    onVarietyChange();
                });
            }

            function onVarietyChange() {
                const days = parseInt($('#varietySelect option:selected').attr('data-days'), 10);
                growingDays = isNaN(days) ? null : days;
                const $info = $('#growingDaysInfo');
                if (!$('#varietySelect').val()) { $info.text('').removeClass('text-danger'); }
                else if (growingDays) { $info.text('Growing days: ' + growingDays).removeClass('text-danger'); }
                else { $info.text('Growing days are not configured for this variety - sowing will be refused. Set them in Administration > Plant Master.').addClass('text-danger'); }
                updateExpected();
                loadSeedLots();
            }

            function loadSeedLots() {
                const speciesId = $('#varietySelect').val();
                const $lot = $('#seedLotSelect');
                if (!speciesId) { fill($lot, [], '-- Select Variety first --', x => x.lot); onLotChange(); return; }
                $.getJSON(handlerUrl, { handler: 'SeedLots', speciesId: speciesId }, function (list) {
                    fill($lot, list, list.length ? '-- Select Seed Lot --' : '-- No Main Office stock for this variety --',
                        x => x.lot + ' - ' + (x.source || 'unknown source') + ' @@ ' + x.area + ' (available: ' + formatQuantity(x.available) + ' ' + x.unit + ')',
                        ($o, x) => $o.attr('data-available', x.available));
                    onLotChange();
                });
            }

            function onLotChange() {
                const a = parseFloat($('#seedLotSelect option:selected').attr('data-available'));
                available = isNaN(a) ? null : a;
                $('#availablePreview').val(available === null ? '' : formatQuantity(available));
                checkQuantity();
            }

            function checkQuantity() {
                const q = parseFloat($('#quantityInput').val());
                $('#quantityWarning').toggleClass('d-none', !(available !== null && !isNaN(q) && q > available));
            }

            function updateExpected() {
                const d = $('#sowingDate').val();
                if (!d || !growingDays) { $('#expectedReadyPreview').val(''); return; }
                const parts = d.split('-').map(Number);
                const dt = new Date(Date.UTC(parts[0], parts[1] - 1, parts[2]));
                dt.setUTCDate(dt.getUTCDate() + growingDays);
                $('#expectedReadyPreview').val(String(dt.getUTCDate()).padStart(2, '0') + '-' + String(dt.getUTCMonth() + 1).padStart(2, '0') + '-' + dt.getUTCFullYear());
            }

            // Live tray preview from the server (same calculation as the save).
            function calcTrays() {
                const q = $('#quantityInput').val();
                const c = $('#cavitySelect').val();
                const $err = $('#trayError');
                $('#traysOut, #seedsUsedOut, #remainingSeedsOut').val('');
                $err.addClass('d-none').text('');
                if (!q || !c) return;
                $.getJSON(handlerUrl, { handler: 'TrayCalculation', quantity: q, cavityType: c }, function (r) {
                    if (r.ok) {
                        $('#traysOut').val(r.trays);
                        $('#seedsUsedOut').val(r.seedsUsed);
                        $('#remainingSeedsOut').val(r.remainingSeeds);
                    }
                    const msg = !r.wholeNumber ? 'Seed Quantity must be a whole number.' : (r.ok ? '' : r.error);
                    if (msg) $err.removeClass('d-none').text(msg);
                });
            }

            $('#plantTypeSelect').on('change', loadVarieties);
            $('#varietySelect').on('change', onVarietyChange);
            $('#seedLotSelect').on('change', onLotChange);
            $('#quantityInput').on('input', function () { checkQuantity(); calcTrays(); });
            $('#cavitySelect').on('change', calcTrays);
            $('#sowingDate').on('change', updateExpected);
            calcTrays();

            // Find seed lot: type -> pick -> Species, Variety and Lot are filled in.
            let finderTimer = null;
            $('#lotFinder').on('input', function () {
                clearTimeout(finderTimer);
                const term = $(this).val().trim();
                const $res = $('#lotFinderResults');
                if (term.length < 2) { $res.addClass('d-none').empty(); return; }
                finderTimer = setTimeout(function () {
                    $.getJSON(handlerUrl, { handler: 'FindLots', term: term }, function (list) {
                        $res.empty();
                        if (!list.length) {
                            $res.append($('<div class="list-group-item text-muted">').text('No Main Office lot with stock matches "' + term + '".'));
                        }
                        list.forEach(function (x) {
                            const $a = $('<button type="button" class="list-group-item list-group-item-action">')
                                .text(x.variety + ' (' + x.crop + ') - lot ' + x.lot + ' - ' + (x.source || 'unknown source') + ' - available ' + formatQuantity(x.available));
                            $a.on('click', function () {
                                $('#plantTypeSelect').val(x.plantTypeId);
                                $('#varietySelect').data('selected', String(x.speciesId));
                                $('#seedLotSelect').data('selected', String(x.id));
                                loadVarieties();
                                $res.addClass('d-none').empty();
                                $('#lotFinder').val(x.variety + ' - lot ' + x.lot);
                            });
                            $res.append($a);
                        });
                        $res.removeClass('d-none');
                    });
                }, 250);
            });

            // Empty trays of the chosen cavity in every Mother Plant Area offered (server balances); the Seed Quantity must be
            // corrected while the chosen Area cannot cover its trays.
            initTrayAvailability({
                url: handlerUrl,
                params: () => ({ cavityType: $('#cavitySelect').val(), areaId: $('#areaSelect').val(), quantity: $('#quantityInput').val() || 0 }),
                triggers: '#areaSelect, #cavitySelect, #quantityInput',
                guard: () => document.getElementById('quantityInput')
            });
            // One click only (the server's one-time token is the real duplicate guard).
            $('#sowingForm').on('submit', function () { if (this.checkValidity()) $('#saveSowingButton').prop('disabled', true).text('Saving...'); });

            // Re-populate dependent lists after a failed POST.
            if ($('#plantTypeSelect').val()) loadVarieties();
        });
    </script>
}
