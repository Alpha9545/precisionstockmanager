@page
@model PlantStockManager.Pages.Production.MotherPlant.AddEmptyTraysModel
@inject PlantStockManager.Data.DatabaseHelper CavityDb
@{
    ViewData["Title"] = "Add Empty Trays";
    var backPage = Model.IsCuttingSection ? "/Production/Cutting/Index" : "/Production/MotherPlant/Index";
    var backLabel = Model.IsCuttingSection ? "Cutting Production" : "Mother Plants";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto mb-4" style="max-width: 820px;">
        <div class="card-header">
            <h4 class="mb-0">Add Empty Trays <span class="text-muted fs-6">&mdash; @(Model.IsCuttingSection ? "Cutting" : "Mother Plant")</span></h4>
            <small class="text-muted">Empty cavity trays go into the selected Mother Plant / Cutting Area's tray stock (no polyhouse). Transplanting and Cutting Tray Sowing in that Area use them.</small>
        </div>
        <div class="card-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success" id="msg-success">@TempData["Success"]</div>
            }
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }
            @if (!Model.SchemaReady)
            {
                <div class="alert alert-warning" id="needs-migration">@PlantStockManager.Data.MotherPlantAreaSchema.MigrationMessage</div>
            }
            else if (!Model.Areas.Any())
            {
                <div class="alert alert-warning" id="no-areas">You may not add empty trays to any Mother Plant / Cutting Area. Adding trays to a Mother Plant Area needs
                    TrayStock.EnterMotherPlant (every Mother Plant Area), or TrayStock.Enter for an Area you are assigned to -- ask the administrator.</div>
            }

            <form method="post" id="trays-form">
                <input type="hidden" asp-for="SubmissionToken" />
                <input type="hidden" asp-for="Section" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold" for="area">Area</label>
                        <select asp-for="AreaId" class="form-select" id="area" required>
                            @if (Model.Areas.Count != 1)
                            {
                                <option value="">-- Select --</option>
                            }
                            @foreach (var a in Model.Areas)
                            {
                                <option value="@a.Id">@a.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold" for="cavity">Cavity</label>
                        <select asp-for="TraySize" class="form-select" id="cavity" required>
                            <option value="">-- Select --</option>
                            @foreach (var c in (await PlantStockManager.Data.WorkflowCorrectionsSchema.SelectableCavitiesAsync(CavityDb)))
                            {
                                <option value="@c">@c</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold" for="qty">Number of trays</label>
                        <input type="number" step="1" min="1" asp-for="Quantity" asp-format="{0:0.##}" class="form-control" id="qty" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold" for="date">Date</label>
                        <input type="date" asp-for="StockDate" asp-format="{0:yyyy-MM-dd}" class="form-control" id="date"
                               max="@PlantStockManager.Services.AppClock.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="remarks">Remark</label>
                        <input type="text" asp-for="Remarks" class="form-control" id="remarks" maxlength="500" />
                    </div>
                </div>
                <div class="text-center mt-4">
                    <a asp-page="@backPage" class="btn btn-secondary me-2">@backLabel</a>
                    <button type="submit" class="btn btn-success" id="saveBtn" @(Model.SchemaReady && Model.Areas.Any() ? "" : "disabled")>Add Empty Trays</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.SchemaReady && Model.Areas.Any())
    {
        <div class="card shadow-sm mx-auto mb-4" style="max-width: 820px;">
            <div class="card-header"><strong>Current empty tray stock</strong> <span class="text-muted small">&mdash; Mother Plant / Cutting Areas you may stock</span></div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0" id="balances">
                    <thead class="table-light"><tr><th>Area</th><th>Cavity</th><th class="text-end">Empty trays</th></tr></thead>
                    <tbody>
                        @foreach (var b in Model.Balances)
                        {
                            <tr><td>@b.AreaName</td><td>@b.TraySize</td><td class="text-end fw-semibold">@Qty(b.PhysicalQuantity)</td></tr>
                        }
                        @if (!Model.Balances.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted">No empty trays recorded yet in these Areas.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // One submit per form (the server also ignores a repeated form token).
        document.getElementById('trays-form').addEventListener('submit', function (e) {
            var btn = document.getElementById('saveBtn');
            if (btn.dataset.sent) { e.preventDefault(); return; }
            if (this.checkValidity()) { btn.dataset.sent = '1'; btn.disabled = true; }
        });
    </script>
}
