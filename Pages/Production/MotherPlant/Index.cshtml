@page
@model PlantStockManager.Pages.Production.MotherPlant.IndexModel
@{
    ViewData["Title"] = "Mother Plant";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Mother Plant</h2>
        <a asp-page="/Production/MotherPlant/Create" class="btn btn-primary">+ Add Mother Plant Batch</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <!-- Dashboard summary -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Active Batches</div>
                    <div class="fs-3 fw-bold">@Model.ActiveBatchCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total Mother Plants (filtered)</div>
                    <div class="fs-3 fw-bold">@Model.TotalMotherPlantQuantity.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Expected Monthly Cutting (filtered)</div>
                    <div class="fs-3 fw-bold">@Model.TotalExpectedMonthlyCutting.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-md-3">
            <label class="form-label">Polyhouse</label>
            <select name="PolyhouseId" class="form-select" asp-for="PolyhouseId">
                <option value="">-- All --</option>
                @foreach (var p in Model.Polyhouses)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Status</label>
            <select name="Status" class="form-select" asp-for="Status">
                <option value="">-- All --</option>
                <option value="Active">Active</option>
                <option value="Completed">Completed</option>
                <option value="Removed">Removed</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Batch #</th>
                    <th>Polyhouse</th>
                    <th>Variety</th>
                    <th>Area</th>
                    <th>Planting Date</th>
                    <th>Mother Plants</th>
                    <th>Cutting Rate</th>
                    <th>Expected Cutting</th>
                    <th>Expected Monthly</th>
                    <th>Supervisor</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var mp in Model.MotherPlants)
                {
                    <tr>
                        <td>@mp.MotherPlantCode</td>
                        <td>@mp.PolyhouseName</td>
                        <td>@mp.SpeciesName <span class="text-muted">(@mp.PlantTypeName)</span></td>
                        <td>@mp.AreaName</td>
                        <td>@mp.PlantingDate.ToString("dd/MM/yyyy")</td>
                        <td>@mp.MotherPlantQuantity.ToString("N2")</td>
                        <td>@mp.CuttingRate.ToString("N2")</td>
                        <td>@mp.ExpectedCuttingQuantity.ToString("N2")</td>
                        <td>@mp.ExpectedMonthlyCuttingQuantity.ToString("N2")</td>
                        <td>@mp.SupervisorName</td>
                        <td><span class="badge bg-secondary">@mp.Status</span></td>
                        <td>
                            <a asp-page="/Production/MotherPlant/Details" asp-route-id="@mp.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            <a asp-page="/Production/MotherPlant/Edit" asp-route-id="@mp.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                        </td>
                    </tr>
                }
                @if (!Model.MotherPlants.Any())
                {
                    <tr><td colspan="13" class="text-center text-muted">No Mother Plant batches found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
