@page "{id:int}"
@model PlantStockManager.Pages.Production.SeedSowing.DetailsModel
@inject PlantStockManager.Authorization.FeatureAccessService FeatureAccess
@{
    ViewData["Title"] = "Sowing Details";
    var canEdit = await FeatureAccess.CanAccessPageAsync(User, "/Production/SeedSowing/Edit");
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 700px;">
        <div class="card-header">
            <h4 class="mb-0">Batch @Model.SeedSowing!.SowingCode</h4>
        </div>
        <div class="card-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }
            <dl class="row mb-0">
                <dt class="col-sm-5">Species/Variety</dt><dd class="col-sm-7">@Model.SeedSowing.SpeciesName (@Model.SeedSowing.PlantTypeName)</dd>
                <dt class="col-sm-5">Sown from</dt><dd class="col-sm-7">@Model.SeedSowing.SourceLabel @(Model.SeedSowing.IsCuttingSource ? "" : (string.IsNullOrEmpty(Model.SeedSowing.BatchNo) ? "-" : Model.SeedSowing.BatchNo))</dd>
                @if (Model.SeedSowing.IsBedSowingSource)
                {
                    <dt class="col-sm-5">Origin</dt>
                    <dd class="col-sm-7">
                        Bed Sowing <a asp-page="/Production/BedSowing/Details" asp-route-id="@Model.SeedSowing.BedSowingId">@Model.SeedSowing.BedSowingCode</a>,
                        transplanted @(Model.SeedSowing.BedTransplantDate?.ToString("dd/MM/yyyy")) (@Model.SeedSowing.BedTransplantCode)
                        <div class="small text-muted">Sowing Date is the bed's; Ready Date = transplant date + Ready Days. The seed was taken from the lot when the bed was sown.</div>
                    </dd>
                }
                @if (Model.SeedSowing.IsTransplantSource)
                {
                    <dt class="col-sm-5">Origin</dt>
                    <dd class="col-sm-7">
                        Transplanted from Ready Stock <a asp-page="/Production/ReadyStock/Lineage" asp-route-id="@Model.SeedSowing.TransplantSourceReadyStockId">batch #@Model.SeedSowing.TransplantSourceReadyStockId</a>
                        on @(Model.SeedSowing.TransplantDate?.ToString("dd/MM/yyyy"))
                        (<a asp-page="/Production/Transplanting/Details" asp-route-id="@Model.SeedSowing.TransplantId">@Model.SeedSowing.TransplantCode</a>)
                        <div class="small text-muted">Sowing Date is the original sowing's; Ready Date = transplant date + Ready Days.</div>
                    </dd>
                }
                <dt class="col-sm-5">Taken from Area</dt><dd class="col-sm-7">@(Model.SeedSowing.SourceAreaName ?? "-")</dd>
                @if (!Model.SeedSowing.IsCuttingSource)
                {
                    <dt class="col-sm-5">Seed Source</dt><dd class="col-sm-7">@(Model.SeedSowing.SeedSourceName ?? "-")</dd>
                }
                <dt class="col-sm-5">Area</dt><dd class="col-sm-7">@Model.SeedSowing.AreaName @(Model.SeedSowing.GrowingPartnerName != null ? $"({Model.SeedSowing.GrowingPartnerName})" : "")</dd>
                <dt class="col-sm-5">Polyhouse</dt><dd class="col-sm-7">@(Model.SeedSowing.PolyhouseName ?? "-")</dd>
                <dt class="col-sm-5">@(Model.SeedSowing.IsCuttingSource ? "Cutting" : "Seed") Quantity entered</dt><dd class="col-sm-7">@(Model.SeedSowing.SeedQuantity > 0 ? Qty(Model.SeedSowing.SeedQuantity) : "not recorded (before the tray rule)")</dd>
                <dt class="col-sm-5">Tray Cavity</dt><dd class="col-sm-7">@Model.SeedSowing.CavityType</dd>
                <dt class="col-sm-5">Complete Trays</dt><dd class="col-sm-7">@(Qty(Model.SeedSowing.NumberOfTrays))</dd>
                <dt class="col-sm-5">Growing Material</dt>
                <dd class="col-sm-7">
                    @if (Model.SeedSowing.GrowingMaterialName == null)
                    {
                        <span class="text-muted">None (not a Main Office Polyhouse sowing, or recorded before Material Stock)</span>
                    }
                    else
                    {
                        @Model.SeedSowing.GrowingMaterialName
                        @foreach (var m in Model.MaterialMovements)
                        {
                            <div class="small text-muted">
                                @(m.TransactionType == PlantStockManager.Services.MaterialStockRules.Consume
                                    ? $"Used {PlantStockManager.Services.MaterialStockRules.Kg(m.StockQuantity, m.Unit)} from {m.PolyhouseName} ({m.Trays} {(m.IsApprovalOverage ? "extra trays at approval" : "trays")} x {PlantStockManager.Services.MaterialStockRules.Kg(m.QuantityPerTray ?? 0, m.Unit)})"
                                    : $"Returned {PlantStockManager.Services.MaterialStockRules.Kg(m.StockQuantity, m.Unit)} to {m.PolyhouseName} ({(m.IsApprovalOverage ? "approval cancelled" : "sowing cancelled")})")
                            </div>
                        }
                    }
                </dd>
                <dt class="col-sm-5">@Model.SeedSowing.UnitName Used (in complete trays)</dt><dd class="col-sm-7">@Qty(Model.SeedSowing.QuantitySown)</dd>
                <dt class="col-sm-5">Remaining @Model.SeedSowing.UnitName (automatically wasted)</dt><dd class="col-sm-7">@(Model.SeedSowing.SeedQuantity > 0 ? Qty(Model.SeedSowing.RemainingSeeds) : "-")</dd>
                <dt class="col-sm-5">Sowing Date</dt><dd class="col-sm-7">@Model.SeedSowing.SowingDate.ToString("dd/MM/yyyy")</dd>
                <dt class="col-sm-5">Ready Stock Days</dt><dd class="col-sm-7">@(Model.SeedSowing.ReadyStockDays?.ToString() ?? "-")</dd>
                <dt class="col-sm-5">Expected Ready Date</dt><dd class="col-sm-7">@(Model.SeedSowing.ExpectedReadyDate?.ToString("dd/MM/yyyy") ?? "Not estimated")</dd>
                <dt class="col-sm-5">Ready Alert</dt>
                <dd class="col-sm-7">
                    @switch (Model.AlertCategory)
                    {
                        case "Overdue":
                            <span class="badge bg-danger">Overdue</span>
                            break;
                        case "ReadyToday":
                            <span class="badge bg-warning text-dark">Ready Today</span>
                            break;
                        case "ReadySoon":
                            <span class="badge bg-info text-dark">Ready Soon</span>
                            break;
                        default:
                            <span class="text-muted">None</span>
                            break;
                    }
                </dd>
                <dt class="col-sm-5">Status</dt><dd class="col-sm-7">@(Model.SeedSowing.Status == "Sown" ? "Growing (awaiting Supervisor Approval)" : Model.SeedSowing.Status)</dd>
                <dt class="col-sm-5">Actual Ready Seedlings</dt><dd class="col-sm-7">@Qty(Model.SeedSowing.ConfirmedReadyQuantity)</dd>
                <dt class="col-sm-5">Wastage</dt><dd class="col-sm-7">@Qty(Model.SeedSowing.WastageQuantity) (@Model.SeedSowing.WastagePercent.ToString("0.00")%)</dd>
                <dt class="col-sm-5">Trays Alive</dt><dd class="col-sm-7">@(Qty(Model.SeedSowing.TraysAliveQuantity)) @(Model.SeedSowing.TraysAliveDate.HasValue ? $"(on {Model.SeedSowing.TraysAliveDate:dd/MM/yyyy})" : "")</dd>
                <dt class="col-sm-5">Hardening Alive</dt><dd class="col-sm-7">@(Qty(Model.SeedSowing.HardeningAliveQuantity)) @(Model.SeedSowing.HardeningAliveDate.HasValue ? $"(on {Model.SeedSowing.HardeningAliveDate:dd/MM/yyyy})" : "")</dd>
                <dt class="col-sm-5">Location</dt><dd class="col-sm-7">@(Model.SeedSowing.Location ?? "-")@(string.IsNullOrEmpty(Model.SeedSowing.LocationDescription) ? "" : $" - {Model.SeedSowing.LocationDescription}")</dd>
                <dt class="col-sm-5">Labour / Responsible Person</dt><dd class="col-sm-7">@Model.SeedSowing.ResponsiblePersonName</dd>
                <dt class="col-sm-5">Supervisor</dt><dd class="col-sm-7">@Model.SeedSowing.SupervisorName</dd>
                <dt class="col-sm-5">Remarks</dt><dd class="col-sm-7">@Model.SeedSowing.Remarks</dd>
                <dt class="col-sm-5">Created</dt><dd class="col-sm-7">@Model.SeedSowing.CreatedDate.ToString("dd/MM/yyyy HH:mm") by @Model.SeedSowing.CreatedBy</dd>
                @if (Model.SeedSowing.ModifiedDate.HasValue)
                {
                    <dt class="col-sm-5">Last Modified</dt><dd class="col-sm-7">@Model.SeedSowing.ModifiedDate.Value.ToString("dd/MM/yyyy HH:mm") by @Model.SeedSowing.ModifiedBy</dd>
                }
            </dl>
        </div>
        <div class="card-footer text-end">
            <a asp-page="/Production/SeedSowing/Index" class="btn btn-secondary">Back</a>
            @if (canEdit && Model.SeedSowing.Status == "Sown")
            {
                <a asp-page="/Production/SeedSowing/Edit" asp-route-id="@Model.SeedSowing.Id" class="btn btn-warning">Edit</a>
            }
        </div>
    </div>
</div>
