@page
@model PlantStockManager.Pages.Production.SeedSowing.CreateFromCuttingModel
@{
    ViewData["Title"] = "Confirm Cutting Sowing";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 900px;">
        <div class="card-header">
            <h4 class="mb-0">Confirm Cutting Sowing</h4>
            <small class="text-muted">Enter the Actual Cutting Quantity, Tray Cavity, Main Area / Polyhouse and Sowing Supervisor. Leftover cuttings below one complete tray are recorded as waste automatically -- never returned to Cutting Stock.</small>
        </div>
        <div class="card-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }
            @if (!Model.StockPools.Any())
            {
                <div class="alert alert-warning">No Cutting Stock with available cuttings in your Areas.</div>
            }
            @if (!Model.Destinations.Any())
            {
                <div class="alert alert-warning">No active growing Main Area / Polyhouse is available to sow into.</div>
            }

            <form method="post">
                <input type="hidden" asp-for="TransferId" />
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label fw-bold">Cutting Stock</label>
                        @{ var anchored = Model.TransferId.HasValue; }
                        @if (anchored)
                        {
                            // Reached straight from Main Office Confirm Receipt for ONE
                            // specific delivery: the Cutting Stock is automatically
                            // selected (never a picker to switch away from here -- that
                            // would detach the Confirmed Cutting Quantity below from the
                            // delivery it belongs to). CuttingStockId still posts via the
                            // hidden field since a disabled <select> posts nothing.
                            var current = Model.SelectedStock;
                            <input type="text" class="form-control" readonly
                                   value="@(current?.SpeciesName?.Trim())@(string.IsNullOrEmpty(current?.SpeciesColor) ? "" : " (" + current!.SpeciesColor + ")") - @(current?.AreaName)" />
                            <input type="hidden" asp-for="CuttingStockId" />
                        }
                        else
                        {
                            <select asp-for="CuttingStockId" id="stock" class="form-select" required data-searchable>
                                <option value="">-- Select variety / Area --</option>
                                @foreach (var s in Model.StockPools)
                                {
                                    <option value="@s.Id" data-available="@s.AvailableQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                        @s.SpeciesName?.Trim()@(string.IsNullOrEmpty(s.SpeciesColor) ? "" : " (" + s.SpeciesColor + ")") - @s.AreaName - available @s.AvailableQuantity.ToString("N0")
                                    </option>
                                }
                            </select>
                        }
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Sowing Date</label>
                        <input type="date" asp-for="SowingDate" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Confirmed Cutting Quantity</label>
                        <input type="number" step="1" min="1" asp-for="CuttingQuantity" id="qty" class="form-control" readonly />
                        <div class="form-text">The confirmed/available quantity for the selected Cutting Stock -- not editable.</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Tray Cavity</label>
                        <select asp-for="CavityType" id="cavity" class="form-select" required>
                            <option value="">-- Select --</option>
                            @foreach (var c in Model.CavityTypes)
                            {
                                <option value="@c">@c</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Main Area / Polyhouse</label>
                        <select asp-for="PolyhouseId" id="polyhouseSelect" class="form-select" required>
                            <option value="">-- Select Main Area Polyhouse --</option>
                            @foreach (var p in Model.Destinations)
                            {
                                <option value="@p.Id" selected="@(Model.PolyhouseId == p.Id)">@p.AreaName - @p.Name</option>
                            }
                        </select>
                        <small class="text-muted">Select a Polyhouse from a Main Area.</small>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Complete Trays</label>
                        <input type="text" id="trays" class="form-control" readonly placeholder="calculated" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Used Cutting</label>
                        <input type="text" id="used" class="form-control" readonly placeholder="calculated" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Remaining Cutting / Waste</label>
                        <input type="text" id="remaining" class="form-control" readonly placeholder="calculated" />
                        <div class="form-text">Any cutting not used for sowing is recorded as waste automatically -- it is never left in Cutting Stock.</div>
                    </div>
                    <div class="col-12"><div class="text-danger small d-none" id="trayError"></div></div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Sowing Supervisor <span class="text-muted fw-normal">(the only person who can approve)</span></label>
                        <select asp-for="SupervisorId" id="supervisorSelect" class="form-select" required disabled="@(Model.Supervisors.Any() ? null : "disabled")">
                            <option value="">@(Model.Supervisors.Any() ? "-- Select supervisor --" : "-- Choose the Main Area / Polyhouse first --")</option>
                            @foreach (var s in Model.Supervisors)
                            {
                                <option value="@s.EmployeeID" selected="@(Model.SupervisorId == s.EmployeeID)">@s.Name</option>
                            }
                        </select>
                        <div class="form-text">Active users assigned to the destination Area who can approve sowings - you may choose yourself. Cannot be changed after saving.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Remarks</label>
                        <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="text-center mt-4">
                    <a asp-page="/Production/CuttingStock/Index" class="btn btn-secondary me-2">Back</a>
                    <button type="submit" class="btn btn-success">Confirm Sowing</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            const url = '@Url.Page("/Production/SeedSowing/CreateFromCutting")';
            let keepSupervisor = '@(Model.SupervisorId.HasValue ? Model.SupervisorId.ToString() : "")';
            function loadSupervisors() {
                const $s = $('#supervisorSelect');
                const polyhouseId = $('#polyhouseSelect').val();
                const current = keepSupervisor || $s.val();
                if (!polyhouseId) {
                    $s.empty().append($('<option value="">').text('-- Choose the Main Area / Polyhouse first --')).prop('disabled', true);
                    return;
                }
                $.getJSON(url, { handler: 'Supervisors', polyhouseId: polyhouseId }, function (list) {
                    $s.empty().append($('<option value="">').text(list.length ? '-- Select supervisor --' : '-- No eligible supervisor is assigned to this Area --'));
                    $.each(list, function (i, u) {
                        const $o = $('<option>').val(u.id).text(u.name);
                        if (String(u.id) === String(current)) $o.prop('selected', true);
                        $s.append($o);
                    });
                    $s.prop('disabled', list.length === 0);
                    keepSupervisor = '';
                });
            }
            $('#polyhouseSelect').on('change', function () { keepSupervisor = ''; loadSupervisors(); });
            loadSupervisors();
            // Confirmed Cutting Quantity is never typed: it always mirrors the
            // selected Cutting Stock's own Available Quantity (display only --
            // the server independently re-derives and enforces this on submit).
            function syncQuantityFromStock() {
                const a = $('#stock option:selected').data('available');
                $('#qty').val(a !== undefined ? a : '');
            }
            function calc() {
                const q = $('#qty').val(), c = $('#cavity').val();
                $('#trays, #used, #remaining').val('');
                $('#trayError').addClass('d-none').text('');
                if (!q || !c) return;
                $.getJSON(url, { handler: 'TrayCalculation', quantity: q, cavityType: c }, function (r) {
                    if (r.ok) { $('#trays').val(r.trays); $('#used').val(r.used); $('#remaining').val(r.remaining); }
                    const msg = !r.wholeNumber ? 'Cutting Quantity must be a whole number.' : (r.ok ? '' : r.error);
                    if (msg) $('#trayError').removeClass('d-none').text(msg);
                });
            }
            $('#stock').on('change', function () { syncQuantityFromStock(); calc(); });
            $('#cavity').on('change', calc);
            calc();
        });
    </script>
}
