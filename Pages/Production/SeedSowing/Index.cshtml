@page
@model PlantStockManager.Pages.Production.SeedSowing.IndexModel
@inject PlantStockManager.Authorization.FeatureAccessService FeatureAccess
@{
    ViewData["Title"] = "Direct Sowing";
    var canSow = await FeatureAccess.CanAccessPageAsync(User, "/Production/SeedSowing/Create");
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Sowings (seed &amp; cutting trays)</h2>
        <div>
            @if (canSow)
            {
                <a asp-page="/Production/SeedSowing/Create" class="btn btn-primary">+ Direct Seed Sowing</a>
                <a asp-page="/Production/SeedSowing/CreateFromCutting" class="btn btn-outline-primary">+ Cutting Tray Sowing</a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @* 2026-10-27: Category (Plant Type) / Source filters -- a GET form; the page validates both on the server. *@
    <form method="get" asp-page="/Production/SeedSowing/Index" class="card card-body bg-light py-2 px-3 mb-3" id="sowingFilters" role="search" aria-label="Filter the list">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <label class="form-label small fw-bold mb-1" for="sowingCategory">Category</label>
                <select name="category" id="sowingCategory" class="form-select form-select-sm">
                    <option value="">All categories</option>
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c.Id" selected="@(Model.Filter.PlantTypeId == c.Id)">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <label class="form-label small fw-bold mb-1" for="sowingSource">Source</label>
                <select name="source" id="sowingSource" class="form-select form-select-sm">
                    <option value="">All sources</option>
                    @foreach (var s in PlantStockManager.Services.SeedSowingListFilter.SourceOptions)
                    {
                        <option value="@s.Value" selected="@(Model.Filter.SourceType == s.Value)">@s.Label</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-auto d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-fill flex-md-grow-0" id="sowingApplyFilters">Apply</button>
                <a asp-page="/Production/SeedSowing/Index" class="btn btn-sm btn-outline-secondary flex-fill flex-md-grow-0 d-inline-flex align-items-center justify-content-center" id="sowingClearFilters">Clear</a>
            </div>
            @if (Model.Filter.IsActive)
            {
                <div class="col-12 col-md small text-muted text-md-end" id="sowingFilterSummary" aria-live="polite">
                    Filtered: @Model.Sowings.Count shown
                </div>
            }
        </div>
        @if (Model.FilterNote != null)
        {
            <div class="small text-warning-emphasis mt-2" id="sowingFilterNote">@Model.FilterNote</div>
        }
    </form>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total Sown (excl. Cancelled)@(Model.Filter.IsActive ? ", rows shown" : "")</div>
                    <div class="fs-3 fw-bold">@Qty(Model.TotalSown)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Batch No.</th>
                    <th>Species/Variety</th>
                    <th>Source</th>
                    <th>Area</th>
                    <th>Polyhouse</th>
                    <th>Cavity x Trays</th>
                    <th>Sowing Date</th>
                    <th>Expected Ready</th>
                    <th>Used</th>
                    <th>Ready Seedlings</th>
                    <th>Wastage</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sw in Model.Sowings)
                {
                    <tr>
                        <td>@sw.SowingCode</td>
                        <td>@sw.SpeciesName <span class="text-muted">(@sw.PlantTypeName)</span></td>
                        <td>@(sw.IsCuttingSource ? "Cutting" : sw.IsBedSowingSource ? "Bed " + sw.BedSowingCode : sw.IsTransplantSource ? "Transplant " + sw.TransplantCode : "Seed lot " + (string.IsNullOrEmpty(sw.BatchNo) ? "-" : sw.BatchNo))</td>
                        <td>@sw.AreaName</td>
                        <td>@(sw.PolyhouseName ?? "-")</td>
                        <td>@sw.CavityType@(sw.NumberOfTrays.HasValue ? $" x{sw.NumberOfTrays}" : "")</td>
                        <td>@sw.SowingDate.ToString("dd/MM/yyyy")</td>
                        <td>@(sw.ExpectedReadyDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>@Qty(sw.QuantitySown)</td>
                        <td>@Qty(sw.ConfirmedReadyQuantity)</td>
                        <td>@Qty(sw.WastageQuantity)</td>
                        <td>
                            @if (sw.Status == "Cancelled")
                            {
                                <span class="badge bg-secondary">Cancelled</span>
                            }
                            else if (sw.Status == "Completed")
                            {
                                <span class="badge bg-primary">Completed</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Growing</span>
                            }
                        </td>
                        <td>
                            <a asp-page="/Production/SeedSowing/Details" asp-route-id="@sw.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            @if (canSow && sw.Status == "Sown")
                            {
                                <a asp-page="/Production/SeedSowing/Edit" asp-route-id="@sw.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Sowings.Any())
                {
                    <tr><td colspan="13" class="text-center text-muted">No Sowing records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
