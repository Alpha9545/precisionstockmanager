@page
@model PlantStockManager.Pages.Production.SeedSowing.IndexModel
@{
    ViewData["Title"] = "Seed Sowing";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Seed Sowing</h2>
        <div>
            <a asp-page="/Production/SeedSowing/Create" class="btn btn-primary">+ Sow Seed</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total Sown (excl. Cancelled)</div>
                    <div class="fs-3 fw-bold">@Model.TotalSown.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Species/Variety</th>
                    <th>Lot/Batch</th>
                    <th>Area</th>
                    <th>Cavity Type</th>
                    <th>Sowing Date</th>
                    <th>Expected Ready</th>
                    <th>Quantity Sown</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sw in Model.Sowings)
                {
                    <tr>
                        <td>@sw.SowingCode</td>
                        <td>@sw.SpeciesName <span class="text-muted">(@sw.PlantTypeName)</span></td>
                        <td>@(string.IsNullOrEmpty(sw.BatchNo) ? "-" : sw.BatchNo)</td>
                        <td>@sw.AreaName</td>
                        <td>@sw.CavityType@(sw.NumberOfTrays.HasValue ? $" x{sw.NumberOfTrays}" : "")</td>
                        <td>@sw.SowingDate.ToString("dd/MM/yyyy")</td>
                        <td>@(sw.ExpectedReadyDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>@sw.QuantitySown.ToString("N2")</td>
                        <td>
                            @if (sw.Status == "Cancelled")
                            {
                                <span class="badge bg-secondary">Cancelled</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Sown</span>
                            }
                        </td>
                        <td>
                            <a asp-page="/Production/SeedSowing/Details" asp-route-id="@sw.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            <a asp-page="/Production/SeedSowing/Edit" asp-route-id="@sw.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                        </td>
                    </tr>
                }
                @if (!Model.Sowings.Any())
                {
                    <tr><td colspan="10" class="text-center text-muted">No Sowing records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
