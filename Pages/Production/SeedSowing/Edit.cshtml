@page "{id:int}"
@model PlantStockManager.Pages.Production.SeedSowing.EditModel
@{
    ViewData["Title"] = "Edit Sowing";
    var s = Model.SeedSowing;
    var unit = s.IsCuttingSource ? "Cuttings" : "Seeds";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 850px;">
        <div class="card-header">
            <h4 class="mb-0">Edit Sowing &mdash; @s.SowingCode</h4>
        </div>
        <div class="card-body">
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <table class="table table-sm table-bordered mb-3">
                <tbody>
                    <tr><th class="w-50">Source</th><td>@(s.IsCuttingSource ? "Cutting Stock" : "Seed lot " + s.BatchNo)</td></tr>
                    <tr><th>Variety</th><td>@s.SpeciesName.Trim() (@s.PlantTypeName)</td></tr>
                    <tr><th>Area</th><td>@s.AreaName</td></tr>
                    <tr><th>Cavity / Complete Trays</th><td>@s.CavityType &times; @(s.NumberOfTrays?.ToString("N0") ?? "-")</td></tr>
                    <tr><th>@unit Used</th><td>@s.QuantitySown.ToString("N0")</td></tr>
                    <tr><th>Assigned Supervisor (only approver)</th><td>@(s.SupervisorName ?? "-")</td></tr>
                    <tr><th>Expected Ready Date</th><td>@(s.ExpectedReadyDate?.ToString("dd/MM/yyyy") ?? "-")</td></tr>
                </tbody>
            </table>
            <div class="small text-muted mb-3">
                These values are final once the sowing is saved. If something is wrong, cancel the sowing
                (the @unit.ToLower() go back to stock) and record it again.
            </div>

            @if (s.Status == "Cancelled")
            {
                <div class="alert alert-warning">This sowing is Cancelled.</div>
            }
            else
            {
                <form method="post">
                    <input type="hidden" asp-for="Id" />
                    <label class="form-label fw-bold">Remarks</label>
                    <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                    <div class="text-center mt-3">
                        <a asp-page="/Production/SeedSowing/Index" class="btn btn-secondary me-2">Back</a>
                        <button type="submit" class="btn btn-success">Save Remarks</button>
                    </div>
                </form>
            }

            @if (s.Status == "Sown" && s.ConfirmedReadyQuantity == 0 && s.WastageQuantity == 0)
            {
                <hr />
                <form method="post" asp-page-handler="Cancel" asp-route-id="@s.Id" onsubmit="return confirm('Cancel this sowing? The @unit.ToLower() used go back to stock. This cannot be undone.');">
                    <div class="text-center">
                        <button type="submit" class="btn btn-outline-danger">Cancel Sowing (return @unit.ToLower() to stock)</button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>
