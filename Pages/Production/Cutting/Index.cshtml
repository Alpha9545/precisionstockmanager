@page
@model PlantStockManager.Pages.Production.Cutting.IndexModel
@inject PlantStockManager.Authorization.FeatureAccessService FeatureAccess
@{
    ViewData["Title"] = "Cutting Production";
    var canEnter = await FeatureAccess.CanAccessPageAsync(User, "/Production/Cutting/Create");
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h3 class="mb-0">Cutting Production</h3>
        <div class="d-flex gap-2">
            <a asp-page="/Production/CuttingStock/Index" class="btn btn-outline-secondary">Cutting Stock</a>
            @if (canEnter)
            {
                <a asp-page="/Production/Cutting/Create" class="btn btn-success">+ Record Cuttings</a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-auto">
            <label class="form-label mb-0">From</label>
            <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-auto">
            <label class="form-label mb-0">To</label>
            <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-auto"><button class="btn btn-primary">Show</button></div>
    </form>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-sm">
            <thead class="table-light">
                <tr>
                    <th>Code</th><th>Date</th><th>Mother Plant</th><th>Variety</th><th>Colour</th><th>Area</th>
                    <th class="text-end">Cuttings</th><th>Supervisor</th><th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Items)
                {
                    <tr>
                        <td>@c.ProductionCode</td>
                        <td>@c.CuttingDate.ToString("dd/MM/yyyy")</td>
                        <td>@c.MotherPlantCode</td>
                        <td>@c.SpeciesName <span class="text-muted">(@c.PlantTypeName)</span></td>
                        <td>@(c.Color ?? "-")</td>
                        <td>@c.AreaName</td>
                        <td class="text-end">@c.Quantity.ToString("N0")</td>
                        <td>@(c.SupervisorName ?? "-")</td>
                        <td>@(c.Remarks ?? "")</td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted">No cuttings recorded in this period.</td></tr>
                }
            </tbody>
            @if (Model.Items.Any())
            {
                <tfoot>
                    <tr class="fw-bold"><td colspan="6">Total</td><td class="text-end">@Model.Items.Sum(i => i.Quantity).ToString("N0")</td><td colspan="2"></td></tr>
                </tfoot>
            }
        </table>
    </div>
</div>
