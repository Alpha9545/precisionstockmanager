@page "{id:int}"
@model PlantStockManager.Pages.Production.LabRequest.ResultModel
@{
    ViewData["Title"] = "Record Lab Result";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 700px;">
        <div class="card-header">
            <h4 class="mb-0">Record Result &mdash; @Model.Request!.LabRequestCode</h4>
        </div>
        <div class="card-body">
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <div class="alert alert-secondary">
                <strong>@Model.Request.SpeciesName (@Model.Request.PlantTypeName)</strong> &mdash;
                Pot Size <strong>@Model.Request.PotSize</strong> &mdash;
                Area <strong>@(Model.Request.AreaName ?? "Unassigned")</strong> &mdash;
                Sent to <strong>@Model.Request.LabName</strong> on @Model.Request.SentDate.ToString("dd/MM/yyyy") &mdash;
                Sent Quantity <strong>@Model.Request.SentQuantity.ToString("N2")</strong>
                <div class="small text-muted">
                    The Received Quantity can be more or less than the Sent Quantity -- it reflects however much
                    the lab actually returned (e.g. multiplication), not a 1:1 return.
                </div>
            </div>

            <form method="post">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Received Quantity</label>
                        <input type="number" step="0.01" min="0.01" asp-for="ReceivedQuantity" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Received Date</label>
                        <input type="date" asp-for="ReceivedDate" class="form-control" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold">Result Notes</label>
                        <textarea asp-for="ResultNotes" class="form-control" rows="3"></textarea>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <a asp-page="/Production/LabRequest/Details" asp-route-id="@Model.Request.Id" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-success">Save Result</button>
                </div>
            </form>
        </div>
    </div>
</div>
