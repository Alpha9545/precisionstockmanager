@page
@model PlantStockManager.Pages.Production.LabRequest.CreateModel
@{
    ViewData["Title"] = "New Lab Request";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 800px;">
        <div class="card-header">
            <h4 class="mb-0">New Lab Request</h4>
        </div>
        <div class="card-body">
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form method="post">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label fw-bold">Species / Pot Size / Area</label>
                        <select id="stockSelect" asp-for="Request.PottedPlantStockId" class="form-select" required>
                            <option value="">-- Select Stock Pool --</option>
                            @foreach (var s in Model.StockPools)
                            {
                                <option value="@s.Id" data-available="@s.AvailableQuantity.ToString("N2")">
                                    @s.SpeciesName (@s.PlantTypeName) - @s.PotSize - @(s.AreaName ?? "Unassigned") (Available: @s.AvailableQuantity.ToString("N2"))
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Lab Name</label>
                        <input type="text" asp-for="Request.LabName" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Sent Quantity</label>
                        <input type="number" step="0.01" min="0.01" asp-for="Request.SentQuantity" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Sent Date</label>
                        <input type="date" asp-for="Request.SentDate" class="form-control" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Expected Result Date</label>
                        <input type="date" asp-for="Request.ExpectedResultDate" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Responsible Person</label>
                        <select asp-for="Request.ResponsiblePersonId" class="form-select">
                            <option value="">-- None --</option>
                            @foreach (var e in Model.PersonOptions)
                            {
                                <option value="@e.EmployeeID">@e.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Remarks</label>
                        <textarea asp-for="Request.Remarks" class="form-control" rows="2"></textarea>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <a asp-page="/Production/LabRequest/Index" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-success">Send to Lab</button>
                </div>
            </form>
        </div>
    </div>
</div>
