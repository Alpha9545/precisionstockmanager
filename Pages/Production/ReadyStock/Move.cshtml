@page "{id:int}"
@model PlantStockManager.Pages.Production.ReadyStock.MoveModel
@{
    ViewData["Title"] = "Send Ready Stock";
    var b = Model.Batch;
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 760px;">
        <div class="card-header">
            <h4 class="mb-0">Send Ready Stock (Trays)</h4>
            <small class="text-muted">The whole batch moves together -- it cannot be split across two Areas, and only before any of it is reserved or dispatched.</small>
        </div>
        <div class="card-body">
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <table class="table table-sm table-bordered">
                <tbody>
                    <tr><th class="w-50">Batch</th><td>@b.SowingCode</td></tr>
                    <tr><th>Variety</th><td>@b.SpeciesName?.Trim() (@b.PlantTypeName)</td></tr>
                    <tr><th>Cavity</th><td>@b.CavityType</td></tr>
                    <tr><th>From Area</th><td>@b.AreaName</td></tr>
                    <tr><th>Ready trays</th><td class="fw-bold">@b.Quantity.ToString("N0")</td></tr>
                    <tr><th>Reserved / Dispatched</th><td>@b.ReservedQuantity.ToString("N0") / @b.DispatchedQuantity.ToString("N0")</td></tr>
                </tbody>
            </table>

            @if (b.ReservedQuantity > 0 || b.DispatchedQuantity > 0)
            {
                <div class="alert alert-warning">This batch already has bookings or dispatches against it, so it can no longer be moved.</div>
            }
            else if (b.AvailableQuantity <= 0)
            {
                <div class="alert alert-warning">Nothing is available to send.</div>
            }
            else
            {
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Send to</label>
                        <div class="d-flex gap-3 flex-wrap">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="Destination" value="@PlantStockManager.Pages.Production.ReadyStock.MoveModel.ToMainOffice" id="dMain" disabled="@(!Model.CanTransfer || !Model.MainOfficeAreas.Any())" />
                                <label class="form-check-label" for="dMain">Main Office</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="Destination" value="@PlantStockManager.Pages.Production.ReadyStock.MoveModel.ToOutlet" id="dOutlet" disabled="@(!Model.CanTransfer || !Model.OutletAreas.Any())" />
                                <label class="form-check-label" for="dOutlet">Outlet</label>
                            </div>
                        </div>
                        @if (!Model.CanTransfer)
                        {
                            <div class="form-text text-danger">You are not authorized to transfer stock.</div>
                        }
                    </div>

                    <div class="mb-3 dest dest-MainOffice d-none">
                        <label class="form-label fw-bold">Main Office Area</label>
                        <select class="form-select dest-area" data-for="MainOffice">
                            @foreach (var a in Model.MainOfficeAreas)
                            {
                                <option value="@a.Id">@a.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3 dest dest-Outlet d-none">
                        <label class="form-label fw-bold">Outlet</label>
                        <select class="form-select dest-area" data-for="Outlet">
                            @foreach (var a in Model.OutletAreas)
                            {
                                <option value="@a.Id">@a.Name</option>
                            }
                        </select>
                    </div>
                    <input type="hidden" asp-for="DestinationAreaId" id="destinationAreaId" />

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Trays to send</label>
                            <input type="number" asp-for="Quantity" class="form-control" readonly />
                            <div class="form-text">Always the whole batch.</div>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Remarks / reference</label>
                            <input type="text" asp-for="Remarks" class="form-control" maxlength="500" />
                        </div>
                    </div>
                    <div class="text-center mt-4">
                        <a asp-page="/Production/ReadyStock/Index" class="btn btn-secondary me-2">Back</a>
                        <button type="submit" class="btn btn-success">Send</button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            function sync() {
                const d = $('input[name="Destination"]:checked').val();
                $('.dest').addClass('d-none');
                if (d) $('.dest-' + d).removeClass('d-none');
                const $sel = $('.dest-area[data-for="' + d + '"]');
                $('#destinationAreaId').val($sel.length ? $sel.val() : '');
            }
            $('input[name="Destination"]').on('change', sync);
            $('.dest-area').on('change', sync);
            sync();
        });
    </script>
}
