@page "{id:int}"
@model PlantStockManager.Pages.Production.ReadyStock.LineageModel
@using PlantStockManager.Services
@{
    ViewData["Title"] = "Batch lineage #" + Model.Batch.Id;
    var b = Model.Batch;
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
        <h3 class="mb-0">Batch #@b.Id &middot; @b.SpeciesName?.Trim()</h3>
        <a asp-page="/Production/ReadyStock/Index" class="btn btn-sm btn-outline-secondary">Ready Stock</a>
    </div>
    <div class="row g-2 mb-3 small" id="balances">
        <div class="col-6 col-md-2"><div class="border rounded p-2 bg-white">Location<br /><strong>@b.AreaName / @(b.PolyhouseName ?? "-")</strong></div></div>
        <div class="col-6 col-md-2"><div class="border rounded p-2 bg-white">Cavity<br /><strong>@b.CavityType</strong></div></div>
        <div class="col-6 col-md-2"><div class="border rounded p-2 bg-white">Physical<br /><strong>@Qty(b.PhysicalQuantity)</strong></div></div>
        <div class="col-6 col-md-2"><div class="border rounded p-2 bg-white">Reserved<br /><strong>@Qty(b.ReservedQuantity)</strong></div></div>
        <div class="col-6 col-md-2"><div class="border rounded p-2 bg-white">In transit<br /><strong>@Qty(b.InTransitQuantity)</strong></div></div>
        <div class="col-6 col-md-2"><div class="border rounded p-2 bg-white">Dispatched<br /><strong>@Qty(b.DispatchedQuantity)</strong></div></div>
    </div>

    <h5>Where it came from</h5>
    <partial name="/Pages/Production/ReadyStock/_LineageChain.cshtml" model="Model.Lineage" />
    @if (Model.ReceivedFrom is { } rf)
    {
        <p class="small">Received through transfer <a asp-page="/Production/MotherPlantTransfers/Index" asp-route-highlight="@rf.Id">@rf.TransferCode</a>
            from @rf.SourceAreaName (@rf.TransferDate.ToString("dd/MM/yyyy")): @Qty(rf.Quantity) sent, @Qty(rf.ReceivedQuantity) received@(rf.LossQuantity is > 0 ? $", {Qty(rf.LossQuantity)} lost in transit" : "").</p>
    }

    <h5>Where its plants went</h5>
    @if (!Model.Children.Any() && !Model.TransfersOut.Any() && !Model.Transplants.Any(t => t.SourceReadyStockId == b.Id))
    {
        <p class="small text-muted">No transfer or transplanting from this batch yet (customer dispatches appear in the ledger below).</p>
    }
    <ul class="small" id="downstream">
        @foreach (var t in Model.TransfersOut)
        {
            <li>Transfer <a asp-page="/Production/MotherPlantTransfers/Index" asp-route-highlight="@t.Id">@t.TransferCode</a> &rarr; @t.DestinationAreaName@(t.DestinationPolyhouseName != null ? " / " + t.DestinationPolyhouseName : "") (@t.PurposeLabel):
                @Qty(t.Quantity) plants, @t.StatusLabel@if (t.ReceivedReadyStockId is int r) { <span> &rarr; <a asp-page="/Production/ReadyStock/Lineage" asp-route-id="@r">batch #@r</a></span> }</li>
        }
        @foreach (var t in Model.Transplants.Where(t => t.SourceReadyStockId == b.Id))
        {
            <li>Transplanting <a asp-page="/Production/Transplanting/Details" asp-route-id="@t.Id">@t.TransplantCode</a> (@t.TransplantDate.ToString("dd/MM/yyyy"), @t.Status):
                @Qty(t.TransplantedQuantity) into @t.TargetCavityType at @t.AreaName / @(t.PolyhouseName ?? "Area trays")@(t.LostQuantity > 0 ? $", {Qty(t.LostQuantity)} lost" : "")
                @if (t.OutputReadyStockId is int o) { <span> &rarr; <a asp-page="/Production/ReadyStock/Lineage" asp-route-id="@o">batch #@o</a></span> }</li>
        }
    </ul>

    <h5>Ledger of this batch</h5>
    <div class="table-responsive">
        <table class="table table-sm table-striped" id="ledger">
            <thead class="table-light"><tr><th>When (IST)</th><th>Type</th><th>Reference</th><th class="text-end">Plants</th><th class="text-end">Before</th><th>Remarks</th></tr></thead>
            <tbody>
                @foreach (var l in Model.Ledger)
                {
                    <tr>
                        <td>@AppClock.ToIndiaTime(l.TransactionDate).ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@l.TransactionType</td>
                        <td class="small">@l.ReferenceType @l.ReferenceId</td>
                        <td class="text-end">@Qty(l.Quantity)</td>
                        <td class="text-end">@Qty(l.BeforeQuantity)</td>
                        <td class="small">@l.Remarks</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="small text-muted">Reservation / transfer-hold rows move reserved or in-transit plants only; every other row changes the batch's plants.</p>
</div>
