@page
@model PlantStockManager.Pages.Production.ReadyStock.IndexModel
@inject PlantStockManager.Authorization.FeatureAccessService FeatureAccess
@using Microsoft.AspNetCore.Authorization
@using PlantStockManager.Services
@inject IAuthorizationService Authz
@inject PlantStockManager.Authorization.AreaAccessService StrictArea
@{
    ViewData["Title"] = "Ready Stock";
    var canSeeSowing = await FeatureAccess.CanAccessPageAsync(User, "/Production/SeedSowing/Details");
    var canSeeApproval = await FeatureAccess.CanAccessPageAsync(User, "/Production/ReadyConfirmation/Index");
    var canMove = await FeatureAccess.CanAccessPageAsync(User, "/Production/ReadyStock/Move");
    // 2026-10-19: Send opens the Main Office / Outlet transfer (whole untouched batch, unchanged) and, for ReadyStock.DispatchToCustomer
    // holders in the batch's own Area, the customer dispatch (whole trays). The Move page and the repository re-check both.
    var canTransferStock = canMove && (await Authz.AuthorizeAsync(User, PlantStockManager.Pages.Production.ReadyStock.MoveModel.TransferPolicy)).Succeeded;
    var canCustomerDispatch = canMove && (await Authz.AuthorizeAsync(User, PlantStockManager.Pages.Production.ReadyStock.MoveModel.CustomerDispatchPolicy)).Succeeded;
    // 2026-10-09: the two paths of Main Area Ready Stock, and transplanting in Mother Plant Areas.
    var canDispatch = await FeatureAccess.CanAccessPageAsync(User, "/Bookings/SeedlingDispatch");
    var canTransferMp = await FeatureAccess.CanAccessPageAsync(User, "/Production/ReadyStock/TransferToMotherPlant");
    var canTransplant = await FeatureAccess.CanAccessPageAsync(User, "/Production/Transplanting/Create");
    var canTrace = await FeatureAccess.CanAccessPageAsync(User, "/Production/ReadyStock/Lineage");
    // 2026-10-22: the Overgrowth page (ReadyStock.Overgrowth); the page and the save check the batch's own Area again.
    var canOvergrowth = await FeatureAccess.CanAccessPageAsync(User, "/Production/ReadyStock/Overgrowth");
    var og = Model.OvergrowthTotals;
    var normal = Model.NormalTotals;
    var dash = "–";
}

<div class="container-fluid mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="mb-0">Ready Stock <small class="text-muted fs-6">(supervisor-approved batches)</small></h2>
        <div class="d-flex flex-wrap gap-1">
            @* 2026-10-27: exports carry the whole list state (ListRoute), so they hold exactly the rows shown. *@
            <a asp-page="/Production/ReadyStock/Index" asp-page-handler="ExportPdf" asp-all-route-data="@Model.ListRoute"
               class="btn btn-outline-secondary btn-sm" target="_blank" rel="noopener" id="exportPdf">Print</a>
            <a asp-page="/Production/ReadyStock/Index" asp-page-handler="ExportExcel" asp-all-route-data="@Model.ListRoute"
               class="btn btn-outline-secondary btn-sm" id="exportExcel">Export Excel</a>
            @if (canSeeApproval)
            {
                <a asp-page="/Production/ReadyConfirmation/Index" class="btn btn-outline-secondary">Supervisor Approval</a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

    <form method="get" class="row g-2 mb-3" id="readyStockFilters" role="search" aria-label="Filter Ready Stock">
        <div class="col-12 col-md-6 col-lg-4">
            <input type="text" name="Search" value="@Model.Search" class="form-control" placeholder="Batch, species, variety, area or polyhouse" />
        </div>
        <div class="col-12 col-sm-6 col-md-3 col-lg-2">
            <select name="Stock" class="form-select" id="stockFilter" aria-label="Overgrowth">
                <option value="" selected="@(Model.Stock != PlantStockManager.Pages.Production.ReadyStock.IndexModel.StockOvergrowth && Model.Stock != PlantStockManager.Pages.Production.ReadyStock.IndexModel.StockNormal)">All stock</option>
                <option value="@PlantStockManager.Pages.Production.ReadyStock.IndexModel.StockOvergrowth" selected="@(Model.Stock == PlantStockManager.Pages.Production.ReadyStock.IndexModel.StockOvergrowth)">@OvergrowthRules.Label only</option>
                <option value="@PlantStockManager.Pages.Production.ReadyStock.IndexModel.StockNormal" selected="@(Model.Stock == PlantStockManager.Pages.Production.ReadyStock.IndexModel.StockNormal)">Normal stock only</option>
            </select>
        </div>
        <div class="col-12 col-sm-6 col-md-3 col-lg-4 d-flex align-items-center">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="IncludeEmpty" value="true" id="includeEmpty" @(Model.IncludeEmpty ? "checked" : "") />
                <label class="form-check-label" for="includeEmpty">Include batches with no plants left</label>
            </div>
        </div>
        @* 2026-10-27: option lists built from the batches this user may see (Services/ReadyStockListFilter.cs).
           Their own line: 2 per line on phones, 3 on tablets, 6 on desktops. *@
        <div class="w-100 m-0"></div>
        <div class="col-6 col-md-4 col-lg-2">
            <label class="form-label small fw-bold mb-1" for="speciesFilter">Species</label>
            <select name="@ReadyStockListFilter.SpeciesKey" class="form-select form-select-sm" id="speciesFilter">
                <option value="">All species</option>
                @foreach (var o in Model.Options.Species) { <option value="@o" selected="@(Model.Filter.Species == o)">@o</option> }
            </select>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <label class="form-label small fw-bold mb-1" for="varietyFilter">Variety</label>
            <select name="@ReadyStockListFilter.VarietyKey" class="form-select form-select-sm" id="varietyFilter">
                <option value="">All varieties</option>
                @foreach (var o in Model.Options.Varieties) { <option value="@o.Id" selected="@(Model.Filter.VarietyId == o.Id)">@o.Label</option> }
            </select>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <label class="form-label small fw-bold mb-1" for="areaFilter">Area</label>
            <select name="@ReadyStockListFilter.AreaKey" class="form-select form-select-sm" id="areaFilter">
                <option value="">All Areas</option>
                @foreach (var o in Model.Options.Areas) { <option value="@o.Id" selected="@(Model.Filter.AreaId == o.Id)">@o.Label</option> }
            </select>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <label class="form-label small fw-bold mb-1" for="polyhouseFilter">Polyhouse</label>
            <select name="@ReadyStockListFilter.PolyhouseKey" class="form-select form-select-sm" id="polyhouseFilter">
                <option value="">All Polyhouses</option>
                @foreach (var o in Model.Options.Polyhouses) { <option value="@o.Id" selected="@(Model.Filter.PolyhouseId == o.Id)">@o.Label</option> }
            </select>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <label class="form-label small fw-bold mb-1" for="originFilter">Origin</label>
            <select name="@ReadyStockListFilter.OriginKey" class="form-select form-select-sm" id="originFilter">
                <option value="">All origins</option>
                @foreach (var o in Model.Options.Origins) { <option value="@o" selected="@(Model.Filter.Origin == o)">@ReadyStockListFilter.OriginLabel(o)</option> }
            </select>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <label class="form-label small fw-bold mb-1" for="statusFilter">Status</label>
            <select name="@ReadyStockListFilter.StatusKey" class="form-select form-select-sm" id="statusFilter">
                <option value="">All statuses</option>
                @foreach (var o in Model.Options.Statuses) { <option value="@o" selected="@(Model.Filter.Status == o)">@o</option> }
            </select>
        </div>
        <div class="col-12 col-sm-auto d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill flex-sm-grow-0" id="applyFilters">Filter</button>
            <a asp-page="/Production/ReadyStock/Index" class="btn btn-outline-secondary flex-fill flex-sm-grow-0" id="clearFilters">Clear</a>
        </div>
        <div class="col-12 col-sm text-sm-end align-self-center small" id="readyStockTotals">
            @* 2026-10-10 standard definitions (docs/STOCK_DEFINITIONS.md) *@
            <strong>Available for booking/dispatch:</strong> @Qty(Model.Items.Sum(i => i.AvailableQuantity)) &middot;
            Physical: @Qty(Model.TotalQuantity) &middot;
            Reserved: @Qty(Model.Items.Sum(i => i.ReservedQuantity))
            @if (Model.Items.Any(i => i.InTransitQuantity > 0))
            {
                <span>&middot; In transit: @Qty(Model.Items.Sum(i => i.InTransitQuantity))</span>
            }
        </div>
    </form>

    @if (Model.FilterNote != null)
    {
        <div class="small text-warning-emphasis mb-2" id="readyStockFilterNote">@Model.FilterNote</div>
    }

    @* 2026-10-22: Overgrowth monitored separately from normal Ready Stock (same Search / empty-batch / option-list filters). *@
    @if (og.Batches > 0 || Model.Stock == PlantStockManager.Pages.Production.ReadyStock.IndexModel.StockOvergrowth)
    {
        <div class="d-flex flex-wrap gap-3 small border rounded px-3 py-2 mb-3 bg-light" id="overgrowthSummary">
            <span>@OvergrowthRules.Badge(true) <strong>@og.Batches</strong> batch@(og.Batches == 1 ? "" : "es") &middot;
                physical <strong id="ogPhysical">@Qty(og.Physical)</strong> &middot; available <strong id="ogAvailable">@Qty(og.Available)</strong> &middot; reserved @Qty(og.Reserved)</span>
            <span class="text-muted">Normal stock: @normal.Batches batch@(normal.Batches == 1 ? "" : "es") &middot; physical <span id="normalPhysical">@Qty(normal.Physical)</span> &middot; available <span id="normalAvailable">@Qty(normal.Available)</span></span>
            @if (Model.Stock != PlantStockManager.Pages.Production.ReadyStock.IndexModel.StockOvergrowth)
            {
                <a asp-page="/Production/ReadyStock/Index" asp-all-route-data="@Model.ListRouteWithStock(PlantStockManager.Pages.Production.ReadyStock.IndexModel.StockOvergrowth)" id="showOvergrowthOnly">Show Overgrowth only</a>
            }
        </div>
    }

    <div class="table-responsive">
        <table class="table table-sm table-striped table-hover">
            <thead class="table-light">
                <tr>
                    <th>Batch No.</th>
                    <th title="Sowing = the batch of a sowing; Received / Transplanted = derived from another batch">Origin</th>
                    <th>Species</th>
                    <th>Variety</th>
                    <th>Area</th>
                    <th>Polyhouse</th>
                    <th>Cavity</th>
                    <th>Sowing Date</th>
                    <th>Seeds / Cuttings Used</th>
                    <th>Sowing Trays</th>
                    <th>Ready Trays</th>
                    <th>Ready Seedlings</th>
                    <th>Wastage</th>
                    <th>Wastage %</th>
                    <th>Reserved</th>
                    <th>Dispatched</th>
                    <th title="Sent to a Mother Plant Area, not yet received: not available here or there">In Transit</th>
                    <th>Available</th>
                    <th>Status</th>
                    <th>Approved By</th>
                    <th>Approval Date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Items)
                {
                    <tr>
                        <td>
                            @if (canSeeSowing)
                            {
                                <a asp-page="/Production/SeedSowing/Details" asp-route-id="@r.SeedSowingId">@r.SowingCode</a>
                            }
                            else
                            {
                                @r.SowingCode
                            }
                            @if (r.IsOvergrowth)
                            {
                                <div>@OvergrowthRules.Badge(true)</div>
                            }
                        </td>
                        <td>
                            @if (r.IsSowingBatch) { <span>Sowing</span> }
                            else { <span class="badge @(r.OriginType == PlantStockManager.Models.ReadyStock.OriginTransplant ? "bg-success" : "bg-info text-dark")">@r.OriginLabel</span> }
                        </td>
                        <td>@r.PlantTypeName</td>
                        <td>@r.SpeciesName</td>
                        <td>@r.AreaName</td>
                        <td>@(r.PolyhouseName ?? "-")</td>
                        <td>@r.CavityType</td>
                        <td>@r.SowingDate.ToString("dd/MM/yyyy")</td>
                        @* Sowing-level figures belong to the original sowing: shown on its own batch only. *@
                        <td>@(r.IsSowingBatch ? Qty(r.QuantitySown) : dash)</td>
                        <td>@(r.IsSowingBatch ? Qty(r.SowingTrays) : dash)</td>
                        <td>@(r.IsSowingBatch ? Qty(r.ReadyTrays, "–") : Qty(r.PhysicalTrays, "–"))</td>
                        <td>@Qty(r.Quantity)</td>
                        <td>@(r.IsSowingBatch ? Qty(r.WastageQuantity) : dash)</td>
                        <td>@(r.IsSowingBatch ? r.WastagePercent.ToString("0.00") + "%" : dash)</td>
                        <td>@Qty(r.ReservedQuantity)</td>
                        <td>@Qty(r.DispatchedQuantity)</td>
                        <td>@(r.InTransitQuantity > 0 ? Qty(r.InTransitQuantity) : dash)</td>
                        <td><strong>@Qty(r.AvailableQuantity)</strong></td>
                        <td>@r.Status</td>
                        <td>@(r.IsSowingBatch ? r.ApprovedByName ?? "-" : dash)</td>
                        <td>@(r.IsSowingBatch ? r.ApprovalDate?.ToString("dd/MM/yyyy") ?? "-" : dash)</td>
                        <td class="text-nowrap">
                            @if ((canTransferStock && r.IsSowingBatch && r.AvailableQuantity > 0 && r.ReservedQuantity == 0 && r.DispatchedQuantity == 0 && r.InTransitQuantity == 0)
                                 || (canCustomerDispatch && (r.InMainArea || r.InMotherPlantArea) && StrictArea.CanAccessArea(User, r.AreaId) && r.TraySize is > 0 && r.AvailableQuantity >= r.TraySize))
                            {
                                <a asp-page="/Production/ReadyStock/Move" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Send</a>
                            }
                            @if (canDispatch && r.AvailableQuantity > 0)
                            {
                                <a asp-page="/Bookings/SeedlingDispatch" class="btn btn-sm btn-outline-secondary" title="Option A: book and dispatch to a customer (existing booking / dispatch workflow)">Dispatch to Customer</a>
                            }
                            @if (canTransferMp && r.IsSowingBatch && r.InMainArea && r.TraySize is > 0 && r.AvailableQuantity >= r.TraySize)
                            {
                                <a asp-page="/Production/ReadyStock/TransferToMotherPlant" asp-route-id="@r.Id" class="btn btn-sm btn-outline-success" title="Option B: send to a Mother Plant Area for transplanting">Transfer to Mother Plant</a>
                            }
                            @if (canTransplant && r.InMotherPlantArea && r.AvailableQuantity > 0)
                            {
                                <a asp-page="/Production/Transplanting/Create" asp-route-id="@r.Id" class="btn btn-sm btn-success">Transplant</a>
                            }
                            @if (canOvergrowth && StrictArea.CanAccessArea(User, r.AreaId) && (r.IsOvergrowth || r.PhysicalQuantity > 0))
                            {
                                <a asp-page="/Production/ReadyStock/Overgrowth" asp-all-route-data="@Model.ListRoute" asp-route-id="@r.Id" class="btn btn-sm btn-outline-warning" data-og-action="@r.Id"
                                   title="@(r.IsOvergrowth ? "Overgrowth since " + r.OvergrowthMarkedAt?.ToString("dd/MM/yyyy") + ": " + r.OvergrowthReason : "Mark this batch as Overgrowth")">@(r.IsOvergrowth ? "OG…" : "Mark OG")</a>
                            }
                            @if (canTrace && (!r.IsSowingBatch || r.Quantity != r.ApprovedReadyQuantity))
                            {
                                <a asp-page="/Production/ReadyStock/Lineage" asp-all-route-data="@Model.ListRoute" asp-route-id="@r.Id" class="btn btn-sm btn-link">Trace</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="22" class="text-center text-muted">@(Model.Stock == PlantStockManager.Pages.Production.ReadyStock.IndexModel.StockOvergrowth ? "No Ready Stock batch is marked as Overgrowth." : Model.Filter.IsActive || !string.IsNullOrWhiteSpace(Model.Search) ? "No Ready Stock matches the selected filters." : "No approved Ready Stock found.")</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
