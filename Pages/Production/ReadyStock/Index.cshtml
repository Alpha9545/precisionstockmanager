@page
@model PlantStockManager.Pages.Production.ReadyStock.IndexModel
@inject PlantStockManager.Authorization.FeatureAccessService FeatureAccess
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService Authz
@inject PlantStockManager.Authorization.AreaAccessService StrictArea
@{
    ViewData["Title"] = "Ready Stock";
    var canSeeSowing = await FeatureAccess.CanAccessPageAsync(User, "/Production/SeedSowing/Details");
    var canSeeApproval = await FeatureAccess.CanAccessPageAsync(User, "/Production/ReadyConfirmation/Index");
    var canMove = await FeatureAccess.CanAccessPageAsync(User, "/Production/ReadyStock/Move");
    // 2026-10-19: Send opens the Main Office / Outlet transfer (whole untouched batch, unchanged) and, for ReadyStock.DispatchToCustomer
    // holders in the batch's own Area, the customer dispatch (whole trays). The Move page and the repository re-check both.
    var canTransferStock = canMove && (await Authz.AuthorizeAsync(User, PlantStockManager.Pages.Production.ReadyStock.MoveModel.TransferPolicy)).Succeeded;
    var canCustomerDispatch = canMove && (await Authz.AuthorizeAsync(User, PlantStockManager.Pages.Production.ReadyStock.MoveModel.CustomerDispatchPolicy)).Succeeded;
    // 2026-10-09: the two paths of Main Area Ready Stock, and transplanting in Mother Plant Areas.
    var canDispatch = await FeatureAccess.CanAccessPageAsync(User, "/Bookings/SeedlingDispatch");
    var canTransferMp = await FeatureAccess.CanAccessPageAsync(User, "/Production/ReadyStock/TransferToMotherPlant");
    var canTransplant = await FeatureAccess.CanAccessPageAsync(User, "/Production/Transplanting/Create");
    var canTrace = await FeatureAccess.CanAccessPageAsync(User, "/Production/ReadyStock/Lineage");
    var dash = "–";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Ready Stock <small class="text-muted fs-6">(supervisor-approved batches)</small></h2>
        <div>
            <a asp-page="/Production/ReadyStock/Index" asp-page-handler="ExportPdf"
               asp-route-Search="@Model.Search" asp-route-IncludeEmpty="@Model.IncludeEmpty"
               class="btn btn-outline-secondary btn-sm" target="_blank" rel="noopener">Print</a>
            <a asp-page="/Production/ReadyStock/Index" asp-page-handler="ExportExcel"
               asp-route-Search="@Model.Search" asp-route-IncludeEmpty="@Model.IncludeEmpty"
               class="btn btn-outline-secondary btn-sm">Export Excel</a>
            @if (canSeeApproval)
            {
                <a asp-page="/Production/ReadyConfirmation/Index" class="btn btn-outline-secondary">Supervisor Approval</a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

    <form method="get" class="row g-2 mb-3">
        <div class="col-md-4">
            <input type="text" name="Search" value="@Model.Search" class="form-control" placeholder="Batch, species, variety, area or polyhouse" />
        </div>
        <div class="col-md-3 d-flex align-items-center">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="IncludeEmpty" value="true" id="includeEmpty" @(Model.IncludeEmpty ? "checked" : "") />
                <label class="form-check-label" for="includeEmpty">Include batches with no plants left</label>
            </div>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">Filter</button>
        </div>
        <div class="col-md-3 text-end align-self-center">
            @* 2026-10-10 standard definitions (docs/STOCK_DEFINITIONS.md) *@
            <strong>Available for booking/dispatch:</strong> @Qty(Model.Items.Sum(i => i.AvailableQuantity)) &middot;
            Physical: @Qty(Model.TotalQuantity) &middot;
            Reserved: @Qty(Model.Items.Sum(i => i.ReservedQuantity))
            @if (Model.Items.Any(i => i.InTransitQuantity > 0))
            {
                <span>&middot; In transit: @Qty(Model.Items.Sum(i => i.InTransitQuantity))</span>
            }
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-sm table-striped table-hover">
            <thead class="table-light">
                <tr>
                    <th>Batch No.</th>
                    <th title="Sowing = the batch of a sowing; Received / Transplanted = derived from another batch">Origin</th>
                    <th>Species</th>
                    <th>Variety</th>
                    <th>Area</th>
                    <th>Polyhouse</th>
                    <th>Cavity</th>
                    <th>Sowing Date</th>
                    <th>Seeds / Cuttings Used</th>
                    <th>Sowing Trays</th>
                    <th>Ready Trays</th>
                    <th>Ready Seedlings</th>
                    <th>Wastage</th>
                    <th>Wastage %</th>
                    <th>Reserved</th>
                    <th>Dispatched</th>
                    <th title="Sent to a Mother Plant Area, not yet received: not available here or there">In Transit</th>
                    <th>Available</th>
                    <th>Status</th>
                    <th>Approved By</th>
                    <th>Approval Date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Items)
                {
                    <tr>
                        <td>
                            @if (canSeeSowing)
                            {
                                <a asp-page="/Production/SeedSowing/Details" asp-route-id="@r.SeedSowingId">@r.SowingCode</a>
                            }
                            else
                            {
                                @r.SowingCode
                            }
                        </td>
                        <td>
                            @if (r.IsSowingBatch) { <span>Sowing</span> }
                            else { <span class="badge @(r.OriginType == PlantStockManager.Models.ReadyStock.OriginTransplant ? "bg-success" : "bg-info text-dark")">@r.OriginLabel</span> }
                        </td>
                        <td>@r.PlantTypeName</td>
                        <td>@r.SpeciesName</td>
                        <td>@r.AreaName</td>
                        <td>@(r.PolyhouseName ?? "-")</td>
                        <td>@r.CavityType</td>
                        <td>@r.SowingDate.ToString("dd/MM/yyyy")</td>
                        @* Sowing-level figures belong to the original sowing: shown on its own batch only. *@
                        <td>@(r.IsSowingBatch ? Qty(r.QuantitySown) : dash)</td>
                        <td>@(r.IsSowingBatch ? Qty(r.SowingTrays) : dash)</td>
                        <td>@(r.IsSowingBatch ? Qty(r.ReadyTrays, "–") : Qty(r.PhysicalTrays, "–"))</td>
                        <td>@Qty(r.Quantity)</td>
                        <td>@(r.IsSowingBatch ? Qty(r.WastageQuantity) : dash)</td>
                        <td>@(r.IsSowingBatch ? r.WastagePercent.ToString("0.00") + "%" : dash)</td>
                        <td>@Qty(r.ReservedQuantity)</td>
                        <td>@Qty(r.DispatchedQuantity)</td>
                        <td>@(r.InTransitQuantity > 0 ? Qty(r.InTransitQuantity) : dash)</td>
                        <td><strong>@Qty(r.AvailableQuantity)</strong></td>
                        <td>@r.Status</td>
                        <td>@(r.IsSowingBatch ? r.ApprovedByName ?? "-" : dash)</td>
                        <td>@(r.IsSowingBatch ? r.ApprovalDate?.ToString("dd/MM/yyyy") ?? "-" : dash)</td>
                        <td class="text-nowrap">
                            @if ((canTransferStock && r.IsSowingBatch && r.AvailableQuantity > 0 && r.ReservedQuantity == 0 && r.DispatchedQuantity == 0 && r.InTransitQuantity == 0)
                                 || (canCustomerDispatch && (r.InMainArea || r.InMotherPlantArea) && StrictArea.CanAccessArea(User, r.AreaId) && r.CavitySize is > 0 && r.AvailableQuantity >= r.CavitySize))
                            {
                                <a asp-page="/Production/ReadyStock/Move" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Send</a>
                            }
                            @if (canDispatch && r.AvailableQuantity > 0)
                            {
                                <a asp-page="/Bookings/SeedlingDispatch" class="btn btn-sm btn-outline-secondary" title="Option A: book and dispatch to a customer (existing booking / dispatch workflow)">Dispatch to Customer</a>
                            }
                            @if (canTransferMp && r.IsSowingBatch && r.InMainArea && r.CavitySize is > 0 && r.AvailableQuantity >= r.CavitySize)
                            {
                                <a asp-page="/Production/ReadyStock/TransferToMotherPlant" asp-route-id="@r.Id" class="btn btn-sm btn-outline-success" title="Option B: send to a Mother Plant Area for transplanting">Transfer to Mother Plant</a>
                            }
                            @if (canTransplant && r.InMotherPlantArea && r.AvailableQuantity > 0)
                            {
                                <a asp-page="/Production/Transplanting/Create" asp-route-id="@r.Id" class="btn btn-sm btn-success">Transplant</a>
                            }
                            @if (canTrace && (!r.IsSowingBatch || r.Quantity != r.ApprovedReadyQuantity))
                            {
                                <a asp-page="/Production/ReadyStock/Lineage" asp-route-id="@r.Id" class="btn btn-sm btn-link">Trace</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="22" class="text-center text-muted">No approved Ready Stock found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
