@page
@model PlantStockManager.Pages.Production.SeedIssue.PendingReceiptsModel
@{
    ViewData["Title"] = "Polyhouse Pending Seed Receipts";
}

<div class="container-fluid mt-4">
    <h2 class="mb-3">Polyhouse/Growing Area &mdash; Pending Seed Receipts</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-md-4">
            <label class="form-label fw-bold">Polyhouse/Growing Area</label>
            <select name="areaId" class="form-select" onchange="this.form.submit()">
                <option value="">-- All My Areas --</option>
                @foreach (var a in Model.DestinationAreas)
                {
                    <option value="@a.Id" selected="@(Model.SelectedAreaId == a.Id)">@a.Name (@a.AreaType)</option>
                }
            </select>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Issue Code</th>
                    <th>From (Main Office Area)</th>
                    <th>To Area</th>
                    <th>Species/Variety</th>
                    <th>Lot/Batch</th>
                    <th>Issued Quantity</th>
                    <th>Issue Date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model.Pending)
                {
                    <tr>
                        <td>@i.IssueCode</td>
                        <td>@i.SourceAreaName</td>
                        <td>@i.DestinationAreaName</td>
                        <td>@i.SpeciesName</td>
                        <td>@(string.IsNullOrEmpty(i.BatchNo) ? "-" : i.BatchNo)</td>
                        <td>@i.IssuedQuantity.ToString("N2")</td>
                        <td>@i.IssueDate.ToString("yyyy-MM-dd")</td>
                        <td class="text-nowrap">
                            <a asp-page="/Production/SeedIssue/ConfirmReceipt" asp-route-id="@i.Id" class="btn btn-sm btn-primary">Confirm Receipt</a>
                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="collapse" data-bs-target="#reject-@i.Id">Reject</button>
                            <div class="collapse mt-2" id="reject-@i.Id">
                                <form method="post" asp-page-handler="Reject">
                                    <input type="hidden" name="id" value="@i.Id" />
                                    <input type="hidden" name="areaId" value="@Model.SelectedAreaId" />
                                    <input type="text" name="reason" class="form-control form-control-sm mb-1" placeholder="Reason for rejection" required />
                                    <button type="submit" class="btn btn-sm btn-danger w-100">Confirm Reject</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Pending.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted">No Seed Issues awaiting confirmation.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
