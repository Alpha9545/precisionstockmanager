@page
@model PlantStockManager.Pages.Production.SeedIssue.CreateModel
@{
    ViewData["Title"] = "Seed Issue (retired)";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 760px;">
        <div class="card-header">
            <h4 class="mb-0">Seed Issue has been retired</h4>
        </div>
        <div class="card-body">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }
            <p>
                Seed is no longer issued from Main Office to a growing Area before sowing. Sowing now takes seed
                <strong>directly from Main Office Seed Stock</strong> and records the Area and Polyhouse on the sowing itself.
            </p>
            <p class="mb-0">
                Earlier Seed Issue records are kept unchanged and remain available as history.
            </p>
        </div>
        <div class="card-footer text-end">
            <a asp-page="/Production/SeedIssue/MyIssues" class="btn btn-outline-secondary me-2">Seed Issue history</a>
            <a asp-page="/Production/SeedSowing/Create" class="btn btn-success">Go to Direct Sowing</a>
        </div>
    </div>
</div>
