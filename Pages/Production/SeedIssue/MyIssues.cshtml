@page
@model PlantStockManager.Pages.Production.SeedIssue.MyIssuesModel
@{
    ViewData["Title"] = "My Seed Issues";
}

<div class="container-fluid mt-4">
    <h2 class="mb-3">My Seed Issues</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-md-4">
            <label class="form-label fw-bold">Main Office Area</label>
            <select name="areaId" class="form-select" onchange="this.form.submit()">
                <option value="">-- Select Area --</option>
                @foreach (var a in Model.MainOfficeAreas)
                {
                    <option value="@a.Id" selected="@(Model.SelectedAreaId == a.Id)">@a.Name</option>
                }
            </select>
        </div>
    </form>

    @if (Model.SelectedAreaId.HasValue)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Issue Code</th>
                        <th>To Area</th>
                        <th>Species/Variety</th>
                        <th>Lot/Batch</th>
                        <th>Issued</th>
                        <th>Confirmed</th>
                        <th>Discrepancy Reason</th>
                        <th>Status</th>
                        <th>Issue Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model.Issues)
                    {
                        <tr>
                            <td>@i.IssueCode</td>
                            <td>@i.DestinationAreaName</td>
                            <td>@i.SpeciesName</td>
                            <td>@(string.IsNullOrEmpty(i.BatchNo) ? "-" : i.BatchNo)</td>
                            <td>@i.IssuedQuantity.ToString("N2")</td>
                            <td>@(i.ConfirmedQuantity?.ToString("N2") ?? "-")</td>
                            <td>@(i.DiscrepancyReason ?? "-")</td>
                            <td>@i.Status</td>
                            <td>@i.IssueDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                    @if (!Model.Issues.Any())
                    {
                        <tr><td colspan="9" class="text-center text-muted">No Seed Issues sent from this Area yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
