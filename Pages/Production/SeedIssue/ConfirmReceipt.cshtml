@page "{id:int}"
@model PlantStockManager.Pages.Production.SeedIssue.ConfirmReceiptModel
@{
    ViewData["Title"] = "Confirm Receipt of Seed";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-header">
            <h4 class="mb-0">Confirm Receipt &mdash; @Model.Issue!.IssueCode</h4>
        </div>
        <div class="card-body">
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <dl class="row">
                <dt class="col-sm-4">From (Main Office Area)</dt>
                <dd class="col-sm-8">@Model.Issue.SourceAreaName</dd>
                <dt class="col-sm-4">To Area</dt>
                <dd class="col-sm-8">@Model.Issue.DestinationAreaName</dd>
                <dt class="col-sm-4">Species/Variety</dt>
                <dd class="col-sm-8">@Model.Issue.SpeciesName</dd>
                <dt class="col-sm-4">Lot/Batch</dt>
                <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Issue.BatchNo) ? "-" : Model.Issue.BatchNo)</dd>
                <dt class="col-sm-4">Sender</dt>
                <dd class="col-sm-8">@(Model.Issue.ResponsiblePersonName ?? "-")</dd>
                <dt class="col-sm-4">Issue Date</dt>
                <dd class="col-sm-8">@Model.Issue.IssueDate.ToString("yyyy-MM-dd")</dd>
                <dt class="col-sm-4">Issued Quantity</dt>
                <dd class="col-sm-8 fw-bold">@Model.Issue.IssuedQuantity.ToString("N2")</dd>
            </dl>

            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Received Quantity (actually received)</label>
                    <input type="number" step="0.01" min="0" asp-for="ConfirmedQuantity" class="form-control" required />
                    <div class="form-text">Defaults to the issued quantity. Change it only if what physically arrived was different.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Discrepancy Reason</label>
                    <textarea asp-for="DiscrepancyReason" class="form-control" rows="2" placeholder="Required only if the received quantity differs from what was issued"></textarea>
                </div>

                <div class="text-center mt-4">
                    <a asp-page="/Production/SeedIssue/PendingReceipts" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-success">Confirm Receipt</button>
                </div>
            </form>
        </div>
    </div>
</div>
