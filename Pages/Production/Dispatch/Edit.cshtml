@page "{id:int}"
@model PlantStockManager.Pages.Production.Dispatch.EditModel
@{
    ViewData["Title"] = "Edit Dispatch";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 800px;">
        <div class="card-header">
            <h4 class="mb-0">Edit Dispatch &mdash; @Model.Dispatch.DispatchCode</h4>
        </div>
        <div class="card-body">
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <div class="alert alert-secondary">
                <strong>Booking @Model.Dispatch.BookingCode</strong> (@Model.Dispatch.CustomerName) &mdash;
                <strong>@Model.Dispatch.SpeciesName (@Model.Dispatch.PlantTypeName)</strong> &mdash;
                Pot Size <strong>@Model.Dispatch.PotSize</strong> &mdash;
                Area <strong>@(Model.Dispatch.AreaName ?? "Unassigned")</strong> &mdash;
                Quantity Dispatched <strong>@Model.Dispatch.Quantity.ToString("N2")</strong>
                <div class="small text-muted">
                    These fields cannot be changed once the dispatch is recorded -- they already moved real stock.
                    Use "Cancel Dispatch" below to reverse it entirely if this record was a mistake.
                </div>
            </div>

            @if (Model.Dispatch.Status == "Cancelled")
            {
                <div class="alert alert-warning">This Dispatch is Cancelled. Stock and the reservation have already been restored.</div>
            }

            <form method="post">
                <input type="hidden" asp-for="Dispatch.Id" />
                <input type="hidden" asp-for="Dispatch.BookingCode" />
                <input type="hidden" asp-for="Dispatch.CreatedBy" />
                <input type="hidden" asp-for="Dispatch.CreatedDate" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Responsible Person</label>
                        <select asp-for="Dispatch.ResponsiblePersonId" class="form-select" disabled="@(Model.Dispatch.Status == "Cancelled")">
                            <option value="">-- None --</option>
                            @foreach (var e in Model.PersonOptions)
                            {
                                <option value="@e.EmployeeID">@e.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Supervisor</label>
                        <select asp-for="Dispatch.SupervisorId" class="form-select" disabled="@(Model.Dispatch.Status == "Cancelled")">
                            <option value="">-- None --</option>
                            @foreach (var e in Model.PersonOptions)
                            {
                                <option value="@e.EmployeeID">@e.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Remarks</label>
                        <textarea asp-for="Dispatch.Remarks" class="form-control" rows="2" disabled="@(Model.Dispatch.Status == "Cancelled")"></textarea>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <a asp-page="/Production/Dispatch/Index" class="btn btn-secondary me-2">Cancel</a>
                    @if (Model.Dispatch.Status != "Cancelled")
                    {
                        <button type="submit" class="btn btn-success">Save Changes</button>
                    }
                </div>
            </form>

            @if (Model.Dispatch.Status != "Cancelled")
            {
                <hr />
                <form method="post" asp-page-handler="Cancel" asp-route-id="@Model.Dispatch.Id" onsubmit="return confirm('Cancel this Dispatch? This restores physical stock and re-reserves this amount against the Booking (which returns to Pending or Partially Dispatched, depending on any other dispatches against it). This cannot be undone.');">
                    <div class="text-center">
                        <button type="submit" class="btn btn-outline-danger">Cancel Dispatch (reverse)</button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>
