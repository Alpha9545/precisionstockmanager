@page
@model PlantStockManager.Pages.Production.Dispatch.IndexModel
@{
    ViewData["Title"] = "Dispatch";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Dispatch</h2>
        <a asp-page="/Production/Dispatch/Create" class="btn btn-primary">+ Record Dispatch</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total Dispatched (Completed)</div>
                    <div class="fs-3 fw-bold">@Model.TotalDispatched.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Booking</th>
                    <th>Customer</th>
                    <th>Species</th>
                    <th>Pot Size</th>
                    <th>Area</th>
                    <th>Quantity</th>
                    <th>Dispatch Date</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Dispatches)
                {
                    <tr>
                        <td>@d.DispatchCode</td>
                        <td>@d.BookingCode</td>
                        <td>@d.CustomerName</td>
                        <td>@d.SpeciesName <span class="text-muted">(@d.PlantTypeName)</span></td>
                        <td>@d.PotSize</td>
                        <td>@(d.AreaName ?? "Unassigned")</td>
                        <td>@d.Quantity.ToString("N2")</td>
                        <td>@d.DispatchDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (d.Status == "Cancelled")
                            {
                                <span class="badge bg-secondary">Cancelled</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                        </td>
                        <td>
                            <a asp-page="/Production/Dispatch/Details" asp-route-id="@d.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            <a asp-page="/Production/Dispatch/Edit" asp-route-id="@d.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                        </td>
                    </tr>
                }
                @if (!Model.Dispatches.Any())
                {
                    <tr><td colspan="10" class="text-center text-muted">No Dispatches found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
