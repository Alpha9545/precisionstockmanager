@page "{id:int}"
@model PlantStockManager.Pages.Production.SeedStock.DetailsModel
@inject PlantStockManager.Authorization.FeatureAccessService FeatureAccess
@{
    ViewData["Title"] = "Seed Stock Details";
    var canEdit = await FeatureAccess.CanAccessPageAsync(User, PlantStockManager.Services.SeedStockEditRules.EditPage);   // System Administrator only
}

<div class="container mt-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (Model.SeedStock == null)
    {
        <div class="alert alert-danger">Not found.</div>
    }
    else
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <h4 class="mb-0">@Model.SeedStock.SpeciesName (@Model.SeedStock.PlantTypeName) &mdash; @Model.SeedStock.AreaName</h4>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3"><strong>Area Type:</strong> @(Model.SeedStock.AreaType ?? "-")</div>
                    <div class="col-md-3"><strong>Lot/Batch:</strong> @(string.IsNullOrEmpty(Model.SeedStock.BatchNo) ? "-" : Model.SeedStock.BatchNo)</div>
                    <div class="col-md-3"><strong>Source:</strong> @(Model.SeedStock.SeedSourceName ?? "-")</div>
                    <div class="col-md-3"><strong>Unit:</strong> @Model.SeedStock.Unit</div>
                    <div class="col-md-3"><strong>Physical Quantity:</strong> @Qty(Model.SeedStock.PhysicalQuantity)</div>
                    <div class="col-md-3"><strong>In Transit:</strong> @Qty(Model.SeedStock.InTransitQuantity)</div>
                    <div class="col-md-3"><strong>Available:</strong> @Qty(Model.SeedStock.AvailableQuantity)</div>
                </div>
                <div class="mt-3">
                    <a asp-page="/Production/SeedStock/AddStock" asp-route-id="@Model.SeedStock.Id" class="btn btn-outline-success btn-sm">Add Stock</a>
                    @if (canEdit)
                    {
                        <a asp-page="/Production/SeedStock/Edit" asp-route-id="@Model.SeedStock.Id" class="btn btn-outline-primary btn-sm" id="editSeedStock">Edit</a>
                    }
                    <a asp-page="/Production/SeedStock/Index" class="btn btn-outline-secondary btn-sm">Back</a>
                </div>
            </div>
        </div>

        <h5>Transaction History</h5>
        <div class="table-responsive">
        <table class="table table-sm table-bordered">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Reference</th>
                    <th>Quantity</th>
                    <th>Before</th>
                    <th>After</th>
                    <th>User</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Transactions)
                {
                    <tr>
                        <td>@t.TransactionDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@t.TransactionType</td>
                        <td>@(t.ReferenceType != null ? $"{t.ReferenceType} #{t.ReferenceId}" : "-")</td>
                        <td>@Qty(t.Quantity)</td>
                        <td>@Qty(t.BeforeQuantity)</td>
                        <td>@Qty(t.AfterQuantity)</td>
                        <td>@(t.UserName ?? "-")</td>
                        <td>@(t.Remarks ?? "-")</td>
                    </tr>
                }
                @if (!Model.Transactions.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted">No transactions yet.</td></tr>
                }
            </tbody>
        </table>
        </div>
    }
</div>
