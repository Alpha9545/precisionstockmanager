@page "{id:int}"
@model PlantStockManager.Pages.Production.SeedStock.EditModel
@{
    ViewData["Title"] = "Edit Seed Stock";
    var s = Model.SeedStock!;
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto mb-4" style="max-width: 920px;">
        <div class="card-header">
            <h4 class="mb-0">Edit Seed Stock &mdash; @s.SpeciesName (@s.PlantTypeName)</h4>
            <small class="text-muted">Administrator correction of a receipt. The original receipt is kept in the transaction history together with its reversal.</small>
        </div>
        <div class="card-body">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger" id="seedEditError">@TempData["Error"]</div>
            }

            <div class="row g-3 mb-3">
                <div class="col-md-3"><strong>Area:</strong> @s.AreaName</div>
                <div class="col-md-3"><strong>Lot/Batch:</strong> @(string.IsNullOrEmpty(s.BatchNo) ? "-" : s.BatchNo)</div>
                <div class="col-md-3"><strong>Source:</strong> @(s.SeedSourceName ?? "-")</div>
                <div class="col-md-3"><strong>Unit:</strong> @s.Unit</div>
                <div class="col-md-3"><strong>Physical:</strong> @Qty(s.PhysicalQuantity)</div>
                <div class="col-md-3"><strong>In Transit:</strong> @Qty(s.InTransitQuantity)</div>
                <div class="col-md-3"><strong>Available:</strong> @Qty(s.AvailableQuantity)</div>
            </div>

            <h5>Receipts</h5>
            <div class="table-responsive">
            <table class="table table-sm table-bordered" id="seedEditReceipts">
                <thead>
                    <tr>
                        <th>Received On</th>
                        <th>Quantity</th>
                        <th>Notes</th>
                        <th>User</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Receipts)
                    {
                        <tr class="@(Model.Receipt?.Id == r.Id ? "table-active" : "")">
                            <td>@r.TransactionDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@Qty(r.Quantity)</td>
                            <td>@(r.Remarks ?? "-")</td>
                            <td>@(r.UserName ?? "-")</td>
                            <td><a asp-page="/Production/SeedStock/Edit" asp-route-id="@s.Id" asp-route-receiptId="@r.Id" class="btn btn-sm btn-outline-primary">Edit</a></td>
                        </tr>
                    }
                    @if (!Model.Receipts.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted">This lot has no receipt that can be edited (its stock came from a Seed Issue or an opening balance).</td></tr>
                    }
                </tbody>
            </table>
            </div>

            @if (Model.Receipt != null)
            {
                <hr />
                <h5>Correct the receipt of @Model.Receipt.TransactionDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm") (@Qty(Model.Receipt.Quantity) @s.Unit)</h5>

                @if (!ModelState.IsValid)
                {
                    <div class="alert alert-danger" id="seedEditErrors">
                        <ul class="mb-0">
                            @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@err.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <form method="post">
                    <input type="hidden" asp-for="ReceiptId" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold" asp-for="ReceivedOn">Received On</label>
                            <input asp-for="ReceivedOn" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold" asp-for="Quantity">Quantity (@s.Unit)</label>
                            <input asp-for="Quantity" asp-format="{0:0.##}" type="number" step="1" min="1" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold" asp-for="Notes">Notes <span class="text-muted fw-normal">(optional)</span></label>
                            <textarea asp-for="Notes" class="form-control" rows="2" maxlength="500"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold" asp-for="Reason">Reason for the correction</label>
                            <input asp-for="Reason" class="form-control" maxlength="200" required placeholder="e.g. wrong count entered, wrong receipt date" />
                        </div>
                    </div>
                    <div class="text-center mt-4">
                        <a asp-page="/Production/SeedStock/Details" asp-route-id="@s.Id" class="btn btn-secondary me-2">Cancel</a>
                        <button type="submit" class="btn btn-success">Save Changes</button>
                    </div>
                </form>
            }
            else if (Model.Receipts.Any())
            {
                <p class="text-muted mb-0">Choose the receipt to correct.</p>
            }

            <div class="mt-3">
                <a asp-page="/Production/SeedStock/Details" asp-route-id="@s.Id" class="btn btn-outline-secondary btn-sm">Back to Details</a>
            </div>
        </div>
    </div>
</div>
