@page
@model PlantStockManager.Pages.Production.SeedStock.CreateModel
@{
    ViewData["Title"] = "New Seed Stock Pool";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 700px;">
        <div class="card-header"><h4 class="mb-0">New Seed Stock Pool</h4></div>
        <div class="card-body">
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Plant Type</label>
                    <select id="plantTypeSelect" class="form-select">
                        <option value="">-- Select Plant Type --</option>
                        @foreach (var pt in Model.PlantTypes)
                        {
                            <option value="@pt.Id">@pt.Name</option>
                        }
                    </select>
                </div>

                <div class="mb-3 position-relative">
                    <label class="form-label fw-bold">Species/Variety</label>
                    <input type="hidden" asp-for="SeedStock.SpeciesId" id="speciesId" />
                    <input type="text" id="speciesSearchInput" class="form-control" autocomplete="off"
                           value="@Model.SelectedSpeciesName" placeholder="Type at least 2 letters to search a variety by name..." />
                    <div id="speciesResults" class="list-group position-absolute w-100 d-none"
                         style="z-index: 20; max-height: 260px; overflow-y: auto;"></div>
                    <div class="form-text">
                        Optionally pick a Plant Type above first to narrow the search; results are limited to the
                        closest 30 matches, so keep typing to narrow further among 1,000+ varieties.
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Area</label>
                    <select asp-for="SeedStock.AreaId" class="form-select">
                        <option value="">-- Select Area --</option>
                        @foreach (var a in Model.Areas)
                        {
                            <option value="@a.Id">@a.Name @(a.AreaType != null ? $"({a.AreaType})" : "")</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Lot/Batch No. (optional)</label>
                    <input asp-for="SeedStock.BatchNo" class="form-control" placeholder="Leave blank if not tracking lots" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Source/Supplier (optional)</label>
                    <select asp-for="SeedStock.SeedSourceId" class="form-select">
                        <option value="">-- None --</option>
                        @foreach (var s in Model.SeedSources)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Unit</label>
                    <input asp-for="SeedStock.Unit" class="form-control" value="pcs" />
                </div>

                <div class="text-center mt-4">
                    <a asp-page="/Production/SeedStock/Index" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-success">Create Pool</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Phase 9 (Seed Stock Usability): a small, self-contained
        // search-as-you-type widget over PlantSpeciesRepository.SearchAsync
        // -- never renders 1,000+ options into a <select>. Plant Type
        // remains an optional narrowing filter, exactly as before.
        $(function () {
            const handlerUrl = '@Url.Page("/Production/SeedStock/Create")';
            let debounceTimer = null;

            function currentPlantTypeId() {
                return $('#plantTypeSelect').val() || '';
            }

            function selectSpecies(id, name) {
                $('#speciesId').val(id);
                $('#speciesSearchInput').val(name);
                $('#speciesResults').addClass('d-none').empty();
            }

            function clearSelection() {
                $('#speciesId').val('');
            }

            function renderResults(list) {
                const $results = $('#speciesResults');
                $results.empty();
                if (!list.length) {
                    $results.append($('<div class="list-group-item text-muted"></div>').text('No matching variety found.'));
                } else {
                    list.forEach(function (s) {
                        const label = s.scientificName ? (s.name + ' (' + s.scientificName + ')') : s.name;
                        const $item = $('<button type="button" class="list-group-item list-group-item-action"></button>').text(label);
                        $item.on('click', function () { selectSpecies(s.id, s.name); });
                        $results.append($item);
                    });
                }
                $results.removeClass('d-none');
            }

            function search() {
                const q = $('#speciesSearchInput').val().trim();
                clearSelection();
                if (q.length < 2) {
                    $('#speciesResults').addClass('d-none').empty();
                    return;
                }
                $.getJSON(handlerUrl, { handler: 'SearchSpecies', q: q, plantTypeId: currentPlantTypeId() || null }, renderResults);
            }

            $('#speciesSearchInput').on('input', function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(search, 250);
            });
            $('#plantTypeSelect').on('change', function () {
                // Re-narrow the current search text (if any) to the newly
                // chosen Plant Type; does not itself load a species list.
                if ($('#speciesSearchInput').val().trim().length >= 2) search();
            });
            $(document).on('click', function (e) {
                if (!$(e.target).closest('#speciesSearchInput, #speciesResults').length) {
                    $('#speciesResults').addClass('d-none');
                }
            });
        });
    </script>
}
