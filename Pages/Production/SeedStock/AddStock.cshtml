@page "{id:int}"
@model PlantStockManager.Pages.Production.SeedStock.AddStockModel
@{
    ViewData["Title"] = "Add Seed Stock";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-header">
            <h4 class="mb-0">Add Stock &mdash; @Model.SeedStock?.SpeciesName @@ @Model.SeedStock?.AreaName</h4>
            <small class="text-muted">
                Lot: @(string.IsNullOrEmpty(Model.SeedStock?.BatchNo) ? "(no lot no.)" : Model.SeedStock!.BatchNo)
            </small>
        </div>
        <div class="card-body">
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            @* Stock balance visible before issuing/sowing (Phase 9): Physical AND
               Available (Physical - InTransit) shown together, so it's clear
               whether some of this lot is already committed elsewhere. *@
            <div class="row g-3 mb-2">
                <div class="col-md-4"><span class="text-muted small">Physical</span><div class="fs-5 fw-bold">@Model.SeedStock?.PhysicalQuantity.ToString("N2") @Model.SeedStock?.Unit</div></div>
                <div class="col-md-4"><span class="text-muted small">In Transit</span><div class="fs-5 fw-bold">@Model.SeedStock?.InTransitQuantity.ToString("N2") @Model.SeedStock?.Unit</div></div>
                <div class="col-md-4"><span class="text-muted small">Available</span><div class="fs-5 fw-bold text-success">@Model.SeedStock?.AvailableQuantity.ToString("N2") @Model.SeedStock?.Unit</div></div>
            </div>

            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Quantity to Add</label>
                    <input asp-for="Quantity" type="number" step="1" min="1" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Remarks</label>
                    <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                </div>
                <div class="text-center mt-4">
                    <a asp-page="/Production/SeedStock/Index" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-success">Add Stock</button>
                </div>
            </form>
        </div>
    </div>
</div>
