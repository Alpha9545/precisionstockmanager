@page "{id:int}"
@model PlantStockManager.Pages.Production.EmptyPotInventory.DetailsModel
@{
    ViewData["Title"] = "Empty Pot Inventory Details";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">
            @Model.EmptyPotInventory!.PotSize
            <span class="text-muted fs-6">(@(Model.EmptyPotInventory.AreaName ?? "Unassigned")@(Model.EmptyPotInventory.GrowingPartnerName != null ? $" / {Model.EmptyPotInventory.GrowingPartnerName}" : ""))</span>
        </h4>
        <div>
            <a asp-page="/Production/EmptyPotInventory/Index" class="btn btn-secondary">Back</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-4"><span class="text-muted small">Physical Quantity</span><div class="fs-4 fw-bold">@Model.EmptyPotInventory.PhysicalQuantity.ToString("N2")</div></div>
                <div class="col-md-4"><span class="text-muted small">Status</span><div class="fs-4">@(Model.EmptyPotInventory.IsActive ? "Active" : "Inactive")</div></div>
            </div>
        </div>
    </div>

    <h5>Transaction History</h5>
    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Reference</th>
                    <th>Qty (+/-)</th>
                    <th>Before</th>
                    <th>After</th>
                    <th>By</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Transactions)
                {
                    <tr>
                        <td>@t.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@t.TransactionType</td>
                        <td>
                            @if (t.ReferenceType == "PotProduction" && t.ReferenceId.HasValue)
                            {
                                <span>PotProduction #@t.ReferenceId (retired)</span>
                            }
                            else if (t.ReferenceType != null)
                            {
                                @($"{t.ReferenceType} #{t.ReferenceId}")
                            }
                            else
                            {
                                @("-")
                            }
                        </td>
                        <td class="@(t.Quantity < 0 ? "text-danger" : "text-success")">@t.Quantity.ToString("N2")</td>
                        <td>@t.BeforeQuantity.ToString("N2")</td>
                        <td>@t.AfterQuantity.ToString("N2")</td>
                        <td>@(t.UserName ?? "-")</td>
                        <td>@t.Remarks</td>
                    </tr>
                }
                @if (!Model.Transactions.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted">No transactions recorded yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
