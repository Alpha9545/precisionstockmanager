@page
@model PlantStockManager.Pages.Production.EmptyPotInventory.AddStockModel
@{
    ViewData["Title"] = "Add Empty Pots";
    var backPage = Model.IsCuttingSection ? "/Production/Cutting/Index" : "/Production/MotherPlant/Index";
    var backLabel = Model.IsCuttingSection ? "Cutting Production" : "Mother Plants";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto mb-4" style="max-width: 820px;">
        <div class="card-header">
            <h4 class="mb-0">Add Empty Pots <span class="text-muted fs-6">&mdash; @(Model.IsCuttingSection ? "Cutting" : "Mother Plant")</span></h4>
            <small class="text-muted">Empty pots added here go straight into the selected Mother Plant / Cutting Area's stock (no polyhouse). Only that Area's pot production can use them.</small>
        </div>
        <div class="card-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success" id="msg-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }
            @if (!Model.Areas.Any())
            {
                <div class="alert alert-warning">You are not assigned to any Mother Plant / Cutting Area. Ask the administrator to assign your Area.</div>
            }
            @if (!Model.PotSizes.Any())
            {
                <div class="alert alert-warning">No pot sizes are set up. Add them in Administration &rarr; Pot Sizes.</div>
            }

            <form method="post">
                <input type="hidden" asp-for="SubmitToken" />
                <input type="hidden" asp-for="Section" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Area</label>
                        <select asp-for="AreaId" class="form-select" required>
                            @if (Model.Areas.Count != 1)
                            {
                                <option value="">-- Select --</option>
                            }
                            @foreach (var a in Model.Areas)
                            {
                                <option value="@a.Id">@a.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Pot Size</label>
                        <select asp-for="PotSize" class="form-select" required>
                            <option value="">-- Select --</option>
                            @foreach (var p in Model.PotSizes)
                            {
                                <option value="@p.Name">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Quantity</label>
                        <input type="number" step="1" min="1" asp-for="Quantity" asp-format="{0:0.##}" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Date</label>
                        <input type="date" asp-for="StockDate" asp-format="{0:yyyy-MM-dd}" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Remark</label>
                        <input type="text" asp-for="Remarks" class="form-control" maxlength="500" />
                    </div>
                </div>
                <div class="text-center mt-4">
                    <a asp-page="@backPage" class="btn btn-secondary me-2">@backLabel</a>
                    <button type="submit" class="btn btn-success" @(Model.Areas.Any() ? "" : "disabled")>Add Empty Pots</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Areas.Any())
    {
        <div class="card shadow-sm mx-auto mb-4" style="max-width: 820px;">
            <div class="card-header"><strong>Current empty pot stock</strong> <span class="text-muted small">&mdash; your Mother Plant / Cutting Areas</span></div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0" id="balances">
                    <thead class="table-light"><tr><th>Area</th><th>Pot Size</th><th class="text-end">Empty pots</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var b in Model.Balances)
                        {
                            <tr>
                                <td>@b.AreaName</td>
                                <td>@b.PotSize</td>
                                <td class="text-end fw-semibold">@Qty(b.PhysicalQuantity)</td>
                                <td class="text-end"><a asp-page="/Production/EmptyPotInventory/Details" asp-route-id="@b.Id" class="btn btn-sm btn-outline-secondary">History</a></td>
                            </tr>
                        }
                        @if (!Model.Balances.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted">No empty pots recorded yet in these Areas.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Prevent a double click from sending the form twice (the server also rejects a reused form token).
        document.querySelector('form[method="post"]').addEventListener('submit', function (e) {
            var btn = this.querySelector('button[type="submit"]');
            if (btn.dataset.sent) { e.preventDefault(); return; }
            btn.dataset.sent = '1';
            btn.disabled = true;
        });
    </script>
}
