@page "{id:int}"
@model PlantStockManager.Pages.Production.EmptyPotInventory.AddStockModel
@{
    ViewData["Title"] = "Add Stock";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-header">
            <h4 class="mb-0">Add Stock &mdash; @Model.EmptyPotInventory!.PotSize</h4>
        </div>
        <div class="card-body">
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <p class="text-muted">Current physical quantity: <strong>@Model.EmptyPotInventory.PhysicalQuantity.ToString("N2")</strong></p>

            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Quantity to Add</label>
                    <input type="number" step="0.01" min="0.01" asp-for="Quantity" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Remarks</label>
                    <textarea asp-for="Remarks" class="form-control" rows="2" placeholder="e.g. purchased from supplier, manual count correction"></textarea>
                </div>

                <div class="text-center mt-4">
                    <a asp-page="/Production/EmptyPotInventory/Details" asp-route-id="@Model.EmptyPotInventory.Id" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-success">Add Stock</button>
                </div>
            </form>
        </div>
    </div>
</div>
