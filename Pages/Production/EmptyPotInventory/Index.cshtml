@page
@model PlantStockManager.Pages.Production.EmptyPotInventory.IndexModel
@inject PlantStockManager.Authorization.FeatureAccessService FeatureAccess
@{
    ViewData["Title"] = "Empty Pot Stock";
    // Purchase / Issue are the retired Main Office workflow (System Administrator only);
    // empty pots are now added by the Mother Plant Supervisor straight to their own Area -- 2026-10-14: from the
    // Mother Plant / Cutting sections (Add Empty Pots); this Pot Production page no longer offers the stock entry.
    var canIssue = await FeatureAccess.CanAccessPageAsync(User, "/Production/EmptyPotInventory/Issue");
    var office = Model.EmptyPotInventories.Where(e => e.AreaType == "MainOffice").ToList();
    var areas = Model.EmptyPotInventories.Where(e => e.AreaType != "MainOffice").ToList();
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h3 class="mb-0">Empty Pot Stock</h3>
        <div class="text-muted small">Empty pots are added from Mother Plant &amp; Cutting &rarr; Add Empty Pots.</div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <p class="text-muted small">
        Empty pots are added directly to a production Area by its Mother Plant Supervisor; each Area can only use its own pots.
    </p>

    <h5>Office store</h5>
    <div class="table-responsive mb-4">
        <table class="table table-sm table-bordered table-striped">
            <thead class="table-light"><tr><th>Pot Size</th><th>Store</th><th class="text-end">In stock</th><th></th></tr></thead>
            <tbody>
                @foreach (var e in office)
                {
                    <tr>
                        <td>@e.PotSize</td>
                        <td>@e.AreaName</td>
                        <td class="text-end fw-bold">@Qty(e.PhysicalQuantity)</td>
                        <td class="text-nowrap">
                            <a asp-page="/Production/EmptyPotInventory/Details" asp-route-id="@e.Id" class="btn btn-sm btn-outline-secondary">History</a>
                            @if (canIssue && e.PhysicalQuantity > 0)
                            {
                                <a asp-page="/Production/EmptyPotInventory/Issue" asp-route-sourcePoolId="@e.Id" class="btn btn-sm btn-outline-primary">Issue</a>
                            }
                        </td>
                    </tr>
                }
                @if (!office.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted">No Office stock.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <h5>Production Areas</h5>
    <div class="table-responsive">
        <table class="table table-sm table-bordered table-striped">
            <thead class="table-light"><tr><th>Area</th><th>Pot Size</th><th class="text-end">Available to this Area</th><th></th></tr></thead>
            <tbody>
                @foreach (var e in areas.OrderBy(a => a.AreaName).ThenBy(a => a.PotSize))
                {
                    <tr>
                        <td>@(e.AreaName ?? "Unassigned (old stock)")</td>
                        <td>@e.PotSize</td>
                        <td class="text-end fw-bold">@Qty(e.PhysicalQuantity)</td>
                        <td><a asp-page="/Production/EmptyPotInventory/Details" asp-route-id="@e.Id" class="btn btn-sm btn-outline-secondary">History</a></td>
                    </tr>
                }
                @if (!areas.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted">No pots issued to production Areas yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
