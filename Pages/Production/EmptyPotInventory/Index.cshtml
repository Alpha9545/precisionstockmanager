@page
@model PlantStockManager.Pages.Production.EmptyPotInventory.IndexModel
@{
    ViewData["Title"] = "Empty Pot Inventory";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Empty Pot Inventory</h2>
        <a asp-page="/Production/EmptyPotInventory/Create" class="btn btn-primary">+ Add Pot Size</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total Empty Pots (Physical)</div>
                    <div class="fs-3 fw-bold">@Model.TotalPhysical.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Pot Size</th>
                    <th>Area</th>
                    <th>Growing Partner</th>
                    <th>Physical Quantity</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.EmptyPotInventories)
                {
                    <tr>
                        <td>@e.PotSize</td>
                        <td>@(e.AreaName ?? "Unassigned")</td>
                        <td>@(e.GrowingPartnerName ?? "Internal")</td>
                        <td>@e.PhysicalQuantity.ToString("N2")</td>
                        <td>
                            @if (e.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <a asp-page="/Production/EmptyPotInventory/Details" asp-route-id="@e.Id" class="btn btn-sm btn-outline-secondary">View / History</a>
                            <a asp-page="/Production/EmptyPotInventory/AddStock" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary">Add Stock</a>
                        </td>
                    </tr>
                }
                @if (!Model.EmptyPotInventories.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted">No Pot Sizes defined yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
