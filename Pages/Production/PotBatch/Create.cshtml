@page
@model PlantStockManager.Pages.Production.PotBatch.CreateModel
@{
    ViewData["Title"] = "Start Pot Batch";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 900px;">
        <div class="card-header">
            <h4 class="mb-0">Start Pot Production Batch</h4>
            <small class="text-muted">Choose the source of the plants first. One plant makes one pot; each day's production uses the Area's own empty pots.</small>
        </div>
        <div class="card-body">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger" id="msg-error">@TempData["Error"]</div>
            }
            <div class="mb-3" id="source-select" role="group" aria-label="Source">
                <span class="fw-bold me-2">Source:</span>
                <a asp-page="/Production/PotBatch/Create" asp-route-source="@CreateModel.SourceCutting" id="source-cutting"
                   class="btn btn-sm @(Model.IsSeedlingSource ? "btn-outline-success" : "btn-success")">Cutting</a>
                <a asp-page="/Production/PotBatch/Create" asp-route-source="@CreateModel.SourceMainOfficeSeedlings" id="source-seedlings"
                   class="btn btn-sm @(Model.IsSeedlingSource ? "btn-success" : "btn-outline-success")">Main Office Seedlings / Ready Stock</a>
            </div>
            @if (Model.IsSeedlingSource)
            {
                <p class="small text-muted">Seedlings received from Main Office Ready Stock for <strong>Pot Production</strong> in your Mother Plant Areas.
                    Stock received for transplanting into trays is not listed, and seedlings for pots are never transplanted into trays.</p>
                @if (!Model.SeedlingsReady)
                {
                    <div class="alert alert-warning" id="seedlings-migration">@PlantStockManager.Data.PotBatchSchema.MigrationMessage</div>
                }
                else if (!Model.SeedlingSources.Any())
                {
                    <div class="alert alert-info" id="no-seedlings">No seedlings received for Pot Production are available in your Mother Plant Areas.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-striped align-middle" id="seedling-sources">
                            <thead class="table-light"><tr><th>Area</th><th>Variety</th><th>Batch</th><th>From (Main Office)</th><th>Sown</th><th>In Area since</th><th class="text-end">Available</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var x in Model.SeedlingSources)
                                {
                                    <tr>
                                        <td>@x.AreaName</td>
                                        <td>@x.SpeciesName <span class="small text-muted">(@x.PlantTypeName)</span></td>
                                        <td>@x.BatchNo <div class="small text-muted">@x.CavityType &middot; <a asp-page="/Production/ReadyStock/Lineage" asp-route-id="@x.ReadyStockId">lineage</a></div></td>
                                        <td>@x.TransferCode <div class="small text-muted">@x.SourceAreaName &middot; batch @(x.SourceBatchNo ?? "-") &middot; sent @x.TransferDate.ToString("dd/MM/yyyy")</div></td>
                                        <td>@x.SowingDate.ToString("dd/MM/yyyy")</td>
                                        <td>@PlantStockManager.Services.AppClock.ToIndiaTime(x.InAreaSinceUtc).ToString("dd/MM/yyyy")</td>
                                        <td class="text-end fw-semibold">@Qty(x.Available)</td>
                                        <td><a asp-page="/Production/PotBatch/CreateFromReadyStock" asp-route-readyStockId="@x.ReadyStockId" class="btn btn-sm btn-success">Pot these seedlings</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <div class="text-center mt-3"><a asp-page="/Production/PotBatch/Index" class="btn btn-secondary">Back</a></div>
            }
            else
            {
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }
            <form method="post" id="cutting-form">
                <input type="hidden" asp-for="SubmissionToken" />
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label fw-bold">Cutting Stock</label>
                        <select asp-for="SourceCuttingStockId" id="stock" class="form-select" required data-searchable>
                            <option value="">-- Select variety / Area --</option>
                            @foreach (var s in Model.StockPools)
                            {
                                <option value="@s.Id" data-available="@s.AvailableQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                    @s.SpeciesName?.Trim()@(string.IsNullOrEmpty(s.SpeciesColor) ? "" : " (" + s.SpeciesColor + ")") - @s.AreaName - available @Qty(s.AvailableQuantity)
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Cuttings Allocated</label>
                        <input type="number" step="1" min="1" asp-for="CuttingAllocated" id="allocated" class="form-control" required />
                        <div class="text-danger small d-none" id="allocWarning">More than the available cuttings.</div>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label fw-bold">Empty pots (production Area - pot size)</label>
                        <select asp-for="EmptyPotInventoryId" id="pool" class="form-select" required>
                            <option value="">-- Select --</option>
                            @foreach (var p in Model.PotPools)
                            {
                                <option value="@p.Id" data-area="@p.AreaId" data-pots="@p.PhysicalQuantity.ToString("0")">@p.AreaName - @p.PotSize - @Qty(p.PhysicalQuantity) empty pots</option>
                            }
                        </select>
                        @if (!Model.PotPools.Any())
                        {
                            <div class="text-danger small">No empty pots have been issued to your Area yet. Ask the Main Office to issue pots first.</div>
                        }
                        <div class="text-warning small d-none" id="potWarning">Fewer empty pots than cuttings: issue more pots to this Area before potting them all.</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Polyhouse <span class="text-muted fw-normal">(optional)</span></label>
                        <select asp-for="PolyhouseId" id="polyhouseSelect" class="form-select">
                            <option value="">-- No Polyhouse --</option>
                        </select>
                        <small class="text-muted">Only the Polyhouses of the pot pool's Area.</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Production Start Date</label>
                        <input type="date" asp-for="ProductionStartDate" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Expected Ready Date</label>
                        <input type="date" asp-for="ExpectedReadyDate" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Ready Confirmation By</label>
                        <select asp-for="ReadyConfirmerId" id="readyConfirmer" class="form-select" required>
                            <option value="">-- Select empty pots first --</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Remarks</label>
                        <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="text-center mt-4">
                    <a asp-page="/Production/PotBatch/Index" class="btn btn-secondary me-2">Back</a>
                    <button type="submit" class="btn btn-success" id="startBtn">Start Batch</button>
                </div>
            </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            const url = '@Url.Page("/Production/PotBatch/Create")';
            const selectedConfirmer = '@(Model.ReadyConfirmerId > 0 ? Model.ReadyConfirmerId.ToString() : "")';
            function checkAlloc() {
                const a = parseFloat($('#stock option:selected').data('available'));
                const q = parseFloat($('#allocated').val());
                const pots = parseFloat($('#pool option:selected').data('pots'));
                $('#allocWarning').toggleClass('d-none', !(!isNaN(a) && !isNaN(q) && q > a));
                $('#potWarning').toggleClass('d-none', !(!isNaN(pots) && !isNaN(q) && q > pots));
            }
            function loadReadyConfirmers() {
                const areaId = $('#pool option:selected').data('area');
                const $s = $('#readyConfirmer');
                if (!areaId) { $s.empty().append('<option value="">-- Select empty pots first --</option>'); return; }
                $.getJSON(url, { handler: 'ReadyConfirmers', areaId: areaId }, function (list) {
                    $s.empty().append($('<option value="">').text(list.length ? '-- Select user --' : '-- No authorized user is assigned to this Area --'));
                    list.forEach(function (u) {
                        const $o = $('<option>').val(u.id).text(u.name);
                        if (String(u.id) === selectedConfirmer || list.length === 1) $o.prop('selected', true);
                        $s.append($o);
                    });
                });
            }
            function loadPolyhouses() {
                const areaId = $('#pool option:selected').data('area');
                const $ph = $('#polyhouseSelect');
                $.getJSON(url, { handler: 'Polyhouses', areaId: areaId || 0 }, function (list) {
                    $ph.empty().append($('<option value="">').text('-- No Polyhouse --'));
                    $.each(list, function (i, x) { $ph.append($('<option>').val(x.id).text(x.name)); });
                });
            }
            $('#stock').on('change', checkAlloc);
            $('#allocated').on('input', checkAlloc);
            $('#pool').on('change', function () { loadReadyConfirmers(); loadPolyhouses(); checkAlloc(); });
            if ($('#cutting-form').length) { loadReadyConfirmers(); loadPolyhouses(); checkAlloc(); }
            // one submit per form (the server also ignores a repeated form token)
            $('#cutting-form').on('submit', function () { if (this.checkValidity()) $('#startBtn').prop('disabled', true); });
        });
    </script>
}
