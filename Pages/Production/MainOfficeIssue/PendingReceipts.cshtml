@page
@model PlantStockManager.Pages.Production.MainOfficeIssue.PendingReceiptsModel
@{
    ViewData["Title"] = "Growing Partner Pending Receipts";
}

<div class="container-fluid mt-4">
    <h2 class="mb-3">Growing Partner &mdash; Pending Starter Material Receipts</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-md-4">
            <label class="form-label fw-bold">Growing Partner Area</label>
            <select name="areaId" class="form-select" onchange="this.form.submit()">
                <option value="">-- All My Areas --</option>
                @foreach (var a in Model.PartnerAreas)
                {
                    <option value="@a.Id" selected="@(Model.SelectedAreaId == a.Id)">@a.Name (@a.GrowingPartnerName)</option>
                }
            </select>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Transfer Code</th>
                    <th>From (Main Office Area)</th>
                    <th>To Area</th>
                    <th>Variety</th>
                    <th>Pot Size</th>
                    <th>Sent Quantity</th>
                    <th>Sent Date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Pending)
                {
                    <tr>
                        <td>@t.TransferCode</td>
                        <td>@t.SourceAreaName</td>
                        <td>@t.DestinationAreaName</td>
                        <td>@t.SpeciesName</td>
                        <td>@t.PotSize</td>
                        <td>@t.Quantity.ToString("N2")</td>
                        <td>@t.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-nowrap">
                            <a asp-page="/Production/MainOfficeIssue/ConfirmReceipt" asp-route-id="@t.Id" class="btn btn-sm btn-primary">Confirm Receipt</a>
                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="collapse" data-bs-target="#reject-@t.Id">Reject</button>
                            <div class="collapse mt-2" id="reject-@t.Id">
                                <form method="post" asp-page-handler="Reject">
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <input type="hidden" name="areaId" value="@Model.SelectedAreaId" />
                                    <input type="text" name="reason" class="form-control form-control-sm mb-1" placeholder="Reason for rejection" required />
                                    <button type="submit" class="btn btn-sm btn-danger w-100">Confirm Reject</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Pending.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted">No Main Office Issue transfers awaiting confirmation.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
