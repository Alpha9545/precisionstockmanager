@page "{id:int}"
@model PlantStockManager.Pages.Production.PropagationBatch.DetailsModel
@{
    ViewData["Title"] = "Propagation Batch Details";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 700px;">
        <div class="card-header">
            <h4 class="mb-0">@Model.PropagationBatch!.BatchCode</h4>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-5">Cutting Delivery</dt>
                <dd class="col-sm-7"><a asp-page="/Production/CuttingDelivery/Details" asp-route-id="@Model.PropagationBatch.CuttingDeliveryId">@Model.PropagationBatch.CuttingDeliveryCode</a></dd>
                <dt class="col-sm-5">Mother Plant</dt>
                <dd class="col-sm-7"><a asp-page="/Production/MotherPlant/Details" asp-route-id="@Model.PropagationBatch.MotherPlantId">@Model.PropagationBatch.MotherPlantCode</a></dd>
                <dt class="col-sm-5">Plant Species</dt><dd class="col-sm-7">@Model.PropagationBatch.SpeciesName (@Model.PropagationBatch.PlantTypeName)</dd>
                <dt class="col-sm-5">Propagation Area</dt><dd class="col-sm-7">@(Model.PropagationBatch.AreaName ?? "-")</dd>
                <dt class="col-sm-5">Propagation Date</dt><dd class="col-sm-7">@Model.PropagationBatch.PropagationDate.ToString("dd/MM/yyyy")</dd>
                <dt class="col-sm-5">Status</dt><dd class="col-sm-7">@Model.PropagationBatch.Status</dd>
                <dt class="col-sm-5">Quantity Planted</dt><dd class="col-sm-7">@Model.PropagationBatch.Quantity.ToString("N2")</dd>
                <dt class="col-sm-5">Survived Quantity</dt><dd class="col-sm-7">@Model.PropagationBatch.SurvivedQuantity.ToString("N2")</dd>
                <dt class="col-sm-5">Loss Quantity</dt><dd class="col-sm-7">@Model.PropagationBatch.LossQuantity.ToString("N2")</dd>
                @* Responsible Person was removed from data entry (Phase 1); an existing value is kept and shown for history only. *@
                @if (!string.IsNullOrEmpty(Model.PropagationBatch.ResponsiblePersonName))
                {
                    <dt class="col-sm-5">Responsible Person (historical)</dt><dd class="col-sm-7">@Model.PropagationBatch.ResponsiblePersonName</dd>
                }
                <dt class="col-sm-5">Supervisor</dt><dd class="col-sm-7">@Model.PropagationBatch.SupervisorName</dd>
                <dt class="col-sm-5">Remarks</dt><dd class="col-sm-7">@Model.PropagationBatch.Remarks</dd>
                <dt class="col-sm-5">Created</dt><dd class="col-sm-7">@Model.PropagationBatch.CreatedDate.ToString("dd/MM/yyyy HH:mm") by @Model.PropagationBatch.CreatedBy</dd>
                @if (Model.PropagationBatch.ModifiedDate.HasValue)
                {
                    <dt class="col-sm-5">Last Modified</dt><dd class="col-sm-7">@Model.PropagationBatch.ModifiedDate.Value.ToString("dd/MM/yyyy HH:mm") by @Model.PropagationBatch.ModifiedBy</dd>
                }
            </dl>
        </div>
        <div class="card-footer text-end">
            <a asp-page="/Production/PropagationBatch/Index" class="btn btn-secondary">Back</a>
            <a asp-page="/Production/PropagationBatch/Edit" asp-route-id="@Model.PropagationBatch.Id" class="btn btn-warning">Edit</a>
        </div>
    </div>
</div>
