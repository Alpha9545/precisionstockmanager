@page
@model PlantStockManager.Pages.Production.PropagationBatch.IndexModel
@{
    ViewData["Title"] = "Propagation Batch";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Propagation Batch</h2>
        <a asp-page="/Production/PropagationBatch/Create" class="btn btn-primary">+ Start Propagation Batch</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total Planted</div>
                    <div class="fs-3 fw-bold">@Model.TotalPlanted.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total Survived</div>
                    <div class="fs-3 fw-bold">@Model.TotalSurvived.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total Loss</div>
                    <div class="fs-3 fw-bold">@Model.TotalLoss.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Cutting Delivery</th>
                    <th>Mother Plant</th>
                    <th>Variety</th>
                    <th>Area</th>
                    <th>Date</th>
                    <th>Planted</th>
                    <th>Survived</th>
                    <th>Loss</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pb in Model.PropagationBatches)
                {
                    <tr>
                        <td>@pb.BatchCode</td>
                        <td>@pb.CuttingDeliveryCode</td>
                        <td>@pb.MotherPlantCode</td>
                        <td>@pb.SpeciesName <span class="text-muted">(@pb.PlantTypeName)</span></td>
                        <td>@(pb.AreaName ?? "-")</td>
                        <td>@pb.PropagationDate.ToString("dd/MM/yyyy")</td>
                        <td>@pb.Quantity.ToString("N2")</td>
                        <td>@pb.SurvivedQuantity.ToString("N2")</td>
                        <td>@pb.LossQuantity.ToString("N2")</td>
                        <td>
                            @switch (pb.Status)
                            {
                                case "Completed":
                                    <span class="badge bg-success">Completed</span>
                                    break;
                                case "ReadyForPotting":
                                    <span class="badge bg-info text-dark">Ready For Potting</span>
                                    break;
                                case "Cancelled":
                                    <span class="badge bg-secondary">Cancelled</span>
                                    break;
                                default:
                                    <span class="badge bg-warning text-dark">Propagating</span>
                                    break;
                            }
                        </td>
                        <td>
                            <a asp-page="/Production/PropagationBatch/Details" asp-route-id="@pb.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            <a asp-page="/Production/PropagationBatch/Edit" asp-route-id="@pb.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                        </td>
                    </tr>
                }
                @if (!Model.PropagationBatches.Any())
                {
                    <tr><td colspan="11" class="text-center text-muted">No Propagation Batch records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
