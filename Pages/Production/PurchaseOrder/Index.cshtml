@page
@model PlantStockManager.Pages.Production.PurchaseOrder.IndexModel
@{
    ViewData["Title"] = "Purchase Orders";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Purchase Orders</h2>
        <a asp-page="/Production/PurchaseOrder/Create" class="btn btn-primary">+ New Purchase Order</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Vendor</th>
                    <th>Order Date</th>
                    <th>Expected Delivery</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model.Orders)
                {
                    <tr>
                        <td>@o.PurchaseOrderCode</td>
                        <td>@o.VendorName</td>
                        <td>@o.OrderDate.ToString("dd/MM/yyyy")</td>
                        <td>@(o.ExpectedDeliveryDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>
                            @{
                                var badgeClass = o.Status switch
                                {
                                    "Completed" => "bg-success",
                                    "PartiallyReceived" => "bg-info text-dark",
                                    "Cancelled" => "bg-secondary",
                                    _ => "bg-warning text-dark"
                                };
                            }
                            <span class="badge @badgeClass">@o.Status</span>
                        </td>
                        <td>
                            <a asp-page="/Production/PurchaseOrder/Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            @if (o.Status == "Pending" || o.Status == "PartiallyReceived")
                            {
                                <a asp-page="/Production/PurchaseOrder/Receive" asp-route-id="@o.Id" class="btn btn-sm btn-outline-success">Receive</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Orders.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted">No Purchase Orders found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
