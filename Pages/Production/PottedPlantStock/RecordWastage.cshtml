@page "{id:int}"
@model PlantStockManager.Pages.Production.PottedPlantStock.RecordWastageModel
@{
    ViewData["Title"] = "Record Wastage";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-header">
            <h4 class="mb-0">Record Wastage &mdash; @Model.Stock!.SpeciesName (@Model.Stock.PotSize)</h4>
        </div>
        <div class="card-body">
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <dl class="row">
                <dt class="col-sm-4">Area</dt><dd class="col-sm-8">@(Model.Stock.AreaName ?? "Unassigned")</dd>
                <dt class="col-sm-4">Available</dt><dd class="col-sm-8 fw-bold">@Model.Stock.AvailableQuantity.ToString("N2")</dd>
                <dt class="col-sm-4">Already Wasted (cum.)</dt><dd class="col-sm-8">@Model.Stock.WastedQuantity.ToString("N2")</dd>
            </dl>

            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Quantity Wasted</label>
                    <input type="number" step="0.01" min="0.01" max="@Model.Stock.AvailableQuantity" asp-for="Quantity" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Reason</label>
                    <textarea asp-for="Reason" class="form-control" rows="2" placeholder="e.g. Disease, Damaged, Died in stock" required></textarea>
                </div>

                <div class="text-center mt-4">
                    <a asp-page="/Production/PottedPlantStock/Details" asp-route-id="@Model.Stock.Id" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-danger">Record Wastage</button>
                </div>
            </form>
        </div>
    </div>
</div>
