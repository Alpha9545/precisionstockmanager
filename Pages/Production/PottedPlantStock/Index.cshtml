@page
@model PlantStockManager.Pages.Production.PottedPlantStock.IndexModel
@inject PlantStockManager.Authorization.FeatureAccessService FeatureAccess
@{
    ViewData["Title"] = "Potted Plant Stock";
    var canMove = await FeatureAccess.CanAccessPageAsync(User, "/Production/PottedPlantStock/Move");
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h3 class="mb-0">Potted Plant Stock</h3>
        <div class="d-flex gap-2">
            <a asp-page="/Production/PotBatch/Index" class="btn btn-outline-secondary">Pot Production</a>
            <a asp-page="/Data/StockHistory" asp-route-stockType="PottedPlant" class="btn btn-outline-secondary">Stock History</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="row g-3 mb-3">
        <div class="col-md-4"><div class="card text-center shadow-sm"><div class="card-body py-2"><div class="text-muted small">In stock</div><div class="fs-4 fw-bold">@Model.TotalPhysical.ToString("N0")</div></div></div></div>
        <div class="col-md-4"><div class="card text-center shadow-sm"><div class="card-body py-2"><div class="text-muted small">Reserved for bookings</div><div class="fs-4 fw-bold">@Model.TotalReserved.ToString("N0")</div></div></div></div>
        <div class="col-md-4"><div class="card text-center shadow-sm"><div class="card-body py-2"><div class="text-muted small">Available</div><div class="fs-4 fw-bold">@Model.TotalAvailable.ToString("N0")</div></div></div></div>
    </div>

    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-md-4">
            <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Search variety, colour, pot size, Area or batch" />
        </div>
        <div class="col-auto form-check ms-2">
            <input type="checkbox" class="form-check-input" id="showEmpty" name="showEmpty" value="true" @(Model.ShowEmpty ? "checked" : "") />
            <label class="form-check-label" for="showEmpty">Show empty</label>
        </div>
        <div class="col-auto"><button class="btn btn-primary">Filter</button></div>
    </form>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>Variety</th><th>Species</th><th>Colour</th><th>Pot Size</th><th>Area</th>
                    <th class="text-end">Quantity</th><th class="text-end">Reserved</th><th class="text-end">Available</th>
                    <th>Batch</th><th>Ready Date</th><th>Status</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Stocks)
                {
                    <tr>
                        <td>@s.SpeciesName?.Trim()</td>
                        <td>@s.PlantTypeName</td>
                        <td>@(s.SpeciesColor ?? "-")</td>
                        <td>@s.PotSize</td>
                        <td>@(s.AreaName ?? "Unassigned")</td>
                        <td class="text-end">@s.PhysicalQuantity.ToString("N0")</td>
                        <td class="text-end">@s.ReservedQuantity.ToString("N0")</td>
                        <td class="text-end fw-bold">@s.AvailableQuantity.ToString("N0")</td>
                        <td>
                            @if (s.LastProductionId.HasValue)
                            {
                                <span title="@s.BatchCodes">@s.BatchCodes</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>@(s.LastReadyDate?.ToLocalTime().ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>
                            <span class="badge @(s.Status == "READY" ? "bg-success" : s.Status == "Reserved" ? "bg-warning text-dark" : "bg-secondary")">@s.Status</span>
                        </td>
                        <td class="text-nowrap">
                            <a asp-page="/Production/PottedPlantStock/Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">History</a>
                            @if (canMove && s.AvailableQuantity > 0)
                            {
                                <a asp-page="/Production/PottedPlantStock/Move" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Send</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Stocks.Any())
                {
                    <tr><td colspan="12" class="text-center text-muted">No potted plant stock. Stock is created when a pot batch is confirmed READY.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
