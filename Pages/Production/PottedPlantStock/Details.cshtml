@page "{id:int}"
@model PlantStockManager.Pages.Production.PottedPlantStock.DetailsModel
@{
    ViewData["Title"] = "Potted Plant Stock Details";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">
            @Model.Stock!.SpeciesName &mdash; @Model.Stock.PotSize
            <span class="text-muted fs-6">(@(Model.Stock.AreaName ?? "Unassigned")@(Model.Stock.GrowingPartnerName != null ? $" / {Model.Stock.GrowingPartnerName}" : ""))</span>
        </h4>
        <a asp-page="/Production/PottedPlantStock/Index" class="btn btn-secondary">Back</a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3"><span class="text-muted small">Physical</span><div class="fs-5 fw-bold">@Qty(Model.Stock.PhysicalQuantity)</div></div>
                <div class="col-md-3"><span class="text-muted small">Reserved</span><div class="fs-5 fw-bold">@Qty(Model.Stock.ReservedQuantity)</div></div>
                <div class="col-md-3"><span class="text-muted small">Available</span><div class="fs-5 fw-bold">@Qty(Model.Stock.AvailableQuantity)</div></div>
                <div class="col-md-3"><span class="text-muted small">Sold/Dispatched (cum.)</span><div class="fs-5 fw-bold">@Qty(Model.Stock.SoldDispatchedQuantity)</div></div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <span class="text-muted small">Pot batches (READY)</span>
                    <div>
                        @if (Model.Stock.LastProductionId.HasValue)
                        {
                            @Model.Stock.BatchCodes
                            <span class="text-muted">&mdash; latest</span>
                            <a asp-page="/Production/PotBatch/Details" asp-route-id="@Model.Stock.LastProductionId">@Model.Stock.LastProductionCode</a>
                            <span class="text-muted">(ready @Model.Stock.LastReadyDate?.ToLocalTime().ToString("dd/MM/yyyy"))</span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </div>
                </div>
                <div class="col-md-6">
                    <span class="text-muted small">Last Transaction</span>
                    <div>@(Model.Stock.LastTransactionDate.HasValue ? Model.Stock.LastTransactionDate.Value.ToString("dd/MM/yyyy HH:mm") : "-")</div>
                </div>
            </div>
        </div>
    </div>

    <h5>Transaction History</h5>
    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Reference</th>
                    <th>Qty (+/-)</th>
                    <th>Before</th>
                    <th>After</th>
                    <th>By</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Transactions)
                {
                    <tr>
                        <td>@t.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@t.TransactionType</td>
                        <td>
                            @if (t.ReferenceType == "PotProductionBatch" && t.ReferenceId.HasValue)
                            {
                                <a asp-page="/Production/PotBatch/Details" asp-route-id="@t.ReferenceId">Pot batch #@t.ReferenceId</a>
                            }
                            else if (t.ReferenceType != null)
                            {
                                @($"{t.ReferenceType} #{t.ReferenceId}")
                            }
                            else
                            {
                                @("-")
                            }
                        </td>
                        <td class="@(t.Quantity < 0 ? "text-danger" : "text-success")">@Qty(t.Quantity)</td>
                        <td>@Qty(t.BeforeQuantity)</td>
                        <td>@Qty(t.AfterQuantity)</td>
                        <td>@(t.UserName ?? "-")</td>
                        <td>@t.Remarks</td>
                    </tr>
                }
                @if (!Model.Transactions.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted">No transactions recorded yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
