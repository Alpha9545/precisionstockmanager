@page
@model PlantStockManager.Pages.Production.PottedPlantBooking.CreateModel
@{
    ViewData["Title"] = "Record Booking";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 900px;">
        <div class="card-header">
            <h4 class="mb-0">Record Booking (reserves Potted Plant Stock)</h4>
        </div>
        <div class="card-body">
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            @if (!Model.StockPools.Any())
            {
                <div class="alert alert-warning">No Potted Plant Stock with Available quantity to book right now.</div>
            }

            <form method="post">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label fw-bold">Species / Pot Size / Area</label>
                        <select asp-for="Booking.PottedPlantStockId" id="stockSelect" class="form-select" required>
                            <option value="">-- Select --</option>
                            @foreach (var s in Model.StockPools)
                            {
                                <option value="@s.Id" data-available="@s.AvailableQuantity.ToString("0.####")">
                                    @s.SpeciesName (@s.PlantTypeName) &mdash; @s.PotSize &mdash; @(s.AreaName ?? "Unassigned") (Available: @s.AvailableQuantity.ToString("N2"))
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Available</label>
                        <input type="text" id="availablePreview" class="form-control" readonly placeholder="Select a pool" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Quantity</label>
                        <input type="number" step="0.01" min="0.01" asp-for="Booking.Quantity" class="form-control" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Booking Date</label>
                        <input type="date" asp-for="Booking.BookingDate" class="form-control" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Delivery Date (tentative)</label>
                        <input type="date" asp-for="Booking.DeliveryDate" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Customer Name</label>
                        <input type="text" asp-for="Booking.CustomerName" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Contact</label>
                        <input type="text" asp-for="Booking.Contact" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Address</label>
                        <input type="text" asp-for="Booking.Address" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold">State</label>
                        <select id="stateDropdown" asp-for="Booking.StateId" class="form-select">
                            <option value="">-- None --</option>
                            @foreach (var s in Model.States)
                            {
                                <option value="@s.StateId">@s.StateName</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold">District</label>
                        <select id="districtDropdown" asp-for="Booking.DistrictId" class="form-select" disabled>
                            <option value="">-- Select State First --</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Booked By</label>
                        <select asp-for="Booking.BookedById" class="form-select">
                            <option value="">-- None --</option>
                            @foreach (var e in Model.BookedByOptions)
                            {
                                <option value="@e.EmployeeID">@e.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Booked By (Other)</label>
                        <input type="text" asp-for="Booking.BookedByOther" class="form-control" placeholder="If not in the list above" />
                    </div>

                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check">
                            <input type="checkbox" asp-for="Booking.AdvanceTaken" id="advanceTaken" class="form-check-input" />
                            <label class="form-check-label" asp-for="Booking.AdvanceTaken">Advance Taken</label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Advance Amount</label>
                        <input type="number" step="0.01" min="0" asp-for="Booking.AdvanceTakenAmount" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Advance Details</label>
                        <input type="text" asp-for="Booking.AdvanceTakenDetails" class="form-control" placeholder="e.g. UPI ref / receipt no." />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Remarks</label>
                        <textarea asp-for="Booking.Remarks" class="form-control" rows="2"></textarea>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <a asp-page="/Production/PottedPlantBooking/Index" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-success">Save Booking</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#stockSelect').on('change', function () {
                const available = $(this).find('option:selected').data('available');
                $('#availablePreview').val(available !== undefined ? available : '');
            }).trigger('change');

            $('#stateDropdown').on('change', function () {
                const stateId = $(this).val();
                const $district = $('#districtDropdown');
                $district.prop('disabled', true).html('<option value="">-- Loading... --</option>');
                if (!stateId) {
                    $district.html('<option value="">-- Select State First --</option>');
                    return;
                }
                $.get(window.location.pathname + '?handler=DistrictsByState&stateId=' + stateId, function (data) {
                    $district.html('<option value="">-- None --</option>');
                    data.forEach(function (d) {
                        $district.append($('<option>').val(d.districtId).text(d.districtName));
                    });
                    $district.prop('disabled', false);
                }).fail(function () {
                    $district.html('<option value="">-- Unable to load --</option>');
                });
            });
        });
    </script>
}
