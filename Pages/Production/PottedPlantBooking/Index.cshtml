@page
@model PlantStockManager.Pages.Production.PottedPlantBooking.IndexModel
@{
    ViewData["Title"] = "Booking (Potted Plant Reservation)";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Booking &mdash; Potted Plant Reservation</h2>
        <a asp-page="/Production/PottedPlantBooking/Create" class="btn btn-primary">+ Record Booking</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total Reserved (Pending)</div>
                    <div class="fs-3 fw-bold">@Model.TotalReserved.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Customer</th>
                    <th>Species</th>
                    <th>Pot Size</th>
                    <th>Area</th>
                    <th>Quantity</th>
                    <th>Dispatched</th>
                    <th>Remaining</th>
                    <th>Booking Date</th>
                    <th>Delivery Date</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.Bookings)
                {
                    <tr>
                        <td>@b.BookingCode</td>
                        <td>@b.CustomerName</td>
                        <td>@b.SpeciesName <span class="text-muted">(@b.PlantTypeName)</span></td>
                        <td>@b.PotSize</td>
                        <td>@(b.AreaName ?? "Unassigned")</td>
                        <td>@b.Quantity.ToString("N2")</td>
                        <td>@b.DispatchedQuantity.ToString("N2")</td>
                        <td>@b.RemainingQuantity.ToString("N2")</td>
                        <td>@b.BookingDate.ToString("dd/MM/yyyy")</td>
                        <td>@(b.DeliveryDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>
                            @if (b.Status == "Cancelled")
                            {
                                <span class="badge bg-secondary">Cancelled</span>
                            }
                            else if (b.Status == "Dispatched")
                            {
                                <span class="badge bg-success">Dispatched</span>
                            }
                            else if (b.Status == "PartiallyDispatched")
                            {
                                <span class="badge bg-info text-dark">Partially Dispatched</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending (Reserved)</span>
                            }
                        </td>
                        <td>
                            <a asp-page="/Production/PottedPlantBooking/Details" asp-route-id="@b.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            <a asp-page="/Production/PottedPlantBooking/Edit" asp-route-id="@b.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                        </td>
                    </tr>
                }
                @if (!Model.Bookings.Any())
                {
                    <tr><td colspan="12" class="text-center text-muted">No Bookings found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
