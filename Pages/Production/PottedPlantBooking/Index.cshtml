@page
@model PlantStockManager.Pages.Production.PottedPlantBooking.IndexModel
@{
    ViewData["Title"] = "Booking (Potted Plant Reservation)";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Booking &mdash; Potted Plant Reservation</h2>
        <a asp-page="/Production/PottedPlantBooking/Create" class="btn btn-primary">+ Record Booking</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total Reserved (Pending)</div>
                    <div class="fs-3 fw-bold">@Qty(Model.TotalReserved)</div>
                </div>
            </div>
        </div>
    </div>

    <form method="get" class="row g-2 align-items-end mb-2">
        <div class="col-12 col-md-4">
            <label class="form-label small fw-bold mb-1">Booking By</label>
            <select name="SelectedBookedBy" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All</option>
                @foreach (var option in Model.BookedByOptions)
                {
                    <option value="@option.Value" selected="@(Model.SelectedBookedBy == option.Value)">@option.Label</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <a asp-page="/Production/PottedPlantBooking/Index" class="btn btn-outline-secondary btn-sm">Clear filters</a>
        </div>
    </form>
    @if (Model.Notice != null)
    {
        <div class="alert alert-warning py-1 small">@Model.Notice</div>
    }
    <div class="small text-muted mb-2">@Model.Bookings.Count.ToString("N0") record@(Model.Bookings.Count == 1 ? "" : "s") found@(Model.BookedByActive ? " (filtered by Booking By)" : "")</div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Customer</th>
                    <th>Booked By</th>
                    <th>Species</th>
                    <th>Pot Size</th>
                    <th>Area</th>
                    <th>Quantity</th>
                    <th>Dispatched</th>
                    <th>Remaining</th>
                    <th>Booking Date</th>
                    <th>Delivery Date</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.Bookings)
                {
                    <tr>
                        <td>@b.BookingCode</td>
                        <td>@b.CustomerName</td>
                        <td>@(PlantStockManager.Services.BookedByFilter.Display(b.BookedById, b.BookedByName, b.BookedByOther))</td>
                        <td>@b.SpeciesName <span class="text-muted">(@b.PlantTypeName)</span></td>
                        <td>@b.PotSize</td>
                        <td>@(b.AreaName ?? "Unassigned")</td>
                        <td>@Qty(b.Quantity)</td>
                        <td>@Qty(b.DispatchedQuantity)</td>
                        <td>@Qty(b.RemainingQuantity)</td>
                        <td>@b.BookingDate.ToString("dd/MM/yyyy")</td>
                        <td>@(b.DeliveryDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>
                            @if (b.Status == "Cancelled")
                            {
                                <span class="badge bg-secondary">Cancelled</span>
                            }
                            else if (b.Status == "Dispatched")
                            {
                                <span class="badge bg-success">Dispatched</span>
                            }
                            else if (b.Status == "PartiallyDispatched")
                            {
                                <span class="badge bg-info text-dark">Partially Dispatched</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending (Reserved)</span>
                            }
                        </td>
                        <td>
                            <a asp-page="/Production/PottedPlantBooking/Details" asp-route-id="@b.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            <a asp-page="/Production/PottedPlantBooking/Edit" asp-route-id="@b.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                        </td>
                    </tr>
                }
                @if (!Model.Bookings.Any())
                {
                    <tr><td colspan="13" class="text-center text-muted">@(Model.BookedByActive ? "No records match the selected filters." : "No Bookings found.")</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
