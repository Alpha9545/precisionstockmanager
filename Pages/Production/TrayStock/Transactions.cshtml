@page
@model PlantStockManager.Pages.Production.TrayStock.TransactionsModel
@{
    ViewData["Title"] = "Tray Stock Transactions";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h3 class="mb-0">Tray Stock Transactions</h3>
        <a asp-page="/Production/TrayStock/Index" class="btn btn-outline-secondary">Back to Tray Stock</a>
    </div>

    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-12 col-md-4">
            <label class="form-label">Area</label>
            <select name="areaId" class="form-select" onchange="this.form.polyhouseId.value=''; this.form.submit()">
                <option value="">All Areas</option>
                @foreach (var a in Model.Areas)
                {
                    <option value="@a.Id" selected="@(Model.AreaId == a.Id)">@a.Name</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label">Polyhouse</label>
            <select name="polyhouseId" class="form-select" onchange="this.form.submit()">
                <option value="">@(Model.AreaId.HasValue ? "All Polyhouses" : "Select an Area first")</option>
                @foreach (var p in Model.Polyhouses)
                {
                    <option value="@p.Id" selected="@(Model.PolyhouseId == p.Id)">@p.Name</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label">Cavity</label>
            <select name="traySize" class="form-select" onchange="this.form.submit()">
                <option value="">All Cavities</option>
                @foreach (var t in Model.TraySizes)
                {
                    <option value="@t" selected="@(Model.TraySize == t)">@t</option>
                }
            </select>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>Date</th><th>Area</th><th>Polyhouse</th><th>Cavity</th><th>Type</th>
                    <th class="text-end">Quantity</th><th class="text-end">Before</th><th class="text-end">After</th>
                    <th>Reference</th><th>User</th><th>Remark</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Transactions)
                {
                    <tr>
                        <td class="text-nowrap">@t.TransactionDate.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")</td>
                        <td>@t.AreaName</td>
                        <td>@(t.PolyhouseName ?? "(Area level, 4 Oct 2026)")</td>
                        <td>@t.TraySize</td>
                        <td>@t.TypeLabel</td>
                        <td class="text-end @(t.Quantity >= 0 ? "text-success" : "text-danger")">@(t.Quantity >= 0 ? "+" : "")@Qty(t.Quantity)</td>
                        <td class="text-end">@Qty(t.BeforeQuantity)</td>
                        <td class="text-end fw-bold">@Qty(t.AfterQuantity)</td>
                        <td>@(t.ReferenceType switch
                            {
                                null => "-",
                                PlantStockManager.Data.TrayStockRepository.AddReferenceType => "-",
                                "TrayStockMigration" or "TrayStockPolyhouseSplit" => "-",
                                "TrayStockReversal" => $"Entry #{t.ReferenceId}",
                                _ => $"{t.ReferenceType} #{t.ReferenceId}"
                            })</td>
                        <td>@(t.UserName ?? "-")</td>
                        <td>@(t.Remarks ?? "-")</td>
                    </tr>
                }
                @if (!Model.Transactions.Any())
                {
                    <tr><td colspan="11" class="text-center text-muted">No tray stock transactions for your Areas.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
