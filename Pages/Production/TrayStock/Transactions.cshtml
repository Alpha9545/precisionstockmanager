@page
@model PlantStockManager.Pages.Production.TrayStock.TransactionsModel
@{
    ViewData["Title"] = "Tray Stock Transactions";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h3 class="mb-0">Tray Stock Transactions</h3>
        <a asp-page="/Production/TrayStock/Index" class="btn btn-outline-secondary">Back to Tray Stock</a>
    </div>

    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-md-4">
            <label class="form-label">Polyhouse</label>
            <select name="polyhouseId" class="form-select" onchange="this.form.submit()">
                <option value="">-- All --</option>
                @foreach (var p in Model.Polyhouses)
                {
                    <option value="@p.Id" selected="@(Model.PolyhouseId == p.Id)">@p.AreaName - @p.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Tray Size</label>
            <select name="traySize" class="form-select" onchange="this.form.submit()">
                <option value="">-- All --</option>
                @foreach (var t in Model.TraySizes)
                {
                    <option value="@t" selected="@(Model.TraySize == t)">@t</option>
                }
            </select>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>Date</th><th>Polyhouse</th><th>Tray Size</th><th>Type</th>
                    <th class="text-end">Quantity</th><th class="text-end">Balance</th>
                    <th>Reference</th><th>Remark</th><th>By</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Transactions)
                {
                    <tr>
                        <td>@t.TransactionDate.ToString("dd-MMM-yyyy HH:mm")</td>
                        <td>@t.PolyhouseName</td>
                        <td>@t.TraySize</td>
                        <td>@t.TransactionType</td>
                        <td class="text-end @(t.Quantity >= 0 ? "text-success" : "text-danger")">@(t.Quantity >= 0 ? "+" : "")@t.Quantity.ToString("N0")</td>
                        <td class="text-end fw-bold">@t.AfterQuantity.ToString("N0")</td>
                        <td>@(t.ReferenceType != null ? $"{t.ReferenceType} #{t.ReferenceId}" : "-")</td>
                        <td>@(t.Remarks ?? "-")</td>
                        <td>@(t.UserName ?? "-")</td>
                    </tr>
                }
                @if (!Model.Transactions.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted">No tray stock transactions yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
