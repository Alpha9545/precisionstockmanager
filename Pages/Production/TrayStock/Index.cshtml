@page
@model PlantStockManager.Pages.Production.TrayStock.IndexModel
@inject PlantStockManager.Authorization.FeatureAccessService FeatureAccess
@{
    ViewData["Title"] = "Tray Stock";
    var canAllocate = await FeatureAccess.CanAccessPageAsync(User, "/Production/TrayStock/Allocate");
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h3 class="mb-0">Tray Stock</h3>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-page="/Production/TrayStock/Transactions" class="btn btn-outline-secondary">Transaction History</a>
            @if (canAllocate)
            {
                <a asp-page="/Production/TrayStock/Allocate" class="btn btn-primary">Allocate Trays</a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-md-4">
            <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Search Polyhouse, Area or Tray Size" />
        </div>
        <div class="col-auto"><button class="btn btn-primary">Filter</button></div>
    </form>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>Polyhouse</th><th>Area</th><th>Tray Size</th><th class="text-end">Available</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Stock)
                {
                    <tr>
                        <td>@s.PolyhouseName</td>
                        <td>@s.AreaName</td>
                        <td>@s.TraySize</td>
                        <td class="text-end fw-bold">@s.PhysicalQuantity.ToString("N0")</td>
                        <td>
                            <a asp-page="/Production/TrayStock/Transactions" asp-route-polyhouseId="@s.PolyhouseId" asp-route-traySize="@s.TraySize" class="btn btn-sm btn-outline-secondary">History</a>
                        </td>
                    </tr>
                }
                @if (!Model.Stock.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted">No tray stock recorded yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
