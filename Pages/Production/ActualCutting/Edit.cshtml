@page "{id:int}"
@model PlantStockManager.Pages.Production.ActualCutting.EditModel
@{
    ViewData["Title"] = "Edit Actual Cutting";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 850px;">
        <div class="card-header">
            <h4 class="mb-0">Edit Actual Cutting &mdash; @Model.ActualCutting.ActualCuttingCode</h4>
        </div>
        <div class="card-body">
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <div class="alert alert-secondary">
                Cutting Plan <strong>@Model.ActualCutting.CuttingPlanNumber</strong> &mdash;
                Mother Plant <strong>@Model.ActualCutting.MotherPlantCode</strong> &mdash;
                <strong>@Model.ActualCutting.SpeciesName</strong>
                <div class="small text-muted">The Cutting Plan / Mother Plant / Species linkage cannot be changed once a record exists -- it preserves traceability.</div>
            </div>

            <form method="post">
                <input type="hidden" asp-for="ActualCutting.Id" />
                <input type="hidden" asp-for="ActualCutting.ActualCuttingCode" />
                <input type="hidden" asp-for="ActualCutting.CreatedBy" />
                <input type="hidden" asp-for="ActualCutting.CreatedDate" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Cutting Date</label>
                        <input type="date" asp-for="ActualCutting.CuttingDate" class="form-control" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Actual Quantity</label>
                        <input type="number" step="0.01" min="0" asp-for="ActualCutting.ActualQuantity" id="actualQtyInput" class="form-control" required />
                    </div>

                    <div class="col-md-4">
                        <small class="text-muted d-block mt-4">Good + Damaged + Rejected must equal Actual Quantity exactly.</small>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Good Quantity</label>
                        <input type="number" step="0.01" min="0" asp-for="ActualCutting.GoodQuantity" class="form-control reconcile-input" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Damaged Quantity</label>
                        <input type="number" step="0.01" min="0" asp-for="ActualCutting.DamagedQuantity" class="form-control reconcile-input" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Rejected Quantity</label>
                        <input type="number" step="0.01" min="0" asp-for="ActualCutting.RejectedQuantity" class="form-control reconcile-input" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Labour / Responsible Person</label>
                        <select asp-for="ActualCutting.ResponsiblePersonId" class="form-select">
                            <option value="">-- None --</option>
                            @foreach (var r in Model.ResponsiblePersons)
                            {
                                <option value="@r.EmployeeID">@r.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Supervisor</label>
                        <select asp-for="ActualCutting.SupervisorId" class="form-select">
                            <option value="">-- None --</option>
                            @foreach (var s in Model.Supervisors)
                            {
                                <option value="@s.EmployeeID">@s.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Remarks</label>
                        <textarea asp-for="ActualCutting.Remarks" class="form-control" rows="2"></textarea>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <a asp-page="/Production/ActualCutting/Index" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-success">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
