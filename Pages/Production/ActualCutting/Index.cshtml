@page
@model PlantStockManager.Pages.Production.ActualCutting.IndexModel
@{
    ViewData["Title"] = "Actual Cutting";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Actual Cutting</h2>
        <a asp-page="/Production/ActualCutting/Create" class="btn btn-primary">+ Record Actual Cutting</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total Good</div>
                    <div class="fs-3 fw-bold">@Model.TotalGood.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total Damaged</div>
                    <div class="fs-3 fw-bold">@Model.TotalDamaged.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total Rejected</div>
                    <div class="fs-3 fw-bold">@Model.TotalRejected.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Cutting Plan</th>
                    <th>Mother Plant</th>
                    <th>Variety</th>
                    <th>Date</th>
                    <th>Actual</th>
                    <th>Good</th>
                    <th>Damaged</th>
                    <th>Rejected</th>
                    <th>Labour</th>
                    <th>Supervisor</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ac in Model.ActualCuttings)
                {
                    <tr>
                        <td>@ac.ActualCuttingCode</td>
                        <td>@ac.CuttingPlanNumber</td>
                        <td>@ac.MotherPlantCode</td>
                        <td>@ac.SpeciesName <span class="text-muted">(@ac.PlantTypeName)</span></td>
                        <td>@ac.CuttingDate.ToString("dd/MM/yyyy")</td>
                        <td>@ac.ActualQuantity.ToString("N2")</td>
                        <td>@ac.GoodQuantity.ToString("N2")</td>
                        <td>@ac.DamagedQuantity.ToString("N2")</td>
                        <td>@ac.RejectedQuantity.ToString("N2")</td>
                        <td>@ac.ResponsiblePersonName</td>
                        <td>@ac.SupervisorName</td>
                        <td>
                            <a asp-page="/Production/ActualCutting/Details" asp-route-id="@ac.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            <a asp-page="/Production/ActualCutting/Edit" asp-route-id="@ac.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                        </td>
                    </tr>
                }
                @if (!Model.ActualCuttings.Any())
                {
                    <tr><td colspan="12" class="text-center text-muted">No Actual Cutting records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
