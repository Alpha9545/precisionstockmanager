@page
@model PlantStockManager.Pages.Production.ActualCutting.CreateModel
@{
    ViewData["Title"] = "Record Actual Cutting";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 850px;">
        <div class="card-header">
            <h4 class="mb-0">Record Actual Cutting</h4>
        </div>
        <div class="card-body">
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            @if (!Model.OpenCuttingPlans.Any())
            {
                <div class="alert alert-warning">
                    No open Cutting Plans have remaining capacity for Actual Cutting.
                    <a asp-page="/Production/CuttingPlan/Create">Add a Cutting Plan</a> first.
                </div>
            }

            <form method="post">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label fw-bold">Cutting Plan</label>
                        <select asp-for="ActualCutting.CuttingPlanId" id="planSelect" class="form-select" required>
                            <option value="">-- Select --</option>
                            @foreach (var cp in Model.OpenCuttingPlans)
                            {
                                var remaining = cp.PlannedQuantity - cp.ActualCuttingQuantityRecorded;
                                <option value="@cp.Id" data-area-id="@Model.AreaOf(cp.MotherPlantId)" data-remaining="@remaining.ToString("0.####")">
                                    @cp.PlanNumber &mdash; @cp.MotherPlantCode / @cp.SpeciesName (Planned @cp.PlannedQuantity.ToString("N2"), Remaining @remaining.ToString("N2"))
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Remaining Capacity</label>
                        <input type="text" id="remainingPreview" class="form-control" readonly placeholder="Select a Cutting Plan" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Cutting Date</label>
                        <input type="date" asp-for="ActualCutting.CuttingDate" class="form-control" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Actual Quantity</label>
                        <input type="number" step="0.01" min="0" asp-for="ActualCutting.ActualQuantity" id="actualQtyInput" class="form-control" required />
                    </div>

                    <div class="col-md-4">
                        <small class="text-muted d-block mt-4">Good + Damaged + Rejected must equal Actual Quantity exactly.</small>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Good Quantity</label>
                        <input type="number" step="0.01" min="0" asp-for="ActualCutting.GoodQuantity" class="form-control reconcile-input" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Damaged Quantity</label>
                        <input type="number" step="0.01" min="0" asp-for="ActualCutting.DamagedQuantity" class="form-control reconcile-input" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Rejected Quantity</label>
                        <input type="number" step="0.01" min="0" asp-for="ActualCutting.RejectedQuantity" class="form-control reconcile-input" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Supervisor</label>
                        <select asp-for="ActualCutting.SupervisorId" class="form-select" data-supervisor-area-source="#planSelect">
                            <option value="">-- None --</option>
                            @foreach (var s in Model.Supervisors)
                            {
                                <option value="@s.EmployeeID" data-areas="@s.AreaAttribute">@s.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Remarks</label>
                        <textarea asp-for="ActualCutting.Remarks" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="col-12">
                        <div id="reconcileWarning" class="alert alert-warning d-none mb-0">
                            Good + Damaged + Rejected does not yet equal Actual Quantity.
                        </div>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <a asp-page="/Production/ActualCutting/Index" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-success">Save Actual Cutting</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#planSelect').on('change', function () {
                const remaining = $(this).find('option:selected').data('remaining');
                $('#remainingPreview').val(remaining !== undefined ? remaining : '');
            }).trigger('change');

            // Client-side hint only -- the server re-validates the exact
            // reconciliation rule (and the DB CHECK constraint enforces it
            // regardless of what the client sends).
            function checkReconcile() {
                const actual = parseFloat($('#actualQtyInput').val()) || 0;
                let sum = 0;
                $('.reconcile-input').each(function () { sum += parseFloat($(this).val()) || 0; });
                $('#reconcileWarning').toggleClass('d-none', Math.abs(sum - actual) < 0.0001);
            }
            $('#actualQtyInput, .reconcile-input').on('input', checkReconcile);
        });
    </script>
}
