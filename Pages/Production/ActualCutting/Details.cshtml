@page "{id:int}"
@model PlantStockManager.Pages.Production.ActualCutting.DetailsModel
@{
    ViewData["Title"] = "Actual Cutting Details";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 700px;">
        <div class="card-header">
            <h4 class="mb-0">@Model.ActualCutting!.ActualCuttingCode</h4>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-5">Cutting Plan</dt>
                <dd class="col-sm-7"><a asp-page="/Production/CuttingPlan/Details" asp-route-id="@Model.ActualCutting.CuttingPlanId">@Model.ActualCutting.CuttingPlanNumber</a></dd>
                <dt class="col-sm-5">Mother Plant</dt>
                <dd class="col-sm-7"><a asp-page="/Production/MotherPlant/Details" asp-route-id="@Model.ActualCutting.MotherPlantId">@Model.ActualCutting.MotherPlantCode</a></dd>
                <dt class="col-sm-5">Plant Species</dt><dd class="col-sm-7">@Model.ActualCutting.SpeciesName (@Model.ActualCutting.PlantTypeName)</dd>
                <dt class="col-sm-5">Cutting Date</dt><dd class="col-sm-7">@Model.ActualCutting.CuttingDate.ToString("dd/MM/yyyy")</dd>
                <dt class="col-sm-5">Planned Quantity (snapshot)</dt><dd class="col-sm-7">@Model.ActualCutting.PlannedQuantity.ToString("N2")</dd>
                <dt class="col-sm-5">Actual Quantity</dt><dd class="col-sm-7">@Model.ActualCutting.ActualQuantity.ToString("N2")</dd>
                <dt class="col-sm-5">Good Quantity</dt><dd class="col-sm-7">@Model.ActualCutting.GoodQuantity.ToString("N2")</dd>
                <dt class="col-sm-5">Damaged Quantity</dt><dd class="col-sm-7">@Model.ActualCutting.DamagedQuantity.ToString("N2")</dd>
                <dt class="col-sm-5">Rejected Quantity</dt><dd class="col-sm-7">@Model.ActualCutting.RejectedQuantity.ToString("N2")</dd>
                <dt class="col-sm-5">Labour / Responsible Person</dt><dd class="col-sm-7">@Model.ActualCutting.ResponsiblePersonName</dd>
                <dt class="col-sm-5">Supervisor</dt><dd class="col-sm-7">@Model.ActualCutting.SupervisorName</dd>
                <dt class="col-sm-5">Remarks</dt><dd class="col-sm-7">@Model.ActualCutting.Remarks</dd>
                <dt class="col-sm-5">Created</dt><dd class="col-sm-7">@Model.ActualCutting.CreatedDate.ToString("dd/MM/yyyy HH:mm") by @Model.ActualCutting.CreatedBy</dd>
                @if (Model.ActualCutting.ModifiedDate.HasValue)
                {
                    <dt class="col-sm-5">Last Modified</dt><dd class="col-sm-7">@Model.ActualCutting.ModifiedDate.Value.ToString("dd/MM/yyyy HH:mm") by @Model.ActualCutting.ModifiedBy</dd>
                }
            </dl>
        </div>
        <div class="card-footer text-end">
            <a asp-page="/Production/ActualCutting/Index" class="btn btn-secondary">Back</a>
            <a asp-page="/Production/ActualCutting/Edit" asp-route-id="@Model.ActualCutting.Id" class="btn btn-warning">Edit</a>
        </div>
    </div>
</div>
