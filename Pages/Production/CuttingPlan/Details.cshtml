@page "{id:int}"
@model PlantStockManager.Pages.Production.CuttingPlan.DetailsModel
@{
    ViewData["Title"] = "Cutting Plan Details";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 700px;">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">@Model.CuttingPlan!.PlanNumber</h4>
            <span class="badge bg-secondary">@Model.CuttingPlan.Status</span>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-5">Mother Plant</dt>
                <dd class="col-sm-7"><a asp-page="/Production/MotherPlant/Details" asp-route-id="@Model.CuttingPlan.MotherPlantId">@Model.CuttingPlan.MotherPlantCode</a></dd>
                <dt class="col-sm-5">Polyhouse</dt><dd class="col-sm-7">@Model.CuttingPlan.PolyhouseName</dd>
                <dt class="col-sm-5">Plant Species</dt><dd class="col-sm-7">@Model.CuttingPlan.SpeciesName (@Model.CuttingPlan.PlantTypeName)</dd>
                <dt class="col-sm-5">Planned Cutting Date</dt><dd class="col-sm-7">@Model.CuttingPlan.PlannedCuttingDate.ToString("dd/MM/yyyy")</dd>
                <dt class="col-sm-5">Planned Quantity</dt><dd class="col-sm-7">@Model.CuttingPlan.PlannedQuantity.ToString("N2")</dd>
                <dt class="col-sm-5">Cutting Rate</dt><dd class="col-sm-7">@Model.CuttingPlan.CuttingRate.ToString("N4")</dd>
                <dt class="col-sm-5">Actual Cutting recorded so far</dt><dd class="col-sm-7">@Model.CuttingPlan.ActualCuttingQuantityRecorded.ToString("N2")</dd>
                <dt class="col-sm-5">Responsible Person</dt><dd class="col-sm-7">@Model.CuttingPlan.ResponsiblePersonName</dd>
                <dt class="col-sm-5">Supervisor</dt><dd class="col-sm-7">@Model.CuttingPlan.SupervisorName</dd>
                <dt class="col-sm-5">Remarks</dt><dd class="col-sm-7">@Model.CuttingPlan.Remarks</dd>
                <dt class="col-sm-5">Created</dt><dd class="col-sm-7">@Model.CuttingPlan.CreatedDate.ToString("dd/MM/yyyy HH:mm") by @Model.CuttingPlan.CreatedBy</dd>
                @if (Model.CuttingPlan.ModifiedDate.HasValue)
                {
                    <dt class="col-sm-5">Last Modified</dt><dd class="col-sm-7">@Model.CuttingPlan.ModifiedDate.Value.ToString("dd/MM/yyyy HH:mm") by @Model.CuttingPlan.ModifiedBy</dd>
                }
            </dl>
        </div>
        <div class="card-footer text-end">
            <a asp-page="/Production/CuttingPlan/Index" class="btn btn-secondary">Back</a>
            <a asp-page="/Production/CuttingPlan/Edit" asp-route-id="@Model.CuttingPlan.Id" class="btn btn-warning">Edit</a>
        </div>
    </div>
</div>
