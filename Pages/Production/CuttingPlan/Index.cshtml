@page
@model PlantStockManager.Pages.Production.CuttingPlan.IndexModel
@{
    ViewData["Title"] = "Cutting Plan";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Cutting Plan</h2>
        <a asp-page="/Production/CuttingPlan/Create" class="btn btn-primary">+ Add Cutting Plan</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Planned (filtered)</div>
                    <div class="fs-3 fw-bold">@Model.PlannedCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total Planned Quantity (filtered)</div>
                    <div class="fs-3 fw-bold">@Model.TotalPlannedQuantity.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-md-3">
            <label class="form-label">Status</label>
            <select name="Status" class="form-select" asp-for="Status">
                <option value="">-- All --</option>
                <option value="Planned">Planned</option>
                <option value="InProgress">InProgress</option>
                <option value="Completed">Completed</option>
                <option value="Cancelled">Cancelled</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-outline-primary w-100">Filter</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Plan #</th>
                    <th>Mother Plant</th>
                    <th>Variety</th>
                    <th>Polyhouse</th>
                    <th>Planned Date</th>
                    <th>Planned Qty</th>
                    <th>Cutting Rate</th>
                    <th>Responsible</th>
                    <th>Supervisor</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cp in Model.CuttingPlans)
                {
                    <tr>
                        <td>@cp.PlanNumber</td>
                        <td>@cp.MotherPlantCode</td>
                        <td>@cp.SpeciesName <span class="text-muted">(@cp.PlantTypeName)</span></td>
                        <td>@cp.PolyhouseName</td>
                        <td>@cp.PlannedCuttingDate.ToString("dd/MM/yyyy")</td>
                        <td>@cp.PlannedQuantity.ToString("N2")</td>
                        <td>@cp.CuttingRate.ToString("N2")</td>
                        <td>@cp.ResponsiblePersonName</td>
                        <td>@cp.SupervisorName</td>
                        <td><span class="badge bg-secondary">@cp.Status</span></td>
                        <td>
                            <a asp-page="/Production/CuttingPlan/Details" asp-route-id="@cp.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            <a asp-page="/Production/CuttingPlan/Edit" asp-route-id="@cp.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                        </td>
                    </tr>
                }
                @if (!Model.CuttingPlans.Any())
                {
                    <tr><td colspan="11" class="text-center text-muted">No Cutting Plans found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
