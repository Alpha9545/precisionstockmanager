@page "{id:int}"
@model PlantStockManager.Pages.Production.CuttingPlan.EditModel
@{
    ViewData["Title"] = "Edit Cutting Plan";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 800px;">
        <div class="card-header">
            <h4 class="mb-0">Edit Cutting Plan &mdash; @Model.CuttingPlan.PlanNumber</h4>
        </div>
        <div class="card-body">
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form method="post">
                <input type="hidden" asp-for="CuttingPlan.Id" />
                <input type="hidden" asp-for="CuttingPlan.PlanNumber" />
                <input type="hidden" asp-for="CuttingPlan.CreatedBy" />
                <input type="hidden" asp-for="CuttingPlan.CreatedDate" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Mother Plant</label>
                        <select asp-for="CuttingPlan.MotherPlantId" id="motherPlantSelect" class="form-select" required>
                            @foreach (var mp in Model.SelectableMotherPlants)
                            {
                                <option value="@mp.Id"
                                        data-area-id="@(mp.AreaId?.ToString() ?? "")"
                                        data-species="@mp.SpeciesName (@mp.PlantTypeName)">
                                    @mp.MotherPlantCode &mdash; @mp.SpeciesName (@mp.PolyhouseName)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Plant Species (from Mother Plant)</label>
                        <input type="text" id="speciesPreview" class="form-control" readonly />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Planned Cutting Date</label>
                        <input type="date" asp-for="CuttingPlan.PlannedCuttingDate" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Planned Quantity</label>
                        <input type="number" step="0.01" min="0.01" asp-for="CuttingPlan.PlannedQuantity" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Cutting Rate</label>
                        <input type="number" step="0.0001" min="0" asp-for="CuttingPlan.CuttingRate" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Status</label>
                        <select asp-for="CuttingPlan.Status" class="form-select">
                            <option value="Planned">Planned</option>
                            <option value="InProgress">InProgress</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Supervisor</label>
                        <select asp-for="CuttingPlan.SupervisorId" class="form-select" data-supervisor-area-source="#motherPlantSelect">
                            <option value="">-- None --</option>
                            @foreach (var s in Model.Supervisors)
                            {
                                <option value="@s.EmployeeID" data-areas="@s.AreaAttribute">@s.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Remarks</label>
                        <textarea asp-for="CuttingPlan.Remarks" class="form-control" rows="2"></textarea>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <a asp-page="/Production/CuttingPlan/Index" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-success">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#motherPlantSelect').on('change', function () {
                const opt = $(this).find('option:selected');
                $('#speciesPreview').val(opt.data('species') || '');
            }).trigger('change');
        });
    </script>
}
