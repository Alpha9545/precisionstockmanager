@page
@model PlantStockManager.Pages.Production.CuttingPlan.CreateModel
@{
    ViewData["Title"] = "Add Cutting Plan";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 800px;">
        <div class="card-header">
            <h4 class="mb-0">Add Cutting Plan</h4>
        </div>
        <div class="card-body">
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            @if (!Model.ActiveMotherPlants.Any())
            {
                <div class="alert alert-warning">
                    No Active Mother Plant batches are available to plan cuttings against.
                    <a asp-page="/Production/MotherPlant/Create">Add a Mother Plant batch</a> first.
                </div>
            }

            <form method="post">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Mother Plant</label>
                        <select asp-for="CuttingPlan.MotherPlantId" id="motherPlantSelect" class="form-select" required>
                            <option value="">-- Select --</option>
                            @foreach (var mp in Model.ActiveMotherPlants)
                            {
                                <option value="@mp.Id"
                                        data-species="@mp.SpeciesName (@mp.PlantTypeName)"
                                        data-polyhouse="@mp.PolyhouseName">
                                    @mp.MotherPlantCode &mdash; @mp.SpeciesName (@mp.PolyhouseName)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Plant Species (from Mother Plant)</label>
                        <input type="text" id="speciesPreview" class="form-control" readonly placeholder="Select a Mother Plant first" />
                        <small class="text-muted">Species is always taken from the selected Mother Plant.</small>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Planned Cutting Date</label>
                        <input type="date" asp-for="CuttingPlan.PlannedCuttingDate" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Planned Quantity</label>
                        <input type="number" step="0.01" min="0.01" asp-for="CuttingPlan.PlannedQuantity" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Cutting Rate</label>
                        <input type="number" step="0.0001" min="0" asp-for="CuttingPlan.CuttingRate" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Status</label>
                        <select asp-for="CuttingPlan.Status" class="form-select">
                            <option value="Planned">Planned</option>
                            <option value="InProgress">InProgress</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Responsible Person</label>
                        <select asp-for="CuttingPlan.ResponsiblePersonId" class="form-select">
                            <option value="">-- None --</option>
                            @foreach (var r in Model.ResponsiblePersons)
                            {
                                <option value="@r.EmployeeID">@r.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Supervisor</label>
                        <select asp-for="CuttingPlan.SupervisorId" class="form-select">
                            <option value="">-- None --</option>
                            @foreach (var s in Model.Supervisors)
                            {
                                <option value="@s.EmployeeID">@s.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Remarks</label>
                        <textarea asp-for="CuttingPlan.Remarks" class="form-control" rows="2"></textarea>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <a asp-page="/Production/CuttingPlan/Index" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-success">Save Cutting Plan</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            // Cosmetic only -- the Species shown here is never submitted;
            // the server always derives SpeciesId from the selected Mother
            // Plant record itself.
            $('#motherPlantSelect').on('change', function () {
                const opt = $(this).find('option:selected');
                const species = opt.data('species');
                $('#speciesPreview').val(species || '');
            }).trigger('change');
        });
    </script>
}
