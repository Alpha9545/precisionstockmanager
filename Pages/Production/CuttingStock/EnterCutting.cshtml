@page
@model PlantStockManager.Pages.Production.CuttingStock.EnterCuttingModel
@{
    ViewData["Title"] = "Enter Cutting";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-header">
            <h4 class="mb-0">Enter Cutting</h4>
        </div>
        <div class="card-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Plant Type</label>
                    <select id="plantTypeSelect" asp-for="PlantTypeId" class="form-select" required>
                        <option value="">-- Select Plant Type --</option>
                        @foreach (var t in Model.PlantTypes)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Variety</label>
                    <select id="speciesSelect" asp-for="SpeciesId" class="form-select" required>
                        <option value="">-- Select Variety --</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Area (Mother Plant / Kunjir / Kiran)</label>
                    <select asp-for="AreaId" class="form-select" required>
                        <option value="">-- Select Area --</option>
                        @foreach (var a in Model.Areas)
                        {
                            <option value="@a.Id">@a.Name (@a.AreaType)</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Cutting Quantity</label>
                    <input type="number" step="0.01" min="0.01" asp-for="Quantity" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Date</label>
                    <input type="text" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" disabled />
                    <div class="form-text">Recorded automatically at the time of entry.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Remarks</label>
                    <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-success">Record Cutting</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('plantTypeSelect').addEventListener('change', function () {
            var plantTypeId = this.value;
            var speciesSelect = document.getElementById('speciesSelect');
            speciesSelect.innerHTML = '<option value="">-- Select Variety --</option>';
            if (!plantTypeId) return;
            fetch('?handler=SpeciesByPlantType&plantTypeId=' + plantTypeId)
                .then(r => r.json())
                .then(data => {
                    data.forEach(function (s) {
                        var opt = document.createElement('option');
                        opt.value = s.id;
                        opt.textContent = s.name;
                        speciesSelect.appendChild(opt);
                    });
                });
        });
    </script>
}
