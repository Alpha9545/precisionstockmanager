@page
@model PlantStockManager.Pages.Production.CuttingStock.GiveToMainOfficeModel
@{
    ViewData["Title"] = "Give Cutting to Main Office";
}

<div class="container-fluid mt-4">
    <h2 class="mb-3">Give Cutting to Main Office</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-md-4">
            <label class="form-label fw-bold">From Area</label>
            <select name="areaId" class="form-select" onchange="this.form.submit()">
                <option value="">-- Select Area --</option>
                @foreach (var a in Model.Areas)
                {
                    <option value="@a.Id" selected="@(Model.SelectedAreaId == a.Id)">@a.Name (@a.AreaType)</option>
                }
            </select>
        </div>
    </form>

    @if (Model.SelectedAreaId.HasValue)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Variety</th>
                        <th>Physical</th>
                        <th>In Transit</th>
                        <th>Available</th>
                        <th style="min-width:220px;">Cutting Quantity / Tray Cavity</th>
                        <th>Send To (Main Office)</th>
                        <th>Remarks</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.StockPools)
                    {
                        <tr>
                            <td>@s.SpeciesName</td>
                            <td>@s.PhysicalQuantity.ToString("N2")</td>
                            <td>@s.InTransitQuantity.ToString("N2")</td>
                            <td class="fw-bold">@s.AvailableQuantity.ToString("N2")</td>
                            <td style="max-width:220px;">
                                <form method="post" asp-page-handler="Send" class="tray-send-form">
                                    <input type="hidden" name="cuttingStockId" value="@s.Id" />
                                    <input type="hidden" name="areaId" value="@Model.SelectedAreaId" />
                                    <input type="number" step="1" min="1" max="@s.AvailableQuantity" name="quantity" class="form-control form-control-sm mb-1 qty-input" placeholder="Cutting quantity" required />
                                    <select name="cavityType" class="form-select form-select-sm mb-1 cavity-input" required>
                                        <option value="">-- Tray Cavity --</option>
                                        @foreach (var c in Model.CavityTypes)
                                        {
                                            <option value="@c">@c</option>
                                        }
                                    </select>
                                    <div class="form-text tray-preview mb-1">&nbsp;</div>
                                    <select name="pendingConfirmationAreaId" class="form-select form-select-sm mb-1" required>
                                        <option value="">-- Main Office --</option>
                                        @foreach (var mo in Model.MainOfficeAreas)
                                        {
                                            <option value="@mo.Id">@mo.Name</option>
                                        }
                                    </select>
                                    <input type="text" name="remarks" class="form-control form-control-sm mb-1" placeholder="Remarks" />
                                    <button type="submit" class="btn btn-sm btn-primary w-100">Send</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.StockPools.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted">No available Cutting Stock at this Area.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Live preview only -- what actually gets sent is always
        // recalculated server-side from scratch on submit.
        $(function () {
            function preview(form) {
                var qty = $(form).find('.qty-input').val();
                var cavity = $(form).find('.cavity-input').val();
                var $out = $(form).find('.tray-preview');
                if (!qty || !cavity) { $out.text(''); return; }
                $.get('@Url.Page("/Production/CuttingStock/GiveToMainOffice", "TrayPreview")', { quantity: qty, cavityType: cavity }, function (r) {
                    $out.text(r.ok
                        ? r.trays + ' complete tray(s) = ' + r.cuttingsUsed + ' cuttings sent; ' + r.remainingCuttings + ' stay in this Area\'s stock.'
                        : r.error);
                });
            }
            $('.tray-send-form').on('input change', '.qty-input, .cavity-input', function () { preview($(this).closest('form')); });
        });
    </script>
}
