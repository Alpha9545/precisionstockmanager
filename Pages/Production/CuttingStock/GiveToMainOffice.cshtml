@page
@model PlantStockManager.Pages.Production.CuttingStock.GiveToMainOfficeModel
@{
    ViewData["Title"] = "Give Cutting to Main Office";
}

<div class="container-fluid mt-4">
    <h2 class="mb-3">Give Cutting to Main Office</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-md-4">
            <label class="form-label fw-bold">From Area</label>
            <select name="areaId" class="form-select" onchange="this.form.submit()">
                <option value="">-- Select Area --</option>
                @foreach (var a in Model.Areas)
                {
                    <option value="@a.Id" selected="@(Model.SelectedAreaId == a.Id)">@a.Name (@a.AreaType)</option>
                }
            </select>
        </div>
    </form>

    @if (Model.SelectedAreaId.HasValue)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Variety</th>
                        <th>Physical</th>
                        <th>In Transit</th>
                        <th>Available</th>
                        <th>Quantity to Send</th>
                        <th>Send To (Main Office)</th>
                        <th>Remarks</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.StockPools)
                    {
                        <tr>
                            <td>@s.SpeciesName</td>
                            <td>@s.PhysicalQuantity.ToString("N2")</td>
                            <td>@s.InTransitQuantity.ToString("N2")</td>
                            <td class="fw-bold">@s.AvailableQuantity.ToString("N2")</td>
                            <td style="max-width:120px;">
                                <form method="post" asp-page-handler="Send">
                                    <input type="hidden" name="cuttingStockId" value="@s.Id" />
                                    <input type="hidden" name="areaId" value="@Model.SelectedAreaId" />
                                    <input type="number" step="0.01" min="0.01" max="@s.AvailableQuantity" name="quantity" class="form-control form-control-sm mb-1" required />
                                    <select name="pendingConfirmationAreaId" class="form-select form-select-sm mb-1" required>
                                        <option value="">-- Main Office --</option>
                                        @foreach (var mo in Model.MainOfficeAreas)
                                        {
                                            <option value="@mo.Id">@mo.Name</option>
                                        }
                                    </select>
                                    <input type="text" name="remarks" class="form-control form-control-sm mb-1" placeholder="Remarks" />
                                    <button type="submit" class="btn btn-sm btn-primary w-100">Send</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.StockPools.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted">No available Cutting Stock at this Area.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
