@page "{id:int}"
@model PlantStockManager.Pages.Production.CuttingStock.ConfirmReceiptModel
@{
    ViewData["Title"] = "Confirm Receipt";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-header">
            <h4 class="mb-0">Confirm Receipt &mdash; @Model.Transfer!.TransferCode</h4>
        </div>
        <div class="card-body">
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <dl class="row">
                <dt class="col-sm-4">Source Area</dt>
                <dd class="col-sm-8">@Model.Transfer.SourceAreaName</dd>
                <dt class="col-sm-4">Variety</dt>
                <dd class="col-sm-8">@Model.Transfer.SpeciesName</dd>
                <dt class="col-sm-4">Tray Cavity</dt>
                <dd class="col-sm-8">@Model.Transfer.CavityType</dd>
                <dt class="col-sm-4">Trays Sent</dt>
                <dd class="col-sm-8">@Model.Transfer.NumberOfTrays</dd>
                <dt class="col-sm-4">Cuttings Sent</dt>
                <dd class="col-sm-8 fw-bold">@Model.Transfer.Quantity.ToString("N0")</dd>
            </dl>

            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Actual Ready Trays</label>
                    <input type="number" step="1" min="1" max="@Model.Transfer.NumberOfTrays" asp-for="ActualReadyTrays" id="actualTrays" class="form-control" required />
                    <div class="form-text">How many complete trays actually arrived / are ready. Cuttings received and wastage are calculated automatically.</div>
                </div>

                <div id="trayPreview" class="alert alert-secondary" style="display:none;"></div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Wastage Reason</label>
                    <select asp-for="WastageReason" class="form-select">
                        <option value="">-- None (no wastage) --</option>
                        @foreach (var r in Model.WastageReasons)
                        {
                            <option value="@r">@r</option>
                        }
                    </select>
                    <div class="form-text">Required only if the trays confirmed are fewer than the trays sent.</div>
                </div>

                <div class="text-center mt-4">
                    <a asp-page="/Production/CuttingStock/PendingConfirmations" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-success">Confirm Receipt</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            function preview() {
                var trays = $('#actualTrays').val();
                var $out = $('#trayPreview');
                if (!trays) { $out.hide(); return; }
                $.get('@Url.Page("/Production/CuttingStock/ConfirmReceipt", "TrayPreview", new { id = Model.Transfer!.Id })', { trays: trays }, function (r) {
                    if (r.ok) {
                        $out.removeClass('alert-danger').addClass('alert-secondary')
                            .text(trays + ' trays x @Model.Transfer.CavityType = ' + r.seedlings + ' cuttings received; wastage ' + r.wastage + ' (' + r.wastagePercent + '%).')
                            .show();
                    } else {
                        $out.removeClass('alert-secondary').addClass('alert-danger').text(r.error).show();
                    }
                });
            }
            $('#actualTrays').on('input change', preview);
            preview();
        });
    </script>
}
