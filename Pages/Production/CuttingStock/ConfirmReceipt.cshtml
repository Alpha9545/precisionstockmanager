@page "{id:int}"
@model PlantStockManager.Pages.Production.CuttingStock.ConfirmReceiptModel
@{
    ViewData["Title"] = "Confirm Cutting Receipt";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 640px;">
        <div class="card-header">
            <h4 class="mb-0">Confirm Cutting Receipt &mdash; @Model.Transfer!.TransferCode</h4>
        </div>
        <div class="card-body">
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <table class="table table-sm table-bordered">
                <tbody>
                    <tr><th class="w-50">From Area</th><td>@Model.Transfer.SourceAreaName</td></tr>
                    <tr><th>To (Main Office)</th><td>@Model.Transfer.PendingConfirmationAreaName</td></tr>
                    <tr><th>Variety</th><td>@Model.Transfer.SpeciesName?.Trim() (@Model.Transfer.PlantTypeName)</td></tr>
                    <tr><th>Delivered (sent)</th><td class="fw-bold" id="sent" data-value="@Model.Transfer.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)">@Model.Transfer.Quantity.ToString("N0")</td></tr>
                </tbody>
            </table>

            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Received quantity (counted on arrival)</label>
                    <input type="number" step="1" min="0" asp-for="ConfirmedQuantity" id="received" class="form-control" required />
                    <div class="form-text">Goes into Main Office Cutting Stock.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Missing in transit</label>
                    <input type="text" id="loss" class="form-control" readonly />
                    <div class="form-text">Delivered &minus; Received. Recorded as wastage (transit loss).</div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Reason for the missing cuttings</label>
                    <textarea asp-for="DiscrepancyReason" id="reason" class="form-control" rows="2" placeholder="Required when cuttings are missing"></textarea>
                </div>

                <div class="text-center mt-4">
                    <a asp-page="/Production/CuttingStock/PendingConfirmations" class="btn btn-secondary me-2">Back</a>
                    <button type="submit" class="btn btn-success">Confirm Receipt</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const sent = parseFloat(document.getElementById('sent').dataset.value);
            const received = document.getElementById('received');
            const loss = document.getElementById('loss');
            const reason = document.getElementById('reason');
            function update() {
                const r = parseFloat(received.value);
                if (isNaN(r)) { loss.value = ''; reason.required = false; return; }
                const l = sent - r;
                loss.value = l < 0 ? 'more than sent - not allowed' : l.toLocaleString('en-IN');
                reason.required = l > 0;
            }
            received.addEventListener('input', update);
            update();
        })();
    </script>
}
