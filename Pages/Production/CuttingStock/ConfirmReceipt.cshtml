@page "{id:int}"
@model PlantStockManager.Pages.Production.CuttingStock.ConfirmReceiptModel
@{
    ViewData["Title"] = "Confirm Receipt";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-header">
            <h4 class="mb-0">Confirm Receipt &mdash; @Model.Transfer!.TransferCode</h4>
        </div>
        <div class="card-body">
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <dl class="row">
                <dt class="col-sm-4">Source Area</dt>
                <dd class="col-sm-8">@Model.Transfer.SourceAreaName</dd>
                <dt class="col-sm-4">Variety</dt>
                <dd class="col-sm-8">@Model.Transfer.SpeciesName</dd>
                <dt class="col-sm-4">Sent Quantity</dt>
                <dd class="col-sm-8 fw-bold">@Model.Transfer.Quantity.ToString("N2")</dd>
            </dl>

            <form method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Confirmed Quantity (actually received)</label>
                    <input type="number" step="0.01" min="0" asp-for="ConfirmedQuantity" class="form-control" required />
                    <div class="form-text">Defaults to the sent quantity. Change it only if what physically arrived was different.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Discrepancy Reason</label>
                    <textarea asp-for="DiscrepancyReason" class="form-control" rows="2" placeholder="Required only if the confirmed quantity differs from what was sent"></textarea>
                </div>

                <div class="text-center mt-4">
                    <a asp-page="/Production/CuttingStock/PendingConfirmations" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-success">Confirm Receipt</button>
                </div>
            </form>
        </div>
    </div>
</div>
