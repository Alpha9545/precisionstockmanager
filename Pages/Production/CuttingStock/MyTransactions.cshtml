@page
@model PlantStockManager.Pages.Production.CuttingStock.MyTransactionsModel
@{
    ViewData["Title"] = "My Cutting Transactions";
}

<div class="container-fluid mt-4">
    <h2 class="mb-3">My Cutting Transactions</h2>

    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-md-4">
            <label class="form-label fw-bold">Area</label>
            <select name="areaId" class="form-select" onchange="this.form.submit()">
                <option value="">-- Select Area --</option>
                @foreach (var a in Model.Areas)
                {
                    <option value="@a.Id" selected="@(Model.SelectedAreaId == a.Id)">@a.Name (@a.AreaType)</option>
                }
            </select>
        </div>
    </form>

    @if (Model.SelectedAreaId.HasValue)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Transfer Code</th>
                        <th>Source Area</th>
                        <th>Destination</th>
                        <th>Variety</th>
                        <th>Sent</th>
                        <th>Confirmed</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Transactions)
                    {
                        <tr>
                            <td>@t.TransferCode</td>
                            <td>@t.SourceAreaName</td>
                            <td>@(t.DestinationAreaName ?? t.PendingConfirmationAreaName)</td>
                            <td>@t.SpeciesName</td>
                            <td>@t.Quantity.ToString("N2")</td>
                            <td>@t.ConfirmedQuantity?.ToString("N2")</td>
                            <td>
                                @{
                                    var badgeClass = t.Status switch
                                    {
                                        "Transplanted" => "bg-success",
                                        "Rejected" => "bg-danger",
                                        "Cancelled" => "bg-secondary",
                                        "ConfirmedAwaitingTransplant" => "bg-info",
                                        _ => "bg-warning text-dark"
                                    };
                                }
                                <span class="badge @badgeClass">@t.Status</span>
                            </td>
                            <td>@t.CreatedDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                    @if (!Model.Transactions.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted">No Cutting transactions for this Area yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
