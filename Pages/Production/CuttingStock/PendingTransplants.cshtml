@page
@model PlantStockManager.Pages.Production.CuttingStock.PendingTransplantsModel
@{
    ViewData["Title"] = "Pending Transplants";
}

<div class="container-fluid mt-4">
    <h2 class="mb-3">Pending Transplants</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-md-4">
            <label class="form-label fw-bold">Main Office Area</label>
            <select name="areaId" class="form-select" onchange="this.form.submit()">
                <option value="">-- All Main Office Areas --</option>
                @foreach (var a in Model.MainOfficeAreas)
                {
                    <option value="@a.Id" selected="@(Model.SelectedAreaId == a.Id)">@a.Name</option>
                }
            </select>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Transfer Code</th>
                    <th>Source Area</th>
                    <th>Variety</th>
                    <th>Cavity</th>
                    <th>Sent</th>
                    <th>Confirmed</th>
                    <th>Wastage</th>
                    <th>Confirmed On</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Pending)
                {
                    <tr>
                        <td>@t.TransferCode</td>
                        <td>@t.SourceAreaName</td>
                        <td>@t.SpeciesName</td>
                        <td>@(t.CavityType ?? "-")</td>
                        <td>@t.Quantity.ToString("N2")</td>
                        <td class="fw-bold">@t.ConfirmedQuantity?.ToString("N2")</td>
                        <td>@(t.WastageQuantity?.ToString("N2") ?? "-")</td>
                        <td>@t.ConfirmedDate?.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <a asp-page="/Production/CuttingStock/Transplant" asp-route-id="@t.Id" class="btn btn-sm btn-primary">Transplant</a>
                        </td>
                    </tr>
                }
                @if (!Model.Pending.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted">No transfers awaiting transplant.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
