@page
@model PlantStockManager.Pages.Production.CuttingStock.IndexModel
@inject PlantStockManager.Authorization.FeatureAccessService FeatureAccess
@{
    ViewData["Title"] = "Cutting Stock";
    var canSend = await FeatureAccess.CanAccessPageAsync(User, "/Production/CuttingStock/GiveToMainOffice");
    var canSow = await FeatureAccess.CanAccessPageAsync(User, "/Production/SeedSowing/CreateFromCutting");
    var canPot = await FeatureAccess.CanAccessPageAsync(User, "/Production/PotBatch/Create");
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h3 class="mb-0">Cutting Stock</h3>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-page="/Production/Cutting/Index" class="btn btn-outline-secondary">Cutting Production</a>
            <a asp-page="/Production/CuttingStock/MyTransactions" class="btn btn-outline-secondary">Deliveries</a>
            <a asp-page="/Data/StockHistory" asp-route-stockType="Cutting" class="btn btn-outline-secondary">Stock History</a>
        </div>
    </div>

    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-md-4">
            <input type="search" name="search" value="@Model.Search" class="form-control" placeholder="Search variety, crop, colour or Area" />
        </div>
        <div class="col-auto form-check ms-2">
            <input type="checkbox" class="form-check-input" id="showEmpty" name="showEmpty" value="true" @(Model.ShowEmpty ? "checked" : "") />
            <label class="form-check-label" for="showEmpty">Show empty</label>
        </div>
        <div class="col-auto"><button class="btn btn-primary">Filter</button></div>
    </form>

    <div class="table-responsive">
        <table class="table table-bordered table-striped table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>Variety</th><th>Colour</th><th>Area</th>
                    <th class="text-end">Physical</th><th class="text-end">In transit</th><th class="text-end">Available</th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Stock)
                {
                    <tr>
                        <td>@s.SpeciesName?.Trim() <span class="text-muted">(@s.PlantTypeName)</span></td>
                        <td>@(s.SpeciesColor ?? "-")</td>
                        <td>@s.AreaName @if (s.AreaType == "MainOffice") { <span class="badge bg-info text-dark">Main Office</span> }</td>
                        <td class="text-end">@s.PhysicalQuantity.ToString("N0")</td>
                        <td class="text-end">@s.InTransitQuantity.ToString("N0")</td>
                        <td class="text-end fw-bold">@s.AvailableQuantity.ToString("N0")</td>
                        <td class="text-nowrap">
                            @if (s.AvailableQuantity > 0)
                            {
                                @if (canSend && s.AreaType != "MainOffice")
                                {
                                    <a asp-page="/Production/CuttingStock/GiveToMainOffice" asp-route-areaId="@s.AreaId" class="btn btn-sm btn-outline-primary">Send to Main Office</a>
                                }
                                @if (canSow)
                                {
                                    <a asp-page="/Production/SeedSowing/CreateFromCutting" asp-route-cuttingStockId="@s.Id" class="btn btn-sm btn-outline-success">Tray Sowing</a>
                                }
                                @if (canPot)
                                {
                                    <a asp-page="/Production/PotBatch/Create" asp-route-cuttingStockId="@s.Id" class="btn btn-sm btn-outline-success">Pot Batch</a>
                                }
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Stock.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted">No cutting stock.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
