@page "{id:int}"
@model PlantStockManager.Pages.Production.OutletSale.DetailsModel
@{
    var s = Model.Sale;
    ViewData["Title"] = "Sale " + s.SaleCode;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">Sale @s.SaleCode</h3>
        <a asp-page="/Production/OutletSale/Index" class="btn btn-secondary">Back</a>
    </div>

    <table class="table table-sm table-bordered">
        <tbody>
            <tr><th class="w-25">Outlet</th><td>@s.OutletAreaName</td></tr>
            <tr><th>Customer</th><td>@s.CustomerName @(string.IsNullOrEmpty(s.CustomerContact) ? "" : "(" + s.CustomerContact + ")")</td></tr>
            <tr><th>Date</th><td>@s.SaleDate.ToString("dd/MM/yyyy")</td></tr>
            <tr><th>Created by</th><td>@(s.CreatedBy ?? "-")</td></tr>
            @if (!string.IsNullOrEmpty(s.Remarks))
            {
                <tr><th>Remarks</th><td>@s.Remarks</td></tr>
            }
        </tbody>
    </table>

    <h6>Items</h6>
    <table class="table table-sm table-striped">
        <thead class="table-light"><tr><th>Type</th><th>Variety</th><th>Colour</th><th>Pot Size / Cavity</th><th class="text-end">Quantity</th></tr></thead>
        <tbody>
            @foreach (var i in s.Items)
            {
                <tr>
                    <td>@(i.IsTray ? "Ready Tray" : "Potted Plant")</td>
                    <td>@i.SpeciesName?.Trim() <span class="text-muted">(@i.PlantTypeName)</span></td>
                    <td>@(i.SpeciesColor ?? "-")</td>
                    <td>@(i.IsTray ? i.CavityType : i.PotSize)</td>
                    <td class="text-end">@i.Quantity.ToString("N0") @(i.IsTray ? "trays" : "pots")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
