@page "{id:int}"
@model PlantStockManager.Pages.Production.PotProductionBatch.DetailsModel
@{
    ViewData["Title"] = "Pot Production Batch Details";
}

@if (Model.Batch == null)
{
    <div class="container mt-4"><div class="alert alert-danger">Batch not found.</div></div>
}
else
{
    var b = Model.Batch;
    var overdue = b.Status == "InProduction" && b.ExpectedReadyDate.Date < DateTime.Today;
    var dueSoon = b.Status == "InProduction" && !overdue && b.ExpectedReadyDate.Date <= DateTime.Today.AddDays(3);

    <div class="container-fluid mt-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="mb-0">Batch @b.BatchCode</h2>
            <a asp-page="/Production/PotProductionBatch/Index" class="btn btn-secondary">Back</a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @if (overdue)
        {
            <div class="alert alert-danger">Expected Ready Date (@b.ExpectedReadyDate.ToString("dd/MM/yyyy")) has passed and this batch is still In Production.</div>
        }
        else if (dueSoon)
        {
            <div class="alert alert-warning">Expected Ready Date (@b.ExpectedReadyDate.ToString("dd/MM/yyyy")) is approaching.</div>
        }

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3"><div class="text-muted small">Variety</div><div class="fw-bold">@b.SpeciesName (@b.PlantTypeName)</div></div>
                    <div class="col-md-3"><div class="text-muted small">Area</div><div class="fw-bold">@b.AreaName (@(b.GrowingPartnerName ?? "Internal"))</div></div>
                    <div class="col-md-3"><div class="text-muted small">Pot Size</div><div class="fw-bold">@b.PotSize</div></div>
                    <div class="col-md-3"><div class="text-muted small">Status</div>
                        <div>
                            @{
                                var badgeClass = b.Status switch { "Ready" => "bg-success", "Cancelled" => "bg-secondary", _ => "bg-warning text-dark" };
                            }
                            <span class="badge @badgeClass">@b.Status</span>
                        </div>
                    </div>

                    <div class="col-md-3"><div class="text-muted small">Planned Cutting Quantity</div><div class="fw-bold">@b.PlannedCuttingQuantity.ToString("N0")</div></div>
                    <div class="col-md-3"><div class="text-muted small">Cuttings Consumed</div><div class="fw-bold">@b.CuttingQuantityConsumedTotal.ToString("N0")</div></div>
                    <div class="col-md-3"><div class="text-muted small">Remaining to Produce</div><div class="fw-bold">@b.RemainingPlannedQuantity.ToString("N0")</div></div>
                    <div class="col-md-3"><div class="text-muted small">Potted Plants Produced</div><div class="fw-bold">@b.QuantityProducedTotal.ToString("N0")</div></div>

                    <div class="col-md-3"><div class="text-muted small">Expected Ready Date</div><div class="fw-bold">@b.ExpectedReadyDate.ToString("dd/MM/yyyy")</div></div>
                    <div class="col-md-3"><div class="text-muted small">Supervisor</div><div class="fw-bold">@(b.SupervisorName ?? "None")</div></div>
                    <div class="col-md-3"><div class="text-muted small">Production Loss</div><div class="fw-bold">@b.Loss.ToString("N0")</div></div>
                </div>
                @if (!string.IsNullOrWhiteSpace(b.Remarks))
                {
                    <div class="mt-3"><div class="text-muted small">Remarks</div><div>@b.Remarks</div></div>
                }
            </div>
        </div>

        <div class="d-flex gap-2 mb-4">
            @if (b.Status == "InProduction")
            {
                <a asp-page="/Production/PotProductionBatch/DailyEntry" asp-route-id="@b.Id" class="btn btn-primary">+ Record Daily Production</a>
                @if (Model.IsAssignedSupervisor)
                {
                    <a asp-page="/Production/PotProductionBatch/ConfirmReady" asp-route-id="@b.Id" class="btn btn-success">Confirm Ready</a>
                }
            }
        </div>

        <h5>Daily Production Entries</h5>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Date</th>
                        <th>Cuttings Consumed</th>
                        <th>Potted Plants Produced</th>
                        <th>Loss</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.DailyEntries)
                    {
                        <tr>
                            <td>@e.ProductionCode</td>
                            <td>@e.ProductionDate.ToString("dd/MM/yyyy")</td>
                            <td>@(e.CuttingQuantityConsumed?.ToString("N0") ?? "-")</td>
                            <td>@e.Quantity.ToString("N0")</td>
                            <td>@(e.Loss?.ToString("N0") ?? "-")</td>
                            <td>
                                <span class="badge @(e.Status == "Cancelled" ? "bg-secondary" : "bg-success")">@e.Status</span>
                            </td>
                        </tr>
                    }
                    @if (!Model.DailyEntries.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted">No daily production recorded yet.</td></tr>
                    }
                </tbody>
                @if (Model.DailyEntries.Any())
                {
                    <tfoot>
                        <tr class="fw-bold">
                            <td colspan="2">Total</td>
                            <td>@Model.DailyEntries.Where(e => e.Status != "Cancelled").Sum(e => e.CuttingQuantityConsumed ?? 0).ToString("N0")</td>
                            <td>@Model.DailyEntries.Where(e => e.Status != "Cancelled").Sum(e => e.Quantity).ToString("N0")</td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
}
