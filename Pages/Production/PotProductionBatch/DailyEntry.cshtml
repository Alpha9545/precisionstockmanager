@page "{id:int}"
@model PlantStockManager.Pages.Production.PotProductionBatch.DailyEntryModel
@{
    ViewData["Title"] = "Record Daily Production";
}

@if (Model.Batch == null)
{
    <div class="container mt-4"><div class="alert alert-danger">Batch not found.</div></div>
}
else
{
    var b = Model.Batch;
    <div class="container mt-4">
        <div class="card shadow-sm mx-auto" style="max-width: 700px;">
            <div class="card-header">
                <h4 class="mb-0">Record Daily Production &mdash; Batch @b.BatchCode</h4>
            </div>
            <div class="card-body">
                @if (!ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <ul class="mb-0">
                            @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@err.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }

                <dl class="row">
                    <dt class="col-sm-4">Variety</dt><dd class="col-sm-8">@b.SpeciesName (@b.PlantTypeName)</dd>
                    <dt class="col-sm-4">Area</dt><dd class="col-sm-8">@b.AreaName</dd>
                    <dt class="col-sm-4">Pot Size</dt><dd class="col-sm-8">@b.PotSize</dd>
                    <dt class="col-sm-4">Remaining to Produce</dt><dd class="col-sm-8">@b.RemainingPlannedQuantity.ToString("N0") cuttings</dd>
                </dl>

                <form method="post">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Production Date</label>
                            <input type="date" asp-for="ProductionDate" class="form-control" required />
                        </div>
                        <div class="col-md-6"></div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Cuttings Consumed Today</label>
                            <input type="number" step="0.01" min="0.01" asp-for="CuttingQuantityConsumed" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Potted Plants Produced Today</label>
                            <input type="number" step="0.01" min="0.01" asp-for="QuantityProduced" class="form-control" required />
                            <small class="text-muted">Must not exceed Cuttings Consumed -- the difference is Production Loss.</small>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold">Remarks</label>
                            <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <a asp-page="/Production/PotProductionBatch/Details" asp-route-id="@b.Id" class="btn btn-secondary me-2">Cancel</a>
                        <button type="submit" class="btn btn-success">Save Daily Production</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
