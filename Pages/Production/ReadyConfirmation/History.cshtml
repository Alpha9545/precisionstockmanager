@page "{id:int}"
@model PlantStockManager.Pages.Production.ReadyConfirmation.HistoryModel
@inject PlantStockManager.Authorization.FeatureAccessService FeatureAccess
@{
    ViewData["Title"] = "Approval History";
    var canApprove = await FeatureAccess.CanAccessPageAsync(User, "/Production/ReadyConfirmation/Confirm");
    // Only the sowing's assigned supervisor may approve it or cancel its approval.
    var me = PlantStockManager.Authorization.ClaimsPrincipalSecurityExtensions.GetUserId(User);
    var isAssignedSupervisor = Model.SeedSowing.SupervisorId.HasValue && Model.SeedSowing.SupervisorId == me;
    // 2026-10-13: a tray batch made by a transplant has no assigned supervisor -- any approver may approve
    // (a Bed Sowing batch not its recorder); an approval is cancelled by the user who made it.
    // 2026-10-16: a Bed Sowing batch only by the designated Bed Sowing approver (Model.BedApprover).
    var transplanted = Model.SeedSowing.IsTransplantedBatch && !Model.SeedSowing.SupervisorId.HasValue;
    var mayApproveHere = isAssignedSupervisor || (transplanted && PlantStockManager.Services.DirectSowingRules.CanApprove(
        null, Model.SeedSowing.CreatedById, Model.SeedSowing.CreatedBy, me, User.Identity?.Name, Model.SeedSowing.SourceType, Model.BedApprover).Ok);
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Approval History &mdash; Batch @Model.SeedSowing.SowingCode</h2>
        <a asp-page="/Production/ReadyConfirmation/Index" asp-all-route-data="Model.ListState.Route" class="btn btn-outline-secondary" id="backToApprovals">Back to Supervisor Approval</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="alert alert-secondary">
        <div class="row">
            <div class="col-md-6"><strong>Variety:</strong> @Model.SeedSowing.SpeciesName (@Model.SeedSowing.PlantTypeName)</div>
            <div class="col-md-6"><strong>Area:</strong> @Model.SeedSowing.AreaName / @(Model.SeedSowing.PolyhouseName ?? "-")</div>
            <div class="col-md-4"><strong>Sown Quantity:</strong> @Qty(Model.SeedSowing.QuantitySown)</div>
            <div class="col-md-4"><strong>Approved Ready:</strong> @Qty(Model.SeedSowing.ConfirmedReadyQuantity)</div>
            <div class="col-md-4"><strong>Wastage:</strong> @Qty(Model.SeedSowing.WastageQuantity)</div>
            <div class="col-md-4"><strong>Still to approve:</strong> @Qty(Model.SeedSowing.RemainingReadyQuantity)</div>
            <div class="col-md-4"><strong>Status:</strong> @Model.SeedSowing.Status</div>
        </div>
        @if (canApprove && mayApproveHere && Model.SeedSowing.RemainingReadyQuantity > 0 && Model.SeedSowing.Status == "Sown")
        {
            <div class="mt-2">
                <a asp-page="/Production/ReadyConfirmation/Confirm" asp-all-route-data="Model.ListState.RouteForBatch(Model.SeedSowing.Id)" class="btn btn-sm btn-success">Approve batch</a>
            </div>
        }
    </div>

    <div class="table-responsive">
        <table class="table table-sm table-striped table-hover">
            <thead class="table-light">
                <tr>
                    <th>Approval Code</th>
                    <th>Approval Date</th>
                    <th>Actual Ready Trays</th>
                    <th>Actual Ready Seedlings</th>
                    <th>Wastage</th>
                    <th>Wastage %</th>
                    <th>Wastage Reason</th>
                    <th>Approved By</th>
                    <th>Status</th>
                    <th>Responsible</th>
                    <th>Supervisor</th>
                    <th>Remarks</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rc in Model.Confirmations)
                {
                    <tr>
                        <td>@rc.ConfirmationCode</td>
                        <td>@rc.ConfirmationDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(Qty(rc.ActualTrayQuantity, "–"))</td>
                        <td>@Qty(rc.ConfirmedQuantity)</td>
                        <td>@Qty(rc.WastageQuantity)</td>
                        <td>@rc.WastagePercent.ToString("0.00")%</td>
                        <td>@(rc.WastageReason ?? "-")</td>
                        <td>@(rc.ApprovedByName ?? rc.CreatedBy ?? "-")</td>
                        <td>
                            @if (rc.Status == "Cancelled")
                            {
                                <span class="badge bg-secondary">Cancelled</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Confirmed</span>
                            }
                        </td>
                        <td>@(rc.ResponsiblePersonName ?? "-")</td>
                        <td>@(rc.SupervisorName ?? "-")</td>
                        <td>@(rc.Remarks ?? "-")</td>
                        <td>
                            @if (canApprove && (isAssignedSupervisor || (transplanted && rc.ApprovedById == me)) && rc.Status == "Confirmed")
                            {
                                <form method="post" asp-page-handler="Cancel" asp-route-confirmationId="@rc.Id" asp-route-seedSowingId="@Model.SeedSowing.Id"
                                      onsubmit="return confirm('Cancel this approval? Its Ready quantity is removed from Ready Stock and the batch is re-opened for approval.');">
                                    @foreach (var kv in Model.ListState.Route)
                                    {
                                        <input type="hidden" name="@kv.Key" value="@kv.Value" />
                                    }
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Confirmations.Any())
                {
                    <tr><td colspan="13" class="text-center text-muted">No approval recorded yet for this batch.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
