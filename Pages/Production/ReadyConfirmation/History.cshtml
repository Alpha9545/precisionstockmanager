@page "{id:int}"
@model PlantStockManager.Pages.Production.ReadyConfirmation.HistoryModel
@inject PlantStockManager.Authorization.FeatureAccessService FeatureAccess
@{
    ViewData["Title"] = "Approval History";
    var canApprove = await FeatureAccess.CanAccessPageAsync(User, "/Production/ReadyConfirmation/Confirm");
    // Only the sowing's assigned supervisor may approve it or cancel its approval.
    var isAssignedSupervisor = Model.SeedSowing.SupervisorId.HasValue
        && Model.SeedSowing.SupervisorId == PlantStockManager.Authorization.ClaimsPrincipalSecurityExtensions.GetUserId(User);
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Approval History &mdash; Batch @Model.SeedSowing.SowingCode</h2>
        <a asp-page="/Production/ReadyConfirmation/Index" class="btn btn-outline-secondary">Back to Supervisor Approval</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="alert alert-secondary">
        <div class="row">
            <div class="col-md-6"><strong>Variety:</strong> @Model.SeedSowing.SpeciesName (@Model.SeedSowing.PlantTypeName)</div>
            <div class="col-md-6"><strong>Area:</strong> @Model.SeedSowing.AreaName / @(Model.SeedSowing.PolyhouseName ?? "-")</div>
            <div class="col-md-4"><strong>Sown Quantity:</strong> @Model.SeedSowing.QuantitySown.ToString("N2")</div>
            <div class="col-md-4"><strong>Approved Ready:</strong> @Model.SeedSowing.ConfirmedReadyQuantity.ToString("N2")</div>
            <div class="col-md-4"><strong>Wastage:</strong> @Model.SeedSowing.WastageQuantity.ToString("N2")</div>
            <div class="col-md-4"><strong>Still to approve:</strong> @Model.SeedSowing.RemainingReadyQuantity.ToString("N2")</div>
            <div class="col-md-4"><strong>Status:</strong> @Model.SeedSowing.Status</div>
        </div>
        @if (canApprove && isAssignedSupervisor && Model.SeedSowing.RemainingReadyQuantity > 0 && Model.SeedSowing.Status == "Sown")
        {
            <div class="mt-2">
                <a asp-page="/Production/ReadyConfirmation/Confirm" asp-route-id="@Model.SeedSowing.Id" class="btn btn-sm btn-success">Approve batch</a>
            </div>
        }
    </div>

    <div class="table-responsive">
        <table class="table table-sm table-striped table-hover">
            <thead class="table-light">
                <tr>
                    <th>Approval Code</th>
                    <th>Approval Date</th>
                    <th>Actual Ready Trays</th>
                    <th>Actual Ready Seedlings</th>
                    <th>Wastage</th>
                    <th>Wastage %</th>
                    <th>Wastage Reason</th>
                    <th>Approved By</th>
                    <th>Status</th>
                    <th>Responsible</th>
                    <th>Supervisor</th>
                    <th>Remarks</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rc in Model.Confirmations)
                {
                    <tr>
                        <td>@rc.ConfirmationCode</td>
                        <td>@rc.ConfirmationDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(rc.ActualTrayQuantity?.ToString("N0") ?? "–")</td>
                        <td>@rc.ConfirmedQuantity.ToString("N0")</td>
                        <td>@rc.WastageQuantity.ToString("N0")</td>
                        <td>@rc.WastagePercent.ToString("0.00")%</td>
                        <td>@(rc.WastageReason ?? "-")</td>
                        <td>@(rc.ApprovedByName ?? rc.CreatedBy ?? "-")</td>
                        <td>
                            @if (rc.Status == "Cancelled")
                            {
                                <span class="badge bg-secondary">Cancelled</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Confirmed</span>
                            }
                        </td>
                        <td>@(rc.ResponsiblePersonName ?? "-")</td>
                        <td>@(rc.SupervisorName ?? "-")</td>
                        <td>@(rc.Remarks ?? "-")</td>
                        <td>
                            @if (canApprove && isAssignedSupervisor && rc.Status == "Confirmed")
                            {
                                <form method="post" asp-page-handler="Cancel" asp-route-confirmationId="@rc.Id" asp-route-seedSowingId="@Model.SeedSowing.Id"
                                      onsubmit="return confirm('Cancel this approval? Its Ready quantity is removed from Ready Stock and the batch is re-opened for approval.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Confirmations.Any())
                {
                    <tr><td colspan="13" class="text-center text-muted">No approval recorded yet for this batch.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
