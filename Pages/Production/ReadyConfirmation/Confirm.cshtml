@page "{id:int}"
@model PlantStockManager.Pages.Production.ReadyConfirmation.ConfirmModel
@{
    ViewData["Title"] = "Supervisor Approval";
    var s = Model.SeedSowing;
    var cavity = PlantStockManager.Services.DirectSowingRules.CavityCount(s.CavityType);
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 900px;">
        <div class="card-header">
            <h4 class="mb-0">Supervisor Approval &mdash; Batch @s.SowingCode</h4>
        </div>
        <div class="card-body">
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <div class="alert alert-secondary">
                <div class="row">
                    <div class="col-md-6"><strong>Variety:</strong> @s.SpeciesName (@s.PlantTypeName)</div>
                    <div class="col-md-6"><strong>Area / Polyhouse:</strong> @s.AreaName / @(s.PolyhouseName ?? "-")</div>
                    <div class="col-md-6"><strong>Sowing Date:</strong> @s.SowingDate.ToString("dd/MM/yyyy")</div>
                    <div class="col-md-6"><strong>Expected Ready Date:</strong> @(s.ExpectedReadyDate?.ToString("dd/MM/yyyy") ?? "Not estimated")</div>
                    <div class="col-md-6"><strong>Sown from:</strong> @s.SourceLabel @(s.IsCuttingSource ? "(" + s.SourceAreaName + ")" : (string.IsNullOrEmpty(s.BatchNo) ? "-" : s.BatchNo))</div>
                    <div class="col-md-6"><strong>Assigned Supervisor:</strong> @(s.SupervisorName ?? "-")</div>
                </div>
            </div>

            @* The sowing -> approval relationship. Everything here comes from the stored sowing (read-only). *@
            <h6 class="fw-bold">From the sowing (read-only)</h6>
            <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle mb-3" style="max-width: 560px;">
                <tbody>
                    <tr><th class="w-50">@(s.IsCuttingSource ? "Cutting" : "Seed") Quantity entered</th><td>@(s.SeedQuantity > 0 ? Qty(s.SeedQuantity) : "not recorded (sowing before the tray rule)")</td></tr>
                    <tr><th>Cavity (inherited, cannot be changed)</th><td><strong>@s.CavityType</strong></td></tr>
                    <tr><th>Sowing Trays</th><td>@(Qty(s.NumberOfTrays))</td></tr>
                    <tr><th>@s.UnitName Used (sown in complete trays)</th><td id="seedsSown" data-value="@s.QuantitySown.ToString(System.Globalization.CultureInfo.InvariantCulture)">@Qty(s.QuantitySown)</td></tr>
                    @if (s.IsCuttingSource && Model.AvailableCuttingStock.HasValue)
                    {
                        <tr><th>Available Cutting Stock now <span class="text-muted fw-normal">(cuttings; excludes in-transit)</span></th><td>@Qty(Model.AvailableCuttingStock.Value) cuttings</td></tr>
                        @if (Model.MaxReadyTrays.HasValue)
                        {
                            <tr><th>Most Actual Ready Trays you can enter now</th><td>@Qty(Model.MaxReadyTrays.Value) trays</td></tr>
                        }
                    }
                </tbody>
            </table>
            </div>

            <form method="post">
                <input type="hidden" asp-for="SeedSowingId" />

                <h6 class="fw-bold">Supervisor Approval</h6>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Actual Ready Trays <span class="text-danger">*</span></label>
                        @if (s.IsCuttingSource)
                        {
                            @* Cutting Tray Sowing: more trays than were sown are allowed (no browser maximum). *@
                            <input type="number" step="1" min="1" asp-for="ActualReadyTrays" asp-format="{0:0.##}"
                                   id="actualTrays" class="form-control" required />
                            <div class="form-text">
                                Enter <strong>TRAYS</strong>, not cuttings: whole trays, at least 1. One tray = @(cavity?.ToString() ?? "?") cuttings.
                                This sowing has @(Qty(s.NumberOfTrays)) trays (@Qty(s.QuantitySown) cuttings).
                                You may enter more trays than that: each extra tray takes @(cavity?.ToString() ?? "?") cuttings from Cutting Stock automatically
                                (you do not enter the extra). The total ready cuttings (trays &times; @(cavity?.ToString() ?? "?")) cannot be more than the
                                available Cutting Stock@(Model.AvailableCuttingStock.HasValue ? " (" + Qty(Model.AvailableCuttingStock.Value) + " cuttings now" + (Model.MaxReadyTrays.HasValue ? ", so at most " + Qty(Model.MaxReadyTrays.Value) + " trays" : "") + ")" : "").
                            </div>
                        }
                        else
                        {
                            @* Direct Seed Sowing: more trays than were sown are allowed too (Approved Change 3 /
                               Database/PhaseG_ReadyConfirmationTrayOverage.sql removed this cap at the database level
                               for every source type -- no browser maximum here either). *@
                            <input type="number" step="1" min="1" asp-for="ActualReadyTrays" asp-format="{0:0.##}"
                                   id="actualTrays" class="form-control" required />
                            <div class="form-text">
                                Whole trays, at least 1. This sowing has @(Qty(s.NumberOfTrays)) trays recorded;
                                approving more than that is a legitimate business outcome (e.g. the sowing under-counted trays) and is
                                accepted with zero wastage. The only quantity you enter.
                            </div>
                        }
                    </div>
                    <div class="col-md-8">
                        @* Calculated by the SERVER (same rule as the save); nothing here is posted. *@
                        <div class="table-responsive">
                        <table class="table table-sm table-bordered mb-0">
                            <tbody>
                                <tr><th class="w-50">Actual Ready Seedlings <span class="text-muted fw-normal">= trays &times; @(cavity?.ToString() ?? "?")</span></th><td id="outSeedlings">&ndash;</td></tr>
                                <tr><th>Wastage <span class="text-muted fw-normal">= @s.UnitName.ToLower() used &minus; ready seedlings</span></th><td id="outWastage">&ndash;</td></tr>
                                <tr><th>Wastage %</th><td id="outWastagePct">&ndash;</td></tr>
                                @if (s.IsCuttingSource)
                                {
                                    <tr><th>Extra Trays <span class="text-muted fw-normal">= ready trays &minus; @(Qty(s.NumberOfTrays, "?")) sown trays (trays)</span></th><td id="outExtraTrays">&ndash;</td></tr>
                                    <tr><th>Extra Cuttings taken from Cutting Stock <span class="text-muted fw-normal">= extra trays &times; @(cavity?.ToString() ?? "?") (cuttings)</span></th><td id="outExtra">&ndash;</td></tr>
                                }
                            </tbody>
                        </table>
                        </div>
                        <div class="text-danger small d-none" id="previewError"></div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Wastage Reason <span class="text-danger">*</span></label>
                        <select asp-for="WastageReason" id="wastageReason" class="form-select">
                            <option value="">-- Select --</option>
                            @foreach (var r in Model.WastageReasons)
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                        <div class="form-text">Required when wastage is more than 0.</div>
                    </div>

                    <div class="col-md-8">
                        <label class="form-label fw-bold">Remarks</label>
                        <textarea asp-for="Remarks" class="form-control" rows="1"></textarea>
                    </div>
                </div>

                <div class="small text-muted mt-3">
                    Approved By is recorded as you (@User.Identity?.Name). Ready Stock receives exactly the Actual Ready
                    Seedlings (complete trays &times; the sowing's cavity); approving closes the batch.
                </div>

                <div class="text-center mt-4">
                    <a asp-page="/Production/ReadyConfirmation/Index" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-success">Approve &amp; Close Batch</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const trays = document.getElementById('actualTrays');
            const reason = document.getElementById('wastageReason');
            const err = document.getElementById('previewError');
            const url = '@Url.Page("/Production/ReadyConfirmation/Confirm", "TrayPreview", new { id = Model.SeedSowing.Id })';
            function fmt(n) { return formatQuantity(n); }
            function preview() {
                ['outSeedlings', 'outWastage', 'outWastagePct', 'outExtraTrays', 'outExtra'].forEach(i => { const e = document.getElementById(i); if (e) e.textContent = '–'; });
                err.classList.add('d-none');
                if (!trays.value) { reason.required = false; return; }
                fetch(url + '&trays=' + encodeURIComponent(trays.value), { headers: { 'Accept': 'application/json' } })
                    .then(r => r.json())
                    .then(r => {
                        if (r.seedlings !== null) {
                            document.getElementById('outSeedlings').textContent = fmt(r.seedlings);
                            document.getElementById('outWastage').textContent = fmt(r.wastage);
                            document.getElementById('outWastagePct').textContent = r.wastagePercent.toFixed(2) + '%';
                            const extraTrays = document.getElementById('outExtraTrays');
                            if (extraTrays) extraTrays.textContent = fmt(r.extraTrays || 0) + ' trays';
                            const extra = document.getElementById('outExtra');
                            if (extra) extra.textContent = fmt(r.extraCuttings || 0) + ' cuttings';
                        }
                        reason.required = r.wastage > 0;
                        if (r.error && !r.ok) { err.textContent = r.error; err.classList.remove('d-none'); }
                    });
            }
            trays.addEventListener('input', preview);
            preview();
        })();
    </script>
}
