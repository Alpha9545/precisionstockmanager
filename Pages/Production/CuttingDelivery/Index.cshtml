@page
@model PlantStockManager.Pages.Production.CuttingDelivery.IndexModel
@{
    ViewData["Title"] = "Cutting Delivery";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Cutting Delivery</h2>
        <a asp-page="/Production/CuttingDelivery/Create" class="btn btn-primary">+ Record Cutting Delivery</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total Delivered</div>
                    <div class="fs-3 fw-bold">@Model.TotalDelivered.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total Net (to Propagation)</div>
                    <div class="fs-3 fw-bold">@Model.TotalNet.ToString("N2")</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Total Loss / Removed / Rejected / Damaged</div>
                    <div class="fs-3 fw-bold">@Model.TotalLossAndDamage.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Actual Cutting</th>
                    <th>Mother Plant</th>
                    <th>Variety</th>
                    <th>Date</th>
                    <th>Delivered</th>
                    <th>Loss</th>
                    <th>Removed</th>
                    <th>Rejected</th>
                    <th>Damaged</th>
                    <th>Net</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cd in Model.CuttingDeliveries)
                {
                    <tr>
                        <td>@cd.DeliveryCode</td>
                        <td>@cd.ActualCuttingCode</td>
                        <td>@cd.MotherPlantCode</td>
                        <td>@cd.SpeciesName <span class="text-muted">(@cd.PlantTypeName)</span></td>
                        <td>@cd.DeliveryDate.ToString("dd/MM/yyyy")</td>
                        <td>@cd.DeliveredQuantity.ToString("N2")</td>
                        <td>@cd.LossQuantity.ToString("N2")</td>
                        <td>@cd.RemovedQuantity.ToString("N2")</td>
                        <td>@cd.RejectedQuantity.ToString("N2")</td>
                        <td>@cd.DamagedQuantity.ToString("N2")</td>
                        <td><strong>@cd.NetQuantity.ToString("N2")</strong></td>
                        <td>
                            @if (cd.Status == "Cancelled")
                            {
                                <span class="badge bg-secondary">Cancelled</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Completed</span>
                            }
                        </td>
                        <td>
                            <a asp-page="/Production/CuttingDelivery/Details" asp-route-id="@cd.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            <a asp-page="/Production/CuttingDelivery/Edit" asp-route-id="@cd.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                        </td>
                    </tr>
                }
                @if (!Model.CuttingDeliveries.Any())
                {
                    <tr><td colspan="13" class="text-center text-muted">No Cutting Delivery records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
