@page "{id:int}"
@model PlantStockManager.Pages.Production.CuttingDelivery.EditModel
@{
    ViewData["Title"] = "Edit Cutting Delivery";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 900px;">
        <div class="card-header">
            <h4 class="mb-0">Edit Cutting Delivery &mdash; @Model.CuttingDelivery.DeliveryCode</h4>
        </div>
        <div class="card-body">
            @if (!ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var err in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <div class="alert alert-secondary">
                Actual Cutting <strong>@Model.CuttingDelivery.ActualCuttingCode</strong> &mdash;
                Mother Plant <strong>@Model.CuttingDelivery.MotherPlantCode</strong> &mdash;
                <strong>@Model.CuttingDelivery.SpeciesName</strong>
                <div class="small text-muted">The Actual Cutting / Mother Plant / Species linkage cannot be changed once a record exists -- it preserves traceability.</div>
            </div>

            <form method="post">
                <input type="hidden" asp-for="CuttingDelivery.Id" />
                <input type="hidden" asp-for="CuttingDelivery.DeliveryCode" />
                <input type="hidden" asp-for="CuttingDelivery.CreatedBy" />
                <input type="hidden" asp-for="CuttingDelivery.CreatedDate" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Delivery Date</label>
                        <input type="date" asp-for="CuttingDelivery.DeliveryDate" class="form-control" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Delivered Quantity</label>
                        <input type="number" step="0.01" min="0" asp-for="CuttingDelivery.DeliveredQuantity" class="form-control" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold">Status</label>
                        <select asp-for="CuttingDelivery.Status" class="form-select">
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold">Loss Quantity</label>
                        <input type="number" step="0.01" min="0" asp-for="CuttingDelivery.LossQuantity" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold">Removed Quantity</label>
                        <input type="number" step="0.01" min="0" asp-for="CuttingDelivery.RemovedQuantity" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold">Rejected Quantity</label>
                        <input type="number" step="0.01" min="0" asp-for="CuttingDelivery.RejectedQuantity" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold">Damaged Quantity</label>
                        <input type="number" step="0.01" min="0" asp-for="CuttingDelivery.DamagedQuantity" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Labour / Responsible Person</label>
                        <select asp-for="CuttingDelivery.ResponsiblePersonId" class="form-select">
                            <option value="">-- None --</option>
                            @foreach (var r in Model.ResponsiblePersons)
                            {
                                <option value="@r.EmployeeID">@r.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Supervisor</label>
                        <select asp-for="CuttingDelivery.SupervisorId" class="form-select">
                            <option value="">-- None --</option>
                            @foreach (var s in Model.Supervisors)
                            {
                                <option value="@s.EmployeeID">@s.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Remarks</label>
                        <textarea asp-for="CuttingDelivery.Remarks" class="form-control" rows="2"></textarea>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <a asp-page="/Production/CuttingDelivery/Index" class="btn btn-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-success">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
