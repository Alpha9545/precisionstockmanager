@page "{id:int}"
@model PlantStockManager.Pages.Production.PotProduction.DetailsModel
@{
    ViewData["Title"] = "Pot Production Details";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 700px;">
        <div class="card-header">
            <h4 class="mb-0">@Model.PotProduction!.ProductionCode</h4>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                @if (Model.PotProduction.IsCuttingSourced)
                {
                    <dt class="col-sm-5">Source</dt>
                    <dd class="col-sm-7"><span class="badge bg-info text-dark">Cutting Stock</span></dd>
                    <dt class="col-sm-5">Growing Partner</dt>
                    <dd class="col-sm-7">@(Model.PotProduction.GrowingPartnerName ?? "Internal")</dd>
                    <dt class="col-sm-5">Cuttings Consumed</dt>
                    <dd class="col-sm-7">@Model.PotProduction.CuttingQuantityConsumed?.ToString("N2")</dd>
                    <dt class="col-sm-5">Production Loss</dt>
                    <dd class="col-sm-7">@Model.PotProduction.Loss?.ToString("N2")</dd>
                }
                else
                {
                    <dt class="col-sm-5">Propagation Batch</dt>
                    <dd class="col-sm-7"><a asp-page="/Production/PropagationBatch/Details" asp-route-id="@Model.PotProduction.PropagationBatchId">@Model.PotProduction.PropagationBatchCode</a></dd>
                    <dt class="col-sm-5">Mother Plant</dt>
                    <dd class="col-sm-7"><a asp-page="/Production/MotherPlant/Details" asp-route-id="@Model.PotProduction.MotherPlantId">@Model.PotProduction.MotherPlantCode</a></dd>
                }
                <dt class="col-sm-5">Plant Species</dt><dd class="col-sm-7">@Model.PotProduction.SpeciesName (@Model.PotProduction.PlantTypeName)</dd>
                <dt class="col-sm-5">Pot Size</dt><dd class="col-sm-7">@Model.PotProduction.PotSize</dd>
                <dt class="col-sm-5">Area</dt><dd class="col-sm-7">@(Model.PotProduction.AreaName ?? "Unassigned")</dd>
                <dt class="col-sm-5">Production Date</dt><dd class="col-sm-7">@Model.PotProduction.ProductionDate.ToString("dd/MM/yyyy")</dd>
                <dt class="col-sm-5">Status</dt><dd class="col-sm-7">@Model.PotProduction.Status</dd>
                <dt class="col-sm-5">Quantity (Potted Plants Produced)</dt><dd class="col-sm-7">@Model.PotProduction.Quantity.ToString("N2")</dd>
                <dt class="col-sm-5">Labour / Responsible Person</dt><dd class="col-sm-7">@Model.PotProduction.ResponsiblePersonName</dd>
                <dt class="col-sm-5">Supervisor</dt><dd class="col-sm-7">@Model.PotProduction.SupervisorName</dd>
                <dt class="col-sm-5">Remarks</dt><dd class="col-sm-7">@Model.PotProduction.Remarks</dd>
                <dt class="col-sm-5">Created</dt><dd class="col-sm-7">@Model.PotProduction.CreatedDate.ToString("dd/MM/yyyy HH:mm") by @Model.PotProduction.CreatedBy</dd>
                @if (Model.PotProduction.ModifiedDate.HasValue)
                {
                    <dt class="col-sm-5">Last Modified</dt><dd class="col-sm-7">@Model.PotProduction.ModifiedDate.Value.ToString("dd/MM/yyyy HH:mm") by @Model.PotProduction.ModifiedBy</dd>
                }
            </dl>
        </div>
        <div class="card-footer text-end">
            <a asp-page="/Production/PotProduction/Index" class="btn btn-secondary">Back</a>
            <a asp-page="/Production/PotProduction/Edit" asp-route-id="@Model.PotProduction.Id" class="btn btn-warning">Edit</a>
        </div>
    </div>
</div>
