<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="iTextSharp" Version="5.5.13.4" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" />
  </ItemGroup>

  <!-- The automated tests are a separate project (tests/PlantStockManager.Tests);
       keep its files out of the web application. -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <Content Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <!-- The Android driver tracking app is a separate Gradle project (mobile/driver-android);
       keep it out of the web application's build and publish output. -->
  <ItemGroup>
    <Compile Remove="mobile\**" />
    <Content Remove="mobile\**" />
    <EmbeddedResource Remove="mobile\**" />
    <None Remove="mobile\**" />
  </ItemGroup>

  <!-- One-off data-import console tools (tools/*) are separate projects that reference this one;
       keep them out of the web application's build and publish output. -->
  <ItemGroup>
    <Compile Remove="tools\**" />
    <Content Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

</Project>
